{"_id":"2jKW38pokAVZJ5X3","name":"Enchanting Workshop","type":"script","scope":"global","img":"icons/magic/symbols/runes-star-blue.webp","command":"// Enchanting Workshop\n(() => {\n  const fn = game.uesrpg?.enchanting?.openWorkshop;\n  if (typeof fn !== 'function') return ui.notifications.error('UESRPG | Enchanting API missing (game.uesrpg.enchanting.openWorkshop)');\n  fn();\n})();\n","flags":{}}
{"_id":"NEbfTx0HbBqNj0fi","name":"Fear Test (Panic/Horror)","type":"script","scope":"global","img":"icons/svg/dice-target.svg","command":"// Fear Test — targets preferred, else controlled, else assigned character\n(async () => {\n  const api = game.uesrpg?.fear;\n  if (!api?.promptFearTest) return ui.notifications.error('UESRPG | Fear API missing (game.uesrpg.fear.promptFearTest)');\n\n  const tokens = Array.from(game.user.targets);\n  const list = tokens.length ? tokens : (canvas.tokens?.controlled ?? []);\n  const actors = Array.from(new Set(list.map(t => t?.actor).filter(Boolean)));\n  if (!actors.length && game.user.character) actors.push(game.user.character);\n  if (!actors.length) return ui.notifications.warn('UESRPG | No targets/controlled/character');\n\n  const DialogV2 = foundry.applications.api.DialogV2;\n  const form = `\n  <form style=\"display:flex; flex-direction:column; gap:8px;\">\n    <label>Type <select name=\"type\"><option value=\"panic\">Panic</option><option value=\"horror\">Horror</option></select></label>\n    <label>Modifier <input name=\"mod\" type=\"number\" value=\"0\" step=\"5\"/></label>\n    <label>Source <input name=\"source\" type=\"text\" value=\"Fear\"/></label>\n    <label>Context <select name=\"ctx\"><option value=\"auto\">Auto</option><option value=\"in\">In Combat</option><option value=\"out\">Out of Combat</option></select></label>\n  </form>`;\n\n  const data = await DialogV2.wait({\n    window: { title: 'Fear Test' },\n    content: form,\n    buttons: [\n      { action: 'run', label: 'Run', default: true, callback: (_e,_b,d) => {\n          const f=d.element.querySelector('form');\n          const type=f.type.value;\n          const modifier=Number(f.mod.value)||0;\n          const source=(f.source.value||'Fear').trim();\n          const ctx=f.ctx.value;\n          const inCombat = ctx==='auto' ? null : (ctx==='in');\n          return {type, modifier, source, inCombat};\n      }},\n      { action: 'cancel', label: 'Cancel' }\n    ],\n    rejectClose: true\n  });\n\n  if (!data || data==='cancel') return;\n  for (const actor of actors) await api.promptFearTest({actor, ...data});\n})();\n","flags":{}}
