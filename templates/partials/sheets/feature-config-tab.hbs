{{!--
  templates/partials/sheets/feature-config-tab.hbs

  Automation / Config tab content for talent, trait, and power item sheets.
  Renders per-item feature configuration stored in flags.uesrpg-3ev4.featureConfig.

  Expected context:
    featureConfig      — merged defaults + persisted flags (from getFeatureConfig)
    featureOptions     — option lists (from getFeatureConfigOptions)
    featureCapabilities — capability booleans (from getFeatureConfigCapabilities)
    isGM               — boolean
--}}

{{#if featureCapabilities.showCore}}
<div class="attribute-tab-container">

    {{!-- ── Core Controls ─────────────────────────────────────────── --}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.CoreSettings"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.EnabledHint"}}">{{localize "UESRPG.Sheets.Item.Enabled"}}</div>
                <div class="right-align-content">
                    <input class="checkbox" type="checkbox"
                           name="flags.uesrpg-3ev4.featureConfig.enabled"
                           {{checked featureConfig.enabled}} />
                </div>
            </div>
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.ApplyModeHint"}}">{{localize "UESRPG.Sheets.Feature.ApplyMode"}}</div>
                <div class="right-align-content">
                    <select name="flags.uesrpg-3ev4.featureConfig.applyMode" data-type="String">
                        {{selectOptions featureOptions.applyModeOptions selected=featureConfig.applyMode localize=false}}
                    </select>
                </div>
            </div>
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.PromptRoutingHint"}}">{{localize "UESRPG.Sheets.Feature.PromptRouting"}}</div>
                <div class="right-align-content">
                    <select name="flags.uesrpg-3ev4.featureConfig.promptMode" data-type="String">
                        {{selectOptions featureOptions.promptModeOptions selected=featureConfig.promptMode localize=false}}
                    </select>
                </div>
            </div>
        </div>
    </div>

    {{!-- ── Context Controls ──────────────────────────────────────── --}}
    {{#if featureCapabilities.showCombatContext}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.Context"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.CombatOnlyHint"}}">{{localize "UESRPG.Sheets.Feature.CombatOnly"}}</div>
                <div class="right-align-content">
                    <input class="checkbox" type="checkbox"
                           name="flags.uesrpg-3ev4.featureConfig.combatOnly"
                           {{checked featureConfig.combatOnly}} />
                </div>
            </div>
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.OutOfCombatHint"}}">{{localize "UESRPG.Sheets.Feature.AllowOutOfCombat"}}</div>
                <div class="right-align-content">
                    <input class="checkbox" type="checkbox"
                           name="flags.uesrpg-3ev4.featureConfig.outOfCombatAllowed"
                           {{checked featureConfig.outOfCombatAllowed}} />
                </div>
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- ── Stacking Override (traits primarily) ──────────────────── --}}
    {{#if featureCapabilities.showStacking}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.Stacking"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.StackingRuleHint"}}">{{localize "UESRPG.Sheets.Feature.StackingRule"}}</div>
                <div class="right-align-content">
                    <select name="flags.uesrpg-3ev4.featureConfig.stackingOverride" data-type="String">
                        {{selectOptions featureOptions.stackingOverrideOptions selected=featureConfig.stackingOverride localize=false}}
                    </select>
                </div>
            </div>
        </div>
        <div class="uesrpg-field-hint">{{localize "UESRPG.Sheets.Feature.StackingOverrideHelp"}}</div>
    </div>
    {{/if}}

    {{!-- ── Target Policy ─────────────────────────────────────────── --}}
    {{#if featureCapabilities.showTargeting}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.Targeting"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.TargetPolicyHint"}}">{{localize "UESRPG.Sheets.Feature.TargetPolicy"}}</div>
                <div class="right-align-content">
                    <select name="flags.uesrpg-3ev4.featureConfig.targetPolicy" data-type="String">
                        {{selectOptions featureOptions.targetPolicyOptions selected=featureConfig.targetPolicy localize=false}}
                    </select>
                </div>
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- ── Effect Transfer ───────────────────────────────────────── --}}
    {{#if featureCapabilities.showEffectTransfer}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.EffectTransfer"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.TransferEffectsHint"}}">{{localize "UESRPG.Sheets.Feature.TransferEffects"}}</div>
                <div class="right-align-content">
                    <input class="checkbox" type="checkbox"
                           name="flags.uesrpg-3ev4.featureConfig.transferEffects"
                           {{checked featureConfig.transferEffects}} />
                </div>
            </div>
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.SuppressSelfHint"}}">{{localize "UESRPG.Sheets.Feature.SuppressSelf"}}</div>
                <div class="right-align-content">
                    <input class="checkbox" type="checkbox"
                           name="flags.uesrpg-3ev4.featureConfig.suppressSelfTransfer"
                           {{checked featureConfig.suppressSelfTransfer}} />
                </div>
            </div>
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.EffectDurationHint"}}">{{localize "UESRPG.Sheets.Feature.EffectDuration"}}</div>
                <div class="right-align-content">
                    <select name="flags.uesrpg-3ev4.featureConfig.effectDuration" data-type="String">
                        {{selectOptions featureOptions.effectDurationOptions selected=featureConfig.effectDuration localize=false}}
                    </select>
                </div>
            </div>
        </div>
        <div class="uesrpg-field-hint">{{localize "UESRPG.Sheets.Feature.EffectTransferHelp"}}</div>
    </div>
    {{/if}}

    {{!-- ── Visibility ────────────────────────────────────────────── --}}
    {{#if featureCapabilities.showVisibility}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.Visibility"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.VisibilityHint"}}">{{localize "UESRPG.Sheets.Feature.Scope"}}</div>
                <div class="right-align-content">
                    <select name="flags.uesrpg-3ev4.featureConfig.visibility" data-type="String">
                        {{selectOptions featureOptions.visibilityOptions selected=featureConfig.visibility localize=false}}
                    </select>
                </div>
            </div>
        </div>
    </div>
    {{/if}}

    {{!-- ── Debug (GM only) ───────────────────────────────────────── --}}
    {{#if isGM}}
    {{#if featureCapabilities.showDebug}}
    <div class="item-selection-container">
        <h2>{{localize "UESRPG.Sheets.Feature.Debug"}}</h2>
        <div class="selection-container">
            <div class="grid-container">
                <div data-tooltip-text="{{localize "UESRPG.Sheets.Feature.ShowInInspectorHint"}}">{{localize "UESRPG.Sheets.Feature.ShowInInspector"}}</div>
                <div class="right-align-content">
                    <input class="checkbox" type="checkbox"
                           name="flags.uesrpg-3ev4.featureConfig.debug.showInInspector"
                           {{checked featureConfig.debug.showInInspector}} />
                </div>
            </div>
        </div>
    </div>
    {{/if}}
    {{/if}}

</div>
{{/if}}
