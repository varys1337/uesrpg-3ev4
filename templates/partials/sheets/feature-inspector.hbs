{{!-- Feature Inspector Panel --}}
{{!-- Collapsible panel showing all trait/talent/power contributions to derived totals. --}}
{{!-- Expects: featureInspector (from buildFeatureInspectorContext) --}}

{{#if featureInspector.hasData}}
<div class="feature-inspector-panel">
  <details class="feature-inspector-details">
    <summary class="feature-inspector-summary">
      <i class="fas fa-search" aria-hidden="true"></i>
      {{localize "UESRPG.Sheets.FeatureInspector.Title"}}
      <span class="feature-inspector-badge">{{localize "UESRPG.Sheets.FeatureInspector.Summary" mods=featureInspector.totalContributions paths=featureInspector.uniquePaths}}</span>
    </summary>

    <div class="feature-inspector-body">
      {{#if isGM}}
      <div class="feature-inspector-actions">
        <button type="button" class="uesrpg-feature-inspector-copy uesrpg-styled-action" data-action="featureInspectorCopy" data-json="{{featureInspector.modsJson}}" data-tooltip-text="{{localize "UESRPG.Sheets.FeatureInspector.CopyHint"}}" aria-label="{{localize "UESRPG.Sheets.FeatureInspector.CopyHint"}}">
          <i class="fas fa-clipboard" aria-hidden="true"></i> {{localize "UESRPG.Sheets.FeatureInspector.Copy"}}
        </button>
      </div>
      {{/if}}

      <div class="feature-inspector-table-wrapper">
        <table class="feature-inspector-table">
          <thead>
            <tr>
              <th>{{localize "UESRPG.Sheets.FeatureInspector.Target"}}</th>
              <th>{{localize "UESRPG.Sheets.FeatureInspector.Source"}}</th>
              <th>{{localize "UESRPG.Sheets.FeatureInspector.Value"}}</th>
              <th>{{localize "UESRPG.Sheets.FeatureInspector.Stacking"}}</th>
              <th>{{localize "UESRPG.Sheets.FeatureInspector.Final"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each featureInspector.groups}}
              {{#each this.contributions}}
              <tr class="feature-inspector-row {{#if @first}}feature-inspector-group-start{{/if}}">
                {{#if @first}}
                <td class="fi-path" rowspan="{{../contributions.length}}">{{../pathLabel}}</td>
                {{/if}}
                <td class="fi-source">
                  <span class="fi-source-type fi-type-{{this.sourceType}}">{{this.sourceType}}</span>
                  {{this.itemName}}
                </td>
                <td class="fi-value">{{this.valueLabel}}</td>
                {{#if @first}}
                <td class="fi-stacking" rowspan="{{../contributions.length}}">{{../stackingLabel}}</td>
                <td class="fi-final" rowspan="{{../contributions.length}}">{{../finalValue}}</td>
                {{/if}}
              </tr>
              {{/each}}
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </details>
</div>
{{/if}}
