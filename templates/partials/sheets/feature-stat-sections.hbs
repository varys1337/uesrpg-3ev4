<div class="uesrpg-feature-stats{{#if twoColumn}} uesrpg-feature-stats--two{{/if}}">
  <fieldset class="attr-fieldset uesrpg-feature-section">
    <legend>Characteristics</legend>
    {{#if item.system.characteristicBonus}}
    <div class="uesrpg-feature-grid">
      <label class="uesrpg-feature-stat">STR <input type="number" name="system.characteristicBonus.strChaBonus" value="{{#if item.system.characteristicBonus.strChaBonus}}{{item.system.characteristicBonus.strChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">END <input type="number" name="system.characteristicBonus.endChaBonus" value="{{#if item.system.characteristicBonus.endChaBonus}}{{item.system.characteristicBonus.endChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">AGI <input type="number" name="system.characteristicBonus.agiChaBonus" value="{{#if item.system.characteristicBonus.agiChaBonus}}{{item.system.characteristicBonus.agiChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">INT <input type="number" name="system.characteristicBonus.intChaBonus" value="{{#if item.system.characteristicBonus.intChaBonus}}{{item.system.characteristicBonus.intChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">WP <input type="number" name="system.characteristicBonus.wpChaBonus" value="{{#if item.system.characteristicBonus.wpChaBonus}}{{item.system.characteristicBonus.wpChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">PRC <input type="number" name="system.characteristicBonus.prcChaBonus" value="{{#if item.system.characteristicBonus.prcChaBonus}}{{item.system.characteristicBonus.prcChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">PRS <input type="number" name="system.characteristicBonus.prsChaBonus" value="{{#if item.system.characteristicBonus.prsChaBonus}}{{item.system.characteristicBonus.prsChaBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">LCK <input type="number" name="system.characteristicBonus.lckChaBonus" value="{{#if item.system.characteristicBonus.lckChaBonus}}{{item.system.characteristicBonus.lckChaBonus}}{{else}}0{{/if}}"></label>
    </div>
    {{else}}
    <div class="attr-empty-hint">No characteristic bonuses</div>
    {{/if}}
  </fieldset>

  <fieldset class="attr-fieldset uesrpg-feature-section">
    <legend>Resistances</legend>
    <div class="uesrpg-feature-grid">
      <label class="uesrpg-feature-stat">Disease <input type="number" name="system.diseaseR" value="{{#if item.system.diseaseR}}{{item.system.diseaseR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Fire <input type="number" name="system.fireR" value="{{#if item.system.fireR}}{{item.system.fireR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Frost <input type="number" name="system.frostR" value="{{#if item.system.frostR}}{{item.system.frostR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Shock <input type="number" name="system.shockR" value="{{#if item.system.shockR}}{{item.system.shockR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Poison <input type="number" name="system.poisonR" value="{{#if item.system.poisonR}}{{item.system.poisonR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Magic <input type="number" name="system.magicR" value="{{#if item.system.magicR}}{{item.system.magicR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Toughness <input type="number" name="system.natToughnessR" value="{{#if item.system.natToughnessR}}{{item.system.natToughnessR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Silver <input type="number" name="system.silverR" value="{{#if item.system.silverR}}{{item.system.silverR}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Sunlight <input type="number" name="system.sunlightR" value="{{#if item.system.sunlightR}}{{item.system.sunlightR}}{{else}}0{{/if}}"></label>
    </div>
  </fieldset>

  {{#if includeStats}}
  <fieldset class="attr-fieldset uesrpg-feature-section">
    <legend>Stats</legend>
    <div class="uesrpg-feature-grid">
      <label class="uesrpg-feature-stat">HP+ <input type="number" name="system.hpBonus" value="{{#if item.system.hpBonus}}{{item.system.hpBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">SP+ <input type="number" name="system.spBonus" value="{{#if item.system.spBonus}}{{item.system.spBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">MP+ <input type="number" name="system.mpBonus" value="{{#if item.system.mpBonus}}{{item.system.mpBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">LP+ <input type="number" name="system.lpBonus" value="{{#if item.system.lpBonus}}{{item.system.lpBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">WT+ <input type="number" name="system.wtBonus" value="{{#if item.system.wtBonus}}{{item.system.wtBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">INI+ <input type="number" name="system.iniBonus" value="{{#if item.system.iniBonus}}{{item.system.iniBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Spd+ <input type="number" name="system.speedBonus" value="{{#if item.system.speedBonus}}{{item.system.speedBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Swim+ <input type="number" name="system.swimBonus" value="{{#if item.system.swimBonus}}{{item.system.swimBonus}}{{else}}0{{/if}}"></label>
      <label class="uesrpg-feature-stat">Fly+ <input type="number" name="system.flyBonus" value="{{#if item.system.flyBonus}}{{item.system.flyBonus}}{{else}}0{{/if}}"></label>
    </div>
  </fieldset>
  {{/if}}
</div>
