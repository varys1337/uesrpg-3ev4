<fieldset class="attr-fieldset uesrpg-feature-section">
  <legend>{{localize "UESRPG.UI.Activation"}}</legend>
  <div class="uesrpg-feature-activation">
    <div class="uesrpg-feature-row">
      <label title="{{localize "UESRPG.Sheets.Feature.ActivatedTitle" itemKind=itemKind}}">
        <input class="checkbox" type="checkbox" name="system.activation.enabled" {{checked item.system.activation.enabled}}>
        {{localize "UESRPG.UI.Activated"}}
      </label>
      <label>
        {{localize "UESRPG.UI.Action"}}
        <select name="system.activation.actionType" data-type="String">
          {{selectOptions actionTypeOptions selected=item.system.activation.actionType localize=false}}
        </select>
      </label>
      <label title="{{localize "UESRPG.Sheets.Feature.SpendCostsTitle"}}">
        <input class="checkbox" type="checkbox" name="system.activation.spendCosts" {{checked item.system.activation.spendCosts}}>
        {{localize "UESRPG.UI.SpendCosts"}}
      </label>
      <label title="{{localize "UESRPG.Sheets.Feature.ConsumeUseTitle"}}">
        <input class="checkbox" type="checkbox" name="system.activation.consumeUse" {{checked item.system.activation.consumeUse}}>
        {{localize "UESRPG.UI.ConsumeUse"}}
      </label>
    </div>

    <div class="uesrpg-feature-subheading">{{localize "UESRPG.UI.Requirements"}}</div>
    <div class="uesrpg-feature-row">
      <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresTarget" {{checked item.system.activation.requirements.requiresTarget}}> {{localize "UESRPG.UI.Target"}}</label>
      <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresEquippedWeapon" {{checked item.system.activation.requirements.requiresEquippedWeapon}}> {{localize "UESRPG.UI.EquippedWeapon"}}</label>
      <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresMelee" {{checked item.system.activation.requirements.requiresMelee}}> {{localize "UESRPG.UI.Melee"}}</label>
      <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresRanged" {{checked item.system.activation.requirements.requiresRanged}}> {{localize "UESRPG.UI.Ranged"}}</label>
      <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresHitLocation" {{checked item.system.activation.requirements.requiresHitLocation}}> {{localize "UESRPG.UI.HitLocation"}}</label>
    </div>

    {{#if includeNpcFlags}}
    <div class="uesrpg-feature-subheading">{{localize "UESRPG.UI.NpcFlags"}}</div>
    <div class="uesrpg-feature-row">
      <label><input class="checkbox" type="checkbox" name="system.activation.flags.npcLuckAllowed" {{checked item.system.activation.flags.npcLuckAllowed}}> {{localize "UESRPG.UI.AllowNpcLuck"}}</label>
      <label><input class="checkbox" type="checkbox" name="system.activation.flags.npcEliteAllowed" {{checked item.system.activation.flags.npcEliteAllowed}}> {{localize "UESRPG.UI.AllowNpcHeroic"}}</label>
    </div>
    {{/if}}

    {{#if includeRangeAoe}}
    <div class="uesrpg-feature-subheading">{{localize "UESRPG.UI.RangeAndAoe"}}</div>
    <div class="uesrpg-feature-row">
      <label>
        {{localize "UESRPG.UI.Range"}}
        <select name="system.rangeType" data-type="String">
          <option value="none" {{#if (eq item.system.rangeType "none")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.RangeType.None"}}</option>
          <option value="ranged" {{#if (eq item.system.rangeType "ranged")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.RangeType.Ranged"}}</option>
          <option value="melee" {{#if (eq item.system.rangeType "melee")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.RangeType.Melee"}}</option>
          <option value="aoe" {{#if (eq item.system.rangeType "aoe")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.RangeType.Aoe"}}</option>
        </select>
      </label>
      <label>
        {{localize "UESRPG.Sheets.Feature.RangeValue"}}
        <input type="text" name="system.range" value="{{item.system.range}}" placeholder="{{localize "UESRPG.Sheets.Feature.RangePlaceholder"}}" />
      </label>
    </div>
    {{#if (eq item.system.rangeType "aoe")}}
    <div class="uesrpg-feature-row">
      <label>
        {{localize "UESRPG.Sheets.Feature.Shape"}}
        <select name="system.aoeShape" data-type="String">
          <option value="circle" {{#if (eq item.system.aoeShape "circle")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.AoeShape.Circle"}}</option>
          <option value="cone" {{#if (eq item.system.aoeShape "cone")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.AoeShape.Cone"}}</option>
          <option value="ray" {{#if (eq item.system.aoeShape "ray")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.AoeShape.Ray"}}</option>
          <option value="rect" {{#if (eq item.system.aoeShape "rect")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.AoeShape.Rect"}}</option>
          <option value="pulse" {{#if (eq item.system.aoeShape "pulse")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.AoeShape.Pulse"}}</option>
        </select>
      </label>
      <label>{{localize "UESRPG.Sheets.Feature.SizeMeters"}} <input type="number" name="system.aoeSize" value="{{item.system.aoeSize}}" min="0" step="0.5" /></label>
      <label>{{localize "UESRPG.Sheets.Feature.WidthMeters"}} <input type="number" name="system.aoeWidth" value="{{item.system.aoeWidth}}" min="0" step="0.5" /></label>
      <label><input class="checkbox" type="checkbox" name="system.aoeIncludeCaster" {{checked item.system.aoeIncludeCaster}}> {{localize "UESRPG.Sheets.Feature.AffectCaster"}}</label>
    </div>
    {{/if}}
    {{/if}}

    <div class="uesrpg-feature-subheading">{{localize "UESRPG.Sheets.Feature.Attack"}}</div>
    <div class="uesrpg-feature-row">
      <label>
        {{localize "UESRPG.Sheets.Feature.IsAttack"}}
        <select name="system.activation.roll.mode" data-type="String">
          <option value="none" {{#if (eq item.system.activation.roll.mode "none")}}selected{{/if}}>{{localize "UESRPG.UI.No"}}</option>
          <option value="attack" {{#if (eq item.system.activation.roll.mode "attack")}}selected{{/if}}>{{localize "UESRPG.UI.Yes"}}</option>
        </select>
      </label>
      {{#if (eq item.system.activation.roll.mode "attack")}}
      <label>
        {{localize "UESRPG.Sheets.Feature.HitLocMode"}}
        <select name="system.activation.roll.hitLocationMode" data-type="String">
          {{selectOptions activationHitLocationModeOptions selected=item.system.activation.roll.hitLocationMode localize=false}}
        </select>
      </label>
      {{/if}}
    </div>

    <div class="uesrpg-feature-subheading">{{localize "UESRPG.Sheets.Feature.DamageHealing"}}</div>
    <div class="uesrpg-feature-row">
      <label>
        {{localize "UESRPG.Sheets.Feature.Mode"}}
        <select name="system.activation.damage.mode" data-type="String">
          {{selectOptions activationDamageModeOptions selected=item.system.activation.damage.mode localize=false}}
        </select>
      </label>
      {{#if (eq item.system.activation.damage.mode "manual")}}
      <label>
        {{localize "UESRPG.Sheets.Feature.Formula"}}
        <input type="text" name="system.activation.damage.formula" value="{{item.system.activation.damage.formula}}" placeholder="{{localize "UESRPG.Sheets.Feature.DamageFormulaPlaceholder"}}" />
      </label>
      <label>
        {{localize "UESRPG.Sheets.Feature.Type"}}
        <select name="system.activation.damage.type" data-type="String">
          {{selectOptions activationDamageTypeOptions selected=item.system.activation.damage.type localize=false}}
        </select>
      </label>
      {{/if}}
      {{#if (eq item.system.activation.damage.mode "healing")}}
      <label>
        {{localize "UESRPG.Sheets.Feature.Formula"}}
        <input type="text" name="system.activation.damage.formula" value="{{item.system.activation.damage.formula}}" placeholder="{{localize "UESRPG.Sheets.Feature.DamageFormulaPlaceholder"}}" />
      </label>
      {{/if}}
      {{#if (eq item.system.activation.damage.mode "temporary")}}
      <label>
        {{localize "UESRPG.Sheets.Feature.Formula"}}
        <input type="text" name="system.activation.damage.formula" value="{{item.system.activation.damage.formula}}" placeholder="{{localize "UESRPG.Sheets.Feature.TemporaryHpFormulaPlaceholder"}}" />
      </label>
      {{/if}}
    </div>

    {{#if (eq item.system.activation.damage.mode "manual")}}
    <div class="u-mt-xs">
      <div class="u-text-bold u-mb-sm u-text-xs">{{localize "UESRPG.Sheets.Feature.DamageQualities"}}</div>
      <input type="hidden" name="activationDamageQualities.present" value="1" />
      <div class="structured-qualities-grid">
        {{#each activationDamageQualitiesCatalog}}
          <div class="structured-qualities-cell">
            <div>{{localize this.label}}</div>
            <div class="right-align-content">
              {{#if this.optionalValue}}
                <div class="structured-optional-value">
                  <input class="checkbox" type="checkbox" name="activationDamageQualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../activationDamageSelectedToggle this.key)}} />
                  <input class="structured-value structured-value--opt" type="number" name="activationDamageQualitiesStructured.value.{{this.key}}" value="{{lookup ../activationDamageSelectedValue this.key}}" min="0" step="1" placeholder="{{localize "UESRPG.Placeholders.NumericValue"}}" />
                </div>
              {{else}}
                {{#if this.hasValue}}
                  <input class="structured-value" type="number" name="activationDamageQualitiesStructured.value.{{this.key}}" value="{{lookup ../activationDamageSelectedValue this.key}}" min="0" step="1" />
                {{else}}
                  <input class="checkbox" type="checkbox" name="activationDamageQualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../activationDamageSelectedToggle this.key)}} />
                {{/if}}
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
      <div class="structured-traits-block u-mt-sm">
        <div class="structured-traits-label">{{localize "UESRPG.Sheets.Item.OtherTraits"}}</div>
        <div class="structured-traits-pills">
          {{#each activationDamageTraitsCatalog}}
            <label class="uesrpg-pill {{#if this.selected}}is-selected{{/if}}">
              <input type="checkbox" name="activationDamageQualitiesTraits.toggle.{{this.key}}" {{checked this.selected}} />
              <span>{{localize this.label}}</span>
            </label>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}

    <div class="uesrpg-feature-subheading">{{localize "UESRPG.Sheets.Feature.CostsUsage"}}</div>
    <div class="uesrpg-feature-costs">
      <label>AP <input type="number" name="system.activation.costs.action_points" value="{{item.system.activation.costs.action_points}}" min="0" step="1" /></label>
      <label>SP <input type="number" name="system.activation.costs.stamina" value="{{item.system.activation.costs.stamina}}" min="0" step="1" /></label>
      <label>MP <input type="number" name="system.activation.costs.magicka" value="{{item.system.activation.costs.magicka}}" min="0" step="1" /></label>
      <label>LP <input type="number" name="system.activation.costs.luck_points" value="{{item.system.activation.costs.luck_points}}" min="0" step="1" /></label>
      {{#if includeHealthCost}}
      <label>HP <input type="number" name="system.activation.costs.health" value="{{item.system.activation.costs.health}}" min="0" step="1" /></label>
      {{/if}}
    </div>
    <div class="uesrpg-feature-costs u-mt-xs">
      <label>{{localize "UESRPG.Sheets.Feature.Current"}} <input type="number" name="system.activation.usage.current" value="{{item.system.activation.usage.current}}" min="0" step="1" /></label>
      <label>{{localize "UESRPG.Sheets.Item.Max"}} <input type="number" name="system.activation.usage.max" value="{{item.system.activation.usage.max}}" min="0" step="1" /></label>
      <label>{{localize "UESRPG.Sheets.Feature.Reset"}}
        <select name="system.activation.usage.period" data-type="String">
          {{selectOptions activationUsagePeriodOptions selected=item.system.activation.usage.period localize=false}}
        </select>
      </label>
      <div class="activation-use-btn-wrap">
        <button type="button" class="{{useButtonClass}}" data-action="{{useAction}}"><i class="fas fa-bolt"></i> {{localize "UESRPG.Sheets.Feature.Use"}}</button>
      </div>
    </div>
  </div>
</fieldset>
