        <div class="sheet-fixed-container">
            <div class="character-profile-container">
                <div class="profile-img-container">
                    <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editPortrait" data-tooltip-text="{{actor.name}}" alt="{{actor.name}}">
                    <div class="status-column">
                        <div class="vertical-flex-container">
                            <img id="wound-icon" src="icons/skills/wounds/blood-drip-droplet-red.webp" data-tooltip-text="{{localize "UESRPG.UI.WoundedPenalty" value=actor.system.woundPenalty}}" alt="">
                            <img id="fatigue-icon" src="icons/magic/control/debuff-energy-hold-green.webp" data-tooltip-text="{{localize "UESRPG.UI.FatiguedPenalty" value=actor.system.fatigue.penalty}}" alt="">
                            <img id="enc-icon" src="icons/containers/bags/pack-leather-brown.webp" data-tooltip-text="{{carryRatingLabel}} {{actor.system.carry_rating.penalty}}" alt="">
                        </div>
                    </div>
                </div>
            </div>
            <h1 class="charname"><input type="text" name="name" value="{{actor.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"></h1>
            <div class="fixed-data-container">
                <div class="resourceBars">
                    {{!-- Health --}}
                    <div class="resource-row" id="hpResource">
                        <button type="button" class="resource-name resource-name--hp" data-resource="hp" data-tooltip="UESRPG.Sheets.FixedHeader.ManageHealth" aria-label="{{localize "UESRPG.Sheets.FixedHeader.ManageHealth"}}">{{localize "UESRPG.UI.HP"}}</button>
                        <div class="maxBar" data-resource="hp">
                            <div class="bar-values">
                                <input type="number" name="system.hp.value" value="{{actor.system.hp.value}}"> / <label>{{actor.system.hp.max}}</label>
                                {{#if (gt actor.system.tempHP 0)}}
                                    <span class="temp-hp-overlay">+{{actor.system.tempHP}}</span>
                                {{/if}}
                            </div>
                            <div id="hpBar" class="currentBar" data-resource="hp"></div>
                        </div>
                        <div class="resource-controls">
                            <i data-direction="increase" data-resource="hp" data-action="incrementResource" class="fas fa-angle-up" data-tooltip="UESRPG.UI.Increase" aria-label="{{localize "UESRPG.UI.Increase"}}"></i>
                            <i data-direction="restore" data-resource="hp" data-action="restoreResource" class="fas fa-undo" data-tooltip="UESRPG.UI.Restore" aria-label="{{localize "UESRPG.UI.Restore"}}"></i>
                            <i data-direction="decrease" data-resource="hp" data-action="incrementResource" class="fas fa-angle-down" data-tooltip="UESRPG.UI.Decrease" aria-label="{{localize "UESRPG.UI.Decrease"}}"></i>
                        </div>
                    </div>
                    {{!-- Stamina --}}
                    <div class="resource-row" id="staminaResource">
                        <button type="button" class="resource-name resource-name--stamina" data-resource="stamina" data-tooltip="UESRPG.Sheets.FixedHeader.ManageStamina" aria-label="{{localize "UESRPG.Sheets.FixedHeader.ManageStamina"}}">{{localize "UESRPG.UI.SP"}}</button>
                        <div class="maxBar" data-resource="stamina">
                            <div class="bar-values">
                                <input type="number" name="system.stamina.value" value="{{actor.system.stamina.value}}"> / <label>{{actor.system.stamina.max}}</label>
                                {{#if (gt actor.system.stamina.temp 0)}}
                                    <span class="temp-hp-overlay">+{{actor.system.stamina.temp}}</span>
                                {{/if}}
                            </div>
                            <div id="staminaBar" class="currentBar" data-resource="stamina"></div>
                        </div>
                        <div class="resource-controls">
                            <i data-direction="increase" data-resource="stamina" data-action="incrementResource" class="fas fa-angle-up" data-tooltip="UESRPG.UI.Increase" aria-label="{{localize "UESRPG.UI.Increase"}}"></i>
                            <i data-direction="restore" data-resource="stamina" data-action="restoreResource" class="fas fa-undo" data-tooltip="UESRPG.UI.Restore" aria-label="{{localize "UESRPG.UI.Restore"}}"></i>
                            <i data-direction="decrease" data-resource="stamina" data-action="incrementResource" class="fas fa-angle-down" data-tooltip="UESRPG.UI.Decrease" aria-label="{{localize "UESRPG.UI.Decrease"}}"></i>
                        </div>
                    </div>
                    {{!-- Magicka --}}
                    <div class="resource-row" id="magickaResource">
                        <button type="button" class="resource-name resource-name--magicka" data-resource="magicka" data-tooltip="UESRPG.Sheets.FixedHeader.ManageMagicka" aria-label="{{localize "UESRPG.Sheets.FixedHeader.ManageMagicka"}}">{{localize "UESRPG.UI.MP"}}</button>
                        <div class="maxBar" data-resource="magicka">
                            <div class="bar-values">
                                <input type="number" name="system.magicka.value" value="{{actor.system.magicka.value}}"> / <label>{{actor.system.magicka.max}}</label>
                                {{#if (gt actor.system.buffers.physical 0)}}
                                    <span class="buffer-overlay" data-tooltip-text="{{localize "UESRPG.Sheets.FixedHeader.PhysicalBuffer" value=actor.system.buffers.physical}}">🛡{{actor.system.buffers.physical}}</span>
                                {{/if}}
                                {{#if (gt actor.system.buffers.magical 0)}}
                                    <span class="buffer-overlay" data-tooltip-text="{{localize "UESRPG.Sheets.FixedHeader.MagicalBuffer" value=actor.system.buffers.magical}}">✨{{actor.system.buffers.magical}}</span>
                                {{/if}}
                                {{#if (gt actor.system.buffers.elemental 0)}}
                                    <span class="buffer-overlay" data-tooltip-text="{{localize "UESRPG.Sheets.FixedHeader.ElementalBuffer" value=actor.system.buffers.elemental}}">🔥{{actor.system.buffers.elemental}}</span>
                                {{/if}}
                            </div>
                            <div id="magickaBar" class="currentBar" data-resource="magicka"></div>
                        </div>
                        <div class="resource-controls">
                            <i data-direction="increase" data-resource="magicka" data-action="incrementResource" class="fas fa-angle-up" data-tooltip="UESRPG.UI.Increase" aria-label="{{localize "UESRPG.UI.Increase"}}"></i>
                            <i data-direction="restore" data-resource="magicka" data-action="restoreResource" class="fas fa-undo" data-tooltip="UESRPG.UI.Restore" aria-label="{{localize "UESRPG.UI.Restore"}}"></i>
                            <i data-direction="decrease" data-resource="magicka" data-action="incrementResource" class="fas fa-angle-down" data-tooltip="UESRPG.UI.Decrease" aria-label="{{localize "UESRPG.UI.Decrease"}}"></i>
                        </div>
                    </div>
                    {{#if actor.ui.worship.available}}
                    <div class="resource-row" id="worshipResource">
                        <button type="button" class="resource-name resource-name--luck" data-resource="worship" data-tooltip="UESRPG.Sheets.FixedHeader.ManagePietyPoints" aria-label="{{localize "UESRPG.Sheets.FixedHeader.ManagePietyPoints"}}">{{localize "UESRPG.UI.PP"}}</button>
                        <div class="maxBar" data-resource="worship" data-value="{{actor.ui.worship.displayPietyValue}}" data-max="{{actor.ui.worship.displayPietyMax}}" data-tooltip-text="{{actor.ui.worship.displayDomainLabel}}">
                            <div class="bar-values">
                                <span>{{actor.ui.worship.displayPietyValue}}</span> / <label>{{actor.ui.worship.displayPietyMax}}</label>
                                {{#if actor.ui.worship.displayDomainLabel}}
                                <span class="temp-hp-overlay">{{actor.ui.worship.displayDomainLabel}}</span>
                                {{/if}}
                            </div>
                            <div id="worshipBar" class="currentBar" data-resource="worship" style="background-color: var(--uesrpg-gold);"></div>
                        </div>
                        <div class="resource-controls">
                            {{#if actor.ui.worship.hasPrimaryDomain}}
                            <i data-direction="increase" data-resource="worship" data-action="incrementResource" class="fas fa-angle-up" data-tooltip="UESRPG.UI.Increase" aria-label="{{localize "UESRPG.UI.Increase"}}"></i>
                            <i data-direction="restore" data-resource="worship" data-action="restoreResource" class="fas fa-undo" data-tooltip="UESRPG.UI.Restore" aria-label="{{localize "UESRPG.UI.Restore"}}"></i>
                            <i data-direction="decrease" data-resource="worship" data-action="incrementResource" class="fas fa-angle-down" data-tooltip="UESRPG.UI.Decrease" aria-label="{{localize "UESRPG.UI.Decrease"}}"></i>
                            {{else}}
                            <i class="fas fa-angle-up" data-tooltip="UESRPG.Sheets.FixedHeader.SetPrimaryRitualDomainFirst" style="opacity:0.35; cursor:not-allowed;" aria-label="{{localize "UESRPG.Sheets.FixedHeader.SetPrimaryRitualDomainFirst"}}"></i>
                            <i class="fas fa-undo" data-tooltip="UESRPG.Sheets.FixedHeader.SetPrimaryRitualDomainFirst" style="opacity:0.35; cursor:not-allowed;" aria-label="{{localize "UESRPG.Sheets.FixedHeader.SetPrimaryRitualDomainFirst"}}"></i>
                            <i class="fas fa-angle-down" data-tooltip="UESRPG.Sheets.FixedHeader.SetPrimaryRitualDomainFirst" style="opacity:0.35; cursor:not-allowed;" aria-label="{{localize "UESRPG.Sheets.FixedHeader.SetPrimaryRitualDomainFirst"}}"></i>
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}
                    {{!-- Luck --}}
                    <div class="resource-row" id="luckResource">
                        <button type="button" class="resource-name resource-name--luck" data-resource="luck_points" data-tooltip="UESRPG.UI.LuckPoints" aria-label="{{localize "UESRPG.UI.LuckPoints"}}">{{localize "UESRPG.UI.LP"}}</button>
                        <div class="maxBar" data-resource="luck_points">
                            <div class="bar-values">
                                <input type="number" name="system.luck_points.value" value="{{actor.system.luck_points.value}}"> / <label>{{actor.system.luck_points.max}}</label>
                            </div>
                            <div id="luck_pointsBar" class="currentBar" data-resource="luck_points"></div>
                        </div>
                        <div class="resource-controls">
                            <i data-direction="increase" data-resource="luck_points" data-action="incrementResource" class="fas fa-angle-up" data-tooltip="UESRPG.UI.Increase" aria-label="{{localize "UESRPG.UI.Increase"}}"></i>
                            <i data-direction="restore" data-resource="luck_points" data-action="restoreResource" class="fas fa-undo" data-tooltip="UESRPG.UI.Restore" aria-label="{{localize "UESRPG.UI.Restore"}}"></i>
                            <i data-direction="decrease" data-resource="luck_points" data-action="incrementResource" class="fas fa-angle-down" data-tooltip="UESRPG.UI.Decrease" aria-label="{{localize "UESRPG.UI.Decrease"}}"></i>
                        </div>
                    </div>
                </div>

                <div class="rest-controls">
                    <button type="button" data-action="shortRest" class="short-rest rest-btn" data-tooltip="UESRPG.Sheets.FixedHeader.ShortRestTitle" aria-label="{{localize "UESRPG.Sheets.FixedHeader.ShortRestTitle"}}">
                        {{localize "UESRPG.UI.ShortRest"}}
                    </button>
                    <button type="button" data-action="longRest" class="long-rest rest-btn" data-tooltip="UESRPG.Sheets.FixedHeader.LongRestTitle" aria-label="{{localize "UESRPG.Sheets.FixedHeader.LongRestTitle"}}">
                        {{localize "UESRPG.UI.LongRest"}}
                    </button>
                </div>

                <div class="characteristics-container">
                    <div class="section-header">
                        {{#if (eq actor.type "NPC")}}
                        <span class="section-header__label" data-action="advancementMenu" role="button" tabindex="0" data-tooltip="UESRPG.Sheets.FixedHeader.CharacteristicsOptions">{{localize "UESRPG.UI.Characteristics"}}</span>
                        {{else}}
                        <span class="section-header__label" data-action="advancementMenu" role="button" tabindex="0" data-tooltip="UESRPG.Sheets.FixedHeader.AdvancementOptions">{{localize "UESRPG.UI.Advancement"}}</span>
                        {{/if}}
                    </div>
                    <div class="characteristic-entry-container">
                        <div class="characteristic">
                            <div id="str" name="Strength" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Strength"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.str.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="end" name="Endurance" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Endurance"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.end.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="agi" name="Agility" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Agility"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.agi.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="int" name="Intelligence" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Intelligence"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.int.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="wp" name="Willpower" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Willpower"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.wp.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="prc" name="Perception" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Perception"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.prc.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="prs" name="Personality" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Personality"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.prs.total}}</div>
                        </div>
                        <div class="characteristic">
                            <div id="lck" name="Luck" data-action="characteristicRoll" class="characteristic-roll rollable">{{localize "UESRPG.UI.Luck"}}</div>
                            <div class="characteristic-value">{{actor.system.characteristics.lck.total}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
