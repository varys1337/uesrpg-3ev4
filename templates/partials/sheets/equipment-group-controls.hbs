<button type="button"
        class="uesrpg-group-toggle {{#if sectionHeader}}section-header__toggle uesrpg-semantic-control uesrpg-plain-control{{else}}uesrpg-group-toggle-button uesrpg-styled-action{{/if}}"
        data-action="groupToggle"
        data-group="{{group}}"
        aria-expanded="true"
        data-tooltip="UESRPG.UI.CollapseExpand"
        aria-label="{{localize "UESRPG.UI.CollapseExpand"}}: {{label}}">
  {{#unless sectionHeader}}
  <i class="fas fa-chevron-down" aria-hidden="true"></i>
  <span class="item-group-label">{{label}}</span>
  {{/unless}}
</button>
{{#if sectionHeader}}
<span class="section-header__label item-group-label">{{label}}</span>
{{/if}}
<button type="button"
        class="item-group-add {{#if sectionHeader}}section-header__action uesrpg-semantic-control uesrpg-plain-control{{else}}uesrpg-styled-action{{/if}}"
        data-action="itemCreate"
        data-item-type="{{itemType}}"
        {{#if altType}}data-alt-type="{{altType}}"{{/if}}
        data-tooltip-text="{{localize "UESRPG.UI.Create"}}: {{label}}"
        aria-label="{{localize "UESRPG.UI.Create"}}: {{label}}">
  <span class="item-group-add__glyph" aria-hidden="true">+</span>
</button>
