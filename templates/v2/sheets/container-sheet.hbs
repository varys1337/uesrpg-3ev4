    <section class="sheet-body">
    
            {{!-- Description Tab --}}
            <!-- <div class="tab" data-group="primary" data-tab="description">
                <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
            </div> -->
    
            {{!-- Attributes Tab --}}
            <div class="tab" data-group="primary" data-tab="attributes">
                <div class="attribute-tab-container">
                    <div class="item-selection-container">
                        <h2>{{localize "UESRPG.Sheets.Container.Contents"}}</h2>
                            <table>
                            <thead>
                                <tr>
                                    <th class="item-name-cell item-create addToContainer"><button type="button" class="uesrpg-semantic-control uesrpg-plain-control" data-action="addToContainer" data-tooltip="UESRPG.Sheets.Container.AddItemTooltip" aria-label="{{localize "UESRPG.Sheets.Container.AddItemTooltip"}}">{{localize "UESRPG.Sheets.Container.AddItem"}}</button></th>
                                    <th>{{localize "UESRPG.Sheets.Equipment.Qty"}}</th>
                                    <th>{{localize "UESRPG.Sheets.Equipment.ENC"}}</th>
                                    <th class="u-ellipsis">
                                        <button type="button" class="item-control bulk-remove-all uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="bulkRemoveAll" data-tooltip="UESRPG.Sheets.Container.RemoveAllTooltip" aria-label="{{localize "UESRPG.Sheets.Container.RemoveAllTooltip"}}"><i class="fas fa-box-open" aria-hidden="true"></i></button>&nbsp;
                                        <button type="button" class="item-control bulk-delete-all uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="bulkDeleteAll" data-tooltip="UESRPG.Sheets.Container.DeleteAllTooltip" aria-label="{{localize "UESRPG.Sheets.Container.DeleteAllTooltip"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                    </th>
                                </tr>
                            </thead>
                            <tbody class="container-drop-zone container-drop-body">
                                {{#if hasContainedItems}}
                                    {{#each containedItems as |item id|}}
                                        <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{#if item.item}}{{item.item.type}}{{/if}}">
                                            <td>
                                                <div class="tableItemNameCell">
                                                    {{#if item.item}}
                                                        <img class="item-img" src="{{item.item.img}}" data-tooltip="UESRPG.Sheets.Container.SendToChat" alt="{{item.item.name}}" />
                                                        <button type="button" class="item-name uesrpg-semantic-control uesrpg-plain-control" data-action="openContainedItem">{{item.item.name}}</button>
                                                    {{/if}}
                                                </div>
                                            </td>
                                            <td>{{#if item.item.system}}{{item.item.system.quantity}}{{else}}0{{/if}}</td>
                                            <td>{{#if item.item.system}}{{item.item.system.enc}}{{else}}0{{/if}}</td>
                                            <td>
                                                <button type="button" class="item-control remove-contained-item uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="removeContainedItem" data-tooltip="UESRPG.Sheets.Container.RemoveFromContainer" aria-label="{{localize "UESRPG.Sheets.Container.RemoveFromContainer"}}"><i class="fas fa-box-open" aria-hidden="true"></i></button>
                                                <button type="button" class="item-control delete-contained-item uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="deleteContainedItem" data-tooltip="UESRPG.Sheets.Container.DeleteItem" aria-label="{{localize "UESRPG.Sheets.Container.DeleteItem"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                                            </td>
                                        </tr>
                                    {{/each}}
                                {{else}}
                                    <tr>
                                        <td colspan="4" class="u-text-center u-text-muted container-empty-hint">
                                            <i>{{localize "UESRPG.Sheets.Container.EmptyMessage"}}</i>
                                        </td>
                                    </tr>
                                {{/if}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        {{!-- Effects Tab --}}
        <div class="tab effects" data-group="primary" data-tab="effects">
            <header class="effects-header flexrow">
                <h3>{{localize "UESRPG.Sheets.Equipment.Effects"}}</h3>
                <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="create" data-tooltip="UESRPG.Sheets.Equipment.CreateEffect" aria-label="{{localize "UESRPG.Sheets.Equipment.CreateEffect"}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
            </header>
            <ol class="effects-list">
                {{#each effects as |effect|}}
                <li class="effect flexrow" data-effect-id="{{effect._id}}">
                    <img class="effect-icon" src="{{effect.img}}" alt="{{effect.name}}" />
                    <h4 class="effect-name">{{effect.name}}</h4>
                    <div class="effect-controls flexrow">
                        <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="toggle" data-effect-id="{{effect._id}}" data-tooltip="UESRPG.Sheets.Equipment.ToggleEffect" aria-label="{{localize "UESRPG.Sheets.Equipment.ToggleEffect"}}"><i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}" aria-hidden="true"></i></button>
                        <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="edit" data-effect-id="{{effect._id}}" data-tooltip="UESRPG.Sheets.Equipment.EditEffect" aria-label="{{localize "UESRPG.Sheets.Equipment.EditEffect"}}"><i class="fas fa-edit" aria-hidden="true"></i></button>
                        <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="delete" data-effect-id="{{effect._id}}" data-tooltip="UESRPG.Sheets.Equipment.DeleteEffect" aria-label="{{localize "UESRPG.Sheets.Equipment.DeleteEffect"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                    </div>
                </li>
                {{/each}}
            </ol>
        </div>
    </section>
