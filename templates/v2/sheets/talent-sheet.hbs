{{!-- Talent Sheet - Compact Layout --}}
<header class="item-compact-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
  <div class="item-header-fields">
    <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="Name"/>
    <div class="item-stats-row">
      <div class="item-stat">
        <input type="text" name="system.level" value="{{item.system.level}}"/>
        <span class="item-stat-label">Level</span>
      </div>
      <div class="item-stat">
        <input type="text" name="system.governingCharacteristics" value="{{item.system.governingCharacteristics}}"/>
        <span class="item-stat-label">Governing Chars.</span>
      </div>
      <div class="item-stat">
        <input type="number" name="system.xpCost" value="{{item.system.xpCost}}"/>
        <span class="item-stat-label">XP Cost</span>
      </div>
      <div class="item-stat">
        <input type="text" name="system.talentReq" value="{{item.system.talentReq}}"/>
        <span class="item-stat-label">Requirement(s)</span>
      </div>
    </div>
  </div>
</header>

<nav class="sheet-tabs tabs" data-group="primary">
  <a class="item" data-action="tab" data-group="primary" data-tab="description">Description</a>
  <a class="item" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
  {{#if enableRuleElements}}<a class="item" data-action="tab" data-group="primary" data-tab="automation">Automation</a>{{/if}}
  <a class="item" data-action="tab" data-group="primary" data-tab="effects">Effects</a>
</nav>

<section class="sheet-body">
  <div class="tab" data-group="primary" data-tab="description">
    <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
  </div>

  <div class="tab" data-group="primary" data-tab="attributes">
    <div class="attribute-tab-container uesrpg-feature-sheet">
      <fieldset class="attr-fieldset uesrpg-feature-section">
        <legend>Flags &amp; Overrides</legend>
        <div class="uesrpg-feature-row">
          <label title="Replace initiative with 3x characteristic">
            Replace INI
            <select name="system.replace.ini.characteristic" data-type="String">
              {{selectOptions item.system.characteristics selected=item.system.replace.ini.characteristic localize=true}}
            </select>
          </label>
          <label title="Replace Wound Threshold with 3x characteristic">
            Replace WT
            <select name="system.replace.wt.characteristic" data-type="String">
              {{selectOptions item.system.characteristics selected=item.system.replace.wt.characteristic localize=true}}
            </select>
          </label>
        </div>

        <div class="uesrpg-feature-row">
          <label><input class="checkbox" type="checkbox" name="system.halfFatiguePenalty" {{checked item.system.halfFatiguePenalty}}> &frac12; Fatigue Penalty</label>
          <label><input class="checkbox" type="checkbox" name="system.halfWoundPenalty" {{checked item.system.halfWoundPenalty}}> &frac12; Wound Penalty</label>
          <label><input class="checkbox" type="checkbox" name="system.untrainedException" {{checked item.system.untrainedException}}> No Untrained Penalty</label>
          <label><input class="checkbox" type="checkbox" name="system.addHalfSpeed" {{checked item.system.addHalfSpeed}}> Add &frac12; Speed</label>
          <label><input class="checkbox" type="checkbox" name="system.doubleSwimSpeed" {{checked item.system.doubleSwimSpeed}}> Double Swim Speed</label>
          <label class="attr-combo-field">
            <input class="checkbox" type="checkbox" name="system.addIBToMP" {{checked item.system.addIBToMP}}> Add IB &rarr; MP
            <input type="number" name="system.addIntToMPMultiplier" value="{{item.system.addIntToMPMultiplier}}" class="attr-tiny-num" title="Multiplier">
          </label>
        </div>
      </fieldset>

      {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-stat-sections.hbs" includeStats=true}}
      {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-activation.hbs"
        actionTypeOptions=talentActionTypeOptions
        includeNpcFlags=false
        includeHealthCost=false
        includeRangeAoe=false
        useButtonClass="uesrpg-talent-use"
        useAction="talentUse"
        itemKind="talent"
      }}
    </div>
  </div>

  {{#if enableRuleElements}}
  <div class="tab" data-group="primary" data-tab="automation">
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/automation-tab.hbs"}}
  </div>
  {{/if}}

  <div class="tab effects" data-group="primary" data-tab="effects">
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
  </div>
</section>
