{{!-- Talent Sheet - Compact Layout --}}
<header class="item-compact-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
  <div class="item-header-fields">
    <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
    <div class="item-stats-row">
      <div class="item-stat">
        <input type="text" name="system.level" value="{{item.system.level}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Chat.Magic.Level"}}</span>
      </div>
      <div class="item-stat">
        <input type="text" name="system.governingCharacteristics" value="{{item.system.governingCharacteristics}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.GoverningChars"}}</span>
      </div>
      <div class="item-stat">
        <input type="number" name="system.xpCost" value="{{item.system.xpCost}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.XPCost"}}</span>
      </div>
      <div class="item-stat">
        <input type="text" name="system.talentReq" value="{{item.system.talentReq}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Requirements"}}</span>
      </div>
    </div>
  </div>
</header>

<nav class="sheet-tabs tabs" data-group="primary">
  <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "UESRPG.UI.Description"}}</a>
  <a class="item" data-action="tab" data-group="primary" data-tab="attributes">{{localize "UESRPG.Sheets.Item.Attributes"}}</a>
  {{#if enableRuleElements}}<a class="item" data-action="tab" data-group="primary" data-tab="automation">{{localize "UESRPG.Sheets.Feature.Automation"}}</a>{{/if}}
  <a class="item" data-action="tab" data-group="primary" data-tab="effects">{{localize "UESRPG.Sheets.Equipment.Effects"}}</a>
</nav>

<section class="sheet-body">
  <div class="tab" data-group="primary" data-tab="description">
    <div class="item-description-container">
      <div class="basic-padding">
        <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
      </div>
    </div>
  </div>

  <div class="tab" data-group="primary" data-tab="attributes">
    <div class="attribute-tab-container uesrpg-feature-sheet">
      <fieldset class="attr-fieldset uesrpg-feature-section">
        <legend>{{localize "UESRPG.Sheets.Feature.FlagsOverrides"}}</legend>
        <div class="uesrpg-feature-row">
          <label title="{{localize "UESRPG.Sheets.Feature.ReplaceIniTitle"}}">
            {{localize "UESRPG.Sheets.Feature.ReplaceIni"}}
            <select name="system.replace.ini.characteristic" data-type="String">
              {{selectOptions characteristicOptions selected=item.system.replace.ini.characteristic}}
            </select>
          </label>
          <label title="{{localize "UESRPG.Sheets.Feature.ReplaceWtTitle"}}">
            {{localize "UESRPG.Sheets.Feature.ReplaceWt"}}
            <select name="system.replace.wt.characteristic" data-type="String">
              {{selectOptions characteristicOptions selected=item.system.replace.wt.characteristic}}
            </select>
          </label>
        </div>

        <div class="uesrpg-feature-row">
          <label><input class="checkbox" type="checkbox" name="system.halfFatiguePenalty" {{checked item.system.halfFatiguePenalty}}> {{localize "UESRPG.Sheets.Feature.HalfFatiguePenalty"}}</label>
          <label><input class="checkbox" type="checkbox" name="system.halfWoundPenalty" {{checked item.system.halfWoundPenalty}}> {{localize "UESRPG.Sheets.Feature.HalfWoundPenalty"}}</label>
          <label><input class="checkbox" type="checkbox" name="system.untrainedException" {{checked item.system.untrainedException}}> {{localize "UESRPG.Sheets.Feature.NoUntrainedPenalty"}}</label>
          <label><input class="checkbox" type="checkbox" name="system.addHalfSpeed" {{checked item.system.addHalfSpeed}}> {{localize "UESRPG.Sheets.Feature.AddHalfSpeed"}}</label>
          <label><input class="checkbox" type="checkbox" name="system.doubleSwimSpeed" {{checked item.system.doubleSwimSpeed}}> {{localize "UESRPG.Sheets.Feature.DoubleSwimSpeed"}}</label>
          <label class="attr-combo-field">
            <input class="checkbox" type="checkbox" name="system.addIBToMP" {{checked item.system.addIBToMP}}> {{localize "UESRPG.Sheets.Feature.AddIbToMp"}}
            <input type="number" name="system.addIntToMPMultiplier" value="{{item.system.addIntToMPMultiplier}}" class="attr-tiny-num" title="{{localize "UESRPG.Sheets.Feature.Multiplier"}}">
          </label>
        </div>
      </fieldset>

      {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-stat-sections.hbs" includeStats=true}}
      {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-activation.hbs"
        actionTypeOptions=talentActionTypeOptions
        includeNpcFlags=false
        includeHealthCost=false
        includeRangeAoe=false
        useButtonClass="uesrpg-talent-use"
        useAction="talentUse"
        itemKind="talent"
      }}
    </div>
  </div>

  {{#if enableRuleElements}}
  <div class="tab" data-group="primary" data-tab="automation">
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/automation-tab.hbs"}}
  </div>
  {{/if}}

  <div class="tab effects" data-group="primary" data-tab="effects">
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
  </div>
</section>
