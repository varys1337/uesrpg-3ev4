<section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
      <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
    </div>

    {{!-- Combat Style Tab --}}
    <div class="tab" data-group="primary" data-tab="combatStyle">
      <div class="uesrpg-combatstyle-panel">
        {{#if item.isOwned}}
          <div class="uesrpg-row uesrpg-row--between uesrpg-combatstyle-active">
            <div class="u-text-muted">
              <b>{{localize "UESRPG.Sheets.CombatStyle.ActiveStyle"}}</b>: {{#if isActiveCombatStyle}}{{localize "UESRPG.UI.Yes"}}{{else}}{{localize "UESRPG.UI.No"}}{{/if}}
            </div>
            {{#if isActiveCombatStyle}}
              <button type="button" class="uesrpg-deactivate-style uesrpg-styled-action" data-action="deactivateStyle">{{localize "UESRPG.Sheets.CombatStyle.Deactivate"}}</button>
            {{else}}
              <button type="button" class="uesrpg-set-active-style uesrpg-styled-action" data-action="setActiveStyle">{{localize "UESRPG.Sheets.CombatStyle.SetActive"}}</button>
            {{/if}}
          </div>
        {{/if}}

        <h3 class="uesrpg-section-title">{{localize "UESRPG.Sheets.CombatStyle.TrainedEquipment"}}</h3>
        <div class="notes uesrpg-notes">
          {{localize "UESRPG.Sheets.CombatStyle.TrainedEquipmentHint"}}
        </div>

        <div class="uesrpg-combatstyle-equipment-grid" aria-label="{{localize "UESRPG.Sheets.CombatStyle.TrainedEquipment"}}">
          {{#each item.system.trainedEquipment as |val idx|}}
            <div class="uesrpg-combatstyle-equip">
              <label>{{localize "UESRPG.ModernUI.Entry" value1=(inc idx)}}</label>
              <input type="text" name="system.trainedEquipment.{{idx}}" value="{{val}}" placeholder="{{localize "UESRPG.Placeholders.TrainedEquipmentExample"}}"/>
            </div>
          {{/each}}
        </div>

        <hr class="uesrpg-divider" />

        <h3 class="uesrpg-section-title">{{localize "UESRPG.Sheets.CombatStyle.SpecialAdvantages"}}</h3>
        <div class="notes uesrpg-notes">
          {{localize "UESRPG.Sheets.CombatStyle.SpecialAdvantagesHint"}}
        </div>

        <div class="uesrpg-combatstyle-special-grid" aria-label="{{localize "UESRPG.Sheets.CombatStyle.SpecialAdvantages"}}">
          {{#each specialActionsRegistry as |sa|}}
            <label class="uesrpg-combatstyle-special" data-tooltip-text="{{sa.name}}">
              <input type="checkbox" name="system.specialAdvantages.{{sa.id}}" {{checked (lookup ../item.system.specialAdvantages sa.id)}} />
              <span class="uesrpg-combatstyle-special__name">{{sa.name}}</span>
              <span class="uesrpg-combatstyle-special__type">{{sa.actionType}}</span>
            </label>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
      {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
    </div>

  </section>
