{{!-- Scroll Sheet --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.Sheets.Item.ScrollName"}}"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <input type="number" name="system.quantity" value="{{#if item.system.quantity}}{{item.system.quantity}}{{else}}1{{/if}}" min="0"/>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Quantity"}}</span>
            </div>
            <div class="item-stat">
                <input type="number" name="system.enc" value="{{#if item.system.enc}}{{item.system.enc}}{{else}}0{{/if}}"/>
                <span class="item-stat-label">ENC</span>
            </div>
        </div>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "UESRPG.UI.Description"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="spell">{{localize "UESRPG.Sheets.Item.SpellReference"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">{{localize "UESRPG.Sheets.Equipment.Effects"}}</a>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
        <div class="item-description-container">
            <div class="basic-padding">
                <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
            </div>
        </div>
    </div>

    {{!-- Spell Reference Tab --}}
    <div class="tab" data-group="primary" data-tab="spell">
        <div class="attribute-tab-container">
            <div class="item-selection-container">
                <h2>{{localize "UESRPG.Sheets.Item.SpellReference"}}</h2>
                <div class="form-group scroll-spell-drop-zone" data-scroll-spell-drop-zone="true">
                    <label>{{localize "UESRPG.Sheets.Item.SpellUUID"}}</label>
                    <input type="text" class="scroll-spell-uuid-input" name="system.spellUuid" value="{{item.system.spellUuid}}" placeholder="{{localize "UESRPG.Sheets.Item.SpellUUIDPlaceholder"}}"/>
                    <p class="hint">
                        {{localize "UESRPG.Sheets.Item.ScrollSpellDropHelp"}}
                    </p>
                </div>
                <div class="form-group">
                    <label style="display:flex;align-items:center;gap:8px;">
                        <input type="checkbox" name="system.requireSchoolTraining" {{checked item.system.requireSchoolTraining}}>
                        <span>{{localize "UESRPG.Sheets.Item.RequireSchoolTrainingPerScroll"}}</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:8px;">
                        <input type="checkbox" name="system.consumeMagicka" {{checked item.system.consumeMagicka}}>
                        <span>{{localize "UESRPG.Sheets.Item.ConsumeMagickaPerScroll"}}</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:8px;">
                        <input type="checkbox" name="system.consumeOnCast" {{checked item.system.consumeOnCast}}>
                        <span>{{localize "UESRPG.Sheets.Item.ExpireScrollOnCast"}}</span>
                    </label>
                    <p class="hint">
                        {{localize "UESRPG.Sheets.Item.ScrollConsumeHelp"}}
                    </p>
                </div>

                {{#if hasLinkedSpell}}
                <div class="form-group">
                    <h3>{{localize "UESRPG.Sheets.Item.LinkedSpell"}}</h3>
                    <p><strong>{{scrollLinkedSpell.name}}</strong> ({{scrollLinkedSpell.school}} L{{scrollLinkedSpell.level}})</p>
                    <p>{{localize "UESRPG.Sheets.Item.Cost"}}: {{scrollLinkedSpell.cost}} MP | {{localize "UESRPG.Sheets.Item.Form"}}: {{scrollLinkedSpell.form}} | {{localize "UESRPG.Sheets.Equipment.Range"}}: {{scrollLinkedSpell.range}}</p>
                    <p>{{localize "UESRPG.UI.Duration"}}: {{scrollLinkedSpell.duration.value}} {{scrollLinkedSpell.duration.unit}}</p>
                    {{#if scrollLinkedSpell.damageInstances.length}}
                    <div>
                        <strong>{{localize "UESRPG.Sheets.Item.DamageInstances"}}:</strong>
                        <ul>
                            {{#each scrollLinkedSpell.damageInstances as |di|}}
                            <li>{{di.formula}} {{#if di.type}}({{di.type}}){{/if}} {{#if di.label}}- {{di.label}}{{/if}}</li>
                            {{/each}}
                        </ul>
                    </div>
                    {{/if}}
                    <p>
                        <strong>{{localize "UESRPG.Sheets.Item.Features"}}:</strong>
                        {{#if scrollLinkedSpell.isInstant}} Instant {{/if}}
                        {{#if scrollLinkedSpell.isDirect}} Direct {{/if}}
                        {{#if scrollLinkedSpell.isZonePersistent}} Zone {{/if}}
                        {{#if scrollLinkedSpell.isRuneSpell}} Rune {{/if}}
                        {{#if scrollLinkedSpell.hasOverTime}} Over Time {{/if}}
                        {{#if scrollLinkedSpell.hasOverload}} Overload {{/if}}
                        {{#if scrollLinkedSpell.isSummonSpell}} Summon {{/if}}
                        {{#if scrollLinkedSpell.hasBuffer}} Buffer {{/if}}
                    </p>
                </div>
                {{/if}}

                {{#if linkedSpellUnresolved}}
                <p class="hint" style="color:#a33;">{{localize "UESRPG.Sheets.Item.LinkedSpellUnresolved"}}</p>
                {{/if}}
            </div>

            {{!-- Cast Button (owned items only) --}}
            {{#if actor}}
            <div class="item-selection-container">
                <h2>{{localize "UESRPG.Sheets.Item.Cast"}}</h2>
                <div class="activation-use-btn-wrap">
                    <button type="button" class="uesrpg-scroll-cast" data-action="castScroll"
                            {{#unless hasLinkedSpell}}disabled title="{{localize "UESRPG.Sheets.Item.NoValidSpellAssigned"}}"{{/unless}}>
                        <i class="fas fa-scroll"></i> {{localize "UESRPG.Sheets.Item.CastScroll"}}
                    </button>
                </div>
                <p class="hint">{{localize "UESRPG.Sheets.Item.ScrollCastHelp"}}</p>
            </div>
            {{/if}}

            {{#if uiSpellcastingConfig}}
            <div class="item-selection-container">
                <h2>{{localize "UESRPG.Sheets.Item.SpellcastingConfiguration"}}</h2>
                <div class="selection-container">
                    <p class="u-text-muted u-text-sm">
                        {{localize "UESRPG.Sheets.Item.SpellcastingConfigurationScrollHelp"}}
                    </p>
                    <div class="grid-container">
                        <div>{{localize "UESRPG.Sheets.Item.EnableSpellcasting"}}</div>
                        <div class="right-align-content">
                            <button type="button" data-action="toggleSpellcastingEnable">
                                {{#if uiSpellcastingConfig.enabled}}{{localize "UESRPG.Sheets.Item.Disable"}}{{else}}{{localize "UESRPG.Sheets.Item.Enable"}}{{/if}}
                            </button>
                        </div>
                    </div>
                    {{#if uiSpellcastingConfig.enabled}}
                    <div class="grid-container">
                        <div>{{localize "UESRPG.Sheets.Item.ChargePoolSoul"}}</div>
                        <div class="right-align-content u-text-muted">{{localize "UESRPG.Sheets.Item.ChargePoolSoulHelp"}}</div>
                    </div>
                    <div class="grid-container">
                        <div>{{localize "UESRPG.Sheets.Item.ChargeCurrentMax"}}</div>
                        <div class="right-align-content">
                            <input type="number" data-spellcasting-charge="value" value="{{uiSpellcastingConfig.poolValue}}" min="0" step="1" class="u-w-50" />
                            <span>/</span>
                            <input type="number" data-spellcasting-charge="max" value="{{uiSpellcastingConfig.poolMax}}" min="0" step="1" class="u-w-50" />
                        </div>
                    </div>
                    <div class="grid-container">
                        <div>{{localize "UESRPG.Sheets.Item.SpellSlots"}}</div>
                        <div class="right-align-content">
                            <button type="button" data-action="addSpellcastingSlot">{{localize "UESRPG.Sheets.Item.AddSlot"}}</button>
                            <button type="button" data-action="editSpellcastingSlot">{{localize "UESRPG.UI.Save"}}</button>
                        </div>
                    </div>
                    {{#each uiSpellcastingConfig.slots as |slot|}}
                    <div class="grid-container" data-spellcasting-slot-id="{{slot.id}}">
                        <div>
                            <input type="text" data-spellcasting-field="label" value="{{slot.label}}" placeholder="{{localize "UESRPG.Sheets.Item.Label"}}" />
                            <div class="u-text-muted u-text-xs">{{slot.spellUuid}}</div>
                        </div>
                        <div class="right-align-content">
                            <input type="number" data-spellcasting-field="cost" value="{{slot.cost}}" min="0" step="1" class="u-w-50" />
                            <input type="number" data-spellcasting-field="bindingStrength" value="{{slot.bindingStrength}}" min="0" max="10" step="1" class="u-w-50" />
                            <select data-spellcasting-field="costMode" class="u-w-50">
                                <option value="soul" {{#if (eq slot.costMode "soul")}}selected{{/if}}>{{localize "UESRPG.Sheets.Item.Soul"}}</option>
                                <option value="magicka" {{#if (eq slot.costMode "magicka")}}selected{{/if}}>{{localize "UESRPG.Sheets.Item.Magicka"}}</option>
                                <option value="none" {{#if (eq slot.costMode "none")}}selected{{/if}}>{{localize "UESRPG.Sheets.Item.NoCost"}}</option>
                            </select>
                            <label><input type="checkbox" data-spellcasting-field="enabled" {{checked slot.enabled}} /> {{localize "UESRPG.Sheets.Item.On"}}</label>
                            <button type="button" data-action="pickSpellcastingSlotSpell" data-slot-id="{{slot.id}}">{{localize "UESRPG.Sheets.Item.Pick"}}</button>
                            <button type="button" data-action="removeSpellcastingSlot" data-slot-id="{{slot.id}}">{{localize "UESRPG.UI.Remove"}}</button>
                        </div>
                    </div>
                    {{/each}}
                    {{#if uiSpellcastingConfig.canCast}}
                    <div class="grid-container">
                        <div>{{localize "UESRPG.Sheets.Equipment.CastEnchantment"}}</div>
                        <div class="right-align-content">
                            <button type="button" data-action="castEnchantment">{{localize "UESRPG.Sheets.Equipment.CastEnchantment"}}</button>
                        </div>
                    </div>
                    {{/if}}
                    {{/if}}
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
        {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
    </div>

</section>
