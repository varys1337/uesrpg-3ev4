{{!-- Weapon Sheet вЂ” Compact Layout --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="Name"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <input type="number" name="system.quantity" value="{{item.system.quantity}}"/>
                <span class="item-stat-label">Quantity</span>
            </div>
            <div class="item-stat">
                {{#if item.system.encEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.encEffective}}" readonly/>
                        <input type="number" name="system.enc" value="{{item.system.enc}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.enc" value="{{item.system.enc}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.enc" value="{{item.system.enc}}"/>
                {{/if}}
                <span class="item-stat-label">ENC</span>
            </div>
            <div class="item-stat">
                {{#if item.system.priceEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.priceEffective}}" readonly/>
                        <input type="number" name="system.price" value="{{item.system.price}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.price" value="{{item.system.price}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.price" value="{{item.system.price}}"/>
                {{/if}}
                <span class="item-stat-label">Price</span>
            </div>
            {{#if (eq item.system.attackMode "ranged")}}
            <div class="item-stat">
                <input type="text" name="system.range" value="{{item.system.range}}" placeholder="X/Y/Z"/>
                {{#if item.system.rangeBandsDerivedEffective.display}}
                    <div class="effective-hint"><span class="label">Eff</span>{{item.system.rangeBandsDerivedEffective.display}}</div>
                {{/if}}
                <span class="item-stat-label">Range</span>
            </div>
            {{/if}}
            <div class="item-stat">
                <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                <span class="item-stat-label">Equipped</span>
            </div>
            <div class="item-stat">
                {{#if item.system.damageEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.damageEffective}}" readonly/>
                        <input type="text" name="system.damage" value="{{item.system.damage}}" class="u-hidden"/>
                    {{else}}
                        <input type="text" name="system.damage" value="{{item.system.damage}}"/>
                    {{/unless}}
                {{else}}
                    <input type="text" name="system.damage" value="{{item.system.damage}}"/>
                {{/if}}
                <span class="item-stat-label">Damage</span>
            </div>
            <div class="item-stat">
                {{#if item.system.damage2Effective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.damage2Effective}}" readonly/>
                        <input type="text" name="system.damage2" value="{{item.system.damage2}}" class="u-hidden"/>
                    {{else}}
                        <input type="text" name="system.damage2" value="{{item.system.damage2}}"/>
                    {{/unless}}
                {{else}}
                    <input type="text" name="system.damage2" value="{{item.system.damage2}}"/>
                {{/if}}
                <span class="item-stat-label">2H Damage</span>
            </div>
        </div>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">Description</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">Effects</a>
</nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        <div class="tab" data-group="primary" data-tab="description">
            <div class="item-description-container">
                <div class="basic-padding">
                    {{editor item.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>

        {{!-- Attributes Tab --}}
        <div class="tab" data-group="primary" data-tab="attributes">
            <div class="attribute-tab-container">
                <div class="item-selection-container">
                    <h2>Attributes</h2>
                    <div class="selection-container">
                        <div class="weapon-attributes-container">
                            <div class="weapon-attributes-section">
                                <h3>Quality &amp; Material</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Quality</label>
                                    <select name="system.qualityLevel">
                                        {{selectOptions weaponQualityOptions selected=item.system.qualityLevel}}
                                    </select>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Material</label>
                                    <select name="system.material">
                                        {{selectOptions weaponMaterialOptions selected=item.system.material}}
                                    </select>
                                </div>
                                <div class="weapon-field-row">
                                    <label>Manual Base Stats</label>
                                    <input class="checkbox" type="checkbox" name="system.gmOverride.useBaseStats" {{checked item.system.gmOverride.useBaseStats}}>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Ignore ENC</label>
                                    <input class="checkbox" type="checkbox" name="system.excludeENC" {{checked item.system.excludeENC}}>
                                </div>
                            </div>

                            <div class="weapon-attributes-section">
                                <h3>Basic Properties</h3>

                                <div class="weapon-field-row">
                                    <label>Handedness</label>
                                    <select name="system.hands">
                                        {{selectOptions weaponHandednessOptions selected=item.system.hands}}
                                    </select>
                                </div>
                                
                                {{#unless (eq item.system.attackMode "ranged")}}
                                <div class="weapon-field-row weapon-field-row--reach">
                                    <label>Reach</label>
                                    <div class="weapon-reach-inline">
                                        <span class="weapon-reach-label">Min Reach</span>
                                        <input class="weapon-reach-input" type="number" name="system.reachMin" value="{{item.system.reachMin}}" min="0" step="1"/>
                                        <span class="weapon-reach-label">Max Reach</span>
                                        <input class="weapon-reach-input" type="number" name="system.reach" value="{{item.system.reach}}" min="0" step="1"/>
                                    </div>
                                </div>
                                {{/unless}}

                                <div class="weapon-field-row">
                                    <label>Roll 2H Damage</label>
                                    <input class="checkbox" type="checkbox" name="system.weapon2H" {{checked item.system.weapon2H}}>
                                </div>
                            </div>
                            
                            <div class="weapon-attributes-section">
                                <h3>Equipment Type</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Equipment Tag</label>
                                    <input type="text" name="system.equipmentType" value="{{item.system.equipmentType}}" placeholder="e.g., Long Blade"/>
                                </div>
                                
                                <div class="weapon-field-row">
                                    <label>Attack Mode</label>
                                    <select name="system.attackMode">
                                        {{selectOptions attackModeOptions selected=item.system.attackMode}}
                                    </select>
                                </div>
                            </div>

                            {{#if (eq item.system.attackMode "ranged")}}
                            <div class="weapon-attributes-section">
                                <h3>Ranged Properties</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Ammunition</label>
                                    <select name="system.ammoId">
                                        <option value="">вЂ”</option>
                                        {{#each ammoOptions}}
                                            <option value="{{this.value}}" {{#if (eq ../item.system.ammoId this.value)}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Consume Ammo</label>
                                    <input type="checkbox" name="system.consumeAmmo" {{checked item.system.consumeAmmo}}>
                                </div>

                                 <div class="weapon-field-row">
                                     <label>Reload Cost (AP)</label>
                                     {{#if canEditReloadAPCost}}
                                     <input type="number" name="system.reloadState.reloadAPCost" value="{{item.system.reloadState.reloadAPCost}}" min="0" step="1"/>
                                     {{else}}
                                     <input type="number" value="{{item.system.reloadState.reloadAPCost}}" min="0" step="1" disabled class="u-input-disabled"/>
                                     {{/if}}
                                 </div>
                                
                                <div class="weapon-field-row">
                                    <label>Loaded</label>
                                    <input type="checkbox" name="system.reloadState.isLoaded" {{checked item.system.reloadState.isLoaded}}/>
                                </div>
                            </div>
                            {{/if}}

                            <div class="weapon-attributes-section">
                                <h3>Enchanting</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Enchant Level</label>
                                    <div class="weapon-enchant-wrap">
                                        <input type="number" name="system.enchant_level" value="{{item.system.enchant_level}}" class="u-w-full"/>
                                        {{#if item.system.enchant_levelEffective}}
                                            <div class="effective-hint"><span class="label">Eff</span>{{item.system.enchant_levelEffective}}</div>
                                        {{/if}}
                                    </div>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Charge</label>
                                    <div class="flex-container weapon-charge-row">
                                        <i class="fas fa-angle-down fa-xs chargeMinus" data-action="chargeMinus"></i>
                                        <input type="number" name="system.charge.value" value="{{item.system.charge.value}}" class="u-w-45"/>
                                        <span>/</span>
                                        <input type="number" name="system.charge.max" value="{{item.system.charge.max}}" class="u-w-45"/>
                                        <i class="fas fa-angle-up fa-xs chargePlus" data-action="chargePlus"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="weapon-attributes-section">
                                <h3>Damage Instances</h3>
                                <p class="u-text-muted u-text-xs">Additional damage types (e.g. elemental enchantments)</p>
                                {{#each item.system.damageInstances as |inst idx|}}
                                <div class="weapon-field-row weapon-damage-instance-grid" data-instance-index="{{idx}}">
                                    <input type="text" name="system.damageInstances.{{idx}}.label" value="{{inst.label}}" placeholder="Label" />
                                    <input type="text" name="system.damageInstances.{{idx}}.formula" value="{{inst.formula}}" placeholder="e.g. 1d4" />
                                    <select name="system.damageInstances.{{idx}}.type">
                                        {{selectOptions @root.damageTypeOptions selected=inst.type}}
                                    </select>
                                    <button type="button" data-action="removeDamageInstance" data-index="{{idx}}" title="Remove" class="weapon-damage-remove-btn" {{#unless @root.editable}}disabled{{/unless}}>
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                {{/each}}
                                {{#if @root.editable}}
                                <button type="button" data-action="addDamageInstance" class="weapon-damage-add-btn">
                                    <i class="fas fa-plus"></i> Add Instance
                                </button>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="quality-container">
                    <div class="flex-container">
                        <h2>Qualities</h2>
                    </div>

                    <!-- Core qualities (kept as a compact grid for automation-critical toggles/values) -->
                    <div class="structured-qualities-grid">
                        {{#each coreQualitiesCatalog}}
                            <div class="structured-qualities-cell">
                                <div>{{this.label}}</div>
                                <div class="right-align-content">
                                    {{#if this.optionalValue}}
                                        <div class="structured-optional-value">
                                            <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                            <input class="structured-value structured-value--opt" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="0" step="1" placeholder="X" />
                                        </div>
                                    {{else}}
                                        {{#if this.hasValue}}
                                            <input class="structured-value" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="0" step="1" />
                                        {{else}}
                                            <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                        {{/if}}
                                    {{/if}}
                                </div>
                            </div>
                        {{/each}}
                    </div>

                    <!-- Other traits (reference / future automation) -->
                    <div class="structured-traits-block">
                        <div class="structured-traits-label">Other Traits</div>
                        <div class="structured-traits-pills">
                            {{#each traitsCatalog}}
                                <label class="uesrpg-pill {{#if this.selected}}is-selected{{/if}}">
                                    <input type="checkbox" name="qualitiesTraits.toggle.{{this.key}}" {{checked this.selected}} />
                                    <span>{{this.label}}</span>
                                </label>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>

    </section>

