    <section class="sheet-body">

        {{!-- Description Tab --}}
        <div class="tab" data-group="primary" data-tab="description">
            <div class="item-description-container">
                <div class="basic-padding">
                    <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
                </div>
            </div>
        </div>

        {{!-- Attributes Tab --}}
        <div class="tab" data-group="primary" data-tab="attributes">
            <div class="attribute-tab-container">
                <div class="item-selection-container">
                    <h2>{{localize "UESRPG.Sheets.Item.Attributes"}}</h2>
                    <div class="selection-container">
                        <div class="weapon-attributes-container">
                            <div class="weapon-attributes-section">
                                <h3>{{localize "UESRPG.Sheets.Item.QualityMaterial"}}</h3>
                                
                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.Quality"}}</label>
                                    <select name="system.qualityLevel">
                                        {{selectOptions weaponQualityOptions selected=item.system.qualityLevel localize=true}}
                                    </select>
                                </div>

                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.Material"}}</label>
                                    <select name="system.material">
                                        {{selectOptions weaponMaterialOptions selected=item.system.material localize=true}}
                                    </select>
                                </div>
                            </div>

                            <div class="weapon-attributes-section">
                                <h3>{{localize "UESRPG.Sheets.Item.BasicProperties"}}</h3>

                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.Handedness"}}</label>
                                    <select name="system.hands">
                                        {{selectOptions weaponHandednessOptions selected=item.system.hands localize=true}}
                                    </select>
                                </div>

                                {{#unless (eq item.system.attackMode "ranged")}}
                                <div class="weapon-field-row weapon-field-row--reach">
                                    <label>{{localize "UESRPG.Sheets.Item.BaseReach"}}</label>
                                    <div class="weapon-reach-inline">
                                        <span class="weapon-reach-label">{{localize "UESRPG.Sheets.Item.Min"}}</span>
                                        <input class="weapon-reach-input" type="number" name="system.reachMin" value="{{weaponSheetPersistedReachMinValue}}" min="0" step="1"/>
                                        <span class="weapon-reach-label">{{localize "UESRPG.Sheets.Item.MaxReach"}}</span>
                                        <input class="weapon-reach-input" type="number" name="system.reach" value="{{weaponSheetPersistedReachValue}}" min="0" step="1"/>
                                    </div>
                                </div>

                                {{#if homebrewReachLengthEnabled}}
                                <div class="weapon-field-row weapon-field-row--length">
                                    <label>{{localize "UESRPG.Sheets.Item.LengthLng"}}</label>
                                    <input type="number" name="flags.uesrpg-3ev4.homebrew.reachLength.length"
                                           value="{{lookup (lookup (lookup (lookup item.flags 'uesrpg-3ev4') 'homebrew') 'reachLength') 'length'}}"
                                           min="0" step="1" placeholder="0"/>
                                </div>
                                <div class="weapon-field-row weapon-field-row--reach">
                                    <label>{{localize "UESRPG.Sheets.Item.ReachOverride"}}</label>
                                    <div class="weapon-reach-inline">
                                        <span class="weapon-reach-label">{{localize "UESRPG.Sheets.Item.Min"}}</span>
                                        <input class="weapon-reach-input" type="number"
                                               name="flags.uesrpg-3ev4.homebrew.reachLength.{{homebrewReachModel}}.min"
                                               value="{{lookup (lookup (lookup (lookup (lookup item.flags 'uesrpg-3ev4') 'homebrew') 'reachLength') homebrewReachModel) 'min'}}"
                                               min="0" step="1" placeholder="0"/>
                                        <span class="weapon-reach-label">{{localize "UESRPG.Sheets.Item.Max"}}</span>
                                        <input class="weapon-reach-input" type="number"
                                               name="flags.uesrpg-3ev4.homebrew.reachLength.{{homebrewReachModel}}.max"
                                               value="{{lookup (lookup (lookup (lookup (lookup item.flags 'uesrpg-3ev4') 'homebrew') 'reachLength') homebrewReachModel) 'max'}}"
                                               min="0" step="1" placeholder="0"/>
                                    </div>
                                </div>
                                {{/if}}
                                {{/unless}}

                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.Roll2HDamage"}}</label>
                                    <input class="checkbox" type="checkbox" name="system.weapon2H" {{checked item.system.weapon2H}}>
                                </div>
                            </div>
                            
                            <div class="weapon-attributes-section">
                                <h3>{{localize "UESRPG.Sheets.Item.EquipmentType"}}</h3>
                                
                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.EquipmentTag"}}</label>
                                    <input type="text" name="system.equipmentType" value="{{item.system.equipmentType}}" placeholder="{{localize "UESRPG.Sheets.Item.EquipmentTagPlaceholder"}}"/>
                                </div>
                                
                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.AttackMode"}}</label>
                                    <select name="system.attackMode">
                                        {{selectOptions attackModeOptions selected=item.system.attackMode localize=true}}
                                    </select>
                                </div>
                            </div>

                            {{#if (eq item.system.attackMode "ranged")}}
                            <div class="weapon-attributes-section">
                                <h3>{{localize "UESRPG.Sheets.Item.RangedProperties"}}</h3>
                                
                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Equipment.Ammunition"}}</label>
                                    <select name="system.ammoId">
                                        <option value="">-</option>
                                        {{#each ammoOptions}}
                                            <option value="{{this.value}}" {{#if (eq ../item.system.ammoId this.value)}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>

                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.ConsumeAmmo"}}</label>
                                    <input type="checkbox" name="system.consumeAmmo" {{checked item.system.consumeAmmo}}>
                                </div>

                                 <div class="weapon-field-row">
                                     <label>{{localize "UESRPG.Sheets.Item.ReloadCostAP"}}</label>
                                     {{#if canEditReloadAPCost}}
                                     <input type="number" name="system.reloadState.reloadAPCost" value="{{item.system.reloadState.reloadAPCost}}" min="0" step="1"/>
                                     {{else}}
                                     <input type="number" value="{{item.system.reloadState.reloadAPCost}}" min="0" step="1" disabled class="u-input-disabled"/>
                                     {{/if}}
                                 </div>
                                
                                <div class="weapon-field-row">
                                    <label>{{localize "UESRPG.Sheets.Item.Loaded"}}</label>
                                    <input type="checkbox" name="system.reloadState.isLoaded" {{checked item.system.reloadState.isLoaded}}/>
                                </div>
                            </div>
                            {{/if}}

                            {{#if showEnchantingInterface}}
                            {{> "systems/uesrpg-3ev4/templates/partials/sheets/item-enchanting-interface.hbs"}}
                            {{/if}}

                        </div>
                    </div>
                </div>

                <div class="quality-container">
                    <div class="flex-container">
                        <h2>{{localize "UESRPG.Sheets.Item.Qualities"}}</h2>
                    </div>

                    <!-- Core qualities (kept as a compact grid for automation-critical toggles/values) -->
                    <div class="structured-qualities-grid">
                        {{#each coreQualitiesCatalog}}
                            <div class="structured-qualities-cell">
                                <div>{{localize this.label}}</div>
                                <div class="right-align-content">
                                    {{#if this.optionalValue}}
                                        <div class="structured-optional-value">
                                            <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                            <input class="structured-value structured-value--opt" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="0" step="1" placeholder="{{localize "UESRPG.Placeholders.NumericValue"}}" />
                                        </div>
                                    {{else}}
                                        {{#if this.hasValue}}
                                            <input class="structured-value" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="0" step="1" />
                                        {{else}}
                                            <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                        {{/if}}
                                    {{/if}}
                                </div>
                            </div>
                        {{/each}}
                    </div>

                    <!-- Other traits (reference / future automation) -->
                    <div class="structured-traits-block">
                        <div class="structured-traits-label">{{localize "UESRPG.Sheets.Item.OtherTraits"}}</div>
                        <div class="structured-traits-pills">
                            {{#each traitsCatalog}}
                                <label class="uesrpg-pill {{#if this.selected}}is-selected{{/if}}">
                                    <input type="checkbox" name="qualitiesTraits.toggle.{{this.key}}" {{checked this.selected}} />
                                    <span>{{localize this.label}}</span>
                                </label>
                            {{/each}}
                        </div>
                    </div>
                </div>

                {{#if uiSpellcastingConfig}}
                {{> "systems/uesrpg-3ev4/templates/partials/sheets/item-spellcasting-config.hbs" helpKey="UESRPG.Sheets.Item.SpellcastingConfigurationWeaponHelp" uiSpellcastingConfig=uiSpellcastingConfig}}
                {{/if}}
            </div>
        </div>

        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>

    </section>
