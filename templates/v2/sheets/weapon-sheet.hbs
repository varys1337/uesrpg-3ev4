{{!-- Weapon Sheet - Compact Layout --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="Name"/>
        <div class="item-stats-row item-stats-row--weapon-armor">
            <div class="item-stats-grid item-stats-grid--two-rows">
                <div class="item-stat">
                    <input type="number" name="system.quantity" value="{{item.system.quantity}}"/>
                    <span class="item-stat-label">Quantity</span>
                </div>
                <div class="item-stat">
                    <input type="number" name="system.enc" value="{{item.system.enc}}"/>
                    <span class="item-stat-label">ENC</span>
                </div>
                <div class="item-stat">
                    <input type="number" name="system.price" value="{{item.system.price}}"/>
                    <span class="item-stat-label">Price</span>
                </div>
                <div class="item-stat">
                    <input type="text" name="system.damage" value="{{item.system.damage}}"/>
                    <span class="item-stat-label">Damage</span>
                </div>
                <div class="item-stat">
                    <input type="text" name="system.damage2" value="{{item.system.damage2}}"/>
                    <span class="item-stat-label">2H Damage</span>
                </div>
                <div class="item-stat">
                    {{#if (eq item.system.attackMode "ranged")}}
                    <input type="text" name="system.range" value="{{item.system.range}}" placeholder="X/Y/Z"/>
                    <span class="item-stat-label">Range</span>
                    {{else}}
                    <input type="number" name="system.reach" value="{{item.system.reach}}" min="0" step="1"/>
                    <span class="item-stat-label">Reach</span>
                    {{/if}}
                </div>
            </div>
            <div class="item-stat item-stat--equipped-side">
                <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                <span class="item-stat-label">Equipped</span>
            </div>
        </div>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">Description</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">Effects</a>
</nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        <div class="tab" data-group="primary" data-tab="description">
            <div class="item-description-container">
                <div class="basic-padding">
                    <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
                </div>
            </div>
        </div>

        {{!-- Attributes Tab --}}
        <div class="tab" data-group="primary" data-tab="attributes">
            <div class="attribute-tab-container">
                <div class="item-selection-container">
                    <h2>Attributes</h2>
                    <div class="selection-container">
                        <div class="weapon-attributes-container">
                            <div class="weapon-attributes-section">
                                <h3>Quality &amp; Material</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Quality</label>
                                    <select name="system.qualityLevel">
                                        {{selectOptions weaponQualityOptions selected=item.system.qualityLevel}}
                                    </select>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Material</label>
                                    <select name="system.material">
                                        {{selectOptions weaponMaterialOptions selected=item.system.material}}
                                    </select>
                                </div>
                            </div>

                            <div class="weapon-attributes-section">
                                <h3>Basic Properties</h3>

                                <div class="weapon-field-row">
                                    <label>Handedness</label>
                                    <select name="system.hands">
                                        {{selectOptions weaponHandednessOptions selected=item.system.hands}}
                                    </select>
                                </div>
                                
                                {{#unless (eq item.system.attackMode "ranged")}}
                                {{#if homebrewReachLengthEnabled}}
                                <div class="weapon-field-row weapon-field-row--length">
                                    <label>Length (LNG)</label>
                                    <input type="number" name="flags.uesrpg-3ev4.homebrew.reachLength.length"
                                           value="{{lookup (lookup (lookup (lookup item.flags 'uesrpg-3ev4') 'homebrew') 'reachLength') 'length'}}"
                                           min="0" step="1" placeholder="0"/>
                                </div>
                                <div class="weapon-field-row weapon-field-row--reach">
                                    <label>Reach</label>
                                    <div class="weapon-reach-inline">
                                        <span class="weapon-reach-label">Min</span>
                                        <input class="weapon-reach-input" type="number"
                                               name="flags.uesrpg-3ev4.homebrew.reachLength.{{homebrewReachModel}}.min"
                                               value="{{lookup (lookup (lookup (lookup (lookup item.flags 'uesrpg-3ev4') 'homebrew') 'reachLength') homebrewReachModel) 'min'}}"
                                               min="0" step="1" placeholder="0"/>
                                        <span class="weapon-reach-label">Max</span>
                                        <input class="weapon-reach-input" type="number"
                                               name="flags.uesrpg-3ev4.homebrew.reachLength.{{homebrewReachModel}}.max"
                                               value="{{lookup (lookup (lookup (lookup (lookup item.flags 'uesrpg-3ev4') 'homebrew') 'reachLength') homebrewReachModel) 'max'}}"
                                               min="0" step="1" placeholder="0"/>
                                    </div>
                                </div>
                                {{else}}
                                <div class="weapon-field-row weapon-field-row--reach">
                                    <label>Reach</label>
                                    <div class="weapon-reach-inline">
                                        <span class="weapon-reach-label">Min Reach</span>
                                        <input class="weapon-reach-input" type="number" name="system.reachMin" value="{{item.system.reachMin}}" min="0" step="1"/>
                                        <span class="weapon-reach-label">Max Reach</span>
                                        <input class="weapon-reach-input" type="number" name="system.reach" value="{{item.system.reach}}" min="0" step="1"/>
                                    </div>
                                </div>
                                {{/if}}
                                {{/unless}}

                                <div class="weapon-field-row">
                                    <label>Roll 2H Damage</label>
                                    <input class="checkbox" type="checkbox" name="system.weapon2H" {{checked item.system.weapon2H}}>
                                </div>
                            </div>
                            
                            <div class="weapon-attributes-section">
                                <h3>Equipment Type</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Equipment Tag</label>
                                    <input type="text" name="system.equipmentType" value="{{item.system.equipmentType}}" placeholder="e.g., Long Blade"/>
                                </div>
                                
                                <div class="weapon-field-row">
                                    <label>Attack Mode</label>
                                    <select name="system.attackMode">
                                        {{selectOptions attackModeOptions selected=item.system.attackMode}}
                                    </select>
                                </div>
                            </div>

                            {{#if (eq item.system.attackMode "ranged")}}
                            <div class="weapon-attributes-section">
                                <h3>Ranged Properties</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Ammunition</label>
                                    <select name="system.ammoId">
                                        <option value="">-</option>
                                        {{#each ammoOptions}}
                                            <option value="{{this.value}}" {{#if (eq ../item.system.ammoId this.value)}}selected{{/if}}>{{this.label}}</option>
                                        {{/each}}
                                    </select>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Consume Ammo</label>
                                    <input type="checkbox" name="system.consumeAmmo" {{checked item.system.consumeAmmo}}>
                                </div>

                                 <div class="weapon-field-row">
                                     <label>Reload Cost (AP)</label>
                                     {{#if canEditReloadAPCost}}
                                     <input type="number" name="system.reloadState.reloadAPCost" value="{{item.system.reloadState.reloadAPCost}}" min="0" step="1"/>
                                     {{else}}
                                     <input type="number" value="{{item.system.reloadState.reloadAPCost}}" min="0" step="1" disabled class="u-input-disabled"/>
                                     {{/if}}
                                 </div>
                                
                                <div class="weapon-field-row">
                                    <label>Loaded</label>
                                    <input type="checkbox" name="system.reloadState.isLoaded" {{checked item.system.reloadState.isLoaded}}/>
                                </div>
                            </div>
                            {{/if}}

                            <div class="weapon-attributes-section enchanting-compact-grid">
                                <h3>Enchanting</h3>
                                
                                <div class="weapon-field-row">
                                    <label>Enchant Level</label>
                                    <div class="weapon-enchant-wrap enchant-inline">
                                        <input type="number" name="system.enchant_level" value="{{item.system.enchant_level}}" class="u-w-full"/>
                                        {{#if item.system.enchant_levelEffective}}
                                            <div class="effective-hint"><span class="label">Eff</span>{{item.system.enchant_levelEffective}}</div>
                                        {{/if}}
                                    </div>
                                </div>

                                <div class="weapon-field-row">
                                    <label>Charge</label>
                                    <div class="flex-container weapon-charge-row enchant-inline enchant-charge-inline">
                                        <button type="button" class="uesrpg-charge-btn" data-action="chargeMinus" title="Decrease current charge">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input type="number" name="system.charge.value" value="{{item.system.charge.value}}" class="enchant-charge-input"/>
                                        <span class="enchant-charge-sep">/</span>
                                        <input type="number" name="system.charge.max" value="{{item.system.charge.max}}" class="enchant-charge-input"/>
                                        <button type="button" class="uesrpg-charge-btn" data-action="chargePlus" title="Increase current charge">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            {{!-- Active Enchantment display (read-only; written by Enchanting Workshop) --}}
                            {{#if enchantmentDisplay}}
                            <div class="weapon-attributes-section weapon-enchantment-display">
                                <h3>Active Enchantment</h3>
                                <div class="weapon-field-row">
                                    <label>Type</label>
                                    <span class="styled-font-gold">{{enchantmentDisplay.typeLabel}}</span>
                                </div>
                                {{#if enchantmentDisplay.useCharges}}
                                <div class="weapon-field-row">
                                    <label>Charge Pool</label>
                                    <span>{{enchantmentDisplay.chargeValue}} / {{enchantmentDisplay.chargeMax}}</span>
                                </div>
                                {{/if}}
                                {{#each enchantmentDisplay.effects as |fx|}}
                                <div class="weapon-enchant-effect-row">
                                    <span class="enchant-effect-label">{{fx.label}}</span>
                                    <span class="enchant-effect-params u-text-muted">{{fx.paramSummary}}</span>
                                </div>
                                {{/each}}
                                {{#if (eq enchantmentDisplay.typeLabel "Cast")}}
                                <div class="weapon-field-row">
                                    <button type="button" data-action="castEnchantment">Cast Enchantment</button>
                                </div>
                                {{/if}}
                            </div>
                            {{/if}}

                        </div>
                    </div>
                </div>

                <div class="quality-container">
                    <div class="flex-container">
                        <h2>Qualities</h2>
                    </div>

                    <!-- Core qualities (kept as a compact grid for automation-critical toggles/values) -->
                    <div class="structured-qualities-grid">
                        {{#each coreQualitiesCatalog}}
                            <div class="structured-qualities-cell">
                                <div>{{this.label}}</div>
                                <div class="right-align-content">
                                    {{#if this.optionalValue}}
                                        <div class="structured-optional-value">
                                            <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                            <input class="structured-value structured-value--opt" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="0" step="1" placeholder="X" />
                                        </div>
                                    {{else}}
                                        {{#if this.hasValue}}
                                            <input class="structured-value" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="0" step="1" />
                                        {{else}}
                                            <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                        {{/if}}
                                    {{/if}}
                                </div>
                            </div>
                        {{/each}}
                    </div>

                    <!-- Other traits (reference / future automation) -->
                    <div class="structured-traits-block">
                        <div class="structured-traits-label">Other Traits</div>
                        <div class="structured-traits-pills">
                            {{#each traitsCatalog}}
                                <label class="uesrpg-pill {{#if this.selected}}is-selected{{/if}}">
                                    <input type="checkbox" name="qualitiesTraits.toggle.{{this.key}}" {{checked this.selected}} />
                                    <span>{{this.label}}</span>
                                </label>
                            {{/each}}
                        </div>
                    </div>
                </div>

                {{#if uiSpellcastingConfig}}
                <div class="quality-container">
                    <div class="flex-container">
                        <h2>Spellcasting Configuration</h2>
                    </div>
                    <div class="selection-container">
                        <p class="u-text-muted u-text-sm">
                            Configure item-based spellcasting slots. For each slot: pick a spell, set binding strength, then choose cost mode and value.
                        </p>
                        <div class="weapon-field-row">
                            <label>Enable Spellcasting</label>
                            <button type="button" data-action="toggleSpellcastingEnable">
                                {{#if uiSpellcastingConfig.enabled}}Disable{{else}}Enable{{/if}}
                            </button>
                        </div>
                        {{#if uiSpellcastingConfig.enabled}}
                        <div class="weapon-field-row">
                            <label>Charge Pool (Soul)</label>
                            <span class="u-text-muted">Used by Soul-cost slots; synced with item Charge.</span>
                        </div>
                        <div class="weapon-field-row">
                            <label>Charge Current / Max</label>
                            <div class="right-align-content">
                                <input type="number" data-spellcasting-charge="value" value="{{uiSpellcastingConfig.poolValue}}" min="0" step="1" class="u-w-50" />
                                <span>/</span>
                                <input type="number" data-spellcasting-charge="max" value="{{uiSpellcastingConfig.poolMax}}" min="0" step="1" class="u-w-50" />
                            </div>
                        </div>
                        <div class="weapon-field-row">
                            <button type="button" data-action="addSpellcastingSlot">Add Spell Slot</button>
                            <button type="button" data-action="editSpellcastingSlot">Save Spellcasting Config</button>
                        </div>
                        {{#each uiSpellcastingConfig.slots as |slot|}}
                        <div class="weapon-enchant-effect-row u-py-sm" data-spellcasting-slot-id="{{slot.id}}">
                            <div class="weapon-field-row">
                                <label>Slot Name</label>
                                <input type="text" data-spellcasting-field="label" value="{{slot.label}}" placeholder="e.g. Fire Bolt" />
                            </div>
                            <div class="weapon-field-row">
                                <label>Resource Cost</label>
                                <input type="number" data-spellcasting-field="cost" value="{{slot.cost}}" min="0" step="1" title="Resource Cost Value" />
                            </div>
                            <div class="weapon-field-row">
                                <label>Binding Strength</label>
                                <input type="number" data-spellcasting-field="bindingStrength" value="{{slot.bindingStrength}}" min="0" max="10" step="1" title="Auto-success DoS value" />
                            </div>
                            <div class="weapon-field-row">
                                <label>Cost Mode</label>
                                <select data-spellcasting-field="costMode">
                                    <option value="soul" {{#if (eq slot.costMode "soul")}}selected{{/if}}>Soul Energy</option>
                                    <option value="magicka" {{#if (eq slot.costMode "magicka")}}selected{{/if}}>Magicka</option>
                                    <option value="none" {{#if (eq slot.costMode "none")}}selected{{/if}}>No Cost</option>
                                </select>
                            </div>
                            <div class="weapon-field-row">
                                <label>Enabled</label>
                                <label>
                                    <input type="checkbox" data-spellcasting-field="enabled" {{checked slot.enabled}} />
                                    Slot Active
                                </label>
                            </div>
                            <div class="weapon-field-row">
                                <label>Stored Spell UUID</label>
                                <span class="enchant-effect-params u-text-muted">{{#if slot.spellUuid}}{{slot.spellUuid}}{{else}}No spell selected yet{{/if}}</span>
                            </div>
                            <div class="weapon-field-row">
                                <button type="button" data-action="pickSpellcastingSlotSpell" data-slot-id="{{slot.id}}">Pick Spell</button>
                                <button type="button" data-action="removeSpellcastingSlot" data-slot-id="{{slot.id}}">Remove Slot</button>
                            </div>
                        </div>
                        {{/each}}
                        {{#if uiSpellcastingConfig.canCast}}
                        <div class="weapon-field-row">
                            <button type="button" data-action="castEnchantment">Cast Enchantment</button>
                        </div>
                        {{/if}}
                        {{/if}}
                    </div>
                </div>
                {{/if}}
            </div>
        </div>

        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>

    </section>
