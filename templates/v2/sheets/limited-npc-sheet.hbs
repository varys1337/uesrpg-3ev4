{{!-- Character Sheet Sections --}}
<div class="sheet-section-container">

  <div class="sheet-fixed-container">
    <div class="character-profile-container">
      <div class="profile-img-container">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" data-action="editPortrait" title="{{actor.name}}">
        <div class="status-column">
          <div class="vertical-flex-container">
            <img id="wound-icon" src="icons/skills/wounds/blood-drip-droplet-red.webp" title="{{localize "UESRPG.UI.WoundedPenalty" value=actor.system.woundPenalty}}">
            <img id="fatigue-icon" src="icons/magic/control/debuff-energy-hold-green.webp" title="{{localize "UESRPG.UI.FatiguedPenalty" value=actor.system.fatigue.penalty}}">
            <img id="enc-icon" src="icons/containers/bags/pack-leather-brown.webp" title="{{carryRatingLabel}} {{actor.system.carry_rating.penalty}}">
          </div>
        </div>
      </div>
      <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-action="tab" data-group="primary" data-tab="core">{{localize "UESRPG.UI.Core"}}</a>
      </nav>
      <div>
        <h1 class="charname"><input type="text" name="name" value="{{actor.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"></h1>
      </div>
    </div>
    <div class="fixed-data-container">
      <div class="resourceBars">
        <div id="hpResource">
          <div class="resourceLabel">
            <button type="button" data-resource="hp">{{localize "UESRPG.UI.Health"}}</button>
            <div class="resourceButton">
              <i data-direction="increase" data-resource="hp" class="fas fa-angle-up incrementResource"></i>
              <i data-direction="decrease" data-resource="hp" class="fas fa-angle-down incrementResource"></i>
            </div>
          </div>
          <div class="maxBar" data-resource="hp">
            <div id="hpBar" class="currentBar" data-resource="hp">
              <input type="number" name="system.hp.value" value="{{actor.system.hp.value}}"> / <label>{{actor.system.hp.max}}</label>
            </div>
          </div>
        </div>
        <div id="staminaResource">
          <div class="resourceLabel">
            <button type="button" data-resource="stamina">{{localize "UESRPG.UI.Stamina"}}</button>
            <div class="resourceButton">
              <i data-direction="increase" data-resource="stamina" class="fas fa-angle-up incrementResource"></i>
              <i data-direction="decrease" data-resource="stamina" class="fas fa-angle-down incrementResource"></i>
            </div>
          </div>
          <div class="maxBar" data-resource="stamina">
            <div id="staminaBar" class="currentBar" data-resource="stamina">
              <input type="number" name="system.stamina.value" value="{{actor.system.stamina.value}}"> / <label>{{actor.system.stamina.max}}</label>
            </div>
          </div>
        </div>
        <div id="magickaResource">
          <div class="resourceLabel">
            <button type="button" data-resource="magicka">{{localize "UESRPG.UI.Magicka"}}</button>
            <div class="resourceButton">
              <i data-direction="increase" data-resource="magicka" class="fas fa-angle-up incrementResource"></i>
              <i data-direction="decrease" data-resource="magicka" class="fas fa-angle-down incrementResource"></i>
            </div>
          </div>
          <div class="maxBar" data-resource="magicka">
            <div id="magickaBar" class="currentBar" data-resource="magicka">
              <input type="number" name="system.magicka.value" value="{{actor.system.magicka.value}}"> / <label>{{actor.system.magicka.max}}</label>
            </div>
          </div>
        </div>
        <div id="luckResource">
          <div class="resourceLabel">
            <button type="button" data-resource="luck_points">{{localize "UESRPG.UI.Luck"}}</button>
            <div class="resourceButton">
              <i data-direction="increase" data-resource="luck_points" class="fas fa-angle-up incrementResource"></i>
              <i data-direction="decrease" data-resource="luck_points" class="fas fa-angle-down incrementResource"></i>
            </div>
          </div>
          <div class="maxBar" data-resource="luck_points">
            <div id="luck_pointsBar" class="currentBar" data-resource="luck_points">
              <input type="number" name="system.luck_points.value" value="{{actor.system.luck_points.value}}"> / <label>{{actor.system.luck_points.max}}</label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="sheet-body">
    <div class="tab core" data-group="primary" data-tab="core">
      <div class="tabContainer">
        <div class="about-buttons">
          <div class="npc-button-stats">
            <div>
              <div class="styled-font">{{localize "UESRPG.UI.SoulEnergy"}}</div>
              <input type="text" name="system.soul_energy" placeholder="{{localize "UESRPG.UI.SoulEnergy"}}" value="{{actor.system.soul_energy}}">
            </div>
            <div>
              <div class="styled-font">{{localize "UESRPG.UI.Race"}}</div>
              <input type="text" name="system.race" placeholder="{{localize "UESRPG.UI.Race"}}" value="{{actor.system.race}}">
            </div>
            <div>
              <div class="styled-font">{{localize "UESRPG.UI.Threat"}}</div>
              <select name="system.threat" data-type="String">
                {{selectOptions actor.system.threatCategory selected=actor.system.threat localize=true}}
              </select>
            </div>
          </div>
        </div>

        <div class="social-section">
          <div class="social-field">
            <div class="section-header">
              <span class="section-header__label">{{localize "UESRPG.UI.Languages"}}</span>
            </div>
            <div class="social-field__body">
              <div class="social-chip-wrap">
                <span class="social-chip social-chip--fixed">{{localize "UESRPG.Choices.Languages.cyrodilic"}}</span>
                {{#each actor.system.socialDisplay.languages.preview as |lang|}}
                  <span class="social-chip">{{lang}}</span>
                {{/each}}
                {{#if actor.system.socialDisplay.languages.hiddenCount}}
                  <span class="social-chip social-chip--muted">{{localize "UESRPG.UI.MoreCount" count=actor.system.socialDisplay.languages.hiddenCount}}</span>
                {{/if}}
                {{#unless actor.system.socialDisplay.languages.preview.length}}
                  <span class="social-chip social-chip--muted">{{localize "UESRPG.UI.NoAdditionalLanguagesSelected"}}</span>
                {{/unless}}
              </div>
            </div>
          </div>

          <div class="social-field">
            <div class="section-header">
              <span class="section-header__label">{{localize "UESRPG.UI.Factions"}}</span>
            </div>
            <div class="social-field__body">
              {{#if actor.system.socialDisplay.factions.preview.length}}
                <ul class="social-faction-summary">
                  {{#each actor.system.socialDisplay.factions.preview as |entry|}}
                    <li>
                      <span class="name">{{entry.name}}</span>
                      {{#if entry.rankTitle}}<span class="meta"> - {{entry.rankTitle}}</span>{{/if}}
                      {{#if entry.location}}<span class="meta"> ({{entry.location}})</span>{{/if}}
                    </li>
                  {{/each}}
                </ul>
                {{#if actor.system.socialDisplay.factions.hiddenCount}}
                  <p class="social-empty">{{localize "UESRPG.UI.MoreFactionsCount" count=actor.system.socialDisplay.factions.hiddenCount}}</p>
                {{/if}}
              {{else}}
                <p class="social-empty">{{localize "UESRPG.UI.NoFactionsSelected"}}</p>
              {{/if}}
            </div>
          </div>
        </div>

        <div class="bioPage">
          <h2>{{localize "UESRPG.UI.Biography"}}</h2>
          <div class="contentContainer">
            <prose-mirror name="system.bio" value="{{actor.system.bio}}" data-document-uuid="{{actor.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{actor.system.enrichedBio}}}</prose-mirror>
          </div>
        </div>

      </div>
    </div>

  </section>
</div>
