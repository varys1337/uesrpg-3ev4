                                                        <input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}">
                                                    </div>
                                                    <img class="item-img" src="{{item.img}}" data-action="itemOpen" title="{{localize "UESRPG.UI.PostToChat"}}"/>
                                                    {{#if item.system.containerStats.container_id}}
                                                        <i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>
                                                    {{/if}}
                                                    <div class="item-name" data-action="itemOpen">{{item.name}}</div>
                                                    {{#if item.system.uiCastEnchantmentCharge}}
                                                        <span class="uesrpg-cast-charge-pill" title="{{localize "UESRPG.Sheets.Equipment.CastEnchantmentCharge"}}">{{item.system.uiCastEnchantmentCharge}}</span>
                                                    {{/if}}
                                                </div>
                                            </td>
                                            <td class="ues-col-stat">{{item.system.quantity}}</td>
                                            <td class="ues-col-stat">{{item.system.enc}}</td>
                                            <td class="ues-col-stat">{{item.system.price}}</td>
                                            <td class="ues-col-actions">
                                                <a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>

                        </div>
                    </div>
                    </div>
                </div>
            </div>
