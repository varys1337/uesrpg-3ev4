<div class="tab core" data-group="primary" data-tab="core">
  <div class="tabContainer">
    <div class="about-buttons">
      <div class="npc-button-stats">
        <div class="npc-button-stats__field npc-button-stats__field--soul-energy">
          <div class="styled-font">{{localize "UESRPG.UI.SoulEnergy"}}</div>
          <input type="text" name="system.soul_energy" placeholder="{{localize "UESRPG.UI.SoulEnergy"}}" value="{{actor.system.soul_energy}}">
        </div>
        <div class="npc-button-stats__field npc-button-stats__field--creature-type">
          <div class="styled-font">{{localize "UESRPG.UI.CreatureType"}}</div>
          <select name="system.race" data-type="String">
            {{selectOptions npcCreatureTypeOptions selected=npcCreatureTypeSelected localize=true}}
          </select>
        </div>
        <div class="npc-button-stats__field npc-button-stats__field--threat">
          <div class="styled-font">{{localize "UESRPG.UI.Threat"}}</div>
          <select name="system.threat" data-type="String">
            {{selectOptions npcThreatTemplateOptions selected=actor.system.threat localize=true}}
          </select>
        </div>
      </div>
    </div>

    <div class="skillContainer">
      <div class="section-header">
        <span class="section-header__label">{{localize "UESRPG.UI.Professions"}}</span>
      </div>
      <ul class="skillList">
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="combat">
            <img class="item-img" src="icons/skills/melee/weapons-crossed-swords-yellow.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Combat"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.combat" value="{{actor.system.professions.combat}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="evade">
            <img class="item-img" src="icons/skills/movement/arrow-upward-yellow.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Evade"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.evade" value="{{actor.system.professions.evade}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="knowledge">
            <img class="item-img" src="icons/skills/trades/academics-study-reading-book.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Knowledge"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.knowledge" value="{{actor.system.professions.knowledge}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="magic">
            <img class="item-img" src="icons/sundries/books/book-open-purple.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Magic"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.magic" value="{{actor.system.professions.magic}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="observe">
            <img class="item-img" src="icons/magic/perception/eye-ringed-green.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Observe"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.observe" value="{{actor.system.professions.observe}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="physical">
            <img class="item-img" src="icons/skills/melee/unarmed-punch-fist.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Physical"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.physical" value="{{actor.system.professions.physical}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="social">
            <img class="item-img" src="icons/skills/social/diplomacy-peace-alliance.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Social"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.social" value="{{actor.system.professions.social}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="stealth">
            <img class="item-img" src="systems/uesrpg-3ev4/images/Icons/invisible.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Stealth"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.professions.stealth" value="{{actor.system.professions.stealth}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <button type="button" class="itemInfo profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="commerce">
            <img class="item-img" src="icons/skills/social/trading-justice-scale-yellow.webp" data-tooltip="UESRPG.UI.PostToChat" alt="" />
            <span class="skill-name">{{localize "UESRPG.UI.Commerce"}}</span>
          </button>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.skills.commerce.tn" value="{{actor.system.skills.commerce.tn}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <div class="itemInfo">
            <button type="button" class="profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="profession1" aria-label="{{localize "UESRPG.UI.Roll"}}">
              <img class="item-img" src="icons/skills/social/trading-justice-scale-yellow.webp" alt="" aria-hidden="true" />
            </button>
            <span class="skill-name">
              <input type="text" placeholder="{{localize "UESRPG.UI.Profession1"}}" name="system.skills.profession1.specialization" value="{{actor.system.skills.profession1.specialization}}">
            </span>
          </div>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.skills.profession1.tn" value="{{actor.system.skills.profession1.tn}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <div class="itemInfo">
            <button type="button" class="profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="profession2" aria-label="{{localize "UESRPG.UI.Roll"}}">
              <img class="item-img" src="icons/skills/social/trading-justice-scale-yellow.webp" alt="" aria-hidden="true" />
            </button>
            <span class="skill-name">
              <input type="text" placeholder="{{localize "UESRPG.UI.Profession2"}}" name="system.skills.profession2.specialization" value="{{actor.system.skills.profession2.specialization}}">
            </span>
          </div>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.skills.profession2.tn" value="{{actor.system.skills.profession2.tn}}"/>%</div>
          </div>
        </li>
        <li class="npc-item">
          <div class="itemInfo">
            <button type="button" class="profession-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="professionsRoll" data-profession-key="profession3" aria-label="{{localize "UESRPG.UI.Roll"}}">
              <img class="item-img" src="icons/skills/social/trading-justice-scale-yellow.webp" alt="" aria-hidden="true" />
            </button>
            <span class="skill-name">
              <input type="text" placeholder="{{localize "UESRPG.UI.Profession3"}}" name="system.skills.profession3.specialization" value="{{actor.system.skills.profession3.specialization}}">
            </span>
          </div>
          <div class="item-controls">
            <div class="item-value profession"><input type="number" name="system.skills.profession3.tn" value="{{actor.system.skills.profession3.tn}}"/>%</div>
          </div>
        </li>
      </ul>
    </div>

    <div class="three-column-flex-container">
      <div class="trait-container">
        <div class="section-header">
          <button type="button" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-action="groupToggle" data-group="traits" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"><i class="fas fa-chevron-down"></i></button>
          <span class="section-header__label">{{localize "UESRPG.UI.Traits"}}</span>
        </div>
        <ol class="single-column-list">
          {{#each actor.trait as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-image-action" data-action="postItemToChat" data-tooltip="UESRPG.UI.PostToChat" aria-label="{{localize "UESRPG.UI.PostToChat"}}"><img class="item-img" src="{{item.img}}" alt="" aria-hidden="true"></button>
                {{#with (lookup @root.actor.ui.traitStackingById item._id) as |stack|}}
                  {{#if stack.highest}}
                  <i class="fas fa-layer-group" data-tooltip-text="{{localize "UESRPG.Sheets.FeatureInspector.TraitStackingHighest" key=stack.key count=stack.count highest=stack.highest unit=stack.unit}}" aria-label="{{localize "UESRPG.Sheets.FeatureInspector.TraitStackingHighest" key=stack.key count=stack.count highest=stack.highest unit=stack.unit}}"></i>
                  {{else}}
                  <i class="fas fa-layer-group" data-tooltip-text="{{localize "UESRPG.Sheets.FeatureInspector.TraitStacking" key=stack.key count=stack.count}}" aria-label="{{localize "UESRPG.Sheets.FeatureInspector.TraitStacking" key=stack.key count=stack.count}}"></i>
                  {{/if}}
                {{/with}}
                <button type="button" class="item-name uesrpg-semantic-control uesrpg-plain-control" data-action="itemOpen">{{item.name}}</button>
              </div>
              <div class="item-controls">
                <button type="button" class="item-control item-delete uesrpg-semantic-control uesrpg-plain-control" data-action="itemDelete" data-tooltip="UESRPG.UI.Delete" aria-label="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></button>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
      <div class="talent-container">
        <div class="section-header">
          <button type="button" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-action="groupToggle" data-group="talents" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"><i class="fas fa-chevron-down"></i></button>
          <span class="section-header__label">{{localize "UESRPG.UI.Talents"}}</span>
        </div>
        <ol class="single-column-list">
          {{#each actor.talent as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-image-action" data-action="postItemToChat" data-tooltip="UESRPG.UI.PostToChat" aria-label="{{localize "UESRPG.UI.PostToChat"}}"><img class="item-img" src="{{item.img}}" alt="" aria-hidden="true"></button>
                <button type="button" class="item-name uesrpg-semantic-control uesrpg-plain-control" data-action="itemOpen">{{item.name}}</button>
              </div>
              <div class="item-controls">
                <button type="button" class="item-control item-delete uesrpg-semantic-control uesrpg-plain-control" data-action="itemDelete" data-tooltip="UESRPG.UI.Delete" aria-label="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></button>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
      <div class="power-container">
        <div class="section-header">
          <button type="button" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-action="groupToggle" data-group="powers" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"><i class="fas fa-chevron-down"></i></button>
          <span class="section-header__label">{{localize "UESRPG.UI.Powers"}}</span>
        </div>
        <ol class="single-column-list">
          {{#each actor.power as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-image-action" data-action="postItemToChat" data-tooltip="UESRPG.UI.PostToChat" aria-label="{{localize "UESRPG.UI.PostToChat"}}"><img class="item-img" src="{{item.img}}" alt="" aria-hidden="true"></button>
                <button type="button" class="item-name uesrpg-semantic-control uesrpg-plain-control" data-action="itemOpen">{{item.name}}</button>
              </div>
              <div class="item-controls">
                <button type="button" class="item-control item-delete uesrpg-semantic-control uesrpg-plain-control" data-action="itemDelete" data-tooltip="UESRPG.UI.Delete" aria-label="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></button>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
    </div>

    <div class="social-section">
      <div class="social-field">
        <div class="section-header">
          <button type="button" data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-group="languages" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"><i class="fas fa-chevron-down"></i></button>
          <span class="section-header__label">{{localize "UESRPG.UI.Languages"}}</span>
          <button type="button" data-action="openLanguageSelector" class="section-header__action uesrpg-styled-action" data-tooltip="UESRPG.UI.ConfigureLanguages" aria-label="{{localize "UESRPG.UI.ConfigureLanguages"}}"><i class="fas fa-pen"></i></button>
        </div>
        <div class="social-field__body">
          <div class="social-chip-wrap">
            <span class="social-chip social-chip--fixed">{{localize "UESRPG.Choices.Languages.cyrodilic"}}</span>
            {{#each actor.system.socialDisplay.languages.preview as |lang|}}
              <span class="social-chip">{{lang}}</span>
            {{/each}}
            {{#if actor.system.socialDisplay.languages.hiddenCount}}
              <span class="social-chip social-chip--muted">{{localize "UESRPG.UI.MoreCount" count=actor.system.socialDisplay.languages.hiddenCount}}</span>
            {{/if}}
            {{#unless actor.system.socialDisplay.languages.preview.length}}
              <span class="social-chip social-chip--muted">{{localize "UESRPG.UI.NoAdditionalLanguagesSelected"}}</span>
            {{/unless}}
          </div>
        </div>
      </div>

      <div class="social-field">
        <div class="section-header">
          <button type="button" data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-group="factions" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"><i class="fas fa-chevron-down"></i></button>
          <span class="section-header__label">{{localize "UESRPG.UI.Factions"}}</span>
          <button type="button" data-action="openFactionSelector" class="section-header__action uesrpg-styled-action" data-tooltip="UESRPG.UI.ConfigureFactions" aria-label="{{localize "UESRPG.UI.ConfigureFactions"}}"><i class="fas fa-pen"></i></button>
        </div>
        <div class="social-field__body">
          {{#if actor.system.socialDisplay.factions.preview.length}}
            <ul class="social-faction-summary">
              {{#each actor.system.socialDisplay.factions.preview as |entry|}}
                <li>
                  <span class="name">{{entry.name}}</span>
                  {{#if entry.rankTitle}}<span class="meta"> - {{entry.rankTitle}}</span>{{/if}}
                  {{#if entry.location}}<span class="meta"> ({{entry.location}})</span>{{/if}}
                </li>
              {{/each}}
            </ul>
            {{#if actor.system.socialDisplay.factions.hiddenCount}}
              <p class="social-empty">{{localize "UESRPG.UI.MoreFactionsCount" count=actor.system.socialDisplay.factions.hiddenCount}}</p>
            {{/if}}
          {{else}}
            <p class="social-empty">{{localize "UESRPG.UI.NoFactionsSelected"}}</p>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Feature Inspector (Chapter 4 trait/talent/power provenance) --}}
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-inspector.hbs"}}

    <div class="bioPage">
      <div class="section-header">
        <button type="button" data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-group="notes" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"><i class="fas fa-chevron-down"></i></button>
        <span class="section-header__label">{{localize "UESRPG.UI.Biography"}}</span>
        <button type="button" class="section-header__action uesrpg-styled-action" data-action="openBioEditor" data-tooltip="UESRPG.UI.EditBiography" aria-label="{{localize "UESRPG.UI.EditBiography"}}">
          <i class="fas fa-pen"></i>
        </button>
      </div>
      <div class="contentContainer">
        <prose-mirror name="system.bio" value="{{actor.system.bio}}" data-document-uuid="{{actor.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{actor.system.enrichedBio}}}</prose-mirror>
      </div>
    </div>

  </div>
</div>
