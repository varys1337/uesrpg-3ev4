                                    {{#if isGM}}
                                    <div class="flex-container-input">
                                        <input type="number" class="uesrpg-attack-input" name="flags.uesrpg-3ev4.combat.attackTrackerOverrides.current" data-kind="current" aria-label="{{localize "UESRPG.Sheets.Combat.CurrentAttacks"}}" value="{{actor.attackTrackerUi.current}}" min="0" step="1">
                                        /
                                        <input type="number" class="uesrpg-attack-input" name="flags.uesrpg-3ev4.combat.attackTrackerOverrides.max" data-kind="max" aria-label="{{localize "UESRPG.Sheets.Combat.MaximumAttacks"}}" value="{{actor.attackTrackerUi.max}}" min="1" step="1">
                                    </div>
                                    {{else}}
                                    {{actor.attackTrackerUi.current}}/{{actor.attackTrackerUi.max}}
                                    {{/if}}
                                    {{else}}
                                    --/--
                                    {{/if}}
                                </div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.Sheets.Combat.Attacks"}}</div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">
                                    {{#if (gt actor.system.speed.flySpeed 0)}}
                                        {{actor.system.speed.flySpeed}}
                                    {{else}}
                                        {{actor.system.speed.swimSpeed}}
                                    {{/if}}
                                </div>
                                <div class="flex-container">
                                    <div class="small-text-label">
                                        {{#if (gt actor.system.speed.flySpeed 0)}}
                                            {{localize "UESRPG.Sheets.Combat.Fly"}}
                                        {{else}}
                                            {{localize "UESRPG.Sheets.Combat.Swim"}}
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">{{actor.system.wound_threshold.value}}</div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.Sheets.Combat.Wound"}}</div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">{{actor.system.initiative.value}}</div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.Sheets.Combat.Initiative"}}</div>
                                </div>
                            </div>
                        </div>
                        <div class="resistance-container uesrpg-panel ues-panel--resistance" data-ues-section="resistance-panel">
                            <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Combat.Resistances"}}</span></div>
                            <div class="resistance-grid">
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Fire"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.fireR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Frost"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.frostR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Shock"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.shockR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.UI.Magic"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.magicR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Poison"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.poisonR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Silver"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.silverR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Sunlight"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.sunlightR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Toughness"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.natToughness}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Disease"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.diseaseR}}%</div>
                                </div>
                            </div>
                        </div>
                        <div class="status-controls-container uesrpg-panel ues-panel--status" data-ues-section="status-panel">
                            <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Combat.Status"}}</span></div>
                            <div class="status-grid-container"><div class="flex-container">
                                    <div>{{localize "UESRPG.UI.Fatigue"}}</div>
                                    <div class="label-flex-container">
                                        <label data-tooltip="UESRPG.Sheets.Combat.FatigueLevelModifier">{{actor.system.fatigue.level}} ({{actor.system.fatigue.bonus}})</label>
                                        <div class="resourceButton">
                                            <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="incrementFatigue" data-direction="increase" aria-label="{{localize "UESRPG.UI.IncreaseFatigue"}}"><i class="fas fa-angle-up incrementFatigue" aria-hidden="true"></i></button>
                                            <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="incrementFatigue" data-direction="decrease" aria-label="{{localize "UESRPG.UI.DecreaseFatigue"}}"><i class="fas fa-angle-down incrementFatigue" aria-hidden="true"></i></button>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.UI.ENC"}}</div>
                                    <label data-tooltip-text="{{actor.system.carry_rating.current}} / {{actor.system.carry_rating.max}}">{{carryRatingLabel}}</label>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Size"}}</div>
                                    <select name="system.size" data-type="String" aria-label="{{localize "UESRPG.Sheets.Combat.Size"}}">
                                        {{selectOptions sizeOptions selected=actor.system.size localize=true}}
                                    </select>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Equipment.AC"}}</div>
                                    <select name="system.armor_class" data-type="String" aria-label="{{localize "UESRPG.Sheets.Equipment.AC"}}">
                                        {{selectOptions armorClassOptions selected=actor.system.armor_class localize=true}}
                                    </select>
                                </div>
                                {{#if engagementFlankingEnabled}}
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.EngagementScore"}}</div>
                                    <div class="uesrpg-status-inline-control">
                                        <input name="flags.uesrpg-3ev4.homebrew.maxEngagementScore" type="number" class="uesrpg-max-engagement-score" min="0" step="1" placeholder="{{localize "UESRPG.UI.Auto"}}" value="{{engagementFlankingMaxES}}" aria-label="{{localize "UESRPG.Sheets.Combat.EngagementScore"}}">
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <!-- Combat Equipped Summary removed — Quick Info bar was unused -->

                    <section class="uesrpg-combat-styles uesrpg-collapsible">
    <div class="section-header uesrpg-combat-section-header">
        <button type="button" data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-group="combat-styles" data-tooltip="UESRPG.UI.CollapseExpand" aria-label="{{localize "UESRPG.Sheets.Combat.CombatStyle"}}: {{localize "UESRPG.UI.CollapseExpand"}}" aria-expanded="true"></button>
        <span class="section-header__label">{{localize "UESRPG.Sheets.Combat.CombatStyle"}}</span>
        <button type="button" class="section-header__action uesrpg-semantic-control uesrpg-plain-control" data-action="itemCreate" data-item-type="combatStyle" data-tooltip="UESRPG.Sheets.Combat.AddCombatStyle" aria-label="{{localize "UESRPG.Sheets.Combat.AddCombatStyle"}}">+</button>
    </div>
    {{#if actor.combatStyle.length}}
    <div class="combat-item-container uesrpg-sheet-table-frame uesrpg-collapse-body">
        <table class="combat-style-table uesrpg-sheet-table">
            <thead><tr>
                <th class="item-name-cell">{{localize "UESRPG.UI.Name"}}</th>
                <th>%</th>
                <th>{{localize "UESRPG.UI.Rank"}}</th>
                <th class="right-align-cell"><i class="fas fa-trash" aria-hidden="true"></i><span class="u-sr-only">{{localize "UESRPG.UI.Delete"}}</span></th>
            </tr></thead>
            <tbody>
                {{#each actor.combatStyle as |item|}}
                <tr class="item" data-item-id="{{item._id}}">
                    <td class="item-name-cell"><div class="flex-container">
                        {{> "systems/uesrpg-3ev4/templates/partials/sheets/skill-roll-icon.hbs" action="combatRoll" rollTargetClass="uesrpg-combat-roll-icon" img=item.img label=item.name}}
                        <button type="button" data-action="itemOpen" class="item-name uesrpg-semantic-control uesrpg-plain-control" data-tooltip-text="{{localize "UESRPG.ModernUI.OpenItemSheet"}}: {{item.name}}" aria-label="{{localize "UESRPG.ModernUI.OpenItemSheet"}}: {{item.name}}">{{item.name}}</button>
                    </div></td>
                    <td>{{item.system.value}}%</td>
                    <td>{{#with (lookup @root.skillRankOptions item.system.rank) as |rankLabel|}}{{localize rankLabel}}{{else}}{{item.system.rank}}{{/with}}</td>
                    <td class="right-align-cell"><button type="button" data-action="itemDelete" class="item-control item-delete uesrpg-semantic-control uesrpg-plain-control" data-tooltip="UESRPG.UI.DeleteItem" aria-label="{{localize "UESRPG.UI.DeleteItem"}}: {{item.name}}"><i class="fas fa-trash" aria-hidden="true"></i></button></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{/if}}
</section>

<div class="uesrpg-actions-section uesrpg-panel uesrpg-panel--subtle" data-actions-root>
    <nav class="uesrpg-actions-tabs tabs" data-group="actions" role="tablist" aria-label="{{localize "UESRPG.Sheets.Combat.Actions"}}">
        <button type="button" data-action="tab" class="uesrpg-actions-subtab uesrpg-semantic-control uesrpg-plain-control" data-group="actions" data-tab="primary" role="tab">{{localize "UESRPG.Sheets.Combat.Primary"}}</button>
        <button type="button" data-action="tab" class="uesrpg-actions-subtab uesrpg-semantic-control uesrpg-plain-control" data-group="actions" data-tab="secondary" role="tab">{{localize "UESRPG.Sheets.Combat.Secondary"}}</button>
        <button type="button" data-action="tab" class="uesrpg-actions-subtab uesrpg-semantic-control uesrpg-plain-control" data-group="actions" data-tab="reactions" role="tab">{{localize "UESRPG.Sheets.Combat.Reactions"}}</button>
        <button type="button" data-action="tab" class="uesrpg-actions-subtab uesrpg-semantic-control uesrpg-plain-control" data-group="actions" data-tab="special" role="tab">{{localize "UESRPG.Sheets.Combat.Special"}}</button>
    </nav>

    <div class="uesrpg-actions-panels">
        <div class="tab uesrpg-actions-panel" role="tabpanel" data-group="actions" data-tab="primary">
            <div class="uesrpg-actions-card">
                <div class="quickbar-buttons quickbar-buttons--compact">
                    {{#if actor.sheetCombatQuick.meleeWeaponId}}
                        <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="attack" data-weapon-id="{{actor.sheetCombatQuick.meleeWeaponId}}" data-attack-mode="melee" data-label="{{localize "UESRPG.Sheets.Combat.AttackMelee"}}" {{#if actor.sheetCombatQuick.quickAttacksDisabled}}disabled="disabled" data-tooltip-text="{{actor.sheetCombatQuick.quickAttacksDisabledReason}}"{{/if}} aria-label="{{localize "UESRPG.Sheets.Combat.AttackMelee"}}{{#if actor.sheetCombatQuick.quickAttacksDisabled}} — {{actor.sheetCombatQuick.quickAttacksDisabledReason}}{{/if}}">{{localize "UESRPG.Sheets.Combat.AttackMelee"}}</button>
                    {{/if}}
                    {{#if actor.sheetCombatQuick.rangedWeaponId}}
                        <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="attack" data-weapon-id="{{actor.sheetCombatQuick.rangedWeaponId}}" data-attack-mode="ranged" data-label="{{localize "UESRPG.Sheets.Combat.AttackRanged"}}" {{#if actor.sheetCombatQuick.quickAttacksDisabled}}disabled="disabled" data-tooltip-text="{{actor.sheetCombatQuick.quickAttacksDisabledReason}}"{{/if}} aria-label="{{localize "UESRPG.Sheets.Combat.AttackRanged"}}{{#if actor.sheetCombatQuick.quickAttacksDisabled}} — {{actor.sheetCombatQuick.quickAttacksDisabledReason}}{{/if}}">{{localize "UESRPG.Sheets.Combat.AttackRanged"}}</button>
                    {{/if}}
                    <button type="button" class="uesrpg-cast-magic uesrpg-styled-action" data-action="castMagic" data-action-type="primary" {{#unless actor.sheetCombatActions.canCastMagic}}disabled="disabled" data-tooltip="UESRPG.Sheets.Combat.NoCastableSourcesOnSheet"{{/unless}} aria-label="{{localize "UESRPG.Sheets.Combat.CastMagic"}}{{#unless actor.sheetCombatActions.canCastMagic}} — {{localize "UESRPG.Sheets.Combat.NoCastableSourcesOnSheet"}}{{/unless}}">{{localize "UESRPG.Sheets.Combat.CastMagic"}}</button>

                    
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="disengage" data-label="{{localize "UESRPG.Sheets.Combat.Disengage"}}">{{localize "UESRPG.Sheets.Combat.Disengage"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="delay" data-label="{{localize "UESRPG.Sheets.Combat.DelayTurn"}}">{{localize "UESRPG.Sheets.Combat.Delay"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="defensive-stance" data-label="{{localize "UESRPG.Sheets.Combat.DefensiveStance"}}">{{localize "UESRPG.Sheets.Combat.DefensiveStance"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="grapple" data-action-type="primary" data-label="{{localize "UESRPG.Sheets.Combat.Grapple"}}">{{localize "UESRPG.Sheets.Combat.Grapple"}}</button>
{{#unless actor.sheetCombatQuick.meleeWeaponId}}{{#unless actor.sheetCombatQuick.rangedWeaponId}}
                        <div class="quickbar-empty">{{localize "UESRPG.Sheets.Combat.EquipWeaponQuickActions"}}</div>
                    {{/unless}}{{/unless}}
                </div>
            </div>
        </div>

        <div class="tab uesrpg-actions-panel" role="tabpanel" data-group="actions" data-tab="secondary">
            <div class="uesrpg-actions-card">
                <div class="quickbar-buttons quickbar-buttons--compact">
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="aim" data-label="{{localize "UESRPG.Sheets.Combat.Aim"}}">{{localize "UESRPG.Sheets.Combat.Aim"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="dash" data-label="{{localize "UESRPG.Sheets.Combat.Dash"}}">{{localize "UESRPG.Sheets.Combat.Dash"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="hide" data-label="{{localize "UESRPG.Sheets.Combat.Hide"}}">{{localize "UESRPG.Sheets.Combat.Hide"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="reload-weapon" data-label="{{localize "UESRPG.Sheets.Combat.ReloadWeapon"}}">{{localize "UESRPG.Sheets.Combat.ReloadWeapon"}}</button>
                    <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction" data-combat-action="use-item" data-label="{{localize "UESRPG.Sheets.Combat.UseItem"}}">{{localize "UESRPG.Sheets.Combat.UseItem"}}</button>
                    {{#if actor.sheetCombatActions.canCastInstantMagic}}
                    <button type="button" class="uesrpg-cast-magic uesrpg-styled-action" data-action="castMagic" data-action-type="secondary">{{localize "UESRPG.Sheets.Combat.CastMagicInstant"}}</button>
                    {{/if}}
    
</div>
            </div>
        </div>

        <div class="tab uesrpg-actions-panel" role="tabpanel" data-group="actions" data-tab="reactions">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/combat-reactions.hbs" isNpc=true}}
        </div>
        <div class="tab uesrpg-actions-panel" role="tabpanel" data-group="actions" data-tab="special">
            <div class="uesrpg-actions-card">

                <div class="actions-help u-mb-sm">{{localize "UESRPG.Sheets.Combat.SpecialActionsHelp"}}</div>

                {{#if actor.sheetCombatActions.specialActions.length}}
                    <div class="uesrpg-special-actions-list">
                        {{#each actor.sheetCombatActions.specialActions as |sa|}}
                            <button type="button" class="uesrpg-quick-action uesrpg-styled-action" data-action="combatQuickAction"
                                    data-combat-action="specialAction"
                                    data-special-id="{{sa.id}}"
                                    data-action-type="{{sa.actionType}}"
                                    data-tooltip-text="{{sa.description}}"
                                    {{#if (eq sa.actionType "primary")}}{{#unless sa.usableNow}}disabled="disabled"{{/unless}}{{/if}}
                             aria-label="{{sa.name}}{{#if sa.description}}: {{sa.description}}{{/if}}">{{sa.name}}</button>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="actions-help">{{localize "UESRPG.Sheets.Combat.NoSpecialActionsRegistry"}}</div>
                {{/if}}
            </div>
        </div>

    </div>
</div>

