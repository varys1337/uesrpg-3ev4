            <div class="tab combat" data-group="primary" data-tab="combat" data-ues-section="combat-tab">
                <div class="combatTabContainer">
                    <div class="combat-tab-primary-header" data-ues-section="combat-header">
                        <div class="combat-stats-container">
                            <div class="combat-stat">
                                <div class="stat-value-label">{{actor.system.speed.value}}</div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.UI.Speed"}}</div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">
                                    <div class="flex-container-input">
                                        <input type="number" name="system.action_points.value" value="{{actor.system.action_points.value}}">
                                        /
                                        <input type="number" name="system.action_points.max" value="{{actor.system.action_points.max}}">
                                    </div>
                                </div>
                                <div class="flex-container">
                                    <div class="small-text-label">AP</div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label {{#if (gte actor.attackTrackerUi.current actor.attackTrackerUi.max)}}attack-limit-warning{{/if}}">
                                    {{#if isGM}}
                                    <div class="flex-container-input">
                                        <input type="number" class="uesrpg-attack-input" name="flags.uesrpg-3ev4.combat.attackTrackerOverrides.current" data-kind="current" value="{{actor.attackTrackerUi.current}}" min="0" step="1">
                                        /
                                        <input type="number" class="uesrpg-attack-input" name="flags.uesrpg-3ev4.combat.attackTrackerOverrides.max" data-kind="max" value="{{actor.attackTrackerUi.max}}" min="1" step="1">
                                    </div>
                                    {{else}}
                                    {{actor.attackTrackerUi.current}}/{{actor.attackTrackerUi.max}}
                                    {{/if}}
                                </div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.Sheets.Combat.Attacks"}}</div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">
                                    {{#if (gt actor.system.speed.flySpeed 0)}}
                                        {{actor.system.speed.flySpeed}}
                                    {{else}}
                                        {{actor.system.speed.swimSpeed}}
                                    {{/if}}
                                </div>
                                <div class="flex-container">
                                    <div class="small-text-label">
                                        {{#if (gt actor.system.speed.flySpeed 0)}}
                                            {{localize "UESRPG.Sheets.Combat.Fly"}}
                                        {{else}}
                                            {{localize "UESRPG.Sheets.Combat.Swim"}}
                                        {{/if}}
                                    </div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">{{actor.system.wound_threshold.value}}</div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.Sheets.Combat.Wound"}}</div>
                                </div>
                            </div>
                            <div class="combat-stat">
                                <div class="stat-value-label">{{actor.system.initiative.value}}</div>
                                <div class="flex-container">
                                    <div class="small-text-label">{{localize "UESRPG.Sheets.Combat.Initiative"}}</div>
                                </div>
                            </div>
                        </div>
                        <div class="resistance-container uesrpg-panel ues-panel--resistance" data-ues-section="resistance-panel">
                            <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Combat.Resistances"}}</span></div>
                            <div class="resistance-grid">
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Fire"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.fireR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Frost"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.frostR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Shock"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.shockR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.UI.Magic"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.magicR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Poison"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.poisonR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Silver"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.silverR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Sunlight"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.sunlightR}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Toughness"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.natToughness}}</div>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Disease"}}</div>
                                    <div class="styled-font-red center-align">{{actor.system.resistance.diseaseR}}%</div>
                                </div>
                            </div>
                        </div>
                        <div class="status-controls-container uesrpg-panel ues-panel--status" data-ues-section="status-panel">
                            <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Combat.Status"}}</span></div>
                            <div class="status-grid-container"><div class="flex-container">
                                    <div>{{localize "UESRPG.UI.Fatigue"}}</div>
                                    <div class="label-flex-container">
                                        <label title="{{localize "UESRPG.Sheets.Combat.FatigueLevelModifier"}}">{{actor.system.fatigue.level}} ({{actor.system.fatigue.bonus}})</label>
                                        <div class="resourceButton">
                                            <i class="fas fa-angle-up incrementFatigue" data-action="incrementFatigue" data-direction="increase"></i>
                                            <i class="fas fa-angle-down incrementFatigue" data-action="incrementFatigue" data-direction="decrease"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex-container">
                                    <div>ENC</div>
                                    <label title="{{actor.system.carry_rating.current}} / {{actor.system.carry_rating.max}}">{{carryRatingLabel}}</label>
                                </div>
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.Size"}}</div>
                                    <select name="system.size" data-type="String">
                                        {{selectOptions sizeOptions selected=actor.system.size localize=true}}
                                    </select>
                                </div>
                                <div class="flex-container">
                                    <div>AC</div>
                                    <select name="system.armor_class" data-type="String">
                                        {{selectOptions armorClassOptions selected=actor.system.armor_class localize=true}}
                                    </select>
                                </div>
                                {{#if engagementFlankingEnabled}}
                                <div class="flex-container">
                                    <div>{{localize "UESRPG.Sheets.Combat.EngagementScore"}}</div>
                                    <div class="uesrpg-status-inline-control">
                                        <input id="npc-max-engagement-score" name="flags.uesrpg-3ev4.homebrew.maxEngagementScore" type="number" class="uesrpg-max-engagement-score" min="0" step="1" placeholder="{{localize "UESRPG.UI.Auto"}}" value="{{engagementFlankingMaxES}}">
                                    </div>
                                </div>
                                {{/if}}
                            </div>
                        </div>
                    </div>

                    <!-- Combat Equipped Summary removed — Quick Info bar was unused -->

                    <div class="combat-item-container">
                        <table class="combat-style-table">
                            <thead>
                                <tr>
                                    <th data-action="itemCreate" class="item-name-cell item-create" id="combatStyle">+ {{localize "UESRPG.Sheets.Combat.CombatStyle"}}</th>
                                    <th>%</th>
                                    <th>{{localize "UESRPG.UI.Rank"}}</th>
                                    <th class="right-align-cell"><i class="fas fa-trash"></i></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each actor.combatStyle as |item id|}}
                                    <tr class="item" data-item-id="{{item._id}}">
                                        <td class="item-name-cell">
                                            <div class="flex-container">
                                                <i data-action="combatRoll" class="fas fa-dice-d20 combat-roll"></i>
                                                <img class="item-img" src="{{item.img}}">
                                                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
                                            </div>
                                        </td>
                                        <td>{{item.system.value}}%</td>
                                        <td>{{item.system.rank}}</td>
                                        <td class="right-align-cell"><a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td>
                                    </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>

<div class="uesrpg-actions-section uesrpg-panel uesrpg-panel--subtle" data-actions-root>
    <nav class="uesrpg-actions-tabs tabs">
        <a data-action="tab" class="uesrpg-actions-subtab" data-group="actions" data-tab="primary">{{localize "UESRPG.Sheets.Combat.Primary"}}</a>
        <a data-action="tab" class="uesrpg-actions-subtab" data-group="actions" data-tab="secondary">{{localize "UESRPG.Sheets.Combat.Secondary"}}</a>
        <a data-action="tab" class="uesrpg-actions-subtab" data-group="actions" data-tab="reactions">{{localize "UESRPG.Sheets.Combat.Reactions"}}</a>
        <a data-action="tab" class="uesrpg-actions-subtab" data-group="actions" data-tab="special">{{localize "UESRPG.Sheets.Combat.Special"}}</a>
    </nav>

    <div class="uesrpg-actions-panels">
        <div class="tab uesrpg-actions-panel" data-group="actions" data-tab="primary">
            <div class="uesrpg-actions-card uesrpg-panel uesrpg-panel--alt">
                <div class="quickbar-title">{{localize "UESRPG.Sheets.Combat.Primary"}}</div>
                <div class="quickbar-buttons quickbar-buttons--compact">
                    {{#if actor.sheetCombatQuick.meleeWeaponId}}
                        <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="attack" data-weapon-id="{{actor.sheetCombatQuick.meleeWeaponId}}" data-attack-mode="melee" data-label="{{localize "UESRPG.Sheets.Combat.AttackMelee"}}" {{#if actor.sheetCombatQuick.quickAttacksDisabled}}disabled="disabled" title="{{actor.sheetCombatQuick.quickAttacksDisabledReason}}"{{/if}}>{{localize "UESRPG.Sheets.Combat.AttackMelee"}}</button>
                    {{/if}}
                    {{#if actor.sheetCombatQuick.rangedWeaponId}}
                        <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="attack" data-weapon-id="{{actor.sheetCombatQuick.rangedWeaponId}}" data-attack-mode="ranged" data-label="{{localize "UESRPG.Sheets.Combat.AttackRanged"}}" {{#if actor.sheetCombatQuick.quickAttacksDisabled}}disabled="disabled" title="{{actor.sheetCombatQuick.quickAttacksDisabledReason}}"{{/if}}>{{localize "UESRPG.Sheets.Combat.AttackRanged"}}</button>
                    {{/if}}
                    <button type="button" class="uesrpg-cast-magic" data-action="castMagic" data-action-type="primary" {{#unless actor.sheetCombatActions.canCastMagic}}disabled="disabled" title="{{localize "UESRPG.Sheets.Combat.NoCastableSourcesOnSheet"}}"{{/unless}}>{{localize "UESRPG.Sheets.Combat.CastMagic"}}</button>

                    
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="disengage" data-label="{{localize "UESRPG.Sheets.Combat.Disengage"}}">{{localize "UESRPG.Sheets.Combat.Disengage"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="delay" data-label="{{localize "UESRPG.Sheets.Combat.DelayTurn"}}">{{localize "UESRPG.Sheets.Combat.Delay"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="defensive-stance" data-label="{{localize "UESRPG.Sheets.Combat.DefensiveStance"}}">{{localize "UESRPG.Sheets.Combat.DefensiveStance"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="grapple" data-action-type="primary" data-label="{{localize "UESRPG.Sheets.Combat.Grapple"}}">{{localize "UESRPG.Sheets.Combat.Grapple"}}</button>
{{#unless actor.sheetCombatQuick.meleeWeaponId}}{{#unless actor.sheetCombatQuick.rangedWeaponId}}
                        <div class="quickbar-empty">{{localize "UESRPG.Sheets.Combat.EquipWeaponQuickActions"}}</div>
                    {{/unless}}{{/unless}}
                </div>
            </div>
        </div>

        <div class="tab uesrpg-actions-panel" data-group="actions" data-tab="secondary">
            <div class="uesrpg-actions-card uesrpg-panel uesrpg-panel--alt">
                <div class="quickbar-title">{{localize "UESRPG.Sheets.Combat.Secondary"}}</div>
                <div class="quickbar-buttons quickbar-buttons--compact">
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="aim" data-label="{{localize "UESRPG.Sheets.Combat.Aim"}}">{{localize "UESRPG.Sheets.Combat.Aim"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="dash" data-label="{{localize "UESRPG.Sheets.Combat.Dash"}}">{{localize "UESRPG.Sheets.Combat.Dash"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="hide" data-label="{{localize "UESRPG.Sheets.Combat.Hide"}}">{{localize "UESRPG.Sheets.Combat.Hide"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="reload-weapon" data-label="{{localize "UESRPG.Sheets.Combat.ReloadWeapon"}}">{{localize "UESRPG.Sheets.Combat.ReloadWeapon"}}</button>
                    <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="use-item" data-label="{{localize "UESRPG.Sheets.Combat.UseItem"}}">{{localize "UESRPG.Sheets.Combat.UseItem"}}</button>
                    {{#if actor.sheetCombatActions.canCastInstantMagic}}
                    <button type="button" class="uesrpg-cast-magic" data-action="castMagic" data-action-type="secondary">{{localize "UESRPG.Sheets.Combat.CastMagicInstant"}}</button>
                    {{/if}}
    
</div>
            </div>
        </div>

        <div class="tab uesrpg-actions-panel" data-group="actions" data-tab="reactions">
            <div class="uesrpg-actions-card uesrpg-panel uesrpg-panel--alt">
                <div class="quickbar-title">{{localize "UESRPG.Sheets.Combat.Reactions"}}</div>
                <div class="actions-help">
                    <strong>{{localize "UESRPG.Sheets.Combat.AttackOfOpportunity"}}:</strong> {{localize "UESRPG.Sheets.Combat.AttackOfOpportunityHelp"}}
                </div>
                
                <div class="reaction-section">
                    <h4>{{localize "UESRPG.Sheets.Combat.AttackOfOpportunity"}}</h4>
                    <div class="quickbar-buttons">
                        <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="attack-of-opportunity" data-label="{{localize "UESRPG.Sheets.Combat.AttackOfOpportunity"}}">
                            <i class="fas fa-crosshairs"></i> {{localize "UESRPG.Sheets.Combat.AttackOfOpportunity"}}
                        </button>
                        <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction" data-combat-action="grapple" data-action-type="reaction" data-label="{{localize "UESRPG.Sheets.Combat.GrappleReaction"}}">
                            {{localize "UESRPG.Sheets.Combat.GrappleReaction"}}
                        </button>
                    </div>
                    <p class="actions-help-small">{{localize "UESRPG.Sheets.Combat.AttackOfOpportunityNpcHelp"}}</p>
                </div>
            </div>
        </div>
        <div class="tab uesrpg-actions-panel" data-group="actions" data-tab="special">
            <div class="uesrpg-actions-card uesrpg-panel uesrpg-panel--alt">
                <div class="quickbar-title">{{localize "UESRPG.Sheets.Combat.Special"}}</div>

                <div class="actions-help u-mb-sm">{{localize "UESRPG.Sheets.Combat.SpecialActionsHelp"}}</div>

                {{#if actor.sheetCombatActions.specialActions.length}}
                    <div class="uesrpg-special-actions-list">
                        {{#each actor.sheetCombatActions.specialActions as |sa|}}
                            <button type="button" class="uesrpg-quick-action" data-action="combatQuickAction"
                                    data-combat-action="specialAction"
                                    data-special-id="{{sa.id}}"
                                    data-action-type="{{sa.actionType}}"
                                    title="{{sa.description}}"
                                    {{#if (eq sa.actionType "primary")}}{{#unless sa.usableNow}}disabled="disabled"{{/unless}}{{/if}}
                            >{{sa.name}}</button>
                        {{/each}}
                    </div>
                {{else}}
                    <div class="actions-help">{{localize "UESRPG.Sheets.Combat.NoSpecialActionsRegistry"}}</div>
                {{/if}}
            </div>
        </div>

    </div>
</div>

{{#if woundsInjuriesUi.enabled}}
<div class="uesrpg-panel uesrpg-panel--subtle uesrpg-wounds-panel">
    <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Wounds.Title"}}</span></div>
    <div class="uesrpg-wounds-table-wrap uesrpg-wounds-table-wrap--compact">
        <table class="uesrpg-wounds-table uesrpg-wounds-table--compact">
            <thead>
                <tr>
                    <th>{{localize "UESRPG.UI.Location"}}</th>
                    <th>{{localize "UESRPG.Sheets.Wounds.Progress"}}</th>
                    <th>{{localize "UESRPG.Sheets.Wounds.State"}}</th>
                    <th class="right-align-cell">{{localize "UESRPG.Sheets.Wounds.Actions"}}</th>
                </tr>
            </thead>
            <tbody>
                {{#if woundsInjuriesUi.hasRows}}
                {{#each woundsInjuriesUi.rows as |row|}}
                <tr class="uesrpg-wounds-row">
                    <td>{{row.hitLocation}}</td>
                    <td>
                        {{#if row.wound}}
                        {{#if row.wound.canEditProgress}}
                        <span class="uesrpg-wounds-progress-inline">
                            <input
                                type="number"
                                min="0"
                                value="{{row.wound.progressInputValue}}"
                                data-wi-action="setProgress"
                                data-effect-id="{{row.wound.id}}"
                                data-wi-progress-input="{{row.wound.id}}"
                                class="uesrpg-wounds-progress-input-plain"
                                title="{{localize "UESRPG.Sheets.Wounds.PressEnterToApply"}}"
                            /> /
                            <input
                                type="number"
                                min="0"
                                value="{{row.wound.damage}}"
                                data-wi-action="setDamage"
                                data-effect-id="{{row.wound.id}}"
                                data-wi-damage-input="{{row.wound.id}}"
                                class="uesrpg-wounds-progress-input-plain"
                                title="{{localize "UESRPG.Sheets.Wounds.PressEnterToApply"}}"
                            />
                        </span>
                        {{else}}
                        {{row.wound.progress}} / {{row.wound.damage}}
                        {{/if}}
                        {{else}}
                        -
                        {{/if}}
                    </td>
                    <td>
                        <div class="uesrpg-wounds-chips">
                            {{#each row.chips as |chip|}}
                            <span class="uesrpg-wound-chip uesrpg-wound-chip--{{chip.tone}}">{{chip.label}}</span>
                            {{/each}}
                        </div>
                    </td>
                    <td class="right-align-cell uesrpg-wounds-actions">
                        <div class="uesrpg-wounds-row-actions">
                            {{#each row.actions as |action|}}
                            <button
                                type="button"
                                class="uesrpg-quick-action uesrpg-quick-action--tiny"
                                data-action="woundsInjuriesControl"
                                data-wi-action="{{action.wiAction}}"
                                data-effect-id="{{action.effectId}}"
                                {{#if action.disabled}}disabled="disabled"{{/if}}
                                {{#if action.title}}title="{{action.title}}"{{/if}}
                            >{{action.label}}</button>
                            {{/each}}
                        </div>
                    </td>
                </tr>
                {{/each}}
                {{else}}
                <tr><td colspan="4" class="actions-help-small">{{localize "UESRPG.Sheets.Wounds.NoneRecorded"}}</td></tr>
                {{/if}}
            </tbody>
        </table>
    </div>
</div>
{{/if}}

{{#if sheetUi.showDiagnostics}}
                        <div class="uesrpg-diagnostics-panel">
                            <div class="diag-row"><span class="diag-label">{{localize "UESRPG.UI.Actor"}}</span><span class="diag-value">{{actor.name}} ({{actor._id}})</span></div>
                            <div class="diag-row"><span class="diag-label">AP</span><span class="diag-value">{{actor.system.action_points.value}} / {{actor.system.action_points.max}}</span></div>
                            <div class="diag-row"><span class="diag-label">{{localize "UESRPG.Sheets.Combat.Quick"}}</span><span class="diag-value">{{#if actor.sheetCombatQuick.meleeWeaponId}}{{localize "UESRPG.UI.Melee"}}={{actor.sheetCombatQuick.meleeWeaponId}}{{/if}} {{#if actor.sheetCombatQuick.rangedWeaponId}}{{localize "UESRPG.UI.Ranged"}}={{actor.sheetCombatQuick.rangedWeaponId}}{{/if}}</span></div>
                        </div>
                    {{/if}}

                </div>
            </div>
