            <div class="tab magic" data-group="primary" data-tab="magic">
                <div class="magicTabContainer">
                    <div class="magicSkillContainer">
                        <div class="section-header">
                            <span class="section-header__label">Magic Skills</span>
                            <button type="button" data-action="itemCreate" class="section-header__action" id="magicSkill">+</button>
                        </div>
                        <ol class="skillList">
                            {{#each actor.magicSkill as |item|}}
                                <li class="item" data-item-id="{{item._id}}">
                                    <div class="itemInfo skill-roll-target" data-action="skillRoll" role="button" tabindex="0">
                                        <img class="item-img" src="{{item.img}}" data-action="itemOpen" title="Open Item"/>
                                        <div class="item-name skill-open-item" data-action="itemOpen">
                                            {{item.name}}
                                        </div>
                                    </div>
                                    <div class="item-controls">
                                        <div class="item-value">{{item.system.value}}%</div>
                                        <a data-action="itemDelete" class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
                                    </div>
                                </li>
                            {{/each}}
                            {{#unless actor.magicSkill.length}}
                                <li>No magic skills trained.</li>
                            {{/unless}}
                        </ol>
                    </div>

                    {{#if actor.ui.worship.enabled}}
                    <div class="spellListContainer">
                        <div class="section-header" style="justify-content:flex-end;">
                            <button type="button" data-action="itemCreate" class="section-header__action" id="invocation">+</button>
                        </div>
                        <div class="spellList">
                            {{#each actor.invocationGroups as |group|}}
                                <div class="spell-school-section" data-school="{{group.key}}">
                                    <h3 class="spell-school-header uesrpg-group-toggle" data-action="groupToggle" data-group="invocation-group-{{group.key}}">
                                        <i class="fas fa-chevron-down collapse-arrow"></i>
                                        <span class="school-name">{{group.label}}</span>
                                        <span class="school-count">({{group.count}})</span>
                                    </h3>
                                    <table class="spell-school-table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Circle</th>
                                                <th>PP Cost</th>
                                                <th><i class="fas fa-trash"></i></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each group.invocations as |invocation|}}
                                                <tr class="spell-row item active" data-item-id="{{invocation._id}}">
                                                    <td class="spell-name-cell">
                                                        <i class="fas fa-dice-d20 magic-roll" data-action="castInvocation" title="Invoke Rite"></i>
                                                        <img class="item-img" src="{{invocation.img}}" data-action="itemOpen" />
                                                        <span class="item-name" data-action="itemOpen">{{invocation.name}}</span>
                                                    </td>
                                                    <td class="spell-rank-cell">Circle {{invocation.system.circle}}</td>
                                                    <td class="spell-mp-cell">{{invocation.system.pietyCost}}</td>
                                                    <td class="spell-actions-cell">
                                                        <a class="item-delete" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
                                                    </td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                </div>
                            {{/each}}
                            {{#unless actor.invocationGroups.length}}
                                <p>No invocations known.</p>
                            {{/unless}}
                        </div>
                    </div>
                    {{/if}}

                    <div class="spellListContainer">
                        <div class="spellList">
                            {{!-- Spell schools organized by category (matching PC sheet) --}}
                            {{#each actor.spellSchools as |schoolData|}}
                                <div class="spell-school-section" data-school="{{schoolData.key}}">
                                    <h3 class="spell-school-header uesrpg-group-toggle" data-action="groupToggle" data-group="spell-school-{{schoolData.key}}">
                                        <i class="fas fa-chevron-down collapse-arrow"></i>
                                        <span class="school-name">{{schoolData.label}}</span>
                                        <span class="school-count">({{schoolData.count}})</span>
                                        <span class="npc-school-rank" onclick="event.stopPropagation();">
                                            <label class="sr-only">Effective Rank</label>
                                            <select name="flags.uesrpg-3ev4.npcMagicSchoolRanks.{{schoolData.key}}" class="npc-school-rank-select">
                                                {{selectOptions @root.actor.ui.npcMagicRankOptions selected=schoolData.effectiveRank}}
                                            </select>
                                        </span>
                                    </h3>
                                    <table class="spell-school-table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Rank</th>
                                                <th>MP Cost</th>
                                                <th><i class="fas fa-trash"></i></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each schoolData.spells as |spell|}}
                                                <tr class="spell-row item active" data-item-id="{{spell._id}}">
                                                    <td class="spell-name-cell">
                                                        <i class="fas fa-dice-d20 magic-roll" data-action="magicRoll" title="Cast Spell (Left-click) / Post Description (Right-click)"></i>
                                                        <img class="item-img" src="{{spell.img}}" data-action="itemOpen" />
                                                        <span class="item-name" data-action="itemOpen">{{spell.name}}</span>
                                                    </td>
                                                    <td class="spell-rank-cell">
                                                        {{#if (eq spell.system.level 1)}}Novice{{/if}}
                                                        {{#if (eq spell.system.level 2)}}Apprentice{{/if}}
                                                        {{#if (eq spell.system.level 3)}}Adept{{/if}}
                                                        {{#if (eq spell.system.level 4)}}Expert{{/if}}
                                                        {{#if (eq spell.system.level 5)}}Master{{/if}}
                                                        {{#if (eq spell.system.level 6)}}Grandmaster{{/if}}
                                                        {{#if (eq spell.system.level 7)}}Legendary{{/if}}
                                                    </td>
                                                    <td class="spell-mp-cell">{{spell.system.cost}}</td>
                                                    <td class="spell-actions-cell">
                                                        <a class="item-delete" data-action="itemDelete" title="Delete"><i class="fas fa-trash"></i></a>
                                                    </td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                </div>
                            {{/each}}
                        </div>
                    </div>

                    {{!-- Active Effects are shown on the Items tab. --}}
                </div>
            </div>
