{{!-- Trait Sheet вЂ” Compact Layout --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="Name"/>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">Description</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
    {{#if enableRuleElements}}<a class="item" data-action="tab" data-group="primary" data-tab="automation">Automation</a>{{/if}}
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">Effects</a>
</nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">
    
            {{!-- Description Tab --}}
            <div class="tab" data-group="primary" data-tab="description">
                {{editor item.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
            </div>
    
            {{!-- Attributes Tab --}}
            <div class="tab" data-group="primary" data-tab="attributes">
                <div class="attribute-tab-container compact-attrs">

                    {{!-- Flags в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ --}}
                    <fieldset class="attr-fieldset">
                        <legend>Flags</legend>
                        <div class="attr-checkbox-grid">
                            <label><input class="checkbox" type="checkbox" name="system.mechanical" {{checked item.system.mechanical}}> Mechanical</label>
                            <label><input class="checkbox" type="checkbox" name="system.halfFatiguePenalty" {{checked item.system.halfFatiguePenalty}}> ВЅ Fatigue Penalty</label>
                            <label><input class="checkbox" type="checkbox" name="system.halfWoundPenalty" {{checked item.system.halfWoundPenalty}}> ВЅ Wound Penalty</label>
                            <label><input class="checkbox" type="checkbox" name="system.painIntolerant" {{checked item.system.painIntolerant}}> Wound Penalty в†’-30</label>
                            <label><input class="checkbox" type="checkbox" name="system.halfSpeed" {{checked item.system.halfSpeed}}> ВЅ Speed</label>
                            <label><input class="checkbox" type="checkbox" name="system.addHalfSpeed" {{checked item.system.addHalfSpeed}}> Add ВЅ Speed</label>
                        </div>
                        <div class="activation-sub-heading u-mt-sm">Structured Data (Optional)</div>
                        <div class="attr-struct-grid">
                            <label>Key <input type="text" name="system.traitKey" value="{{item.system.traitKey}}" placeholder="e.g., resistance.fire" /></label>
                            <label>Param <input type="text" name="system.traitParam" value="{{item.system.traitParam}}" placeholder="e.g., Fire" /></label>
                            <label>Value <input type="number" name="system.traitValue" value="{{item.system.traitValue}}" step="1" /></label>
                            <label>Unit <input type="text" name="system.traitUnit" value="{{item.system.traitUnit}}" placeholder="%, flat" /></label>
                        </div>
                        <div class="attr-struct-grid u-mt-xs">
                            <label class="u-grid-span-full">Notes <input type="text" name="system.traitNotes" value="{{item.system.traitNotes}}" /></label>
                        </div>
                    </fieldset>

                    {{!-- Characteristics + Resistances + Stats в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ --}}
                    <div class="attr-three-col">
                        <fieldset class="attr-fieldset">
                            <legend>Characteristics</legend>
                            {{#if item.system.characteristicBonus}}
                            <div class="attr-stat-grid">
                                <label>STR <input type="number" name="system.characteristicBonus.strChaBonus" value="{{#if item.system.characteristicBonus.strChaBonus}}{{item.system.characteristicBonus.strChaBonus}}{{else}}0{{/if}}"></label>
                                <label>END <input type="number" name="system.characteristicBonus.endChaBonus" value="{{#if item.system.characteristicBonus.endChaBonus}}{{item.system.characteristicBonus.endChaBonus}}{{else}}0{{/if}}"></label>
                                <label>AGI <input type="number" name="system.characteristicBonus.agiChaBonus" value="{{#if item.system.characteristicBonus.agiChaBonus}}{{item.system.characteristicBonus.agiChaBonus}}{{else}}0{{/if}}"></label>
                                <label>INT <input type="number" name="system.characteristicBonus.intChaBonus" value="{{#if item.system.characteristicBonus.intChaBonus}}{{item.system.characteristicBonus.intChaBonus}}{{else}}0{{/if}}"></label>
                                <label>WP  <input type="number" name="system.characteristicBonus.wpChaBonus"  value="{{#if item.system.characteristicBonus.wpChaBonus}}{{item.system.characteristicBonus.wpChaBonus}}{{else}}0{{/if}}"></label>
                                <label>PRC <input type="number" name="system.characteristicBonus.prcChaBonus" value="{{#if item.system.characteristicBonus.prcChaBonus}}{{item.system.characteristicBonus.prcChaBonus}}{{else}}0{{/if}}"></label>
                                <label>PRS <input type="number" name="system.characteristicBonus.prsChaBonus" value="{{#if item.system.characteristicBonus.prsChaBonus}}{{item.system.characteristicBonus.prsChaBonus}}{{else}}0{{/if}}"></label>
                                <label>LCK <input type="number" name="system.characteristicBonus.lckChaBonus" value="{{#if item.system.characteristicBonus.lckChaBonus}}{{item.system.characteristicBonus.lckChaBonus}}{{else}}0{{/if}}"></label>
                            </div>
                            {{else}}
                            <div class="attr-empty-hint">No characteristic bonuses</div>
                            {{/if}}
                        </fieldset>
                        <fieldset class="attr-fieldset">
                            <legend>Resistances</legend>
                            <div class="attr-stat-grid">
                                <label>Disease   <input type="number" name="system.diseaseR"      value="{{#if item.system.diseaseR}}{{item.system.diseaseR}}{{else}}0{{/if}}"></label>
                                <label>Fire      <input type="number" name="system.fireR"         value="{{#if item.system.fireR}}{{item.system.fireR}}{{else}}0{{/if}}"></label>
                                <label>Frost     <input type="number" name="system.frostR"        value="{{#if item.system.frostR}}{{item.system.frostR}}{{else}}0{{/if}}"></label>
                                <label>Shock     <input type="number" name="system.shockR"        value="{{#if item.system.shockR}}{{item.system.shockR}}{{else}}0{{/if}}"></label>
                                <label>Poison    <input type="number" name="system.poisonR"       value="{{#if item.system.poisonR}}{{item.system.poisonR}}{{else}}0{{/if}}"></label>
                                <label>Magic     <input type="number" name="system.magicR"        value="{{#if item.system.magicR}}{{item.system.magicR}}{{else}}0{{/if}}"></label>
                                <label>Toughness <input type="number" name="system.natToughnessR" value="{{#if item.system.natToughnessR}}{{item.system.natToughnessR}}{{else}}0{{/if}}"></label>
                                <label>Silver    <input type="number" name="system.silverR"       value="{{#if item.system.silverR}}{{item.system.silverR}}{{else}}0{{/if}}"></label>
                                <label>Sunlight  <input type="number" name="system.sunlightR"     value="{{#if item.system.sunlightR}}{{item.system.sunlightR}}{{else}}0{{/if}}"></label>
                            </div>
                        </fieldset>
                        <fieldset class="attr-fieldset">
                            <legend>Stats</legend>
                            <div class="attr-stat-grid">
                                <label>HP+   <input type="number" name="system.hpBonus"    value="{{#if item.system.hpBonus}}{{item.system.hpBonus}}{{else}}0{{/if}}"></label>
                                <label>SP+   <input type="number" name="system.spBonus"    value="{{#if item.system.spBonus}}{{item.system.spBonus}}{{else}}0{{/if}}"></label>
                                <label>MP+   <input type="number" name="system.mpBonus"    value="{{#if item.system.mpBonus}}{{item.system.mpBonus}}{{else}}0{{/if}}"></label>
                                <label>LP+   <input type="number" name="system.lpBonus"    value="{{#if item.system.lpBonus}}{{item.system.lpBonus}}{{else}}0{{/if}}"></label>
                                <label>WT+   <input type="number" name="system.wtBonus"    value="{{#if item.system.wtBonus}}{{item.system.wtBonus}}{{else}}0{{/if}}"></label>
                                <label>INI+  <input type="number" name="system.iniBonus"   value="{{#if item.system.iniBonus}}{{item.system.iniBonus}}{{else}}0{{/if}}"></label>
                                <label>Spd+  <input type="number" name="system.speedBonus" value="{{#if item.system.speedBonus}}{{item.system.speedBonus}}{{else}}0{{/if}}"></label>
                                <label>Swim+ <input type="number" name="system.swimBonus"  value="{{#if item.system.swimBonus}}{{item.system.swimBonus}}{{else}}0{{/if}}"></label>
                                <label>Fly+  <input type="number" name="system.flyBonus"   value="{{#if item.system.flyBonus}}{{item.system.flyBonus}}{{else}}0{{/if}}"></label>
                            </div>
                        </fieldset>
                    </div>

                    {{!-- Activation в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ --}}
                    <fieldset class="attr-fieldset">
                        <legend>Activation</legend>
                        <div class="activation-compact">
                            <div class="activation-row">
                                <label title="If enabled, using this trait posts an activation card and spends costs">
                                    <input class="checkbox" type="checkbox" name="system.activation.enabled" {{checked item.system.activation.enabled}}>
                                    Activated
                                </label>
                                <label>
                                    Action
                                    <select name="system.activation.actionType" data-type="String">
                                        {{selectOptions traitActionTypeOptions selected=item.system.activation.actionType localize=false}}
                                    </select>
                                </label>
                                <label title="Deduct configured costs on use">
                                    <input class="checkbox" type="checkbox" name="system.activation.spendCosts" {{checked item.system.activation.spendCosts}}>
                                    Spend Costs
                                </label>
                                <label title="Consume one use from Usage tracker">
                                    <input class="checkbox" type="checkbox" name="system.activation.consumeUse" {{checked item.system.activation.consumeUse}}>
                                    Consume Use
                                </label>
                            </div>

                            <div class="activation-sub-heading">Requirements</div>
                            <div class="activation-row">
                                <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresTarget" {{checked item.system.activation.requirements.requiresTarget}}> Target</label>
                                <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresEquippedWeapon" {{checked item.system.activation.requirements.requiresEquippedWeapon}}> Equipped Weapon</label>
                                <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresMelee" {{checked item.system.activation.requirements.requiresMelee}}> Melee</label>
                                <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresRanged" {{checked item.system.activation.requirements.requiresRanged}}> Ranged</label>
                                <label><input class="checkbox" type="checkbox" name="system.activation.requirements.requiresHitLocation" {{checked item.system.activation.requirements.requiresHitLocation}}> Hit Location</label>
                            </div>

                            <div class="activation-sub-heading">NPC Flags</div>
                            <div class="activation-row">
                                <label><input class="checkbox" type="checkbox" name="system.activation.flags.npcLuckAllowed" {{checked item.system.activation.flags.npcLuckAllowed}}> Allow NPC Luck</label>
                                <label><input class="checkbox" type="checkbox" name="system.activation.flags.npcEliteAllowed" {{checked item.system.activation.flags.npcEliteAllowed}}> Allow NPC Heroic</label>
                            </div>

                            <div class="activation-sub-heading">Attack</div>
                            <div class="activation-row">
                                <label>
                                    Is Attack?
                                    <select name="system.activation.roll.mode" data-type="String">
                                        <option value="none" {{#if (eq item.system.activation.roll.mode "none")}}selected{{/if}}>No</option>
                                        <option value="attack" {{#if (eq item.system.activation.roll.mode "attack")}}selected{{/if}}>Yes</option>
                                    </select>
                                </label>
                                {{#if (eq item.system.activation.roll.mode "attack")}}
                                <label>
                                    Hit Loc Mode
                                    <select name="system.activation.roll.hitLocationMode" data-type="String">
                                        {{selectOptions activationHitLocationModeOptions selected=item.system.activation.roll.hitLocationMode localize=false}}
                                    </select>
                                </label>
                                {{/if}}
                            </div>

                            <div class="activation-sub-heading">Damage / Healing</div>
                            <div class="activation-row">
                                <label>
                                    Mode
                                    <select name="system.activation.damage.mode" data-type="String">
                                        {{selectOptions activationDamageModeOptions selected=item.system.activation.damage.mode localize=false}}
                                    </select>
                                </label>
                                {{#if (eq item.system.activation.damage.mode "manual")}}
                                <label>
                                    Formula
                                    <input type="text" name="system.activation.damage.formula" value="{{item.system.activation.damage.formula}}" placeholder="e.g., 1d8+2" />
                                </label>
                                <label>
                                    Type
                                    <select name="system.activation.damage.type" data-type="String">
                                        {{selectOptions activationDamageTypeOptions selected=item.system.activation.damage.type localize=false}}
                                    </select>
                                </label>
                                {{/if}}
                                {{#if (eq item.system.activation.damage.mode "healing")}}
                                <label>
                                    Formula
                                    <input type="text" name="system.activation.damage.formula" value="{{item.system.activation.damage.formula}}" placeholder="e.g., 1d8+2" />
                                </label>
                                {{/if}}
                                {{#if (eq item.system.activation.damage.mode "temporary")}}
                                <label>
                                    Formula
                                    <input type="text" name="system.activation.damage.formula" value="{{item.system.activation.damage.formula}}" placeholder="e.g., 1d6+1" />
                                </label>
                                {{/if}}
                            </div>
                            {{#if (eq item.system.activation.damage.mode "manual")}}
                            <div class="u-mt-xs">
                                <div class="u-text-bold u-mb-sm u-text-xs">Damage Qualities</div>
                                <input type="hidden" name="activationDamageQualities.present" value="1" />
                                <div class="structured-qualities-grid">
                                    {{#each activationDamageQualitiesCatalog}}
                                        <div class="structured-qualities-cell">
                                            <div>{{this.label}}</div>
                                            <div class="right-align-content">
                                                {{#if this.optionalValue}}
                                                    <div class="structured-optional-value">
                                                        <input class="checkbox" type="checkbox" name="activationDamageQualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../activationDamageSelectedToggle this.key)}} />
                                                        <input class="structured-value structured-value--opt" type="number" name="activationDamageQualitiesStructured.value.{{this.key}}" value="{{lookup ../activationDamageSelectedValue this.key}}" min="0" step="1" placeholder="X" />
                                                    </div>
                                                {{else}}
                                                    {{#if this.hasValue}}
                                                        <input class="structured-value" type="number" name="activationDamageQualitiesStructured.value.{{this.key}}" value="{{lookup ../activationDamageSelectedValue this.key}}" min="0" step="1" />
                                                    {{else}}
                                                        <input class="checkbox" type="checkbox" name="activationDamageQualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../activationDamageSelectedToggle this.key)}} />
                                                    {{/if}}
                                                {{/if}}
                                            </div>
                                        </div>
                                    {{/each}}
                                </div>
                                <div class="structured-traits-block u-mt-sm">
                                    <div class="structured-traits-label">Other Traits</div>
                                    <div class="structured-traits-pills">
                                        {{#each activationDamageTraitsCatalog}}
                                            <label class="uesrpg-pill {{#if this.selected}}is-selected{{/if}}">
                                                <input type="checkbox" name="activationDamageQualitiesTraits.toggle.{{this.key}}" {{checked this.selected}} />
                                                <span>{{this.label}}</span>
                                            </label>
                                        {{/each}}
                                    </div>
                                </div>
                            </div>
                            {{/if}}

                            <div class="activation-sub-heading">Costs &amp; Usage</div>
                            <div class="activation-costs-grid">
                                <label>AP <input type="number" name="system.activation.costs.action_points" value="{{item.system.activation.costs.action_points}}" min="0" step="1" /></label>
                                <label>SP <input type="number" name="system.activation.costs.stamina" value="{{item.system.activation.costs.stamina}}" min="0" step="1" /></label>
                                <label>MP <input type="number" name="system.activation.costs.magicka" value="{{item.system.activation.costs.magicka}}" min="0" step="1" /></label>
                                <label>LP <input type="number" name="system.activation.costs.luck_points" value="{{item.system.activation.costs.luck_points}}" min="0" step="1" /></label>
                                <label>HP <input type="number" name="system.activation.costs.health" value="{{item.system.activation.costs.health}}" min="0" step="1" /></label>
                            </div>
                            <div class="activation-costs-grid u-mt-xs">
                                <label>Current <input type="number" name="system.activation.usage.current" value="{{item.system.activation.usage.current}}" min="0" step="1" /></label>
                                <label>Max <input type="number" name="system.activation.usage.max" value="{{item.system.activation.usage.max}}" min="0" step="1" /></label>
                                <label>Reset
                                    <select name="system.activation.usage.period" data-type="String">
                                        {{selectOptions activationUsagePeriodOptions selected=item.system.activation.usage.period localize=false}}
                                    </select>
                                </label>
                                <div class="activation-use-btn-wrap">
                                    <button type="button" class="uesrpg-trait-use" data-action="traitUse"><i class="fas fa-bolt"></i> Use</button>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>

        {{!-- Automation Tab --}}
        {{#if enableRuleElements}}
        <div class="tab" data-group="primary" data-tab="automation">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/automation-tab.hbs"}}
        </div>
        {{/if}}

        {{!-- Effects Tab --}}
        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>
    </section>

