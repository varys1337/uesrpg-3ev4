  <section class="sheet-body">

    {{!-- Tab 1 - Overview --}}
    <div class="tab" data-group="primary" data-tab="description">
      <div class="spell-casting-body spell-casting-body--overview">
        <section class="spell-section spell-section--editor">
          <div class="item-description-container">
            <div class="basic-padding">
              <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
            </div>
          </div>
        </section>
      </div>
    </div>

    {{!-- Tab 2 - Casting --}}
    <div class="tab" data-group="primary" data-tab="casting">
      <div class="spell-casting-body">

        <section class="spell-section spell-section--hero">
          <h4 class="spell-section-title">{{localize "UESRPG.Chat.Magic.Casting"}}</h4>
          <div class="spell-subtab-body">
              <div class="spell-row spell-row-checks spell-row-checks--cluster">
                <label class="spell-check"><input type="checkbox" name="system.isAttackSpell" {{checked item.system.isAttackSpell}} /> {{localize "UESRPG.ModernUI.AttackSpell"}}</label>
                <label class="spell-check"><input type="checkbox" name="system.isInstant" {{checked item.system.isInstant}} /> {{localize "UESRPG.Dialogs.AlchemyWorkshop.Instant"}}</label>
                <label class="spell-check"><input type="checkbox" name="system.hasUpkeep" {{checked item.system.hasUpkeep}} data-spell-structure /> {{localize "UESRPG.Spells.Attributes.upkeep.Label"}}</label>
                <label class="spell-check"><input type="checkbox" name="system.hasOverload" {{checked item.system.hasOverload}} data-spell-structure /> {{localize "UESRPG.Dialogs.SpellOptions.Overload"}}</label>
                <label class="spell-check"><input type="checkbox" name="system.hasReinforce" {{checked item.system.hasReinforce}} data-spell-structure /> {{localize "UESRPG.ModernUI.Reinforce"}}</label>
                {{#if canConfigureAlchemyEffectTags}}
                  <label class="spell-check"><input type="checkbox" name="flags.uesrpg-3ev4.alchemyEffect.potion" {{checked alchemyEffectFlags.potion}} data-spell-autosave /> {{localize "UESRPG.Sheets.Item.AlchemyKind.Potion"}}</label>
                  <label class="spell-check"><input type="checkbox" name="flags.uesrpg-3ev4.alchemyEffect.toxin" {{checked alchemyEffectFlags.toxin}} data-spell-autosave /> {{localize "UESRPG.Sheets.Item.AlchemyKind.Toxin"}}</label>
                {{/if}}
              </div>

              {{#if item.system.hasOverload}}
              <fieldset class="spell-fieldset">
                <legend>{{localize "UESRPG.Dialogs.SpellOptions.Overload"}}</legend>
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.UI.Effect"}}</label>
                  <input type="text" name="system.overloadEffect" value="{{item.system.overloadEffect}}" placeholder="{{localize "UESRPG.Placeholders.OverloadEffect"}}" class="spell-input spell-input-fill" />
                </div>
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.ModernUI.BonusDmg"}}</label>
                  <input type="text" name="system.overloadBonusDamage" value="{{item.system.overloadBonusDamage}}" placeholder="{{localize "UESRPG.Placeholders.OverloadBonusDamage"}}" class="spell-input spell-input-sm" />
                </div>
              </fieldset>
              {{/if}}

              {{#if item.system.hasReinforce}}
              <fieldset class="spell-fieldset">
                <legend>{{localize "UESRPG.ModernUI.Reinforce"}}</legend>
                <div class="spell-row">
                  <input type="text" name="system.reinforceDescription" value="{{item.system.reinforceDescription}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Placeholders.ReinforceMechanics"}}" />
                </div>
              </fieldset>
              {{/if}}
            </div>
        </section>

        {{!-- Targeting & range + duration --}}
        <div class="spell-2col-grid">

        {{!-- Targeting & range --}}
        <section class="spell-section">
          <h4 class="spell-section-title">{{localize "UESRPG.ModernUI.TargetingRange"}}</h4>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.ModernUI.TargetMode"}}</label>
            <select name="system.engine.targeting.mode" class="spell-input spell-input-med" data-spell-structure>
              {{selectOptions targetingModeOptions selected=spellEngine.targeting.mode}}
            </select>
            {{#if (eq spellEngine.targeting.mode "multi")}}
            <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.Item.Max"}}</label>
            <input type="number" name="system.engine.targeting.maxTargets" value="{{spellEngine.targeting.maxTargets}}" min="1" class="spell-input spell-input-xs" />
            {{/if}}
          </div>
          <div class="spell-row">
            <label class="spell-label spell-label-sm">{{localize "UESRPG.UI.Range"}}</label>
            <input type="text" name="system.range" value="{{item.system.range}}" placeholder="{{localize "UESRPG.Sheets.Feature.RangePlaceholder"}}" class="spell-input spell-input-sm" />
          </div>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.Chat.Opposed.Defense"}}</label>
            <select name="system.engine.defenseModel" class="spell-input spell-input-fill" data-spell-structure>
              {{selectOptions defenseModelOptions selected=selectedDefenseModel}}
            </select>
          </div>

          {{#if (eq selectedDefenseModel "characteristic")}}
          <fieldset class="spell-fieldset">
            <legend>{{localize "UESRPG.ModernUI.CharacteristicDefense"}}</legend>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.ModernUI.DefenderCHA"}}</label>
              <select name="system.engine.characteristicDefense.defenderCharacteristic" class="spell-input spell-input-med">
                {{selectOptions bindingCharacteristicOptions selected=spellEngine.characteristicDefense.defenderCharacteristic}}
              </select>
            </div>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.ModernUI.TNModifier"}}</label>
              <select name="system.engine.characteristicDefense.modifierMode" class="spell-input spell-input-sm" data-spell-structure>
                {{selectOptions charDefModifierModeOptions selected=spellEngine.characteristicDefense.modifierMode}}
              </select>
              {{#if (eq spellEngine.characteristicDefense.modifierMode "formula")}}
              <input type="number" name="system.engine.characteristicDefense.modifierFormula"
                     value="{{spellEngine.characteristicDefense.modifierFormula}}"
                     class="spell-input spell-input-sm" placeholder="{{localize "UESRPG.Placeholders.CharacteristicDefenseModifier"}}" />
              {{/if}}
            </div>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.ModernUI.OnSuccess"}}</label>
              <select name="system.engine.characteristicDefense.onSuccess" class="spell-input spell-input-med">
                {{selectOptions charDefSuccessOptions selected=spellEngine.characteristicDefense.onSuccess}}
              </select>
            </div>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.ModernUI.OnFailure"}}</label>
              <select name="system.engine.characteristicDefense.onFailure" class="spell-input spell-input-med" data-spell-structure>
                {{selectOptions charDefFailureOptions selected=spellEngine.characteristicDefense.onFailure}}
              </select>
            </div>
            <p class="spell-hint">{{localize "UESRPG.ModernUI.TNDefenderSCharacteristicModifierSpellStrengthUsesTheCastResolvedStrengt"}}</p>
          </fieldset>

          {{#if (eq spellEngine.characteristicDefense.onFailure "consequences")}}
          <fieldset class="spell-fieldset">
            <legend>{{localize "UESRPG.ModernUI.ConsequencesOnFailedSave"}}</legend>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.ModernUI.StaminaDelta"}}</label>
              <input type="number" name="system.engine.consequences.staminaDelta"
                     value="{{spellEngine.consequences.staminaDelta}}"
                     class="spell-input spell-input-xs" />
              <label class="spell-label spell-label--offset">{{localize "UESRPG.ModernUI.HealthDelta"}}</label>
              <input type="number" name="system.engine.consequences.healthDelta"
                     value="{{spellEngine.consequences.healthDelta}}"
                     class="spell-input spell-input-xs" />
              <label class="spell-label spell-label--offset">{{localize "UESRPG.ModernUI.MagickaDelta"}}</label>
              <input type="number" name="system.engine.consequences.magickaDelta"
                     value="{{spellEngine.consequences.magickaDelta}}"
                     class="spell-input spell-input-xs" />
            </div>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.ActiveEffects.Badges.Condition"}}</label>
              <select name="system.engine.consequences.applyCondition" class="spell-input spell-input-med">
                {{selectOptions consequenceConditionOptions selected=spellEngine.consequences.applyCondition}}
              </select>
            </div>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.UI.Description"}}</label>
              <input type="text" name="system.engine.consequences.description"
                     value="{{spellEngine.consequences.description}}"
                     class="spell-input" placeholder="{{localize "UESRPG.Placeholders.FlavourText"}}" />
            </div>
            <p class="spell-hint">{{localize "UESRPG.ModernUI.UseNegativeValuesForDrainsEG10SPAppliedWhenTheDefenderFailsTheCharacteri"}}</p>
          </fieldset>
          {{/if}}
          {{/if}}

          {{#if (eq spellEngine.targeting.mode "template")}}
          <fieldset class="spell-fieldset">
            <legend>{{localize "UESRPG.Apps.CombatSettings.Sections.AreaOfEffect"}}</legend>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.Sheets.Feature.Shape"}}</label>
              <select name="system.aoeShape" class="spell-input spell-input-med">
                <option value="circle" {{#if (eq item.system.aoeShape "circle")}}selected{{/if}}>{{localize "UESRPG.ModernUI.CircleRadius"}}</option>
                <option value="cone" {{#if (eq item.system.aoeShape "cone")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.AoeShape.Cone"}}</option>
                <option value="ray" {{#if (eq item.system.aoeShape "ray")}}selected{{/if}}>{{localize "UESRPG.ModernUI.RayLine"}}</option>
                <option value="rect" {{#if (eq item.system.aoeShape "rect")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Rectangle"}}</option>
                <option value="pulse" {{#if (eq item.system.aoeShape "pulse")}}selected{{/if}}>{{localize "UESRPG.ModernUI.PulseCasterCentered"}}</option>
              </select>
            </div>
            <div class="spell-row">
              <label class="spell-label">{{localize "UESRPG.Sheets.Feature.SizeMeters"}}</label>
              <input type="number" name="system.aoeSize" value="{{item.system.aoeSize}}" min="0" step="0.5" class="spell-input spell-input-sm" />
              <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.Feature.WidthMeters"}}</label>
              <input type="number" name="system.aoeWidth" value="{{item.system.aoeWidth}}" min="0" step="0.5" class="spell-input spell-input-sm" />
            </div>
            <div class="spell-row spell-row-checks">
              <label class="spell-check"><input type="checkbox" name="system.aoePulse" {{checked item.system.aoePulse}} /> {{localize "UESRPG.Sheets.Feature.AoeShape.Pulse"}}</label>
              <label class="spell-check"><input type="checkbox" name="system.aoeIncludeCaster" {{checked item.system.aoeIncludeCaster}} /> {{localize "UESRPG.Sheets.Feature.AffectCaster"}}</label>
            </div>
          </fieldset>
          {{/if}}
        </section>

        {{!-- Duration & persistence --}}
        <section class="spell-section">
          <h4 class="spell-section-title">{{localize "UESRPG.ModernUI.DurationPersistence"}}</h4>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.UI.Duration"}}</label>
            {{#unless (or (eq item.system.duration.unit "instant") (eq item.system.duration.unit "permanent"))}}
              <input type="number" name="system.duration.value" value="{{item.system.duration.value}}" min="0" class="spell-input spell-input-xs" />
            {{/unless}}
            <select name="system.duration.unit" class="spell-input spell-input-med" data-spell-structure>
              {{selectOptions item.system.duration.units selected=item.system.duration.unit}}
            </select>
          </div>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.ModernUI.Mindlock"}}</label>
            <input type="number" name="system.mindlockValue" value="{{item.system.mindlockValue}}" min="0" class="spell-input spell-input-xs" />
          </div>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.ModernUI.DispelStr"}}</label>
            <select name="system.engine.persistence.dispelStrength" class="spell-input spell-input-med" data-spell-structure>
              {{selectOptions dispelStrengthOptions selected=spellEngine.persistence.dispelStrength}}
            </select>
            {{#if (eq spellEngine.persistence.dispelStrength "fixed")}}
            <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.Feature.Value"}}</label>
            <input type="number" name="system.engine.persistence.dispelFixedValue" value="{{spellEngine.persistence.dispelFixedValue}}" min="0" class="spell-input spell-input-xs" />
            {{/if}}
          </div>

          {{#if item.system.hasUpkeep}}
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.Spells.Attributes.upkeep.Label"}}</label>
            <span class="spell-status-ok"><i class="fas fa-check-circle"></i> {{localize "UESRPG.ModernUI.AutoPromptRenewal"}}</span>
          </div>
          {{/if}}
        </section>

        </div>{{!-- /.spell-2col-grid --}}

        {{!-- Scaling levels --}}
        <details class="spell-details-section" data-uesrpg="scaling-levels">
          <summary class="spell-details-summary">
            <i class="fas fa-chevron-right spell-details-caret" aria-hidden="true"></i>
            <span class="spell-details-title">{{localize "UESRPG.ModernUI.ScalingLevels"}}</span>
            <span class="spell-details-badge">{{item.system.scaling.levels.length}}</span>
          </summary>
          <div class="spell-details-actions">
            <button class="spell-btn-inline add-scaling-level uesrpg-styled-action" type="button" data-action="addScalingLevel" data-tooltip-text="{{localize 'UESRPG.Sheets.Spell.AddScalingLevel'}}" {{#unless @root.editable}}disabled{{/unless}} aria-label="{{localize 'UESRPG.Sheets.Spell.AddScalingLevel'}}">
              <i class="fas fa-plus" aria-hidden="true"></i> {{localize "UESRPG.Sheets.Spell.Add"}}
            </button>
          </div>
          <div class="spell-details-body">
          {{#if item.system.scaling.levels.length}}
          <div class="spell-table-scroll">
            <table class="spell-table">
              <colgroup>
                <col class="spell-col-known" />
                <col class="spell-col-level" />
                <col class="spell-col-cost" />
                <col class="spell-col-strength" />
                <col class="spell-col-damage-type" />
                <col class="spell-col-duration" />
                <col class="spell-col-action" />
              </colgroup>
              <thead>
                <tr>
                  <th class="spell-th-known">{{localize "UESRPG.ModernUI.Known"}}</th>
                  <th class="spell-th-level">{{localize "UESRPG.ModernUI.Lvl"}}</th>
                  <th class="spell-th-cost">{{localize "UESRPG.UI.MP"}}</th>
                  <th class="spell-th-strength">{{localize "UESRPG.UI.Strength"}}</th>
                  <th class="spell-th-damage-type">{{localize "UESRPG.Sheets.Feature.Type"}}</th>
                  <th class="spell-th-duration">{{localize "UESRPG.UI.Duration"}}</th>
                  <th class="spell-th-action"></th>
                </tr>
              </thead>
              <tbody>
                {{#each item.system.scaling.levels as |scalingEntry idx|}}
                <tr data-index="{{idx}}">
                  <td class="spell-td-known">
                    <input type="checkbox" name="system.scaling.levels.{{idx}}.known" {{checked scalingEntry.known}} data-scaling-input="true" data-tooltip-text="{{localize "UESRPG.ModernUI.KnownAtThisLevel"}}" aria-label="{{localize "UESRPG.Sheets.Spell.KnownAtLevel" level=scalingEntry.level}}" {{#unless @root.editable}}disabled{{/unless}} />
                  </td>
                  <td class="spell-td-level"><input type="number" name="system.scaling.levels.{{idx}}.level" value="{{scalingEntry.level}}" min="1" max="7" class="spell-table-input spell-table-input-narrow" data-dtype="Number" data-scaling-input="true" {{#unless @root.editable}}disabled{{/unless}} /></td>
                  <td class="spell-td-cost"><input type="number" name="system.scaling.levels.{{idx}}.cost" value="{{scalingEntry.cost}}" min="0" class="spell-table-input spell-table-input-narrow" data-dtype="Number" data-scaling-input="true" {{#unless @root.editable}}disabled{{/unless}} /></td>
                  <td class="spell-td-strength"><input type="text" name="system.scaling.levels.{{idx}}.spellStrengthFormula" value="{{scalingEntry.spellStrengthFormula}}" placeholder="{{localize "UESRPG.ModernUI.BlankWB"}}" class="spell-table-input" data-dtype="String" data-scaling-input="true" {{#unless @root.editable}}disabled{{/unless}} /></td>
                  <td class="spell-td-damage-type">
                    <select name="system.scaling.levels.{{idx}}.damageType" class="spell-table-select" data-dtype="String" data-scaling-input="true" {{#unless @root.editable}}disabled{{/unless}}>
                      {{selectOptions @root.damageTypeOptions selected=scalingEntry.damageType}}
                    </select>
                  </td>
                  <td class="spell-td-duration">
                    <input type="number" name="system.scaling.levels.{{idx}}.duration.value" value="{{scalingEntry.duration.value}}" min="0" class="spell-table-input spell-table-input-narrow" data-dtype="Number" data-scaling-input="true" {{#unless @root.editable}}disabled{{/unless}} />
                    <select name="system.scaling.levels.{{idx}}.duration.unit" class="spell-table-select spell-table-select--duration" data-dtype="String" data-scaling-input="true" {{#unless @root.editable}}disabled{{/unless}}>
                      <option value="instant" {{#if (eq scalingEntry.duration.unit "instant")}}selected{{/if}}>{{localize "UESRPG.Dialogs.AlchemyWorkshop.Instant"}}</option>
                      <option value="rounds" {{#if (eq scalingEntry.duration.unit "rounds")}}selected{{/if}}>{{localize "UESRPG.ActiveEffects.Fields.Rounds"}}</option>
                      <option value="minutes" {{#if (eq scalingEntry.duration.unit "minutes")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Minutes"}}</option>
                      <option value="hours" {{#if (eq scalingEntry.duration.unit "hours")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Hours"}}</option>
                      <option value="days" {{#if (eq scalingEntry.duration.unit "days")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Days"}}</option>
                    </select>
                  </td>
                  <td class="spell-td-action">
                    <button class="spell-btn-delete remove-scaling-level uesrpg-styled-action" type="button" data-action="removeScalingLevel" data-index="{{idx}}" data-tooltip-text="{{localize 'UESRPG.Sheets.Spell.DeleteScalingLevel'}}" aria-label="{{localize 'UESRPG.Sheets.Spell.DeleteScalingLevel'}} {{scalingEntry.level}}" {{#unless @root.editable}}disabled{{/unless}}>
                      <i class="fas fa-trash" aria-hidden="true"></i>
                    </button>
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
          {{else}}
          <p class="spell-empty">{{localize "UESRPG.ModernUI.NoScalingLevelsDefinedClickAddToCreateVariantCastingLevels"}}</p>
          {{/if}}
          </div>
        </details>

      </div>
    </div>

    {{!-- Tab 3 - Automation --}}
    <div class="tab" data-group="primary" data-tab="automation">
      <div class="spell-casting-body">
        <section class="spell-section">
          <h4 class="spell-section-title">
            {{localize "UESRPG.Apps.TalentsSettings.Sections.ActiveEffects"}}
            <button type="button" class="effect-control spell-btn-inline uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="create" data-tooltip-text="{{localize 'UESRPG.Sheets.Equipment.CreateEffect'}}" aria-label="{{localize 'UESRPG.Sheets.Equipment.CreateEffect'}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
          </h4>
          <div class="effects-grid">
            {{#each effects as |effect id|}}
            <div class="effect-row" data-effect-id="{{effect._id}}">
              <img class="effect-icon" src="{{effect.img}}" data-tooltip-text="{{effect.name}}" alt="{{effect.name}}"/>
              <span class="effect-name">{{effect.name}}</span>
              <div class="effect-controls">
                <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="edit" data-effect-id="{{effect._id}}" data-tooltip-text="{{localize 'UESRPG.Sheets.Equipment.EditEffect'}}" aria-label="{{localize 'UESRPG.Sheets.Equipment.EditEffect'}}"><i class="fas fa-edit" aria-hidden="true"></i></button>
                <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="delete" data-effect-id="{{effect._id}}" data-tooltip-text="{{localize 'UESRPG.Sheets.Equipment.DeleteEffect'}}" aria-label="{{localize 'UESRPG.Sheets.Equipment.DeleteEffect'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                <button type="button" class="effect-control uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="effectControl" data-effect-action="toggle" data-effect-id="{{effect._id}}" data-tooltip-text="{{#if effect.disabled}}{{localize 'UESRPG.Sheets.Item.Enable'}}{{else}}{{localize 'UESRPG.Sheets.Item.Disable'}}{{/if}}" aria-label="{{#if effect.disabled}}{{localize 'UESRPG.Sheets.Item.Enable'}}{{else}}{{localize 'UESRPG.Sheets.Item.Disable'}}{{/if}}">
                  <i class="fas {{#if effect.disabled}}fa-check{{else}}fa-times{{/if}}" aria-hidden="true"></i>
                </button>
              </div>
            </div>
            {{/each}}
          </div>
        </section>

        <section class="spell-section spell-section--diagnostic">
          <h4 class="spell-section-title">{{localize "UESRPG.ModernUI.EffectPolicies"}}</h4>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.ActiveEffects.Sections.Stacking"}}</label>
            <select name="system.engine.effects.stackingPolicy" class="spell-input spell-input-fill">
              {{selectOptions stackingPolicyOptions selected=spellEngine.effects.stackingPolicy}}
            </select>
          </div>
          <div class="spell-row">
            <label class="spell-label">{{localize "UESRPG.ModernUI.Ownership"}}</label>
            <select name="system.engine.effects.ownershipPolicy" class="spell-input spell-input-fill">
              {{selectOptions ownershipPolicyOptions selected=spellEngine.effects.ownershipPolicy}}
            </select>
          </div>
          <p class="spell-hint">{{localize "UESRPG.ModernUI.StackingControlsRepeatedCastsOwnershipDecidesWhoReceivesTheActiveEffect"}}</p>
        </section>

        <section class="spell-section">
          <div class="spell-automation-stack">
            <div class="spell-modules-grid">

            {{!-- Buffer / Barrier (moved from above) --}}
            <section class="spell-module-panel {{#if item.system.hasBuffer}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-shield-alt"></i> {{localize "UESRPG.ModernUI.BufferBarrier"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.hasBuffer" {{checked item.system.hasBuffer}} data-spell-structure /> {{localize "UESRPG.ModernUI.GrantsBuffer"}}</label>
              </div>
              {{#if item.system.hasBuffer}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ModernUI.BufferType"}}</label>
                <select name="system.buffer.type" class="spell-input spell-input-med">
                  <option value="none" {{#if (eq item.system.buffer.type "none")}}selected{{/if}}>{{localize "UESRPG.Labels.DAMAGE_TYPE.none"}}</option>
                  <option value="physical" {{#if (eq item.system.buffer.type "physical")}}selected{{/if}}>{{localize "UESRPG.UI.Physical"}}</option>
                  <option value="magical" {{#if (eq item.system.buffer.type "magical")}}selected{{/if}}>{{localize "UESRPG.UI.Magical"}}</option>
