                <legend>{{localize "UESRPG.ModernUI.SunderBinding"}}</legend>
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.ModernUI.TargetActor"}}</label>
                  <div class="spell-input spell-input-fill spell-input-row">
                    <input type="text" name="system.engine.conjure.actorUuid"
                           value="{{spellEngine.conjure.actorUuid}}"
                           placeholder="{{localize "UESRPG.Placeholders.SummonedActorUUID"}}"
                           class="spell-input spell-input-fill conjure-drop-target"
                           data-conjure-drop="actor" data-spell-autosave />
                    {{#if spellEngine.conjure.actorLabel}}
                    <span class="spell-hint spell-hint--nowrap">{{spellEngine.conjure.actorLabel}}</span>
                    {{/if}}
                    <button type="button" class="spell-btn-inline conjure-clear-btn uesrpg-styled-action" data-action="conjureClear" data-conjure-clear="actor" data-tooltip-text="{{localize 'UESRPG.Buttons.Clear'}}" aria-label="{{localize 'UESRPG.Buttons.Clear'}}">
                      <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.Chat.Magic.Characteristic"}}</label>
                  <select name="system.engine.conjure.bindingCharacteristic" class="spell-input spell-input-sm">
                    {{selectOptions bindingCharacteristicOptions selected=spellEngine.conjure.bindingCharacteristic}}
                  </select>
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.ModernUI.SSModifier"}}</label>
                  <input type="number" name="system.engine.conjure.bindingModifier"
                         value="{{spellEngine.conjure.bindingModifier}}"
                         class="spell-input spell-input-xs" data-spell-autosave />
                </div>
                <p class="spell-hint">{{localize "UESRPG.ModernUI.OpposedCharacteristicTestToSunderAConjuredCreatureSBinding"}}</p>
              </fieldset>
              {{/if}}
            </section>
            {{/if}}

            {{!-- Module: Disintegrate --}}
            <section class="spell-module-panel {{#if spellEngine.disintegrate.enabled}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-atom"></i> {{localize "UESRPG.ModernUI.Disintegrate"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.engine.disintegrate.enabled" {{checked spellEngine.disintegrate.enabled}} data-spell-structure /> {{localize "UESRPG.ModernUI.ApplyDamagedQualityInsteadOfDealingDamage"}}</label>
              </div>
              {{#if spellEngine.disintegrate.enabled}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.UI.Target"}}</label>
                <select name="system.engine.disintegrate.target" class="spell-input spell-input-med">
                  {{selectOptions disintegrateTargetOptions selected=spellEngine.disintegrate.target}}
                </select>
              </div>
              <p class="spell-hint">{{localize "UESRPG.ModernUI.AppliesDamagedSpellStrengthToTargetSEquippedArmorShieldOrWeapon"}}</p>
              {{/if}}
            </section>

            {{!-- Module: Drain --}}
            <section class="spell-module-panel {{#if spellEngine.drain.enabled}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-tint"></i> {{localize "UESRPG.ModernUI.Drain"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.engine.drain.enabled" {{checked spellEngine.drain.enabled}} data-spell-structure /> {{localize "UESRPG.ModernUI.DrainCurrentResourcePool"}}</label>
              </div>
              {{#if spellEngine.drain.enabled}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ModernUI.Pool"}}</label>
                <select name="system.engine.drain.type" class="spell-input spell-input-med">
                  {{selectOptions drainTypeOptions selected=spellEngine.drain.type}}
                </select>
                <label class="spell-check spell-check--offset"><input type="checkbox" name="system.engine.drain.transferToCaster" {{checked spellEngine.drain.transferToCaster}} /> {{localize "UESRPG.ModernUI.TransferToCasterAbsorb"}}</label>
              </div>
              <p class="spell-hint">{{localize "UESRPG.ModernUI.ReducesTheTargetSCurrentPoolByTheResolvedSpellStrengthValue"}}</p>
              {{/if}}
            </section>

            {{!-- Module: Resource Restoration --}}
            <section class="spell-module-panel {{#if spellEngine.resourceRestore.enabled}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-hand-holding-medical"></i> {{localize "UESRPG.ModernUI.ResourceRestoration"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.engine.resourceRestore.enabled" {{checked spellEngine.resourceRestore.enabled}} data-spell-structure /> {{localize "UESRPG.ModernUI.RestoreCurrentResourcePool"}}</label>
              </div>
              {{#if spellEngine.resourceRestore.enabled}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.Sheets.Feature.Mode"}}</label>
                <select name="system.engine.resourceRestore.kind" class="spell-input spell-input-med" data-spell-structure>
                  {{selectOptions resourceRestoreKindOptions selected=spellEngine.resourceRestore.kind}}
                </select>
                <label class="spell-label spell-label-sm">{{localize "UESRPG.UI.Target"}}</label>
                <select name="system.engine.resourceRestore.target" class="spell-input spell-input-sm">
                  {{selectOptions resourceRestoreTargetOptions selected=spellEngine.resourceRestore.target}}
                </select>
              </div>

              {{#if (eq spellEngine.resourceRestore.kind "restoreResource")}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ModernUI.Resource"}}</label>
                <select name="system.engine.resourceRestore.resource" class="spell-input spell-input-med">
                  {{selectOptions resourceRestoreResourceOptions selected=spellEngine.resourceRestore.resource}}
                </select>
                <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.WarfareUnit.Amount"}}</label>
                <input type="text" name="system.engine.resourceRestore.amount" value="{{spellEngine.resourceRestore.amount}}" placeholder="{{localize "UESRPG.ModernUI.SS"}}" class="spell-input spell-input-sm" />
              </div>
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ActiveEffects.Options.StackPolicy.cap"}}</label>
                <select name="system.engine.resourceRestore.capMode" class="spell-input spell-input-med" data-spell-structure>
                  {{selectOptions resourceRestoreCapModeOptions selected=spellEngine.resourceRestore.capMode}}
                </select>
                {{#if (eq spellEngine.resourceRestore.capMode "custom")}}
                <input type="text" name="system.engine.resourceRestore.cap" value="{{spellEngine.resourceRestore.cap}}" placeholder="{{localize "UESRPG.ModernUI.COST"}}" class="spell-input spell-input-sm" />
                {{/if}}
              </div>
              {{else}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.UI.Fatigue"}}</label>
                <input type="number" name="system.engine.resourceRestore.removeFatigueLevels" value="{{spellEngine.resourceRestore.removeFatigueLevels}}" min="1" class="spell-input spell-input-xs" />
                <label class="spell-label spell-label--offset">{{localize "UESRPG.ModernUI.SPAmount"}}</label>
                <input type="text" name="system.engine.resourceRestore.amount" value="{{spellEngine.resourceRestore.amount}}" placeholder="{{localize "UESRPG.ModernUI.SS"}}" class="spell-input spell-input-sm" />
              </div>
              {{/if}}

              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.engine.resourceRestore.chat" {{checked spellEngine.resourceRestore.chat}} /> {{localize "UESRPG.ModernUI.PostChatSummary"}}</label>
              </div>
              <p class="spell-hint">{{localize "UESRPG.ModernUI.SupportsSSCOSTLEVELArithmeticMinABAndMaxABValuesAreClampedToTheTargetSCu"}}</p>
              {{/if}}
            </section>

            {{!-- Module: Cloak (Aura) --}}
            <section class="spell-module-panel {{#if spellEngine.cloak.enabled}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-spinner"></i> {{localize "UESRPG.ModernUI.CloakAura"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.engine.cloak.enabled" {{checked spellEngine.cloak.enabled}} data-spell-structure /> {{localize "UESRPG.ModernUI.ApplyEffectsToNearbyTargetsEachTurn"}}</label>
              </div>
              {{#if spellEngine.cloak.enabled}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ModernUI.RangeM"}}</label>
                <input type="number" name="system.engine.cloak.range"
                       value="{{spellEngine.cloak.range}}"
                       class="spell-input spell-input-xs" min="0" step="1" />
                <label class="spell-check spell-check--offset"><input type="checkbox" name="system.engine.cloak.excludeSelf" {{checked spellEngine.cloak.excludeSelf}} /> {{localize "UESRPG.ModernUI.ExcludeCaster"}}</label>
              </div>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.engine.cloak.useSpellDamage" {{checked spellEngine.cloak.useSpellDamage}} /> {{localize "UESRPG.ModernUI.ApplySpellDamageToTargetsInRange"}}</label>
              </div>
              <p class="spell-hint">{{localize "UESRPG.ModernUI.AtTheEndOfTheCasterSTurnAllTokensWithinRangeTakeTheSpellSDamageAndOrRece"}}</p>
              {{/if}}
            </section>

            {{!-- Module: Rune / Trap --}}
            <section class="spell-module-panel {{#if item.system.isRuneSpell}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-crosshairs"></i> {{localize "UESRPG.ModernUI.RuneTrap"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.isRuneSpell" {{checked item.system.isRuneSpell}} data-spell-structure /> {{localize "UESRPG.ModernUI.RuneTrap"}}</label>
              </div>
              {{#if item.system.isRuneSpell}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ModernUI.Trigger"}}</label>
                <select name="system.runeTriggerType" class="spell-input spell-input-med">
                  <option value="" {{#if (eq item.system.runeTriggerType "")}}selected{{/if}}>{{localize "UESRPG.Labels.DAMAGE_TYPE.none"}}</option>
                  <option value="proximity" {{#if (eq item.system.runeTriggerType "proximity")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Proximity"}}</option>
                  <option value="time" {{#if (eq item.system.runeTriggerType "time")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Timed"}}</option>
                  <option value="manual" {{#if (eq item.system.runeTriggerType "manual")}}selected{{/if}}>{{localize "UESRPG.Chat.Common.Manual"}}</option>
                </select>
                <label class="spell-label spell-label-sm">{{localize "UESRPG.UI.Radius"}}</label>
                <input type="number" name="system.runeTriggerRadius" value="{{item.system.runeTriggerRadius}}" min="0" step="0.5" class="spell-input spell-input-xs" />
                <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.Combat.Delay"}}</label>
                <input type="number" name="system.runeTriggerDelay" value="{{item.system.runeTriggerDelay}}" min="0" class="spell-input spell-input-xs" />
              </div>
              {{/if}}
            </section>

            {{!-- Module: Persistent Zone --}}
            <section class="spell-module-panel {{#if item.system.isZonePersistent}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-globe"></i> {{localize "UESRPG.ModernUI.PersistentZone"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.isZonePersistent" {{checked item.system.isZonePersistent}} data-spell-structure /> {{localize "UESRPG.ModernUI.PersistentZone"}}</label>
              </div>
              {{#if item.system.isZonePersistent}}
              <p class="spell-hint">{{localize "UESRPG.ModernUI.CreatesAPersistentAoEZoneLinkedToAMeasuredTemplateRequiresAoERangeType"}}</p>
              {{/if}}
            </section>

            {{!-- Module: Spell Defense (Absorption/Reflect) --}}
            <section class="spell-module-panel {{#if item.system.isSpellDefense}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-user-shield"></i> {{localize "UESRPG.ModernUI.SpellDefense"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.isSpellDefense" {{checked item.system.isSpellDefense}} data-spell-structure /> {{localize "UESRPG.ModernUI.SpellDefenseAbsorptionReflect"}}</label>
              </div>
              {{#if item.system.isSpellDefense}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.Sheets.Feature.Type"}}</label>
                <select name="system.spellDefenseType" class="spell-input spell-input-med">
                  {{selectOptions item.system.spellDefenseTypes selected=item.system.spellDefenseType}}
                </select>
              </div>
              <p class="spell-hint">{{localize "UESRPG.ModernUI.SpellDefenseResolutionHint"}}</p>
              {{/if}}
            </section>

            {{!-- Module: OverTime --}}
            <section class="spell-module-panel {{#if item.system.hasOverTime}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-redo"></i> {{localize "UESRPG.ModernUI.OverTime"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.hasOverTime" {{checked item.system.hasOverTime}} data-spell-structure /> {{localize "UESRPG.ModernUI.OverTime"}}</label>
              </div>
              {{#if item.system.hasOverTime}}

              {{#each overTimeEntries as |ot idx|}}
              <fieldset class="spell-fieldset spell-fieldset--relative">
                <legend>{{localize "UESRPG.ModernUI.Entry" value1=(inc idx)}}
                  {{#if @root.editable}}
                  <button class="spell-btn-delete spell-btn-delete--legend uesrpg-styled-action" type="button" data-action="removeOvertimeEntry" data-index="{{idx}}" data-tooltip-text="{{localize 'UESRPG.Apps.TravelPlanner.RemoveEntry'}}" aria-label="{{localize 'UESRPG.Apps.TravelPlanner.RemoveEntry'}}">
                    <i class="fas fa-trash" aria-hidden="true"></i>
                  </button>
                  {{/if}}
                </legend>
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.ModernUI.Trigger"}}</label>
                  <select name="system.overTimeEntries.{{idx}}.trigger" class="spell-input spell-input-med" data-spell-autosave>
                    <option value="turnStart" {{#if (eq ot.trigger "turnStart")}}selected{{/if}}>{{localize "UESRPG.ModernUI.TurnStart"}}</option>
                    <option value="turnEnd" {{#if (eq ot.trigger "turnEnd")}}selected{{/if}}>{{localize "UESRPG.ModernUI.TurnEnd"}}</option>
                    <option value="roundStart" {{#if (eq ot.trigger "roundStart")}}selected{{/if}}>{{localize "UESRPG.ModernUI.RoundStart"}}</option>
                    <option value="roundEnd" {{#if (eq ot.trigger "roundEnd")}}selected{{/if}}>{{localize "UESRPG.ModernUI.RoundEnd"}}</option>
                    <option value="worldTime" {{#if (eq ot.trigger "worldTime")}}selected{{/if}}>{{localize "UESRPG.ModernUI.WorldTime"}}</option>
                  </select>
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.ModernUI.Every"}}</label>
                  <input type="number" name="system.overTimeEntries.{{idx}}.cadenceEvery" value="{{ot.cadenceEvery}}" min="1" class="spell-input spell-input-xs" data-spell-autosave />
                  <select name="system.overTimeEntries.{{idx}}.cadenceUnit" class="spell-input spell-input-sm" data-spell-autosave>
                    <option value="rounds" {{#if (eq ot.cadenceUnit "rounds")}}selected{{/if}}>{{localize "UESRPG.ActiveEffects.Fields.Rounds"}}</option>
                    <option value="seconds" {{#if (eq ot.cadenceUnit "seconds")}}selected{{/if}}>{{localize "UESRPG.ActiveEffects.Fields.Seconds"}}</option>
                  </select>
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.Item.Max"}}</label>
                  <input type="number" name="system.overTimeEntries.{{idx}}.maxTicks" value="{{ot.maxTicks}}" min="0" placeholder="∞" class="spell-input spell-input-xs" data-spell-autosave />
                </div>
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.ModernUI.Payload"}}</label>
                  <select name="system.overTimeEntries.{{idx}}.payloadType" class="spell-input spell-input-med" data-spell-structure>
                    <option value="damage" {{#if (eq ot.payloadType "damage")}}selected{{/if}}>{{localize "UESRPG.Chat.Common.Damage"}}</option>
                    <option value="heal" {{#if (or (eq ot.payloadType "heal") (eq ot.payloadType "healing"))}}selected{{/if}}>{{localize "UESRPG.ModernUI.Heal"}}</option>
                    <option value="endEffect" {{#if (eq ot.payloadType "endEffect")}}selected{{/if}}>{{localize "UESRPG.ModernUI.EndEffect"}}</option>
                    <option value="saveThenApply" {{#if (eq ot.payloadType "saveThenApply")}}selected{{/if}}>{{localize "UESRPG.ModernUI.SaveThenApply"}}</option>
                  </select>
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.Sheets.Feature.Formula"}}</label>
                  <input type="text" name="system.overTimeEntries.{{idx}}.formula" value="{{ot.formula}}" placeholder="{{localize "UESRPG.Labels.SUPPLY_DICE.1d6"}}" class="spell-input spell-input-sm" data-spell-autosave />
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.ModernUI.DmgType"}}</label>
                  <select name="system.overTimeEntries.{{idx}}.damageType" class="spell-input spell-input-sm" data-spell-autosave>
                    {{selectOptions @root.item.system.damageTypes selected=ot.damageType}}
                  </select>
                  <label class="spell-check"><input type="checkbox" name="system.overTimeEntries.{{idx}}.ignoreReduction" {{checked ot.ignoreReduction}} data-spell-autosave /> {{localize "UESRPG.ModernUI.IgnoreReduction"}}</label>
                </div>

                {{#if (eq ot.payloadType "saveThenApply")}}
                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.UI.Save"}}</label>
                  <select name="system.overTimeEntries.{{idx}}.saveKey" class="spell-input spell-input-sm" data-spell-autosave>
                    <option value="str" {{#if (eq ot.saveKey "str")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.STR"}}</option>
                    <option value="end" {{#if (eq ot.saveKey "end")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.END"}}</option>
                    <option value="agi" {{#if (eq ot.saveKey "agi")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.AGI"}}</option>
                    <option value="int" {{#if (eq ot.saveKey "int")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.INT"}}</option>
                    <option value="wp" {{#if (eq ot.saveKey "wp")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.WP"}}</option>
                    <option value="prc" {{#if (eq ot.saveKey "prc")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.PRC"}}</option>
                    <option value="prs" {{#if (eq ot.saveKey "prs")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.PRS"}}</option>
                    <option value="lck" {{#if (eq ot.saveKey "lck")}}selected{{/if}}>{{localize "UESRPG.Sheets.Feature.StatLabel.LCK"}}</option>
                  </select>
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.Chat.Common.TN"}}</label>
                  <input type="number" name="system.overTimeEntries.{{idx}}.saveTN" value="{{ot.saveTN}}" min="0" class="spell-input spell-input-xs" data-spell-autosave />
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.ModernUI.Pass"}}</label>
                  <select name="system.overTimeEntries.{{idx}}.saveSuccess" class="spell-input spell-input-sm" data-spell-autosave>
                    <option value="endEffect" {{#if (eq ot.saveSuccess "endEffect")}}selected{{/if}}>{{localize "UESRPG.ModernUI.EndEffect"}}</option>
                    <option value="halve" {{#if (eq ot.saveSuccess "halve")}}selected{{/if}}>{{localize "UESRPG.ModernUI.HalveDmg"}}</option>
                    <option value="negate" {{#if (eq ot.saveSuccess "negate")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Negate"}}</option>
                  </select>
                  <label class="spell-label spell-label-sm">{{localize "UESRPG.ModernUI.Fail"}}</label>
                  <select name="system.overTimeEntries.{{idx}}.saveFailure" class="spell-input spell-input-sm" data-spell-autosave>
                    <option value="damage" {{#if (eq ot.saveFailure "damage")}}selected{{/if}}>{{localize "UESRPG.Chat.Common.Damage"}}</option>
                    <option value="condition" {{#if (eq ot.saveFailure "condition")}}selected{{/if}}>{{localize "UESRPG.ActiveEffects.Badges.Condition"}}</option>
                  </select>
                </div>
                {{/if}}

                <div class="spell-row">
                  <label class="spell-label">{{localize "UESRPG.Sheets.Item.Label"}}</label>
                  <input type="text" name="system.overTimeEntries.{{idx}}.label" value="{{ot.label}}" placeholder="{{localize "UESRPG.Placeholders.OverTimeLabel"}}" class="spell-input spell-input-fill" data-spell-autosave />
                  <label class="spell-check"><input type="checkbox" name="system.overTimeEntries.{{idx}}.chatLog" {{checked ot.chatLog}} data-spell-autosave /> {{localize "UESRPG.ModernUI.ChatLog"}}</label>
                </div>
              </fieldset>
              {{/each}}

              {{#if @root.editable}}
              <button type="button" data-action="addOvertimeEntry" class="spell-btn-add uesrpg-styled-action">
                <i class="fas fa-plus" aria-hidden="true"></i> {{localize "UESRPG.Sheets.Spell.AddOvertimeEntry"}}
              </button>
              {{/if}}
              {{/if}}
            </section>

            {{!-- Module: Summon --}}
            <section class="spell-module-panel {{#if item.system.isSummonSpell}}spell-module-panel--expanded{{/if}}">
              <h4 class="spell-module-title"><i class="fas fa-dragon"></i> {{localize "UESRPG.ModernUI.Summon"}}</h4>
              <div class="spell-row spell-row-checks">
                <label class="spell-check"><input type="checkbox" name="system.isSummonSpell" {{checked item.system.isSummonSpell}} data-spell-structure /> {{localize "UESRPG.ModernUI.Summon"}}</label>
              </div>
              {{#if item.system.isSummonSpell}}
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.ModernUI.ActorUUID"}}</label>
                <input type="text" name="system.engine.summon.actorUuid" value="{{spellEngine.summon.actorUuid}}" placeholder="{{localize "UESRPG.Placeholders.CompendiumActorUUID"}}" class="spell-input spell-input-fill" />
              </div>
              <div class="spell-row">
                <label class="spell-label">{{localize "UESRPG.Sheets.Item.Quantity"}}</label>
                <input type="number" name="system.engine.summon.quantity" value="{{spellEngine.summon.quantity}}" min="1" class="spell-input spell-input-xs" />
              </div>
              <p class="spell-hint">{{localize "UESRPG.ModernUI.LeaveBlankToPromptAtCastTime"}}</p>
              {{/if}}
            </section>

            </div>{{!-- /.spell-modules-grid --}}

            {{!-- Effect Recipes (Experimental - hidden by default) --}}
            {{#if enableSpellRecipes}}
            <section class="spell-module-panel">
              <h4 class="spell-module-title">
                <i class="fas fa-flask"></i> {{localize "UESRPG.ModernUI.EffectRecipes"}}
                <span class="spell-hint spell-hint--inline">{{localize "UESRPG.ModernUI.Experimental"}}</span>
                <button type="button" class="spell-btn-inline add-effect-recipe uesrpg-styled-action" data-action="addEffectRecipe" data-tooltip-text="{{localize 'UESRPG.Sheets.Spell.AddEffectRecipe'}}" {{#unless @root.editable}}disabled{{/unless}} aria-label="{{localize 'UESRPG.Sheets.Spell.AddEffectRecipe'}}">
                  <i class="fas fa-plus" aria-hidden="true"></i> {{localize "UESRPG.Sheets.Spell.Add"}}
                </button>
              </h4>

              {{#if spellEngine.effects.recipes.length}}
              <div class="spell-recipes-list">
                {{#each spellEngine.effects.recipes as |recipe idx|}}
                <div class="spell-recipe-row" data-recipe-index="{{idx}}">
                  <select name="system.engine.effects.recipes.{{idx}}.key" class="spell-recipe-key" data-recipe-input="true">
                    <option value="">{{localize "UESRPG.ModernUI.Key"}}</option>
                    {{#each @root.modifierKeyOptions as |label key|}}
                    <option value="{{key}}" {{#if (eq key ../recipe.key)}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                  <select name="system.engine.effects.recipes.{{idx}}.mode" class="spell-recipe-mode" data-recipe-input="true">
                    {{selectOptions @root.effectRecipeModeOptions selected=recipe.mode}}
                  </select>
                  <input type="text" name="system.engine.effects.recipes.{{idx}}.value" value="{{recipe.value}}" placeholder="{{localize "UESRPG.Placeholders.RecipeValue"}}" class="spell-recipe-value" data-recipe-input="true" />
                  <select name="system.engine.effects.recipes.{{idx}}.target" class="spell-recipe-target" data-recipe-input="true">
                    <option value="target" {{#if (eq recipe.target "target")}}selected{{/if}}>{{localize "UESRPG.UI.Target"}}</option>
                    <option value="self" {{#if (eq recipe.target "self")}}selected{{/if}}>{{localize "UESRPG.ModernUI.Self"}}</option>
                  </select>
                  <input type="text" name="system.engine.effects.recipes.{{idx}}.label" value="{{recipe.label}}" placeholder="{{localize "UESRPG.Sheets.Item.Label"}}" class="spell-recipe-label" data-recipe-input="true" />
                  <button type="button" class="spell-btn-delete remove-effect-recipe uesrpg-styled-action" data-action="removeEffectRecipe" data-recipe-index="{{idx}}" data-tooltip-text="{{localize 'UESRPG.Sheets.Spell.RemoveEffectRecipe'}}" aria-label="{{localize 'UESRPG.Sheets.Spell.RemoveEffectRecipe'}}" {{#unless @root.editable}}disabled{{/unless}}>
                    <i class="fas fa-trash" aria-hidden="true"></i>
                  </button>
                </div>
                {{/each}}
              </div>
              {{else}}
              <p class="spell-empty">{{localize "UESRPG.ModernUI.NoRecipesUseAddButtonAbove"}}</p>
              {{/if}}
            </section>
            {{/if}}

          </div>
        </section>
      </div>
    </div>

  </section>
