<div class="tab core" data-group="primary" data-tab="core">
  <div class="tabContainer uesrpg-sheet-body">

    <div class="skillContainer">
      <div class="section-header">
        <span class="section-header__label">{{localize "UESRPG.UI.Skills"}}</span>
      </div>
      <ul class="skillList">
        {{#each actor.skill as |item id|}}
          <li class="item" data-item-id="{{item._id}}">
            <div class="itemInfo skill-roll-target" data-action="skillRoll" role="button" tabindex="0">
              <img class="item-img" src="{{item.img}}" title="{{localize "UESRPG.UI.PostToChat"}}"/>
              <div class="item-name skill-open-item">{{item.name}}</div>
            </div>
            <div class="item-controls">
              <div class="item-value">{{item.system.value}}%</div>
              <a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>

    <div class="three-column-flex-container">
      <div class="trait-container">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="traits" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">{{localize "UESRPG.UI.Traits"}}</span>
        </div>
        <ol class="single-column-list">
          {{#each actor.trait as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <img data-action="postItemToChat" class="item-img" src="{{item.img}}" title="{{localize "UESRPG.UI.PostToChat"}}"/>
                {{#with (lookup @root.actor.ui.traitStackingById item._id) as |stack|}}
                  <i class="fas fa-layer-group" title="Trait stacking: key '{{stack.key}}' appears {{stack.count}} times{{#if stack.highest}}. Highest X: {{stack.highest}}{{#if stack.unit}} {{stack.unit}}{{/if}}{{/if}}"></i>
                {{/with}}
                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
              </div>
              <div class="item-controls">
                <a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>

      <div class="talent-container">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="talents" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">{{localize "UESRPG.UI.Talents"}}</span>
        </div>
        <ol class="single-column-list">
          {{#each actor.talent as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <img data-action="postItemToChat" class="item-img" src="{{item.img}}" title="{{localize "UESRPG.UI.PostToChat"}}"/>
                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
              </div>
              <div class="item-controls">
                <a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>

      <div class="power-container">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="powers" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">{{localize "UESRPG.UI.Powers"}}</span>
        </div>
        <ol class="single-column-list">
          {{#each actor.power as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <img data-action="postItemToChat" class="item-img" src="{{item.img}}" title="{{localize "UESRPG.UI.PostToChat"}}"/>
                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
              </div>
              <div class="item-controls">
                <a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
    </div>

    <div class="social-section">
      <div class="social-field">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="languages" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">{{localize "UESRPG.UI.Languages"}}</span>
          <button type="button" data-action="openLanguageSelector" class="section-header__action" title="{{localize "UESRPG.UI.ConfigureLanguages"}}"><i class="fas fa-pen"></i></button>
        </div>
        <div class="social-field__body">
          <div class="social-chip-wrap">
            <span class="social-chip social-chip--fixed">{{localize "UESRPG.Choices.Languages.cyrodilic"}}</span>
            {{#each actor.system.socialDisplay.languages.preview as |lang|}}
              <span class="social-chip">{{lang}}</span>
            {{/each}}
            {{#if actor.system.socialDisplay.languages.hiddenCount}}
              <span class="social-chip social-chip--muted">{{localize "UESRPG.UI.MoreCount" count=actor.system.socialDisplay.languages.hiddenCount}}</span>
            {{/if}}
            {{#unless actor.system.socialDisplay.languages.preview.length}}
              <span class="social-chip social-chip--muted">{{localize "UESRPG.UI.NoAdditionalLanguagesSelected"}}</span>
            {{/unless}}
          </div>
        </div>
      </div>

      <div class="social-field">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="factions" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">{{localize "UESRPG.UI.Factions"}}</span>
          <button type="button" data-action="openFactionSelector" class="section-header__action" title="{{localize "UESRPG.UI.ConfigureFactions"}}"><i class="fas fa-pen"></i></button>
        </div>
        <div class="social-field__body">
          {{#if actor.system.socialDisplay.factions.preview.length}}
            <ul class="social-faction-summary">
              {{#each actor.system.socialDisplay.factions.preview as |entry|}}
                <li>
                  <span class="name">{{entry.name}}</span>
                  {{#if entry.rankTitle}}<span class="meta"> - {{entry.rankTitle}}</span>{{/if}}
                  {{#if entry.location}}<span class="meta"> ({{entry.location}})</span>{{/if}}
                </li>
              {{/each}}
            </ul>
            {{#if actor.system.socialDisplay.factions.hiddenCount}}
              <p class="social-empty">{{localize "UESRPG.UI.MoreFactionsCount" count=actor.system.socialDisplay.factions.hiddenCount}}</p>
            {{/if}}
          {{else}}
            <p class="social-empty">{{localize "UESRPG.UI.NoFactionsSelected"}}</p>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Feature Inspector (Chapter 4 trait/talent/power provenance) --}}
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-inspector.hbs"}}

    <div class="bioPage">
      <div class="section-header">
        <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="notes" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a>
        <span class="section-header__label">{{localize "UESRPG.UI.Biography"}}</span>
        <button type="button" class="section-header__action" data-action="openBioEditor" title="{{localize "UESRPG.UI.EditBiography"}}">
          <i class="fas fa-pen"></i>
        </button>
      </div>
      <div class="contentContainer">
        <prose-mirror name="system.bio" value="{{actor.system.bio}}" data-document-uuid="{{actor.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{actor.system.enrichedBio}}}</prose-mirror>
      </div>
    </div>

  </div>
</div>
