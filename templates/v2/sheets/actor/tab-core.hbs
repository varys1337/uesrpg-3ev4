<div class="tab core" data-group="primary" data-tab="core">
  <div class="tabContainer uesrpg-sheet-body">

    <div class="about-buttons">
      <div class="buttonStats">
        <button type="button" data-action="luckyMenu" id="luckyMenu">Lucky/Unlucky</button>
        <button type="button" data-action="xpMenu" id="xpMenu">Exp: {{actor.system.xp}}</button>
        <button type="button" data-action="raceMenu" id="raceMenu">Race: {{actor.system.race}}</button>
        <button type="button" data-action="birthSignMenu" id="birthSignMenu">Sign: {{actor.system.birthsign}}</button>
      </div>
    </div>

    <div class="skillContainer">
      <div class="section-header">
        <span class="section-header__label">Skills</span>
        <button type="button" data-action="itemCreate" class="section-header__action" id="skill" title="Add Skill">+</button>
      </div>
      <ul class="skillList">
        {{#each actor.skill as |item id|}}
          <li class="item" data-item-id="{{item._id}}">
            <div class="itemInfo skill-roll-target" data-action="skillRoll" role="button" tabindex="0">
              <img class="item-img" src="{{item.img}}" title="Send to Chat"/>
              <div class="item-name skill-open-item">{{item.name}}</div>
            </div>
            <div class="item-controls">
              <div class="item-value">{{item.system.value}}%</div>
              <a data-action="itemDelete" class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>

    <div class="three-column-flex-container">
      <div class="trait-container">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="traits" title="Collapse/Expand"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">Traits</span>
          <button type="button" data-action="itemCreate" class="section-header__action" id="trait" title="Add Trait">+</button>
        </div>
        <ol class="single-column-list">
          {{#each actor.trait as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <img data-action="postItemToChat" class="item-img" src="{{item.img}}" title="Activate"/>
                {{#with (lookup @root.actor.ui.traitStackingById item._id) as |stack|}}
                  <i class="fas fa-layer-group" title="Trait stacking: key '{{stack.key}}' appears {{stack.count}} times{{#if stack.highest}}. Highest X: {{stack.highest}}{{#if stack.unit}} {{stack.unit}}{{/if}}{{/if}}"></i>
                {{/with}}
                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
              </div>
              <div class="item-controls">
                <a data-action="itemDelete" class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>

      <div class="talent-container">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="talents" title="Collapse/Expand"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">Talents</span>
          <button type="button" data-action="itemCreate" class="section-header__action" id="talent" title="Add Talent">+</button>
        </div>
        <ol class="single-column-list">
          {{#each actor.talent as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <img data-action="postItemToChat" class="item-img" src="{{item.img}}" title="Activate"/>
                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
              </div>
              <div class="item-controls">
                <a data-action="itemDelete" class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>

      <div class="power-container">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="powers" title="Collapse/Expand"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">Powers</span>
          <button type="button" data-action="itemCreate" class="section-header__action" id="power" title="Add Power">+</button>
        </div>
        <ol class="single-column-list">
          {{#each actor.power as |item id|}}
            <li class="item" data-item-id="{{item._id}}">
              <div class="itemInfo">
                <img data-action="postItemToChat" class="item-img" src="{{item.img}}" title="Activate"/>
                <div data-action="itemOpen" class="item-name">{{item.name}}</div>
              </div>
              <div class="item-controls">
                <a data-action="itemDelete" class="item-control item-delete" title="Delete Item"><i class="fas fa-trash"></i></a>
              </div>
            </li>
          {{/each}}
        </ol>
      </div>
    </div>

    <div class="social-section">
      <div class="social-field">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="languages" title="Collapse/Expand"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">Languages</span>
          <button type="button" data-action="openLanguageSelector" class="section-header__action" title="Configure Languages"><i class="fas fa-pen"></i></button>
        </div>
        <div class="social-field__body">
          <div class="social-chip-wrap">
            <span class="social-chip social-chip--fixed">Cyrodilic</span>
            {{#each actor.system.socialDisplay.languages.preview as |lang|}}
              <span class="social-chip">{{lang}}</span>
            {{/each}}
            {{#if actor.system.socialDisplay.languages.hiddenCount}}
              <span class="social-chip social-chip--muted">+{{actor.system.socialDisplay.languages.hiddenCount}} more</span>
            {{/if}}
            {{#unless actor.system.socialDisplay.languages.preview.length}}
              <span class="social-chip social-chip--muted">No additional languages selected</span>
            {{/unless}}
          </div>
        </div>
      </div>

      <div class="social-field">
        <div class="section-header">
          <a data-action="groupToggle" class="section-header__toggle uesrpg-group-toggle" data-group="factions" title="Collapse/Expand"><i class="fas fa-chevron-down"></i></a>
          <span class="section-header__label">Factions</span>
          <button type="button" data-action="openFactionSelector" class="section-header__action" title="Configure Factions"><i class="fas fa-pen"></i></button>
        </div>
        <div class="social-field__body">
          {{#if actor.system.socialDisplay.factions.preview.length}}
            <ul class="social-faction-summary">
              {{#each actor.system.socialDisplay.factions.preview as |entry|}}
                <li>
                  <span class="name">{{entry.name}}</span>
                  {{#if entry.rankTitle}}<span class="meta"> - {{entry.rankTitle}}</span>{{/if}}
                  {{#if entry.location}}<span class="meta"> ({{entry.location}})</span>{{/if}}
                </li>
              {{/each}}
            </ul>
            {{#if actor.system.socialDisplay.factions.hiddenCount}}
              <p class="social-empty">+{{actor.system.socialDisplay.factions.hiddenCount}} more factions</p>
            {{/if}}
          {{else}}
            <p class="social-empty">No factions selected.</p>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Feature Inspector (Chapter 4 trait/talent/power provenance) --}}
    {{> "systems/uesrpg-3ev4/templates/partials/sheets/feature-inspector.hbs"}}

    <div class="bioPage">
      <div class="section-header">
        <span class="section-header__label">Biography</span>
        <button type="button" class="section-header__action" data-action="openBioEditor" title="Edit Biography">
          <i class="fas fa-pen"></i>
        </button>
      </div>
      <div class="contentContainer">
        {{editor actor.system.bio target="system.bio" button=true owner=owner engine="prosemirror" editable=editable}}
      </div>
    </div>

  </div>
</div>

