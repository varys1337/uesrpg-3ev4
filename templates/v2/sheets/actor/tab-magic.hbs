            <div class="tab magic" data-group="primary" data-tab="magic" data-list-filter-root="magic">
                <div class="magicTabContainer">
                    {{#if sheetUi.showSheetSearchBars}}
                    {{> "systems/uesrpg-3ev4/templates/partials/sheets/list-filter.hbs" scope="magic"}}
                    {{/if}}
                    <div class="magicSkillContainer">
                        <div class="section-header">
                            <span class="section-header__label">{{localize "UESRPG.Sheets.Magic.MagicSkills"}}</span>
                        </div>
                        <ol class="skillList">
                            {{#each actor.magicSkill as |item id|}}
                                <li class="item" data-item-id="{{item._id}}">
                                    <button type="button" class="itemInfo skill-roll-target uesrpg-semantic-control uesrpg-plain-control" data-action="skillRoll">
                                        <img class="item-img" src="{{item.img}}" data-tooltip="UESRPG.UI.PostToChat" alt="{{item.name}}" />
                                        <span class="item-name skill-open-item">
                                            {{item.name}}
                                        </span>
                                    </button>
                                    <div class="item-controls">
                                        <div class="item-value">{{item.system.value}}%</div>
                                        <button type="button" data-action="itemDelete" class="item-control item-delete uesrpg-semantic-control uesrpg-plain-control" data-tooltip="UESRPG.UI.DeleteItem" aria-label="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></button>
                                    </div>
                                </li>
                            {{/each}}
                            {{#unless actor.magicSkill.length}}
                                <li>{{localize "UESRPG.Sheets.Magic.NoMagicSkillsTrained"}}</li>
                            {{/unless}}
                        </ol>
                    </div>

                    {{#if actor.ui.worship.enabled}}
                    <div class="spellListContainer">
                        <div class="section-header section-header--actions-end">
                            <button type="button" data-action="itemCreate" data-item-type="invocation" class="section-header__action uesrpg-styled-action" data-tooltip="UESRPG.Sheets.Magic.AddInvocation" aria-label="{{localize "UESRPG.Sheets.Magic.AddInvocation"}}">+</button>
                        </div>
                        <div class="spellList">
                            {{#each actor.invocationGroups as |group|}}
                                <div class="spell-school-section" data-school="{{group.key}}">
                                    <button type="button" class="spell-school-header uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-action="groupToggle" data-group="invocation-group-{{group.key}}" aria-expanded="true">
                                        <i class="fas fa-chevron-down collapse-arrow"></i>
                                        <span class="school-name">{{group.label}}</span>
                                        <span class="school-count">({{group.count}})</span>
                                    </button>
                                    <table class="spell-school-table">
                                        <thead>
                                            <tr>
                                                <th>{{localize "UESRPG.UI.Name"}}</th>
                                                <th>{{localize "UESRPG.Sheets.Magic.Circle"}}</th>
                                                <th>{{localize "UESRPG.Sheets.Magic.PPCost"}}</th>
                                                <th><i class="fas fa-trash"></i></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each group.invocations as |invocation|}}
                                                <tr class="spell-row item active" data-item-id="{{invocation._id}}">
                                                    <td class="spell-name-cell">
                                                        <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="castInvocation" data-tooltip="UESRPG.Sheets.Magic.InvokeRite" aria-label="{{localize "UESRPG.Sheets.Magic.InvokeRite"}}"><i class="fas fa-dice-d20 magic-roll" aria-hidden="true"></i></button>
                                                        <img class="item-img" src="{{invocation.img}}" alt="{{invocation.name}}" />
                                                        <button type="button" data-action="itemOpen" class="item-name uesrpg-semantic-control uesrpg-plain-control">{{invocation.name}}</button>
                                                    </td>
                                                    <td class="spell-rank-cell">{{localize "UESRPG.Sheets.Magic.Circle"}} {{invocation.system.circle}}</td>
                                                    <td class="spell-mp-cell">{{invocation.system.pietyCost}}</td>
                                                    <td class="spell-actions-cell">
                                                        <button type="button" data-action="itemDelete" class="item-delete uesrpg-semantic-control uesrpg-plain-control" data-tooltip="UESRPG.UI.Delete" aria-label="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></button>
                                                    </td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                </div>
                            {{/each}}
                            {{#unless actor.invocationGroups.length}}
                                <p>{{localize "UESRPG.Sheets.Magic.NoInvocationsKnown"}}</p>
                            {{/unless}}
                        </div>
                    </div>
                    {{/if}}

                    <div class="spellListContainer">
                        <div class="spellList">
                            {{!-- Spell schools organized by category --}}
                            {{#each actor.spellSchools as |schoolData|}}
                                <div class="spell-school-section" data-school="{{schoolData.key}}">
                                    <button type="button" class="spell-school-header uesrpg-group-toggle uesrpg-semantic-control uesrpg-plain-control" data-action="groupToggle" data-group="spell-school-{{schoolData.key}}" aria-expanded="true">
                                        <i class="fas fa-chevron-down collapse-arrow"></i>
                                        <span class="school-name">{{schoolData.label}}</span>
                                        <span class="school-count">({{schoolData.count}})</span>
                                    </button>
                                    <table class="spell-school-table">
                                        <thead>
                                            <tr>
                                                <th>{{localize "UESRPG.UI.Name"}}</th>
                                                <th>{{localize "UESRPG.UI.Rank"}}</th>
                                                <th>{{localize "UESRPG.Sheets.Magic.MPCost"}}</th>
                                                <th><i class="fas fa-trash"></i></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each schoolData.spells as |spell|}}
                                                <tr class="spell-row item active" data-item-id="{{spell._id}}">
                                                    <td class="spell-name-cell">
                                                        <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-icon-action" data-action="castMagic" data-tooltip="UESRPG.Sheets.Magic.CastSpellPostDescription" aria-label="{{localize "UESRPG.Sheets.Magic.CastSpellPostDescription"}}"><i class="fas fa-dice-d20 magic-roll" aria-hidden="true"></i></button>
                                                        <img class="item-img" src="{{spell.img}}" alt="{{spell.name}}" />
                                                        <button type="button" data-action="itemOpen" class="item-name uesrpg-semantic-control uesrpg-plain-control">{{spell.name}}</button>
                                                    </td>
                                                    <td class="spell-rank-cell">
                                                        {{#if (eq spell.system.level 1)}}{{localize "UESRPG.Choices.Ranks.novice"}}{{/if}}
                                                        {{#if (eq spell.system.level 2)}}{{localize "UESRPG.Choices.Ranks.apprentice"}}{{/if}}
                                                        {{#if (eq spell.system.level 3)}}{{localize "UESRPG.Choices.Ranks.adept"}}{{/if}}
                                                        {{#if (eq spell.system.level 4)}}{{localize "UESRPG.Choices.Ranks.expert"}}{{/if}}
                                                        {{#if (eq spell.system.level 5)}}{{localize "UESRPG.Choices.Ranks.master"}}{{/if}}
                                                        {{#if (eq spell.system.level 6)}}{{localize "UESRPG.Choices.Ranks.grandmaster"}}{{/if}}
                                                        {{#if (eq spell.system.level 7)}}{{localize "UESRPG.Choices.Ranks.legendary"}}{{/if}}
                                                    </td>
                                                    <td class="spell-mp-cell">{{spell.system.cost}}</td>
                                                    <td class="spell-actions-cell">
                                                        <button type="button" data-action="itemDelete" class="item-delete uesrpg-semantic-control uesrpg-plain-control" data-tooltip="UESRPG.UI.Delete" aria-label="{{localize "UESRPG.UI.Delete"}}"><i class="fas fa-trash"></i></button>
                                                    </td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                </div>
                            {{/each}}
                        </div>
                    </div>

                    {{!-- Active Effects are shown on the Items tab. --}}

                    {{!-- Spell Effects Breakdown (Origin AE summaries) --}}
                    {{#if spellEffectsBreakdown.length}}
                    <div class="spell-effects-breakdown">
                        <button type="button" data-action="groupToggle" class="uesrpg-group-toggle u-cursor-pointer uesrpg-semantic-control uesrpg-plain-control" data-group="spell-effects-breakdown" aria-expanded="true">
                            <i class="fas fa-chevron-down collapse-arrow"></i>
                            {{localize "UESRPG.Sheets.Magic.SpellEffectsBreakdown"}}
                            <span class="spell-effect-count">({{spellEffectsBreakdown.length}})</span>
                        </button>
                        <div class="collapse-content">
                            {{#each spellEffectsBreakdown as |se|}}
                            <div class="spell-effect-entry">
                                <div class="spell-effect-header">
                                    <img src="{{se.img}}" class="spell-effect-img" alt="{{se.name}}" />
                                    <strong>{{se.name}}</strong>
                                    {{#if se.school}}<span class="spell-effect-school">({{se.school}})</span>{{/if}}
                                    {{#unless se.isSelf}}<span class="spell-effect-caster">{{localize "UESRPG.Sheets.Magic.ByCaster" caster=se.casterName}}</span>{{/unless}}
                                    <span class="spell-effect-duration">{{se.durationLabel}}</span>
                                    {{#if se.hasUpkeep}}<span class="spell-effect-upkeep">{{localize "UESRPG.Sheets.Magic.UpkeepCount" count=se.refreshCount}}</span>{{/if}}
                                    {{#if se.canCancel}}
                                    <button type="button" data-action="cancelSpell" class="uesrpg-cancel-spell uesrpg-semantic-control uesrpg-plain-control" data-effect-id="{{se.id}}" data-tooltip="UESRPG.Sheets.Magic.CancelSpell" aria-label="{{localize "UESRPG.Sheets.Magic.CancelSpell"}}">
                                        <i class="fas fa-times-circle"></i>
                                    </button>
                                    {{/if}}
                                </div>
                                {{#if se.modifiedKeys.length}}
                                <div class="spell-effect-details">
                                    {{#each se.modifiedKeys as |mk|}}
                                    <span class="spell-effect-tag">
                                        {{mk.label}}: {{mk.value}}
                                    </span>
                                    {{/each}}
                                </div>
                                {{/if}}
                                {{#if se.costPaid}}<div class="spell-effect-cost">{{localize "UESRPG.Sheets.Magic.CostMp" cost=se.costPaid}}{{#if se.linkedCount}} · {{localize "UESRPG.Sheets.Magic.LinkedCount" count=se.linkedCount}}{{/if}}</div>{{/if}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/if}}

                </div>
            </div>
