                                        <th data-action="itemCreate" class="item-name-cell item-create ues-col-name" id="createSelect"><div class="ues-th-content"><a data-action="groupToggle" class="uesrpg-group-toggle" data-group="gear" title="{{localize "UESRPG.UI.CollapseExpand"}}"><i class="fas fa-chevron-down"></i></a><span class="item-group-label">{{localize "UESRPG.Sheets.Equipment.Equipment"}}</span><span class="item-group-add" aria-hidden="true">+</span></div></th>
                                        <th class="ues-col-stat">{{localize "UESRPG.Sheets.Equipment.Qty"}}</th>
                                        <th class="ues-col-stat">ENC</th>
                                        <th class="ues-col-stat">{{localize "UESRPG.Sheets.Equipment.Price"}}</th>
                                        <th class="ues-col-actions"><i class="fas fa-trash"></i></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each actor.gear.equipped as |item id|}}
                                        <tr class="item active{{#if item._encIsTopContributor}} uesrpg-enc-top{{/if}}" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                                            <td class="item-name-cell ues-col-name">
                                                <div class="tableItemNameCell">
                                                    <div class="qty-controls">
                                                        <input type="checkbox" data-action="itemEquip" class="itemEquip checkbox" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}">
                                                    </div>
                                                    <img class="item-img" src="{{item.img}}" title="{{localize "UESRPG.UI.PostToChat"}}"/>
                                                    {{#if item.system.containerStats.contained}}
                                                        <i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" data-action="openContainer" class="fa-solid fa-backpack" data-container-id="{{item.system.containerStats.container_id}}"></i>
                                                    {{/if}}
                                                    <div data-action="itemOpen" class="item-name">{{item.name}}</div>
                                                    {{#if item.system.uiCastEnchantmentCharge}}
                                                        <span class="uesrpg-cast-charge-pill" title="{{localize "UESRPG.Sheets.Equipment.CastEnchantmentCharge"}}">{{item.system.uiCastEnchantmentCharge}}</span>
                                                    {{/if}}
                                                </div>
                                            </td>
                                            <td class="ues-col-stat">{{item.system.quantity}}</td>
                                            <td class="ues-col-stat">{{item.system.enc}}</td>
                                            <td class="ues-col-stat">{{item.system.price}}</td>
                                            <td class="ues-col-actions">
                                                <a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    {{/each}}
                                    {{#each actor.gear.unequipped as |item id|}}
                                        <tr class="item active{{#if item._encIsTopContributor}} uesrpg-enc-top{{/if}}" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                                            <td class="item-name-cell ues-col-name">
                                                <div class="tableItemNameCell">
                                                    <div class="qty-controls">
                                                        <input type="checkbox" data-action="itemEquip" class="itemEquip checkbox" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}">
                                                    </div>
                                                    <img class="item-img" src="{{item.img}}" title="{{localize "UESRPG.UI.PostToChat"}}"/>
                                                    {{#if item.system.containerStats.contained}}
                                                        <i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" data-action="openContainer" class="fa-solid fa-backpack" data-container-id="{{item.system.containerStats.container_id}}"></i>
                                                    {{/if}}
                                                    <div data-action="itemOpen" class="item-name">{{item.name}}</div>
                                                    {{#if item.system.uiCastEnchantmentCharge}}
                                                        <span class="uesrpg-cast-charge-pill" title="{{localize "UESRPG.Sheets.Equipment.CastEnchantmentCharge"}}">{{item.system.uiCastEnchantmentCharge}}</span>
                                                    {{/if}}
                                                </div>
                                            </td>
                                            <td class="ues-col-stat">{{item.system.quantity}}</td>
                                            <td class="ues-col-stat">{{item.system.enc}}</td>
                                            <td class="ues-col-stat">{{item.system.price}}</td>
                                            <td class="ues-col-actions">
                                                <a data-action="itemDelete" class="item-control item-delete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    {{/each}}
                                </tbody>
                            </table>

                        </div>
                    </div>
                    </div>
                </div>
            </div>
