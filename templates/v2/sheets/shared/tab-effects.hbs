<div class="tab effects" data-group="primary" data-tab="effects" data-ues-section="effects-tab">
  <div class="effectsTabContainer">
    <div class="uesrpg-panel uesrpg-panel--subtle uesrpg-equipment-effects-section">
      <header class="effects-header flexrow">
        <h3>{{localize "UESRPG.Sheets.Equipment.Effects"}}</h3>
        <a data-action="effectControl" class="effect-control" data-effect-action="create" title="{{localize "UESRPG.Sheets.Equipment.CreateEffect"}}">
          <i class="fas fa-plus"></i>
        </a>
      </header>
      <ol class="effects-list uesrpg-equipment-effects-list">
        {{#each effects as |effect|}}
          <li class="effect flexrow" data-effect-id="{{effect._id}}">
            <img class="effect-icon" src="{{effect.img}}" />
            <div class="effect-summary">
              <h4 class="effect-name">{{effect.name}}</h4>
              {{#if effect.badges.length}}
                <div class="effect-badges">
                  {{#each effect.badges as |badge|}}
                    <span class="effect-meta-badge {{badge.class}}" title="{{badge.title}}">{{badge.label}}</span>
                  {{/each}}
                </div>
              {{/if}}
            </div>
            <div class="effect-controls flexrow">
              <a data-action="effectControl" class="effect-control" data-effect-action="toggle" data-effect-id="{{effect._id}}" title="{{localize "UESRPG.Sheets.Equipment.ToggleEffect"}}">
                <i class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
              </a>
              <a data-action="effectControl" class="effect-control" data-effect-action="edit" data-effect-id="{{effect._id}}" title="{{localize "UESRPG.Sheets.Equipment.EditEffect"}}"><i class="fas fa-edit"></i></a>
              <a data-action="effectControl" class="effect-control" data-effect-action="delete" data-effect-id="{{effect._id}}" title="{{localize "UESRPG.Sheets.Equipment.DeleteEffect"}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
        {{/each}}
      </ol>
      {{#unless effects.length}}
        <p class="effects-empty-msg">{{localize "UESRPG.Sheets.Equipment.NoActiveEffects"}}</p>
      {{/unless}}
    </div>
  </div>
</div>
