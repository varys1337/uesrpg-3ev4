<div class="uesrpg-item-sheet-header-part">
<header class="item-compact-header">
    <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-image-action" data-action="editPortrait" data-edit="img" data-tooltip-text="{{item.name}}" aria-label="{{item.name}}"><img class="profile-img" alt="" src="{{item.img}}" width="64" height="64" aria-hidden="true"></button>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <input type="number" name="system.quantity" value="{{#if item.system.quantity}}{{item.system.quantity}}{{else}}0{{/if}}"/>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Quantity"}}</span>
            </div>
            <div class="item-stat">
                <input type="number" name="system.enc" value="{{#if item.system.enc}}{{item.system.enc}}{{else}}0{{/if}}" min="0" step="0.1"/>
                <span class="item-stat-label">{{localize "UESRPG.UI.ENC"}}</span>
            </div>
            <div class="item-stat">
                <input type="number" name="system.price" value="{{#if item.system.price}}{{item.system.price}}{{else}}0{{/if}}"/>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Equipment.Price"}}</span>
            </div>
        </div>
    </div>
</header>
</div>
