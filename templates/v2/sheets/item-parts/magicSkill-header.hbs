<div class="uesrpg-item-sheet-header-part">
<header class="item-compact-header">
    <img class="profile-img" alt="{{item.name}}" src="{{item.img}}" data-edit="img" data-action="editPortrait" data-tooltip-text="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <label>{{item.system.value}}</label>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.TargetNumber"}}</span>
            </div>
            <div class="item-stat">
                <select name="system.rank" data-type="String">
                    {{selectOptions skillRankOptions selected=item.system.rank localize=true}}
                </select>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Rank"}}</span>
            </div>
            <div class="item-stat">
                <input type="text" name="system.governingCha" value="{{item.system.governingCha}}"/>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.GoverningChar"}}</span>
            </div>
            <div class="item-stat">
                <select name="system.baseCha" data-type="String">
                    {{selectOptions characteristicOptions selected=item.system.baseCha}}
                </select>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.SelectedChar"}}</span>
            </div>
        </div>
        <div class="item-specialization-row">
            <input type="text" name="system.trainedItems" value="{{item.system.trainedItems}}" data-dtype="String" placeholder="{{localize "UESRPG.Sheets.Item.Specialization"}}"/>
            <span class="uesrpg-field-hint">{{localize "UESRPG.Sheets.Item.SpecializationHint"}}</span>
        </div>
    </div>
</header>
</div>
