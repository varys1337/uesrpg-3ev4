<div class="uesrpg-item-sheet-header-part">
<header class="item-compact-header">
    <img class="profile-img" alt="{{item.name}}" src="{{item.img}}" data-edit="img" data-action="editPortrait" data-tooltip-text="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.Sheets.Item.ScrollName"}}"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <input type="number" name="system.quantity" value="{{#if item.system.quantity}}{{item.system.quantity}}{{else}}1{{/if}}" min="0"/>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Quantity"}}</span>
            </div>
            <div class="item-stat">
                <input type="number" name="system.enc" value="{{#if item.system.enc}}{{item.system.enc}}{{else}}0{{/if}}" min="0" step="0.1"/>
                <span class="item-stat-label">{{localize "UESRPG.UI.ENC"}}</span>
            </div>
        </div>
    </div>
</header>
</div>
