<div class="uesrpg-item-sheet-header-part">
<header class="item-compact-header">
  <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-image-action" data-action="editPortrait" data-edit="img" data-tooltip-text="{{item.name}}" aria-label="{{item.name}}"><img class="profile-img" alt="" src="{{item.img}}" width="64" height="64" aria-hidden="true"></button>
  <div class="item-header-fields">
    <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
    <div class="item-stats-row">
      <div class="item-stat">
        <input type="text" name="system.level" value="{{item.system.level}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Chat.Magic.Level"}}</span>
      </div>
      <div class="item-stat">
        <input type="text" name="system.governingCharacteristics" value="{{item.system.governingCharacteristics}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.GoverningChars"}}</span>
      </div>
      <div class="item-stat">
        <input type="number" name="system.xpCost" value="{{item.system.xpCost}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.XPCost"}}</span>
      </div>
      <div class="item-stat">
        <input type="text" name="system.talentReq" value="{{item.system.talentReq}}"/>
        <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Requirements"}}</span>
      </div>
    </div>
  </div>
</header>
</div>

