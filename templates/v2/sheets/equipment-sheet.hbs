<section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
        <div class="item-description-container">
            <div class="basic-padding">
                <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
            </div>
        </div>
    </div>

    {{!-- Attributes Tab --}}
    <div class="tab" data-group="primary" data-tab="attributes">
        <div class="attribute-tab-container">
            <div class="item-selection-container">
                        <h2>{{localize "UESRPG.Sheets.Item.Attributes"}}</h2>
                        <div class="selection-container">
                            {{> "systems/uesrpg-3ev4/templates/partials/sheets/soul-energy-panel.hbs"}}
                            {{> "systems/uesrpg-3ev4/templates/partials/sheets/alchemy-panel.hbs"}}
                            <div class="grid-container">
                                <div>{{localize "UESRPG.Sheets.Item.WearableItem"}}</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.wearable" {{checked item.system.wearable}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>{{localize "UESRPG.Sheets.Item.Equipped"}}</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                                </div>
                            </div>
                            {{#if showEnchantingInterface}}
                            {{> "systems/uesrpg-3ev4/templates/partials/sheets/item-enchanting-interface.hbs"}}
                            {{/if}}
                        </div>
                    </div>
                    <div class="attribute-container">
                        <div class="item-characteristic-container">
                            <h2>{{localize "UESRPG.Sheets.Item.Characteristics"}}</h2>
                            <div class="modifier-container">
                                {{#if item.system.characteristicBonus}}
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Strength"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.strChaBonus" value="{{#if item.system.characteristicBonus.strChaBonus}}{{item.system.characteristicBonus.strChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Endurance"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.endChaBonus" value="{{#if item.system.characteristicBonus.endChaBonus}}{{item.system.characteristicBonus.endChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Agility"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.agiChaBonus" value="{{#if item.system.characteristicBonus.agiChaBonus}}{{item.system.characteristicBonus.agiChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Intelligence"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.intChaBonus" value="{{#if item.system.characteristicBonus.intChaBonus}}{{item.system.characteristicBonus.intChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Willpower"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.wpChaBonus" value="{{#if item.system.characteristicBonus.wpChaBonus}}{{item.system.characteristicBonus.wpChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Perception"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.prcChaBonus" value="{{#if item.system.characteristicBonus.prcChaBonus}}{{item.system.characteristicBonus.prcChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Personality"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.prsChaBonus" value="{{#if item.system.characteristicBonus.prsChaBonus}}{{item.system.characteristicBonus.prsChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.UI.Luck"}}</div>
                                    <div><input type="number" name="system.characteristicBonus.lckChaBonus" value="{{#if item.system.characteristicBonus.lckChaBonus}}{{item.system.characteristicBonus.lckChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                {{else}}
                                <div class="u-text-center u-text-italic attr-empty-hint">
                                    {{localize "UESRPG.Sheets.Item.NoCharacteristicBonuses"}}
                                </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="item-resistance-container">
                            <h2>{{localize "UESRPG.Sheets.Item.Resistances"}}</h2>
                            <div class="modifier-container">
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Feature.DamageType.Disease"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.diseaseR" value="{{#if item.system.diseaseR}}{{item.system.diseaseR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Feature.DamageType.Fire"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.fireR" value="{{#if item.system.fireR}}{{item.system.fireR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Feature.DamageType.Frost"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.frostR" value="{{#if item.system.frostR}}{{item.system.frostR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Feature.DamageType.Shock"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.shockR" value="{{#if item.system.shockR}}{{item.system.shockR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Feature.DamageType.Poison"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.poisonR" value="{{#if item.system.poisonR}}{{item.system.poisonR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Feature.DamageType.Magic"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.magicR" value="{{#if item.system.magicR}}{{item.system.magicR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Item.Toughness"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.natToughnessR" value="{{#if item.system.natToughnessR}}{{item.system.natToughnessR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Item.Silver"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.silverR" value="{{#if item.system.silverR}}{{item.system.silverR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>{{localize "UESRPG.Sheets.Item.Sunlight"}}</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.sunlightR" value="{{#if item.system.sunlightR}}{{item.system.sunlightR}}{{else}}0{{/if}}"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

    </div>


    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
        {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
    </div>
</section>
