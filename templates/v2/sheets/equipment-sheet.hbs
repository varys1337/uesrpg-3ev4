{{!-- Equipment Sheet (Generic) --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="Name"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <input type="number" name="system.quantity" value="{{#if item.system.quantity}}{{item.system.quantity}}{{else}}0{{/if}}"/>
                <span class="item-stat-label">Quantity</span>
            </div>
            <div class="item-stat">
                <input type="number" name="system.enc" value="{{#if item.system.enc}}{{item.system.enc}}{{else}}0{{/if}}"/>
                <span class="item-stat-label">ENC</span>
            </div>
            <div class="item-stat">
                <input type="number" name="system.price" value="{{#if item.system.price}}{{item.system.price}}{{else}}0{{/if}}"/>
                <span class="item-stat-label">Price</span>
            </div>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">Description</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">Effects</a>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">

    {{!-- Description Tab --}}
    <div class="tab" data-group="primary" data-tab="description">
        <div class="item-description-container">
            <div class="basic-padding">
                <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
            </div>
        </div>
    </div>

    {{!-- Attributes Tab --}}
    <div class="tab" data-group="primary" data-tab="attributes">
        <div class="attribute-tab-container">
            <div class="item-selection-container">
                        <h2>Attributes</h2>
                        <div class="selection-container">
                            <div class="grid-container">
                                <div>Alchemy</div>
                                <div class="right-align-content">
                                    {{#if isAlchemyIngredient}}
                                    <button type="button" data-action="clearAlchemyIngredient">
                                        <i class="fas fa-times"></i> Remove Ingredient
                                    </button>
                                    {{else}}
                                    <button type="button" data-action="enableAlchemyIngredient">
                                        <i class="fas fa-flask"></i> Enable Ingredient
                                    </button>
                                    {{/if}}
                                    {{#if isAlchemyProduct}}
                                    <button type="button" data-action="clearAlchemyProduct">
                                        <i class="fas fa-times"></i> Remove Product
                                    </button>
                                    {{else}}
                                    <button type="button" data-action="enableAlchemyProduct">
                                        <i class="fas fa-vial"></i> Enable Product
                                    </button>
                                    {{/if}}
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Wearable Item</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.wearable" {{checked item.system.wearable}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Equipped</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Charge Reduction</div>
                                <div class="right-align-content">
                                    {{!-- Guard: defensive access for charge.reduction with default 0 --}}
                                    <input type="number" name="system.charge.reduction" value="{{#if item.system.charge.reduction}}{{item.system.charge.reduction}}{{else}}0{{/if}}">
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Enchant Level</div>
                                <div class="right-align-content">
                                    <input type="number" name="system.enchant_level" value="{{#if item.system.enchant_level}}{{item.system.enchant_level}}{{else}}0{{/if}}">
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Charge</div>
                                <div class="right-align-content enchant-inline enchant-charge-inline">
                                    <button type="button" class="uesrpg-charge-btn" data-action="chargeMinus" title="Decrease current charge">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input type="number" name="system.charge.value" value="{{#if item.system.charge.value}}{{item.system.charge.value}}{{else}}0{{/if}}" class="enchant-charge-input"/>
                                    <span class="enchant-charge-sep">/</span>
                                    <input type="number" name="system.charge.max" value="{{#if item.system.charge.max}}{{item.system.charge.max}}{{else}}0{{/if}}" class="enchant-charge-input"/>
                                    <button type="button" class="uesrpg-charge-btn" data-action="chargePlus" title="Increase current charge">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="attribute-container">
                        <div class="item-characteristic-container">
                            <h2>Characteristics</h2>
                            <div class="modifier-container">
                                {{#if item.system.characteristicBonus}}
                                <div class="grid-container">
                                    <div>Strength</div>
                                    <div><input type="number" name="system.characteristicBonus.strChaBonus" value="{{#if item.system.characteristicBonus.strChaBonus}}{{item.system.characteristicBonus.strChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Endurance</div>
                                    <div><input type="number" name="system.characteristicBonus.endChaBonus" value="{{#if item.system.characteristicBonus.endChaBonus}}{{item.system.characteristicBonus.endChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Agility</div>
                                    <div><input type="number" name="system.characteristicBonus.agiChaBonus" value="{{#if item.system.characteristicBonus.agiChaBonus}}{{item.system.characteristicBonus.agiChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Intelligence</div>
                                    <div><input type="number" name="system.characteristicBonus.intChaBonus" value="{{#if item.system.characteristicBonus.intChaBonus}}{{item.system.characteristicBonus.intChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Willpower</div>
                                    <div><input type="number" name="system.characteristicBonus.wpChaBonus" value="{{#if item.system.characteristicBonus.wpChaBonus}}{{item.system.characteristicBonus.wpChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Perception</div>
                                    <div><input type="number" name="system.characteristicBonus.prcChaBonus" value="{{#if item.system.characteristicBonus.prcChaBonus}}{{item.system.characteristicBonus.prcChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Personality</div>
                                    <div><input type="number" name="system.characteristicBonus.prsChaBonus" value="{{#if item.system.characteristicBonus.prsChaBonus}}{{item.system.characteristicBonus.prsChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Luck</div>
                                    <div><input type="number" name="system.characteristicBonus.lckChaBonus" value="{{#if item.system.characteristicBonus.lckChaBonus}}{{item.system.characteristicBonus.lckChaBonus}}{{else}}0{{/if}}"></div>
                                </div>
                                {{else}}
                                <div class="u-text-center u-text-italic attr-empty-hint">
                                    No characteristic bonuses (defaults to 0)
                                </div>
                                {{/if}}
                            </div>
                        </div>
                        <div class="item-resistance-container">
                            <h2>Resistances</h2>
                            <div class="modifier-container">
                                <div class="grid-container">
                                    <div>Disease</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.diseaseR" value="{{#if item.system.diseaseR}}{{item.system.diseaseR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Fire</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.fireR" value="{{#if item.system.fireR}}{{item.system.fireR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Frost</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.frostR" value="{{#if item.system.frostR}}{{item.system.frostR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Shock</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.shockR" value="{{#if item.system.shockR}}{{item.system.shockR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Poison</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.poisonR" value="{{#if item.system.poisonR}}{{item.system.poisonR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Magic</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.magicR" value="{{#if item.system.magicR}}{{item.system.magicR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Toughness</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.natToughnessR" value="{{#if item.system.natToughnessR}}{{item.system.natToughnessR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Silver</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.silverR" value="{{#if item.system.silverR}}{{item.system.silverR}}{{else}}0{{/if}}"></div>
                                </div>
                                <div class="grid-container">
                                    <div>Sunlight</div>
                                    {{!-- Guard: defensive access with default 0 --}}
                                    <div><input type="number" name="system.sunlightR" value="{{#if item.system.sunlightR}}{{item.system.sunlightR}}{{else}}0{{/if}}"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {{!-- Alchemy Ingredient Section --}}
                {{#if isAlchemyIngredient}}
                <div class="item-alchemy-section uesrpg-panel u-mt-sm">
                    <h2>Alchemy Ingredient</h2>
                    <div class="grid-container">
                        <div>School</div>
                        <div>
                            <select name="flags.uesrpg-3ev4.alchemy.school">
                                <option value="alteration" {{#if (eq alchemyData.school "alteration")}}selected{{/if}}>Alteration</option>
                                <option value="conjuration" {{#if (eq alchemyData.school "conjuration")}}selected{{/if}}>Conjuration</option>
                                <option value="destruction" {{#if (eq alchemyData.school "destruction")}}selected{{/if}}>Destruction</option>
                                <option value="illusion" {{#if (eq alchemyData.school "illusion")}}selected{{/if}}>Illusion</option>
                                <option value="mysticism" {{#if (eq alchemyData.school "mysticism")}}selected{{/if}}>Mysticism</option>
                                <option value="restoration" {{#if (eq alchemyData.school "restoration")}}selected{{/if}}>Restoration</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid-container">
                        <div>Strength Base</div>
                        <div><input type="number" name="flags.uesrpg-3ev4.alchemy.strengthBase" value="{{alchemyData.strengthBase}}" min="1" max="20"></div>
                    </div>
                    <div class="grid-container">
                        <div>Depth Base</div>
                        <div><input type="number" name="flags.uesrpg-3ev4.alchemy.depthBase" value="{{alchemyData.depthBase}}" min="1" max="10"></div>
                    </div>
                    <div class="grid-container u-mt-xs">
                        <div></div>
                        <div>
                            <button type="button" data-action="clearAlchemyIngredient">
                                <i class="fas fa-times"></i> Remove Ingredient Type
                            </button>
                        </div>
                    </div>
                </div>
                {{/if}}

                {{!-- Alchemy Product Section (Potion / Poison / Toxin) --}}
                {{#if isAlchemyProduct}}
                <div class="item-alchemy-product-section uesrpg-panel u-mt-sm">
                    <h2>Alchemy Product</h2>

                    <div class="grid-container">
                        <div>Kind</div>
                        <div>
                            <select name="flags.uesrpg-3ev4.alchemy.kind">
                                <option value="potion" {{#if (eq alchemyProduct.kind "potion")}}selected{{/if}}>Potion</option>
                                <option value="poison" {{#if (eq alchemyProduct.kind "poison")}}selected{{/if}}>Poison</option>
                                <option value="toxin" {{#if (eq alchemyProduct.kind "toxin")}}selected{{/if}}>Toxin</option>
                            </select>
                        </div>
                    </div>

                    {{#if (eq alchemyProduct.kind "poison")}}
                    <div class="grid-container">
                        <div>Poison Level</div>
                        <div><input type="number" name="flags.uesrpg-3ev4.alchemy.poisonLevel" value="{{alchemyProduct.poisonLevel}}" min="1"></div>
                    </div>
                    <div class="grid-container">
                        <div>Damage Formula</div>
                        <div><input type="text" name="flags.uesrpg-3ev4.alchemy.damageFormula" value="{{alchemyProduct.damageFormula}}"></div>
                    </div>
                    {{/if}}

                    {{#if (eq alchemyProduct.kind "toxin")}}
                    <div class="grid-container">
                        <div>Duration (Rounds)</div>
                        <div><input type="number" name="flags.uesrpg-3ev4.alchemy.durationRounds" value="{{alchemyProduct.durationRounds}}" min="1"></div>
                    </div>
                    <div class="grid-container">
                        <div>Max Hits</div>
                        <div><input type="number" name="flags.uesrpg-3ev4.alchemy.maxHits" value="{{alchemyProduct.maxHits}}" min="1"></div>
                    </div>
                    {{/if}}

                    {{!-- Potion/ToXin effects list (display only; authored by the Alchemy Workshop) --}}
                    {{#if (or (eq alchemyProduct.kind "potion") (eq alchemyProduct.kind "toxin"))}}
                    <div class="u-mt-xs">
                        <h3 style="margin: 0.25rem 0;">Effects</h3>
                        {{#if alchemyProduct.effects.length}}
                        <ul class="u-list-compact">
                            {{#each alchemyProduct.effects as |e|}}
                            <li><b>{{e.label}}</b> (SL {{e.spellLevel}})</li>
                            {{/each}}
                        </ul>
                        {{else}}
                        <div class="u-text-italic">No effects set (use the Alchemy Workshop to brew).</div>
                        {{/if}}
                    </div>
                    {{/if}}

                    <div class="grid-container u-mt-xs">
                        <div>Backfired</div>
                        <div class="right-align-content">
                            <input class="checkbox" type="checkbox" name="flags.uesrpg-3ev4.alchemy.backfired" {{checked alchemyProduct.backfired}}>
                        </div>
                    </div>

                    <div class="grid-container u-mt-xs">
                        <div></div>
                        <div class="right-align-content" style="display:flex; gap:0.35rem; flex-wrap:wrap; justify-content:flex-end;">
                            {{#if (eq alchemyProduct.kind "potion")}}
                            <button type="button" data-action="drinkAlchemyProduct">
                                <i class="fas fa-glass-whiskey"></i> Drink
                            </button>
                            {{else}}
                            <button type="button" data-action="applyAlchemyProductToWeapon">
                                <i class="fas fa-syringe"></i> Apply to Weapon
                            </button>
                            {{/if}}
                            <button type="button" data-action="clearAlchemyProduct">
                                <i class="fas fa-times"></i> Remove Product Type
                            </button>
                        </div>
                    </div>
                </div>
                {{/if}}

    </div>


    {{!-- Effects Tab --}}
    <div class="tab effects" data-group="primary" data-tab="effects">
        {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
    </div>
</section>

