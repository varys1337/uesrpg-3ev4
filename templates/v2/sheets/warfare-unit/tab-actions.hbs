{{!-- templates/v2/sheets/warfare-unit/tab-actions.hbs --}}
<div class="tab actions" data-group="primary" data-tab="actions">
  <div class="tabContainer">
    <div class="warfare-sheet-content">

      {{#unless warfareEnabled}}
      <div class="warfare-callout warfare-callout--warning" role="status">
        <h3>{{localize "UESRPG.Sheets.WarfareUnit.MechanicsDisabledTitle"}}</h3>
        <p>{{warfareMechanicsDisabledMessage}}</p>
      </div>
      {{else}}

      <div class="warfare-clash-section">
        <button type="button" class="warfare-clash-btn uesrpg-styled-action" data-action="initiateClash"
          data-tooltip-text="{{localize "UESRPG.ModernUI.TargetOneEnemyWarfareUnitTokenThenChooseMeleeOrRangedAndResolveAClashWit"}}" aria-label="{{localize "UESRPG.ModernUI.TargetOneEnemyWarfareUnitTokenThenChooseMeleeOrRangedAndResolveAClashWit"}}">
          &#9876; {{localize "UESRPG.Sheets.WarfareUnit.InitiateClash"}}
        </button>
        <button type="button" class="warfare-clash-btn uesrpg-styled-action" data-action="startMixedOpposed"
          data-tooltip-text="{{localize "UESRPG.ModernUI.TargetOnePCOrNPCTokenToStartAnExplicitMixedWarfareOpposedCard"}}" aria-label="{{localize "UESRPG.ModernUI.TargetOnePCOrNPCTokenToStartAnExplicitMixedWarfareOpposedCard"}}">
          {{localize "UESRPG.Sheets.WarfareUnit.StrikeCharacter"}}
        </button>
        <button type="button" class="warfare-clash-btn warfare-clash-btn--discipline uesrpg-styled-action" data-action="rollDiscipline"
          data-tooltip-text="{{localize "UESRPG.ModernUI.RollAGeneralDisciplineTestForThisUnit"}}" aria-label="{{localize "UESRPG.ModernUI.RollAGeneralDisciplineTestForThisUnit"}}">
          {{localize "UESRPG.Sheets.WarfareUnit.RollDiscipline"}}
        </button>
      </div>

      <div class="warfare-action-columns">
        <div class="warfare-action-column">
          <h3 class="warfare-action-column__header">{{localize "UESRPG.Sheets.WarfareUnit.LeaderActions"}}</h3>
          <div class="warfare-action-column__list">
            {{#each leaderActions}}
            <button type="button"
              class="warfare-action-btn uesrpg-styled-action"
              data-action="rollWarfareAction"
              data-action-id="{{this.id}}"
              data-action-type="leader"
              data-tooltip-text="{{this.summary}}" aria-label="{{this.summary}}">{{this.label}}</button>
            {{else}}
            <p class="warfare-hint">{{localize "UESRPG.Sheets.WarfareUnit.NoLeaderActions"}}</p>
            {{/each}}
          </div>
        </div>

        <div class="warfare-action-column">
          <h3 class="warfare-action-column__header">{{localize "UESRPG.Sheets.WarfareUnit.UnitActions"}}</h3>
          <div class="warfare-action-column__list">
            {{#each unitActions}}
            <button type="button"
              class="warfare-action-btn uesrpg-styled-action"
              data-action="rollWarfareAction"
              data-action-id="{{this.id}}"
              data-action-type="unit"
              data-tooltip-text="{{this.summary}}" aria-label="{{this.summary}}">{{this.label}}</button>
            {{else}}
            <p class="warfare-hint">{{localize "UESRPG.Sheets.WarfareUnit.NoUnitActions"}}</p>
            {{/each}}
          </div>
        </div>
      </div>

      <fieldset class="warfare-fieldset">
        <legend>{{localize "UESRPG.Sheets.WarfareUnit.BattleState"}}</legend>
        <div class="warfare-form-grid">
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.hidden" {{checked system.status.battle.hidden}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.Hidden"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.ambushReady" {{checked system.status.battle.ambushReady}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.AmbushReady"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.broken" {{checked system.status.battle.broken}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.Broken"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.suppressed" {{checked system.status.battle.suppressed}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.Suppressed"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.defeated" {{checked system.status.battle.defeated}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.Defeated"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.frenzied" {{checked system.status.battle.frenzied}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.Frenzied"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.battle.flyer" {{checked system.status.battle.flyer}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.BattleStateValues.Flyer"}}</label></div>
          <div class="form-group"><label><input type="checkbox" name="system.status.leaderless" {{checked system.status.leaderless}} {{#unless editable}}disabled{{/unless}}> {{localize "UESRPG.Sheets.WarfareUnit.Leaderless"}}</label></div>
        </div>
      </fieldset>

      {{/unless}}

    </div>
  </div>
</div>
