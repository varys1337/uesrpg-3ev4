{{!-- templates/v2/sheets/warfare-unit/tab-items.hbs --}}
<div class="tab items" data-group="primary" data-tab="items">
  <div class="tabContainer">
    <div class="warfare-sheet-content">

      <fieldset class="warfare-fieldset">
        <legend>Upkeep</legend>
        <div class="warfare-form-grid">
          <div class="form-group">
            <label for="wf-economy-cadence">Payment Cadence</label>
            <select id="wf-economy-cadence" name="system.economy.cadence" {{#unless editable}}disabled{{/unless}}>
              {{#each economy.supportedCadences}}
              <option value="{{this}}" {{#if (eq this ../economy.cadence)}}selected{{/if}}>{{capitalize this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label for="wf-economy-mode">Payment Mode</label>
            <select id="wf-economy-mode" name="system.economy.mode" {{#unless editable}}disabled{{/unless}}>
              {{#each economy.supportedModes}}
              <option value="{{this}}" {{#if (eq this ../economy.mode)}}selected{{/if}}>{{capitalize this}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>Amount</label>
            <input type="number" name="system.economy.amount" value="{{economy.amount}}" {{#unless editable}}disabled{{/unless}} min="0">
          </div>
          <div class="form-group">
            <label>Unpaid Weeks</label>
            <input type="number" name="system.economy.unpaidWeeks" value="{{economy.unpaidWeeks}}" {{#unless editable}}disabled{{/unless}} min="0">
          </div>
          <div class="form-group">
            <label>Special Modifier</label>
            <input type="number" name="system.economy.specialModifier" value="{{economy.specialModifier}}" {{#unless editable}}disabled{{/unless}}>
          </div>
          <div class="form-group">
            <label><input type="checkbox" name="system.economy.enslaved" {{checked economy.enslaved}} {{#unless editable}}disabled{{/unless}}> Enslaved</label>
          </div>
        </div>
        <p class="warfare-hint">Derived weekly upkeep: <strong>{{derived.weeklyUpkeep}} gp</strong>.</p>
      </fieldset>

      <fieldset class="warfare-fieldset">
        <legend>Apparel and Mounts</legend>
        <div class="warfare-form-grid">
          <div class="form-group">
            <label for="wf-apparel">Apparel</label>
            <select id="wf-apparel" name="system.gear.apparel" {{#unless editable}}disabled{{/unless}}>
              {{#each apparelOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label for="wf-mount">Mount</label>
            <select id="wf-mount" name="system.mounts.primary" {{#unless editable}}disabled{{/unless}}>
              {{#each mountOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label>Gear Sets</label>
            <input type="number" name="system.gear.sets" value="{{system.gear.sets}}" {{#unless editable}}disabled{{/unless}} min="0">
          </div>
        </div>
        <div class="warfare-form-grid warfare-form-grid--readonly">
          <div class="form-group">
            <label>DMG</label>
            <span class="warfare-derived-value">{{system.gear.dmg}}</span>
          </div>
          <div class="form-group">
            <label>AR</label>
            <span class="warfare-derived-value">{{system.gear.ar}}</span>
          </div>
          <div class="form-group">
            <label>MAR</label>
            <span class="warfare-derived-value">{{system.gear.mar}}</span>
          </div>
          <div class="form-group">
            <label>Speed</label>
            <span class="warfare-derived-value">{{system.stats.speed.value}}</span>
          </div>
          <div class="form-group">
            <label>Mount Trait</label>
            <span class="warfare-derived-value">{{derived.mountTrait}}</span>
          </div>
        </div>
      </fieldset>

      <fieldset class="warfare-fieldset">
        <legend>Deployables and Support Equipment</legend>
        {{#if editable}}
        <button type="button" data-action="addOwnedEquipment" class="warfare-btn warfare-btn--small"><i class="fas fa-plus"></i> Add Equipment</button>
        {{/if}}
        {{#each equipmentOwned}}
        <div class="warfare-equipment-row" data-owned-index="{{@index}}">
          <input type="text" name="system.equipment.owned.{{@index}}.key" value="{{this.key}}" placeholder="Catalog Key" {{#unless ../editable}}disabled{{/unless}}>
          <input type="text" name="system.equipment.owned.{{@index}}.name" value="{{this.name}}" placeholder="Display Name" {{#unless ../editable}}disabled{{/unless}}>
          <input type="number" name="system.equipment.owned.{{@index}}.deployTime" value="{{this.deployTime}}" min="1" {{#unless ../editable}}disabled{{/unless}}>
          <input type="number" name="system.equipment.owned.{{@index}}.deployProgress" value="{{this.deployProgress}}" min="0" {{#unless ../editable}}disabled{{/unless}}>
          <label><input type="checkbox" name="system.equipment.owned.{{@index}}.deployed" {{checked this.deployed}} {{#unless ../editable}}disabled{{/unless}}> Deployed</label>
          <label><input type="checkbox" name="system.equipment.owned.{{@index}}.expended" {{checked this.expended}} {{#unless ../editable}}disabled{{/unless}}> Expended</label>
          <input type="text" name="system.equipment.owned.{{@index}}.placement" value="{{this.placement}}" placeholder="Placement" {{#unless ../editable}}disabled{{/unless}}>
          <input type="text" name="system.equipment.owned.{{@index}}.effect" value="{{this.effect}}" placeholder="Effect" {{#unless ../editable}}disabled{{/unless}}>
          {{#if ../editable}}
          <button type="button" data-action="deployOwnedEquipmentToRegion" data-owned-index="{{@index}}" class="warfare-btn warfare-btn--small" title="Deploy to Region"><i class="fas fa-location-arrow"></i></button>
          <button type="button" data-action="configureOwnedEquipmentRegion" data-owned-index="{{@index}}" class="warfare-btn warfare-btn--small" title="Configure Region"><i class="fas fa-draw-polygon"></i></button>
          <button type="button" data-action="removeOwnedEquipment" data-owned-index="{{@index}}" class="warfare-btn warfare-btn--icon" title="Remove"><i class="fas fa-trash"></i></button>
          {{/if}}
        </div>
        {{else}}
        <p class="warfare-hint">No support equipment configured.</p>
        {{/each}}
      </fieldset>

      {{#if derived.equipmentEntries.length}}
      <fieldset class="warfare-fieldset">
        <legend>Derived Equipment Summary</legend>
        <div class="warfare-action-column__list">
          {{#each derived.equipmentEntries}}
          <div class="warfare-effect-row">
            <span><strong>{{this.name}}</strong></span>
            <span>Deploy {{this.deployTime}}</span>
            <span class="warfare-effect-row__status">{{#if this.isBattleScroll}}Battle Scroll{{else}}Support{{/if}}</span>
          </div>
          {{/each}}
        </div>
      </fieldset>
      {{/if}}

      <fieldset class="warfare-fieldset">
        <legend>Active Effects</legend>
        {{#each effects}}
        <div class="warfare-effect-row">
          <img src="{{this.img}}" alt="{{this.name}}" width="24" height="24">
          <span>{{this.name}}</span>
          <span class="warfare-effect-row__status">{{#if this.disabled}}(Disabled){{/if}}</span>
          <button type="button" data-action="editEffect" data-effect-id="{{this.id}}" class="warfare-btn warfare-btn--icon" title="Edit"><i class="fas fa-edit"></i></button>
          {{#if ../editable}}
          <button type="button" data-action="deleteEffect" data-effect-id="{{this.id}}" class="warfare-btn warfare-btn--icon" title="Delete"><i class="fas fa-trash"></i></button>
          {{/if}}
        </div>
        {{else}}
        <p class="warfare-hint">No active effects.</p>
        {{/each}}
        {{#if editable}}
        <button type="button" data-action="createEffect" class="warfare-btn warfare-btn--small"><i class="fas fa-plus"></i> Add Effect</button>
        {{/if}}
      </fieldset>

      {{#if hasLegacyDeployableEquipment}}
      <fieldset class="warfare-fieldset warfare-fieldset--legacy">
        <legend>Legacy Deployables</legend>
        <p class="warfare-hint">Legacy `system.deployableEquipment[]` data is preserved until it is manually migrated into Deployables and Support Equipment.</p>
        {{#if editable}}
        <button type="button" data-action="addEquipment" class="warfare-btn warfare-btn--small"><i class="fas fa-plus"></i> Add Legacy Deployable</button>
        {{/if}}
        {{#each system.deployableEquipment}}
        <div class="warfare-equipment-row" data-equip-index="{{@index}}">
          <input type="text" name="system.deployableEquipment.{{@index}}.name" value="{{this.name}}" placeholder="Item Name" {{#unless ../editable}}disabled{{/unless}}>
          <input type="number" name="system.deployableEquipment.{{@index}}.deployTime" value="{{this.deployTime}}" min="0" {{#unless ../editable}}disabled{{/unless}}>
          <input type="text" name="system.deployableEquipment.{{@index}}.effect" value="{{this.effect}}" placeholder="Effect" {{#unless ../editable}}disabled{{/unless}}>
          {{#if ../editable}}
          <button type="button" data-action="removeEquipment" data-equip-index="{{@index}}" class="warfare-btn warfare-btn--icon" title="Remove"><i class="fas fa-trash"></i></button>
          {{/if}}
        </div>
        {{/each}}
      </fieldset>
      {{/if}}

      <fieldset class="warfare-fieldset">
        <legend>Rules Source</legend>
        <p><strong>{{system.rules.source}}</strong> v{{system.rules.version}}</p>
      </fieldset>

    </div>
  </div>
</div>
