{{!-- Skill Sheet - Compact Layout --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <label>{{item.system.value}}</label>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.TargetNumber"}}</span>
            </div>
            <div class="item-stat">
                <select name="system.rank" data-type="String">
                    {{selectOptions skillRankOptions selected=item.system.rank localize=true}}
                </select>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Rank"}}</span>
            </div>
            <div class="item-stat">
                <input type="text" name="system.governingCha" value="{{item.system.governingCha}}"/>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.GoverningChar"}}</span>
            </div>
            <div class="item-stat">
                <select name="system.baseCha" data-type="String">
                    {{selectOptions characteristicOptions selected=item.system.baseCha}}
                </select>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.SelectedChar"}}</span>
            </div>
        </div>
        <div class="item-specialization-row">
            <input type="text" name="system.trainedItems" value="{{item.system.trainedItems}}" data-dtype="String" placeholder="{{localize "UESRPG.Sheets.Item.Specialization"}}"/>
            <span class="uesrpg-field-hint">{{localize "UESRPG.Sheets.Item.SpecializationHint"}}</span>
        </div>
    </div>
</header>
{{#if canAdministrativeCorrect}}<button type="button" class="dialog-button uesrpg-admin-correction" data-action="administrativeCorrection">{{localize "UESRPG.DefectUpdate.AdministrativeCorrection"}}</button>{{/if}}

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "UESRPG.UI.Description"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">{{localize "UESRPG.Sheets.Equipment.Effects"}}</a>
</nav>

{{!-- Sheet Body --}}
<section class="sheet-body">

            {{!-- Description Tab --}}
            <div class="tab" data-group="primary" data-tab="description">
                <div class="item-description-container">
                    <div class="basic-padding">
                        <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
                    </div>
                </div>
            </div>
        


        {{!-- Effects Tab --}}
        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>
</section>
