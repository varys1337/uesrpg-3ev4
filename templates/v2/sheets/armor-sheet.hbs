{{!-- Armor Sheet – Compact Layout --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
        <div class="item-stats-row item-stats-row--weapon-armor">
            <div class="item-stats-grid item-stats-grid--two-rows">
                <div class="item-stat">
                    <input type="number" name="system.quantity" value="{{item.system.quantity}}"/>
                    <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Quantity"}}</span>
                </div>
                <div class="item-stat">
                    <input type="number" name="system.enc" value="{{item.system.enc}}"/>
                    <span class="item-stat-label">{{localize "UESRPG.UI.ENC"}}</span>
                </div>
                <div class="item-stat">
                    <input type="number" name="system.price" value="{{item.system.price}}"/>
                    <span class="item-stat-label">{{localize "UESRPG.Sheets.Equipment.Price"}}</span>
                </div>
            </div>
            <div class="item-stat item-stat--equipped-side">
                <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Equipped"}}</span>
            </div>
        </div>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "UESRPG.UI.Description"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">{{localize "UESRPG.Sheets.Item.Attributes"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">{{localize "UESRPG.Sheets.Equipment.Effects"}}</a>
</nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

            {{!-- Description Tab --}}
            <div class="tab" data-group="primary" data-tab="description">
                <div class="item-description-container">
                    <div class="basic-padding">
                        <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
                    </div>
                </div>
            </div>

            {{!-- Attributes Tab --}}
            <div class="tab" data-group="primary" data-tab="attributes">
                <div class="attribute-tab-container">
                    <div class="item-selection-container">
                        <h2>{{localize "UESRPG.Sheets.Item.Attributes"}}</h2>
                        <div class="selection-container enchanting-compact-grid">
                            <div class="armor-attributes-container">

                                {{!-- Quality section --}}
                                <div class="armor-attributes-section">
                                    <h3>{{localize "UESRPG.Sheets.Item.Quality"}}</h3>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.Quality"}}</label>
                                        <select name="system.qualityLevel">
                                            {{selectOptions weaponQualityOptions selected=item.system.qualityLevel localize=true}}
                                        </select>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.Runed"}}</label>
                                        <input class="checkbox" type="checkbox" name="system.runed" {{checked item.system.runed}}>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.UI.Magic"}}</label>
                                        <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.magic" {{checked (lookup qualitiesSelectedToggle "magic")}}>
                                    </div>
                                </div>

                                {{!-- Type section --}}
                                <div class="armor-attributes-section">
                                    <h3>{{localize "UESRPG.Sheets.Equipment.Type"}}</h3>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.ArmorClass"}}</label>
                                        <select name="system.armorClass">
                                            {{selectOptions armorClassOptions selected=item.system.armorClass localize=true}}
                                        </select>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.Damaged"}}</label>
                                        <input type="number" name="qualitiesStructured.value.damaged" value="{{lookup qualitiesSelectedValue "damaged"}}" min="0" step="1" title="{{localize "UESRPG.Sheets.Item.DamagedArmorTitle"}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.EffectiveAR"}}</label>
                                        <span class="item-stat-derived" title="{{localize "UESRPG.Sheets.Item.EffectiveARTitle"}}">{{item.system.armorEffective}}</span>
                                    </div>
                                </div>

                                {{!-- Full Armor Values --}}
                                <div class="armor-attributes-section">
                                    <h3>{{localize "UESRPG.Sheets.Item.FullArmorValues"}}</h3>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Equipment.Armor"}}</label>
                                        <input type="number" name="system.armorValues.full.armor" value="{{item.system.armorValues.full.armor}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.MagicAR"}}</label>
                                        <input type="number" name="system.armorValues.full.magic_ar" value="{{item.system.armorValues.full.magic_ar}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.SpecialAR"}}</label>
                                        <input type="number" name="system.armorValues.full.special_ar" value="{{item.system.armorValues.full.special_ar}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.SpecialARType"}}</label>
                                        <input type="text" name="system.armorValues.full.special_ar_type" value="{{item.system.armorValues.full.special_ar_type}}" placeholder="{{localize "UESRPG.Sheets.Item.ElementPlaceholder"}}"/>
                                    </div>
                                </div>

                                {{!-- Partial Armor Values --}}
                                <div class="armor-attributes-section">
                                    <h3>{{localize "UESRPG.Sheets.Item.PartialArmorValues"}}</h3>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Equipment.Armor"}}</label>
                                        <input type="number" name="system.armorValues.partial.armor" value="{{item.system.armorValues.partial.armor}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.MagicAR"}}</label>
                                        <input type="number" name="system.armorValues.partial.magic_ar" value="{{item.system.armorValues.partial.magic_ar}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.SpecialAR"}}</label>
                                        <input type="number" name="system.armorValues.partial.special_ar" value="{{item.system.armorValues.partial.special_ar}}"/>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.SpecialARType"}}</label>
                                        <input type="text" name="system.armorValues.partial.special_ar_type" value="{{item.system.armorValues.partial.special_ar_type}}" placeholder="{{localize "UESRPG.Sheets.Item.ElementPlaceholder"}}"/>
                                    </div>
                                </div>

                                {{!-- Weight --}}
                                <div class="armor-attributes-section">
                                    <h3>{{localize "UESRPG.Sheets.Item.Weight"}}</h3>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.WeightClass"}}</label>
                                        <select name="system.weightClass">
                                            {{selectOptions armorWeightClassOptions selected=item.system.weightClass localize=true}}
                                        </select>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.EffectiveWeightClass"}}</label>
                                        <input type="text" value="{{#if item.system.weightClassEffective}}{{item.system.weightClassEffective}}{{else}}{{item.system.effectiveWeightClass}}{{/if}}" disabled>
                                    </div>
                                </div>

                                {{!-- Enchanting --}}
                                <div class="armor-attributes-section enchanting-compact-grid">
                                    <h3>{{localize "UESRPG.Sheets.Item.Enchanting"}}</h3>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.EnchantLevel"}}</label>
                                        <div class="enchant-inline">
                                            <input type="number" name="system.enchant_level" value="{{item.system.enchant_level}}"/>
                                        </div>
                                    </div>
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.Charge"}}</label>
                                        <div class="enchant-inline enchant-charge-inline">
                                            <button type="button" class="uesrpg-charge-btn" data-action="chargeMinus" title="{{localize "UESRPG.Sheets.Item.DecreaseCurrentCharge"}}">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                            <input type="number" name="system.charge.value" value="{{item.system.charge.value}}" class="enchant-charge-input">
                                            <span class="enchant-charge-sep">/</span>
                                            <input type="number" name="system.charge.max" value="{{item.system.charge.max}}" class="enchant-charge-input">
                                            <button type="button" class="uesrpg-charge-btn" data-action="chargePlus" title="{{localize "UESRPG.Sheets.Item.IncreaseCurrentCharge"}}">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                    {{#if enchantmentDisplay}}
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.ActiveEnchantment"}}</label>
                                        <span class="styled-font-gold">{{enchantmentDisplay.typeLabel}}</span>
                                    </div>
                                    {{#if (eq enchantmentDisplay.typeLabel "Cast")}}
                                    <div class="weapon-field-row">
                                        <label>{{localize "UESRPG.Sheets.Item.Cast"}}</label>
                                        <button type="button" data-action="castEnchantment">{{localize "UESRPG.Sheets.Equipment.CastEnchantment"}}</button>
                                    </div>
                                    {{/if}}
                                    {{/if}}
                                </div>

                            </div>
                        </div>
                    </div>

                    {{!-- Hit Locations --}}
                    <div class="item-selection-container">
                        <h2>{{localize "UESRPG.Sheets.Item.HitLocationsCovered"}}</h2>
                        <div class="selection-container armor-hitloc-table">
                            <div class="armor-hitloc-pair">
                                <div class="armor-hitloc-row">
                                    <div class="armor-hitloc-row__name">{{localize "UESRPG.Sheets.Item.HitLocation.Head"}}</div>
                                    <label class="armor-hitloc-row__toggle">
                                        <span>{{localize "UESRPG.Sheets.Item.Covered"}}</span>
                                        <input class="checkbox" type="checkbox" name="system.hitLocations.Head" {{checked item.system.hitLocations.Head}}>
                                    </label>
                                </div>
                                <div class="armor-hitloc-row">
                                    <div class="armor-hitloc-row__name">{{localize "UESRPG.Sheets.Item.HitLocation.Body"}}</div>
                                    <label class="armor-hitloc-row__toggle">
                                        <span>{{localize "UESRPG.Sheets.Item.Covered"}}</span>
                                        <input class="checkbox" type="checkbox" name="system.hitLocations.Body" {{checked item.system.hitLocations.Body}}>
                                    </label>
                                </div>
                            </div>
                            <div class="armor-hitloc-pair">
                                <div class="armor-hitloc-row">
                                    <div class="armor-hitloc-row__name">{{localize "UESRPG.Sheets.Item.HitLocation.RightArm"}}</div>
                                    <label class="armor-hitloc-row__toggle">
                                        <span>{{localize "UESRPG.Sheets.Item.Covered"}}</span>
                                        <input class="checkbox" type="checkbox" name="system.hitLocations.RightArm" {{checked item.system.hitLocations.RightArm}}>
                                    </label>
                                </div>
                                <div class="armor-hitloc-row">
                                    <div class="armor-hitloc-row__name">{{localize "UESRPG.Sheets.Item.HitLocation.LeftArm"}}</div>
                                    <label class="armor-hitloc-row__toggle">
                                        <span>{{localize "UESRPG.Sheets.Item.Covered"}}</span>
                                        <input class="checkbox" type="checkbox" name="system.hitLocations.LeftArm" {{checked item.system.hitLocations.LeftArm}}>
                                    </label>
                                </div>
                            </div>
                            <div class="armor-hitloc-pair">
                                <div class="armor-hitloc-row">
                                    <div class="armor-hitloc-row__name">{{localize "UESRPG.Sheets.Item.HitLocation.RightLeg"}}</div>
                                    <label class="armor-hitloc-row__toggle">
                                        <span>{{localize "UESRPG.Sheets.Item.Covered"}}</span>
                                        <input class="checkbox" type="checkbox" name="system.hitLocations.RightLeg" {{checked item.system.hitLocations.RightLeg}}>
                                    </label>
                                </div>
                                <div class="armor-hitloc-row">
                                    <div class="armor-hitloc-row__name">{{localize "UESRPG.Sheets.Item.HitLocation.LeftLeg"}}</div>
                                    <label class="armor-hitloc-row__toggle">
                                        <span>{{localize "UESRPG.Sheets.Item.Covered"}}</span>
                                        <input class="checkbox" type="checkbox" name="system.hitLocations.LeftLeg" {{checked item.system.hitLocations.LeftLeg}}>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    {{#if uiSpellcastingConfig}}
                    {{> "systems/uesrpg-3ev4/templates/partials/sheets/item-spellcasting-config.hbs" helpKey="UESRPG.Sheets.Item.SpellcastingConfigurationHelp" uiSpellcastingConfig=uiSpellcastingConfig}}
                    {{/if}}
                </div>
            </div>

        {{!-- Effects Tab --}}
        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>
</section>
