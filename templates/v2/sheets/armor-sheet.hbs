{{!-- Armor Sheet вЂ” Compact Layout --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="Name"/>
        <div class="item-stats-row">
            <div class="item-stat">
                <input type="number" name="system.quantity" value="{{item.system.quantity}}"/>
                <span class="item-stat-label">Quantity</span>
            </div>
            <div class="item-stat">
                {{#if item.system.encEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.encEffective}}" readonly/>
                        <input type="number" name="system.enc" value="{{item.system.enc}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.enc" value="{{item.system.enc}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.enc" value="{{item.system.enc}}"/>
                {{/if}}
                <span class="item-stat-label">ENC</span>
            </div>
            <div class="item-stat">
                {{#if item.system.priceEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.priceEffective}}" readonly/>
                        <input type="number" name="system.price" value="{{item.system.price}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.price" value="{{item.system.price}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.price" value="{{item.system.price}}"/>
                {{/if}}
                <span class="item-stat-label">Price</span>
            </div>
            <div class="item-stat">
                <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                <span class="item-stat-label">Equipped</span>
            </div>
            <div class="item-stat">
                {{#if item.system.armorEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.armorEffective}}" readonly/>
                        <input type="number" name="system.armor" value="{{item.system.armor}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.armor" value="{{item.system.armor}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.armor" value="{{item.system.armor}}"/>
                {{/if}}
                <span class="item-stat-label">Armor</span>
            </div>
            <div class="item-stat">
                {{#if item.system.magic_arEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.magic_arEffective}}{{#if item.system.special_ar_typeEffective}} {{item.system.special_ar_typeEffective}}{{/if}}" readonly/>
                        <input type="number" name="system.magic_ar" value="{{item.system.magic_ar}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.magic_ar" value="{{item.system.magic_ar}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.magic_ar" value="{{item.system.magic_ar}}"/>
                {{/if}}
                <span class="item-stat-label">Magic AR</span>
            </div>
            <div class="item-stat">
                {{#if item.system.blockRatingEffective}}
                    {{#unless item.system.gmOverride.useBaseStats}}
                        <input type="text" value="{{item.system.blockRatingEffective}}" readonly/>
                        <input type="number" name="system.blockRating" value="{{item.system.blockRating}}" class="u-hidden"/>
                    {{else}}
                        <input type="number" name="system.blockRating" value="{{item.system.blockRating}}"/>
                    {{/unless}}
                {{else}}
                    <input type="number" name="system.blockRating" value="{{item.system.blockRating}}"/>
                {{/if}}
                <span class="item-stat-label">Block</span>
            </div>
        </div>
    </div>
</header>

{{!-- Sheet Tab Navigation --}}
<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">Description</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">Attributes</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">Effects</a>
</nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">
    
            {{!-- Description Tab --}}
            <div class="tab" data-group="primary" data-tab="description">
                <div class="item-description-container">
                    <div class="basic-padding">
                        {{editor item.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                    </div>
                </div>
            </div>
    
            {{!-- Attributes Tab --}}
            <div class="tab" data-group="primary" data-tab="attributes">
                <div class="attribute-tab-container">
                    <div class="item-selection-container">
                        <h2>Attributes</h2>

                            <h3>Quality</h3>
                            <div class="grid-container">
                                <div>Quality</div>
                                <div class="right-align-content">
                                    <select name="system.qualityLevel">
  {{selectOptions weaponQualityOptions selected=item.system.qualityLevel}}
</select>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Runed</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.runed" {{checked item.system.runed}}>
                                </div>
                            </div>

                            <h3>Type</h3>
                            <div class="grid-container">
                                <div>Armor Class</div>
                                <div class="right-align-content">
                                    <select name="system.armorClass">
                                      {{selectOptions armorClassOptions selected=item.system.armorClass}}
                                    </select>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Material</div>
                                <div class="right-align-content">
                                    <select name="system.material">
                                      {{selectOptions armorMaterialOptions selected=item.system.material}}
                                    </select>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Manual Base Stats</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.gmOverride.useBaseStats" {{checked item.system.gmOverride.useBaseStats}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Is Shield</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.isShield" {{checked item.system.isShield}}>
                                </div>
                            </div>
                            {{#if item.system.isShieldEffective}}
                            <div class="grid-container">
                                <div>Shield Type</div>
                                <div class="right-align-content">
                                    <select name="system.shieldType">
                                      {{selectOptions shieldTypeOptions selected=item.system.shieldType}}
                                    </select>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Magic BR</div>
                                <div class="right-align-content">
                                    <input type="text" value="{{item.system.magic_brEffective}}" disabled>
                                </div>
                            </div>
                            {{#if item.system.magic_brSpecial}}
                            <div class="grid-container">
                                <div>Magic BR (Special)</div>
                                <div class="right-align-content">
                                    <input type="text" value="{{item.system.magic_brSpecial.value}} vs {{item.system.magic_brSpecial.type}}" disabled>
                                </div>
                            </div>
                            {{/if}}
                            {{/if}}

                            <h3>Weight</h3>
                            <div class="grid-container">
                                <div>Weight Class</div>
                                <div class="right-align-content">
                                    <select name="system.weightClass">
  {{selectOptions armorWeightClassOptions selected=item.system.weightClass}}
</select>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Effective Weight Class</div>
                                <div class="right-align-content">
                                    <input type="text" value="{{#if item.system.weightClassEffective}}{{item.system.weightClassEffective}}{{else}}{{item.system.effectiveWeightClass}}{{/if}}" disabled>
                                </div>
                            </div>

                        <div class="selection-container">
                            <div class="grid-container">
                                <div>Ignore ENC</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.excludeENC" {{checked item.system.excludeENC}}>
                                </div>
                            </div>
</div>
                    </div>

                    {{! -- ENCHANTING SECTION --}}
                    <div class="item-selection-container">
                        <h2>Enchanting</h2>
                        <div class="selection-container enchanting-compact-grid">
                            <div class="grid-container">
                                <div>Enchant Level</div>
                                <div class="right-align-content enchant-inline">
                                    <input type="number" name="system.enchant_level" value="{{item.system.enchant_level}}"/>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Charge</div>
                                <div class="right-align-content enchant-inline enchant-charge-inline">
                                    <button type="button" class="uesrpg-charge-btn" data-action="chargeMinus" title="Decrease current charge">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                    <input type="number" name="system.charge.value" value="{{item.system.charge.value}}" class="enchant-charge-input">
                                    <span class="enchant-charge-sep">/</span>
                                    <input type="number" name="system.charge.max" value="{{item.system.charge.max}}" class="enchant-charge-input">
                                    <button type="button" class="uesrpg-charge-btn" data-action="chargePlus" title="Increase current charge">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            {{#if enchantmentDisplay}}
                            <div class="grid-container">
                                <div>Active Enchantment</div>
                                <div class="right-align-content">
                                    <span class="styled-font-gold">{{enchantmentDisplay.typeLabel}}</span>
                                </div>
                            </div>
                            {{#if (eq enchantmentDisplay.typeLabel "Cast")}}
                            <div class="grid-container">
                                <div>Cast</div>
                                <div class="right-align-content">
                                    <button type="button" data-action="castEnchantment">Cast Enchantment</button>
                                </div>
                            </div>
                            {{/if}}
                            {{/if}}
                        </div>
                    </div>

                                        {{! -- HIT LOCATIONS SECTION --}}
                    {{#unless item.system.isShieldEffective}}
                    <div class="item-selection-container">
                        <h2>Hit Locations Covered</h2>
                        <div class="selection-container">
                            <div class="grid-container">
                                <div>Head</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.hitLocations.Head" {{checked item.system.hitLocations.Head}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Body</div>
                                <div class="right-align-content">
                                    <input class="checkbox" type="checkbox" name="system.hitLocations.Body" {{checked item.system.hitLocations.Body}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Right Arm</div>
                                <div class="right-align-content">
                                   <input class="checkbox" type="checkbox" name="system.hitLocations.RightArm" {{checked item.system.hitLocations.RightArm}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Left Arm</div>
                                <div class="right-align-content">
                                   <input class="checkbox" type="checkbox" name="system.hitLocations.LeftArm" {{checked item.system.hitLocations.LeftArm}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Right Leg</div>
                                <div class="right-align-content">
                                  <input class="checkbox" type="checkbox" name="system.hitLocations.RightLeg" {{checked item.system.hitLocations.RightLeg}}>
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Left Leg</div>
                                <div class="right-align-content">
                                   <input class="checkbox" type="checkbox" name="system.hitLocations.LeftLeg" {{checked item.system.hitLocations.LeftLeg}}>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/unless}}

                    <div class="quality-container">
                        <div class="flex-container">
                            <h2>Qualities</h2>
                        </div>
                        <div class="structured-qualities-grid is-armor">
                            {{#each coreQualitiesCatalog}}
                                <div class="structured-qualities-cell">
                                    <div>{{this.label}}</div>
                                    <div class="right-align-content">
                                        {{#if this.isTrait}}
                                            <input class="checkbox" type="checkbox" name="qualitiesTraits.toggle.{{this.key}}" {{checked this.selected}} />
                                        {{else}}
                                            {{#if this.hasValue}}
                                                <input class="structured-value" type="number" name="qualitiesStructured.value.{{this.key}}" value="{{lookup ../qualitiesSelectedValue this.key}}" min="{{this.min}}" step="1" />
                                            {{else}}
                                                <input class="checkbox" type="checkbox" name="qualitiesStructured.toggle.{{this.key}}" {{checked (lookup ../qualitiesSelectedToggle this.key)}} />
                                            {{/if}}
                                        {{/if}}
                                    </div>
                                </div>
                            {{/each}}
                        </div>

                        <!-- Armor does not use an extended trait list; Shield is surfaced above. -->
                    </div>

                    {{#if uiSpellcastingConfig}}
                    <div class="quality-container">
                        <div class="flex-container">
                            <h2>Spellcasting Configuration</h2>
                        </div>
                        <div class="selection-container">
                            <p class="u-text-muted u-text-sm">
                                Configure item-based spell slots by picking a spell, binding strength, and cost mode/value.
                            </p>
                            <div class="grid-container">
                                <div>Enable Spellcasting</div>
                                <div class="right-align-content">
                                    <button type="button" data-action="toggleSpellcastingEnable">
                                        {{#if uiSpellcastingConfig.enabled}}Disable{{else}}Enable{{/if}}
                                    </button>
                                </div>
                            </div>
                            {{#if uiSpellcastingConfig.enabled}}
                            <div class="grid-container">
                                <div>Charge Pool (Soul)</div>
                                <div class="right-align-content u-text-muted">Used by Soul-cost slots; synced with item Charge.</div>
                            </div>
                            <div class="grid-container">
                                <div>Charge Current / Max</div>
                                <div class="right-align-content">
                                    <input type="number" data-spellcasting-charge="value" value="{{uiSpellcastingConfig.poolValue}}" min="0" step="1" class="u-w-50" />
                                    <span>/</span>
                                    <input type="number" data-spellcasting-charge="max" value="{{uiSpellcastingConfig.poolMax}}" min="0" step="1" class="u-w-50" />
                                </div>
                            </div>
                            <div class="grid-container">
                                <div>Slots</div>
                                <div class="right-align-content">
                                    <button type="button" data-action="addSpellcastingSlot">Add Slot</button>
                                    <button type="button" data-action="editSpellcastingSlot">Save</button>
                                </div>
                            </div>
                            {{#each uiSpellcastingConfig.slots as |slot|}}
                            <div class="grid-container" data-spellcasting-slot-id="{{slot.id}}">
                                <div>
                                    <input type="text" data-spellcasting-field="label" value="{{slot.label}}" placeholder="Label" />
                                    <div class="u-text-muted u-text-xs">{{slot.spellUuid}}</div>
                                </div>
                                <div class="right-align-content">
                                    <input type="number" data-spellcasting-field="cost" value="{{slot.cost}}" min="0" step="1" title="Soul Cost" class="u-w-50" />
                                    <input type="number" data-spellcasting-field="bindingStrength" value="{{slot.bindingStrength}}" min="0" max="10" step="1" title="Binding Strength" class="u-w-50" />
                                    <select data-spellcasting-field="costMode" class="u-w-50">
                                        <option value="soul" {{#if (eq slot.costMode "soul")}}selected{{/if}}>Soul</option>
                                        <option value="magicka" {{#if (eq slot.costMode "magicka")}}selected{{/if}}>Magicka</option>
                                        <option value="none" {{#if (eq slot.costMode "none")}}selected{{/if}}>No Cost</option>
                                    </select>
                                    <label><input type="checkbox" data-spellcasting-field="enabled" {{checked slot.enabled}} /> On</label>
                                    <button type="button" data-action="pickSpellcastingSlotSpell" data-slot-id="{{slot.id}}">Pick</button>
                                    <button type="button" data-action="removeSpellcastingSlot" data-slot-id="{{slot.id}}">Remove</button>
                                </div>
                            </div>
                            {{/each}}
                            {{#if uiSpellcastingConfig.canCast}}
                            <div class="grid-container">
                                <div>Cast</div>
                                <div class="right-align-content">
                                    <button type="button" data-action="castEnchantment">Cast Enchantment</button>
                                </div>
                            </div>
                            {{/if}}
                            {{/if}}
                        </div>
                    </div>
                    {{/if}}
                </div>
            </div>
        


        {{!-- Effects Tab --}}
        <div class="tab effects" data-group="primary" data-tab="effects">
            {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
        </div>
</section>
