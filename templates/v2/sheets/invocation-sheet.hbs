<section class="sheet-body">
  <div class="tab" data-group="primary" data-tab="overview">
    <div class="spell-casting-body spell-casting-body--overview">
      <section class="spell-section spell-section--editor">
        <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
      </section>
    </div>
  </div>

  <div class="tab" data-group="primary" data-tab="ritual">
    <div class="spell-casting-body">
      <section class="spell-section">
        <h4 class="spell-section-title">{{localize "UESRPG.Sheets.Item.RitualDetails"}}</h4>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Item.Ritual"}}</label>
          <input type="text" name="system.ritual" value="{{item.system.ritual}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.RitualClassification"}}" />
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Equipment.Range"}}</label>
          <input type="text" name="system.range" value="{{item.system.range}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.RangeTargets"}}" />
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.UI.Duration"}}</label>
          <input type="text" name="system.duration" value="{{item.system.duration}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.UI.Duration"}}" />
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Item.Aspects"}}</label>
          <input type="text" name="system.aspectsText" value="{{item.system.aspectsText}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.AspectsPlaceholder"}}" />
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Item.TNSkill"}}</label>
          <select name="system.tnDomainKey" class="spell-input spell-input-fill">
            {{selectOptions invocationTnDomainOptions selected=item.system.tnDomainKey}}
          </select>
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.UI.Requirements"}}</label>
          <textarea name="system.requirements" rows="4" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.RequirementsOfferingsMaterials"}}">{{item.system.requirements}}</textarea>
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Equipment.Effects"}}</label>
          <textarea name="system.effect" rows="6" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.EffectText"}}">{{item.system.effect}}</textarea>
        </div>
      <section class="spell-section">
        <h4 class="spell-section-title">{{localize "UESRPG.Sheets.Item.Source"}}</h4>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Item.SourceKey"}}</label>
          <input type="text" name="system.source.sourceKey" value="{{item.system.source.sourceKey}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.StableImportKey"}}" />
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Item.SourcePath"}}</label>
          <input type="text" name="system.source.sourcePath" value="{{item.system.source.sourcePath}}" class="spell-input spell-input-fill" placeholder="{{localize "UESRPG.Sheets.Item.ImportSourcePath"}}" />
        </div>
        <div class="spell-row">
          <label class="spell-label">{{localize "UESRPG.Sheets.Item.ImportVersion"}}</label>
          <input type="number" name="system.source.importVersion" value="{{item.system.source.importVersion}}" min="0" class="spell-input spell-input-xs" />
        </div>
      </section>
    </div>
  </div>

  <div class="tab" data-group="primary" data-tab="effects">
    <div class="spell-casting-body">
      {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
    </div>
  </div>
</section>
