  <div class="sheet-section-container">
    <div class="sheet-fixed-container">
      <div class="character-profile-container">
        <div class="profile-img-container">
          <img class="profile-img" src="{{actor.img}}" data-tooltip-text="{{actor.name}}" alt="{{actor.name}}">
        </div>
        <div>
          <h1 class="charname">{{actor.name}}</h1>
        </div>
      </div>
    </div>

    <section class="sheet-body">
      <div class="limited-info">
        <i class="fas fa-users"></i>
        <h2>{{actor.name}}</h2>
        <p>{{localize "UESRPG.UI.GroupOfAdventurers"}}</p>
      </div>

      {{#if resolvedMembers.length}}
      <div class="visible-members">
        <h3>{{localize "UESRPG.UI.KnownMembers"}}</h3>
        <div class="member-portraits">
          {{#each resolvedMembers as |member|}}
          {{#if member.canView}}
          <div class="member-portrait-limited">
            <button type="button" class="uesrpg-semantic-control uesrpg-plain-control uesrpg-image-action" data-action="viewMember" data-tooltip-text="{{member.name}}" aria-label="{{member.name}}"><img src="{{member.img}}" alt="" data-uuid="{{member.uuid}}" class="member-portrait-clickable" aria-hidden="true"></button>
            <div>{{member.name}}</div>
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if enrichedDescription}}
      <div class="description-section">
        <h3>{{localize "UESRPG.UI.Description"}}</h3>
        <div class="content-container">{{{enrichedDescription}}}</div>
      </div>
      {{/if}}
    </section>
  </div>
