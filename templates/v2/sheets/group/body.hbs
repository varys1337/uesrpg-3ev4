    <section class="sheet-body">

      {{!-- ─── Members Tab ─── --}}
      <div class="tab members" data-group="primary" data-tab="members">
        <!-- Drop zone -->
        <div class="member-drop-zone">
          <i class="fas fa-users drop-icon"></i>
          <p class="drop-hint">
            {{#if editable}}{{localize "UESRPG.UI.DragActorsToGroup"}}{{else}}{{localize "UESRPG.UI.GroupMembers"}}{{/if}}
          </p>
        </div>

        {{#if resolvedMembers.length}}
        <!-- Controls row -->
        <div class="controls">
          {{#if isGM}}
          <button type="button" data-action="deployGroup">
            <i class="fas fa-chess-board"></i> {{localize "UESRPG.UI.DeployGroup"}}
          </button>
          {{/if}}
          {{#if showArmyCampaign}}
          <button type="button" data-action="openArmyCampaign">
            <i class="fas fa-flag"></i> {{localize "UESRPG.UI.ArmyCampaign"}}
          </button>
          {{/if}}
          <button type="button" data-action="shortRest">
            <i class="fas fa-coffee"></i> {{localize "UESRPG.UI.ShortRest"}}
          </button>
          <button type="button" data-action="longRest">
            <i class="fas fa-bed"></i> {{localize "UESRPG.UI.LongRest"}}
          </button>
        </div>

        <!-- Member list -->
        <div class="member-list-scrollable">
          {{#each resolvedMembers as |member|}}
          <div class="member-item" data-uuid="{{member.uuid}}">

            <!-- Portrait spans 2 rows -->
            <div class="member-portrait" data-action="viewMember">
              <img src="{{member.img}}" width="40" height="40" title="{{member.name}}"
                   class="{{#if member.missing}}member-missing{{/if}}">
            </div>

            <!-- Name in row 1, column 2 -->
            <div class="member-name" data-action="viewMember">
              {{member.name}}
              {{#if member.missing}}<span class="member-missing-label">({{localize "UESRPG.UI.Missing"}})</span>{{/if}}
            </div>

            <!-- Stats in row 2, column 2 -->
            {{#if member.canView}}
            <div class="member-stats">
              <span title="{{localize "UESRPG.UI.HealthPoints"}}"><i class="fas fa-heart stat-hp"></i> {{member.hp.value}}/{{member.hp.max}}</span>
              <span title="{{localize "UESRPG.UI.StaminaPoints"}}"><i class="fas fa-bolt stat-sp"></i> {{member.stamina.value}}/{{member.stamina.max}}</span>
              {{#if member.magicka}}<span title="{{localize "UESRPG.UI.MagickaPoints"}}"><i class="fas fa-hat-wizard stat-mp"></i> {{member.magicka.value}}/{{member.magicka.max}}</span>{{/if}}
              <span title="{{localize "UESRPG.UI.Speed"}}"><i class="fas fa-running stat-speed"></i> {{member.speed}}</span>
              {{#if member.fatigue}}<span class="stat-fatigue" title="{{localize "UESRPG.UI.FatigueLevel"}}"><i class="fas fa-exclamation-triangle"></i> {{localize "UESRPG.UI.Fatigue"}} {{member.fatigue}}</span>{{/if}}
            </div>
            {{/if}}

            <!-- Delete button spans 2 rows, column 3 -->
            {{#if ../editable}}
            <button type="button" data-action="removeMember" title="{{localize "UESRPG.UI.RemoveFromGroup"}}"
                    class="member-remove-btn">
              <i class="fas fa-times"></i>
            </button>
            {{/if}}
          </div>
          {{/each}}
        </div>
        {{else}}
        <p class="group-empty">{{localize "UESRPG.UI.NoMembersInGroup"}}</p>
        {{/if}}
      </div>

      {{!-- ─── Inventory Tab ─── --}}
      <div class="tab inventory equipment" data-group="primary" data-tab="inventory" data-ues-section="group-inventory">
        <div class="equipmentTabContainer group-equipment-tab">
          <div class="uesrpg-equipment-main-body">
            <div class="itemListContainer">
              <div class="tableListHeader">
                <div class="equipment-info-container group-equipment-info">
                  <div class="wealthContainer uesrpg-panel">
                    <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Equipment.Wealth"}}</span></div>
                    <div class="uesrpg-equipment-panel-body">
                      <div class="wealthLabel">{{groupInventorySummary.totalWealth}}</div>
                      <div class="group-equipment-summary-note">{{localize "UESRPG.UI.PartyWealth"}}: {{groupInventorySummary.partyWealth}}</div>
                      <div class="group-equipment-summary-note">{{localize "UESRPG.UI.GroupWealth"}}: {{groupInventorySummary.groupWealth}}</div>
                      <button type="button" data-action="wealthCalc" class="wealthCalc">{{localize "UESRPG.Sheets.Equipment.AddSubtract"}}</button>
                    </div>
                  </div>
                  <div class="encContainer uesrpg-panel">
                    <div class="section-header"><span class="section-header__label">{{localize "UESRPG.Sheets.Equipment.Encumbrance"}}</span></div>
                    <div class="uesrpg-equipment-panel-body">
                      <div class="encLabel">{{groupInventorySummary.currentEnc}} / {{groupInventorySummary.maxEnc}} ENC</div>
                      <div class="group-equipment-summary-note">{{localize "UESRPG.UI.GroupItemsEnc"}}: {{groupInventorySummary.groupItemsEnc}} ENC</div>
                      <div class="group-equipment-summary-note">{{groupInventorySummary.label}}{{#if groupInventorySummary.penalty}} ({{groupInventorySummary.penalty}}){{/if}}</div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="containerList" data-ues-section="group-container-list">
                <table class="ues-table--container">
                  <thead>
                    <tr class="uesrpg-equipment-group-header" data-action="groupToggle" data-group="group-containers">
                      {{> "systems/uesrpg-3ev4/templates/partials/sheets/equipment-group-name-header.hbs" group="group-containers" itemType="container" legacyId="container" nameCellClass="ues-col-name" label=(localize "UESRPG.Sheets.Equipment.Container")}}
                      <th class="ues-col-stat" title="{{localize "UESRPG.Sheets.Equipment.EmptyContainerEncTitle"}}">ENC</th>
                      <th class="ues-col-stat">{{localize "UESRPG.Sheets.Equipment.Capacity"}}</th>
                      <th class="ues-col-stat">{{localize "UESRPG.Sheets.Equipment.ItemCount"}}</th>
                      <th class="ues-col-actions"><i class="fas fa-trash"></i></th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each container as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                      <td class="item-name-cell ues-col-name">
                        <div class="tableItemNameCell">
                          <div class="qty-controls">
                            <input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}">
                          </div>
                          <img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">
                          <div class="item-name" data-action="duplicateItem">{{item.name}}</div>
                        </div>
                      </td>
                      <td class="ues-col-stat" title="{{localize "UESRPG.Sheets.Equipment.ContainerOwnEnc"}}">{{item.system.enc}}</td>
                      <td class="ues-col-stat">{{item.system.container_enc.current}}/{{item.system.container_enc.max}}</td>
                      <td class="ues-col-stat">{{item.system.container_enc.item_count}}</td>
                      <td class="ues-col-actions"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>

              <div class="equipmentList">
                <table class="weapon-table">
                  <thead>
                    <tr class="uesrpg-equipment-group-header" data-action="groupToggle" data-group="group-weapons">
                      {{> "systems/uesrpg-3ev4/templates/partials/sheets/equipment-group-name-header.hbs" group="group-weapons" itemType="weapon" legacyId="weapon" label=(localize "UESRPG.Sheets.Equipment.Weapons")}}
                      <th>{{localize "UESRPG.Sheets.Equipment.Damage"}}</th>
                      <th>{{localize "UESRPG.Sheets.Equipment.Range"}}</th>
                      <th>{{localize "UESRPG.Sheets.Equipment.TwoHandedAmmo"}}</th>
                      <th class="right-align-cell"><i class="fas fa-trash"></i></th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each weapon.equipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                      <td class="item-name-cell">
                        <div class="flex-container">
                          <input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}">
                          <img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">
                          {{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}
                          <div class="item-name" data-action="duplicateItem">{{item.name}}</div>
                        </div>
                      </td>
                      <td class="damage-entry">{{#if item.system.damage3}}{{item.system.damage3}}{{else}}{{item.system.damage}}{{/if}}</td>
                      <td>{{#if item.system.resolvedDistanceDisplay}}{{item.system.resolvedDistanceDisplay}}{{else}}{{#if item.system.range}}{{item.system.range}}{{else}}{{item.system.reach}}{{/if}}{{/if}}</td>
                      <td>{{#if item.system.weapon2H}}2H{{else}}{{#if item.system.inlineAmmoLabel}}{{item.system.inlineAmmoLabel}}{{else}}-{{/if}}{{/if}}</td>
                      <td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td>
                    </tr>
                    {{/each}}
                    {{#each weapon.unequipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                      <td class="item-name-cell">
                        <div class="flex-container">
                          <input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}">
                          <img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">
                          {{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}
                          <div class="item-name" data-action="duplicateItem">{{item.name}}</div>
                        </div>
                      </td>
                      <td class="damage-entry">{{#if item.system.damage3}}{{item.system.damage3}}{{else}}{{item.system.damage}}{{/if}}</td>
                      <td>{{#if item.system.resolvedDistanceDisplay}}{{item.system.resolvedDistanceDisplay}}{{else}}{{#if item.system.range}}{{item.system.range}}{{else}}{{item.system.reach}}{{/if}}{{/if}}</td>
                      <td>{{#if item.system.weapon2H}}2H{{else}}{{#if item.system.inlineAmmoLabel}}{{item.system.inlineAmmoLabel}}{{else}}-{{/if}}{{/if}}</td>
                      <td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>

                <table class="ammunition-table">
                  <thead>
                    <tr class="uesrpg-equipment-group-header" data-action="groupToggle" data-group="group-ammunition">
                      {{> "systems/uesrpg-3ev4/templates/partials/sheets/equipment-group-name-header.hbs" group="group-ammunition" itemType="ammunition" legacyId="ammunition" label=(localize "UESRPG.Sheets.Equipment.Ammunition")}}
                      <th>{{localize "UESRPG.Sheets.Equipment.Bonus"}}</th>
                      <th>{{localize "UESRPG.Sheets.Equipment.Qty"}}</th>
                      <th class="right-align-cell"><i class="fas fa-trash"></i></th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each ammunition.equipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                      <td class="item-name-cell"><div class="flex-container"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td>
                      <td>{{item.system.damage}}</td>
                      <td>{{item.system.quantity}}</td>
                      <td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td>
                    </tr>
                    {{/each}}
                    {{#each ammunition.unequipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}">
                      <td class="item-name-cell"><div class="flex-container"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td>
                      <td>{{item.system.damage}}</td>
                      <td>{{item.system.quantity}}</td>
                      <td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>

                <table class="shield-table">
                  <thead>
                    <tr class="uesrpg-equipment-group-header" data-action="groupToggle" data-group="group-shields">
                      {{> "systems/uesrpg-3ev4/templates/partials/sheets/equipment-group-name-header.hbs" group="group-shields" itemType="shield" legacyId="shield" label=(localize "UESRPG.Sheets.Equipment.Shields")}}
                      <th>BR</th>
                      <th>MBR</th>
                      <th>{{localize "UESRPG.Sheets.Equipment.Type"}}</th>
                      <th class="right-align-cell"><i class="fas fa-trash"></i></th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each shield.equipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}"><td class="item-name-cell"><div class="flex-container"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td><td>{{#if item.system.blockRatingEffective}}{{item.system.blockRatingEffective}}{{else}}{{item.system.blockRating}}{{/if}}</td><td>{{#if item.system.magic_brEffective}}{{item.system.magic_brEffective}}{{else}}{{item.system.magic_br}}{{/if}}</td><td>{{#if item.system.shieldType}}{{item.system.shieldType}}{{else}}{{localize "UESRPG.UI.Normal"}}{{/if}}</td><td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td></tr>
                    {{/each}}
                    {{#each shield.unequipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}"><td class="item-name-cell"><div class="flex-container"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td><td>{{#if item.system.blockRatingEffective}}{{item.system.blockRatingEffective}}{{else}}{{item.system.blockRating}}{{/if}}</td><td>{{#if item.system.magic_brEffective}}{{item.system.magic_brEffective}}{{else}}{{item.system.magic_br}}{{/if}}</td><td>{{#if item.system.shieldType}}{{item.system.shieldType}}{{else}}{{localize "UESRPG.UI.Normal"}}{{/if}}</td><td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td></tr>
                    {{/each}}
                  </tbody>
                </table>

                <table class="armor-table">
                  <thead>
                    <tr class="uesrpg-equipment-group-header" data-action="groupToggle" data-group="group-armor">
                      {{> "systems/uesrpg-3ev4/templates/partials/sheets/equipment-group-name-header.hbs" group="group-armor" itemType="armor" legacyId="armor" label=(localize "UESRPG.Sheets.Equipment.Armor")}}
                      <th>AR</th>
                      <th>MR</th>
                      <th>BR</th>
                      <th class="right-align-cell"><i class="fas fa-trash"></i></th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each armor.equipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}"><td class="item-name-cell"><div class="flex-container"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td><td>{{#if item.system.armorEffective}}{{item.system.armorEffective}}{{else}}{{item.system.armor}}{{/if}}</td><td>{{#if item.system.magic_arEffective}}{{item.system.magic_arEffective}}{{#if item.system.special_ar_typeEffective}} {{item.system.special_ar_typeEffective}}{{/if}}{{else}}{{item.system.magic_ar}}{{/if}}</td><td>{{#if item.system.blockRatingEffective}}{{item.system.blockRatingEffective}}{{else}}{{item.system.blockRating}}{{/if}}</td><td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td></tr>
                    {{/each}}
                    {{#each armor.unequipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}"><td class="item-name-cell"><div class="flex-container"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td><td>{{#if item.system.armorEffective}}{{item.system.armorEffective}}{{else}}{{item.system.armor}}{{/if}}</td><td>{{#if item.system.magic_arEffective}}{{item.system.magic_arEffective}}{{#if item.system.special_ar_typeEffective}} {{item.system.special_ar_typeEffective}}{{/if}}{{else}}{{item.system.magic_ar}}{{/if}}</td><td>{{#if item.system.blockRatingEffective}}{{item.system.blockRatingEffective}}{{else}}{{item.system.blockRating}}{{/if}}</td><td class="right-align-cell"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td></tr>
                    {{/each}}
                  </tbody>
                </table>

                <table class="ues-table--gear">
                  <thead>
                    <tr class="uesrpg-equipment-group-header" data-action="groupToggle" data-group="group-gear">
                      {{> "systems/uesrpg-3ev4/templates/partials/sheets/equipment-group-name-header.hbs" group="group-gear" itemType="createSelect" legacyId="createSelect" nameCellClass="ues-col-name" label=(localize "UESRPG.Sheets.Equipment.Equipment")}}
                      <th class="ues-col-stat">{{localize "UESRPG.Sheets.Equipment.Qty"}}</th>
                      <th class="ues-col-stat">ENC</th>
                      <th class="ues-col-stat">{{localize "UESRPG.Sheets.Equipment.Price"}}</th>
                      <th class="ues-col-actions"><i class="fas fa-trash"></i></th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each gear.equipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}"><td class="item-name-cell ues-col-name"><div class="tableItemNameCell"><div class="qty-controls"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"></div><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td><td class="ues-col-stat">{{item.system.quantity}}</td><td class="ues-col-stat">{{item.system.enc}}</td><td class="ues-col-stat">{{item.system.price}}</td><td class="ues-col-actions"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td></tr>
                    {{/each}}
                    {{#each gear.unequipped as |item id|}}
                    <tr class="item active" data-item-id="{{item._id}}" data-item-type="{{item.type}}"><td class="item-name-cell ues-col-name"><div class="tableItemNameCell"><div class="qty-controls"><input type="checkbox" class="itemEquip checkbox" data-action="itemEquip" {{checked item.system.equipped}} title="{{localize "UESRPG.UI.Equip"}}"></div><img class="item-img" src="{{item.img}}" title="{{item.name}}" data-action="itemShow">{{#if item.system.containerStats.container_id}}<i title="{{localize "UESRPG.Sheets.Equipment.OpenContainer"}}" class="fa-solid fa-backpack" data-action="openContainer" data-container-id="{{item.system.containerStats.container_id}}"></i>{{/if}}<div class="item-name" data-action="duplicateItem">{{item.name}}</div></div></td><td class="ues-col-stat">{{item.system.quantity}}</td><td class="ues-col-stat">{{item.system.enc}}</td><td class="ues-col-stat">{{item.system.price}}</td><td class="ues-col-actions"><a class="item-control item-delete" data-action="itemDelete" title="{{localize "UESRPG.UI.DeleteItem"}}"><i class="fas fa-trash"></i></a></td></tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      {{!-- ─── Travel Tab ─── --}}
      <div class="tab travel" data-group="primary" data-tab="travel">
        <h3>{{localize "UESRPG.UI.TravelMovement"}}</h3>

        <div class="travel-stats">
          <div class="stat-card">
            <h4>{{localize "UESRPG.UI.GroupSpeed"}}</h4>
            <div class="stat-speed-value">{{displayAverageSpeed}} m/round</div>
            <div class="stat-speed-kmh">{{displayAverageSpeedKmh}} km/h</div>
            <p class="stat-hint">{{localize "UESRPG.UI.GroupSpeedHint"}}</p>
          </div>

          <div class="stat-card">
            <h4>{{localize "UESRPG.UI.TravelPace"}}</h4>
            <div class="pace-controls">
              <button type="button" data-action="changePace" class="change-pace">
                {{#if (eq currentPace "fast")}}{{localize "UESRPG.UI.Fast"}}{{/if}}
                {{#if (eq currentPace "normal")}}{{localize "UESRPG.UI.Normal"}}{{/if}}
                {{#if (eq currentPace "slow")}}{{localize "UESRPG.UI.Slow"}}{{/if}}
              </button>
            </div>
            <p class="stat-hint">{{localize "UESRPG.UI.TravelPaceHint"}}</p>
          </div>
        </div>

        <div class="pace-reference">
          <h4>{{localize "UESRPG.UI.TravelPace"}}</h4>
          <table class="pace-table">
            <thead>
              <tr>
                <th>{{localize "UESRPG.Sheets.Group.Pace"}}</th>
                <th class="text-center">{{localize "UESRPG.Sheets.Group.SpeedKmh"}}</th>
                <th class="text-center">{{localize "UESRPG.Sheets.Group.DailyEightHours"}}</th>
                <th>{{localize "UESRPG.Sheets.Group.Effect"}}</th>
              </tr>
            </thead>
            <tbody>
              <tr {{#if (eq currentPace 'fast')}}class="pace-active"{{/if}}>
                <td><b>{{localize "UESRPG.UI.Fast"}}</b></td>
                <td class="text-center">{{localize "UESRPG.Sheets.Group.FastSpeedKmh"}}</td>
                <td class="text-center">{{localize "UESRPG.Sheets.Group.FastDailyDistance"}}</td>
                <td>{{localize "UESRPG.Sheets.Group.FastPaceEffect"}}</td>
              </tr>
              <tr {{#if (eq currentPace 'normal')}}class="pace-active"{{/if}}>
                <td><b>{{localize "UESRPG.UI.Normal"}}</b></td>
                <td class="text-center">{{localize "UESRPG.Sheets.Group.NormalSpeedKmh"}}</td>
                <td class="text-center">{{localize "UESRPG.Sheets.Group.NormalDailyDistance"}}</td>
                <td>--</td>
              </tr>
              <tr {{#if (eq currentPace 'slow')}}class="pace-active"{{/if}}>
                <td><b>{{localize "UESRPG.UI.Slow"}}</b></td>
                <td class="text-center">{{localize "UESRPG.Sheets.Group.SlowSpeedKmh"}}</td>
                <td class="text-center">{{localize "UESRPG.Sheets.Group.SlowDailyDistance"}}</td>
                <td>{{localize "UESRPG.Sheets.Group.SlowPaceEffect"}}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      {{!-- ─── Details Tab ─── --}}
      <div class="tab details" data-group="primary" data-tab="details">
        <div class="editor-section description">
          <h3>
            {{localize "UESRPG.UI.Description"}}
            <button type="button" data-action="openDescriptionEditor" class="section-header__action" title="{{localize "UESRPG.UI.EditDescription"}}">
              <i class="fas fa-pen"></i>
            </button>
          </h3>
          <prose-mirror name="system.description" value="{{system.description}}" data-document-uuid="{{actor.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{enrichedDescription}}}</prose-mirror>
        </div>

        <div class="editor-section notes">
          <h3>
            {{localize "UESRPG.UI.Notes"}}
            <button type="button" data-action="openNotesEditor" class="section-header__action" title="{{localize "UESRPG.UI.EditNotes"}}">
              <i class="fas fa-pen"></i>
            </button>
          </h3>
          <prose-mirror name="system.notes" value="{{system.notes}}" data-document-uuid="{{actor.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{enrichedNotes}}}</prose-mirror>
        </div>
      </div>

    </section>
