{{!-- Shield Sheet --}}
<header class="item-compact-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" data-action="editPortrait" title="{{item.name}}" width="64" height="64"/>
    <div class="item-header-fields">
        <input class="item-compact-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize "UESRPG.UI.Name"}}"/>
        <div class="item-stats-row item-stats-row--weapon-armor">
            <div class="item-stats-grid item-stats-grid--two-rows">
                <div class="item-stat"><input type="number" name="system.quantity" value="{{item.system.quantity}}"/><span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Quantity"}}</span></div>
                <div class="item-stat"><input type="number" name="system.enc" value="{{item.system.enc}}"/><span class="item-stat-label">ENC</span></div>
                <div class="item-stat"><input type="number" name="system.price" value="{{item.system.price}}"/><span class="item-stat-label">{{localize "UESRPG.Sheets.Equipment.Price"}}</span></div>
                <div class="item-stat"><input type="number" name="system.blockRating" value="{{item.system.blockRating}}"/><span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Block"}}</span></div>
                <div class="item-stat"><input type="number" name="system.magic_br" value="{{item.system.magic_br}}"/><span class="item-stat-label">{{localize "UESRPG.Sheets.Item.MagicBR"}}</span></div>
            </div>
            <div class="item-stat item-stat--equipped-side">
                <input class="checkbox" type="checkbox" name="system.equipped" {{checked item.system.equipped}}>
                <span class="item-stat-label">{{localize "UESRPG.Sheets.Item.Equipped"}}</span>
            </div>
        </div>
    </div>
</header>

<nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "UESRPG.UI.Description"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="attributes">{{localize "UESRPG.Sheets.Item.Attributes"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="effects">{{localize "UESRPG.Sheets.Equipment.Effects"}}</a>
</nav>

<section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="description">
        <div class="item-description-container">
            <div class="basic-padding">
                <prose-mirror name="system.description" value="{{item.system.description}}" data-document-uuid="{{item.uuid}}" toggled {{#unless editable}}disabled{{/unless}}>{{{item.system.enrichedDescription}}}</prose-mirror>
            </div>
        </div>
    </div>

    <div class="tab" data-group="primary" data-tab="attributes">
        <div class="attribute-tab-container">
            <div class="item-selection-container">
                <h2>{{localize "UESRPG.Sheets.Item.Attributes"}}</h2>
                <div class="selection-container enchanting-compact-grid">
                    <div class="armor-attributes-container">
                        <div class="armor-attributes-section">
                            <h3>{{localize "UESRPG.Sheets.Item.Quality"}}</h3>
                            <div class="weapon-field-row"><label>{{localize "UESRPG.Sheets.Item.Quality"}}</label><select name="system.qualityLevel">{{selectOptions weaponQualityOptions selected=item.system.qualityLevel}}</select></div>
                            <div class="weapon-field-row"><label>{{localize "UESRPG.Sheets.Item.Runed"}}</label><input class="checkbox" type="checkbox" name="system.runed" {{checked item.system.runed}}></div>
                        </div>
                        <div class="armor-attributes-section">
                            <h3>{{localize "UESRPG.Sheets.Equipment.Type"}}</h3>
                            <div class="weapon-field-row"><label>{{localize "UESRPG.Sheets.Item.ShieldType"}}</label><select name="system.shieldType">{{selectOptions shieldTypeOptions selected=item.system.shieldType}}</select></div>
                        </div>
                        <div class="armor-attributes-section">
                            <h3>{{localize "UESRPG.Sheets.Item.Weight"}}</h3>
                            <div class="weapon-field-row"><label>{{localize "UESRPG.Sheets.Item.WeightClass"}}</label><select name="system.weightClass">{{selectOptions armorWeightClassOptions selected=item.system.weightClass}}</select></div>
                            <div class="weapon-field-row"><label>{{localize "UESRPG.Sheets.Item.EffectiveWeightClass"}}</label><input type="text" value="{{#if item.system.weightClassEffective}}{{item.system.weightClassEffective}}{{else}}{{item.system.effectiveWeightClass}}{{/if}}" disabled></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="tab effects" data-group="primary" data-tab="effects">
        {{> "systems/uesrpg-3ev4/templates/partials/sheets/effects-tab.hbs"}}
    </div>
</section>
