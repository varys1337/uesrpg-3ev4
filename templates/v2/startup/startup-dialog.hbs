<div class="uesrpg-startup">
  <div class="dialogForm">
    <div class="startup-panel startup-panel--social">
      <a class="startup-social-link" href="{{discordInviteUrl}}" aria-label="{{localize "UESRPG.Startup.Discord"}}">
        <i class="fab fa-discord fa-2x"></i>
      </a>
      <a class="startup-social-link" href="{{githubUrl}}" aria-label="{{localize "UESRPG.Startup.GitHub"}}">
        <i class="fab fa-github fa-2x"></i>
      </a>
    </div>

    <div class="startup-panel startup-panel--copy">
      <h2>{{localize "UESRPG.Startup.JoinCommunityTitle"}}</h2>
      <p class="startup-copy">
        {{localize "UESRPG.Startup.JoinCommunityBody"}}
        <a href="{{discordInviteUrl}}">{{localize "UESRPG.Startup.DiscordServer"}}</a>.
      </p>

      <h2>{{localize "UESRPG.Startup.SpecialThanksTitle"}}</h2>
      <ul class="startup-thanks-list">
        <li>{{localize "UESRPG.Startup.ThanksDogBoneZone"}}</li>
        <li>{{localize "UESRPG.Startup.ThanksGman95"}}</li>
        <li>{{localize "UESRPG.Startup.ThanksMaintainers"}}</li>
      </ul>
    </div>

    <div class="startup-panel startup-panel--note">
      <p>{{localize "UESRPG.Startup.DisablePopupNote"}}</p>
    </div>
  </div>
</div>
