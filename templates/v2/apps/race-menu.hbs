<div class="uesrpg-creation-dialog">
  <div class="menu-pinned">
    <div class="menu-instructions menu-instructions--full">
      <p>{{localize "UESRPG.Apps.RaceMenu.Instructions"}}</p>
      <label for="customRace">{{localize "UESRPG.Apps.RaceMenu.CustomRace"}}</label>
      <input type="text" id="customRace" placeholder="{{localize "UESRPG.Apps.RaceMenu.CustomRacePlaceholder"}}">
    </div>
  </div>

  <div class="menu-cards">
    <h2 class="menu-section-heading">{{localize "UESRPG.Apps.RaceMenu.CoreRaces"}}</h2>
    <div class="menu-grid">{{{coreRaceCards}}}</div>

    <h2 class="menu-section-heading">{{localize "UESRPG.Apps.RaceMenu.CoreVariants"}}</h2>
    <div class="menu-grid">{{{variantRaceCards}}}</div>

    <h2 class="menu-section-heading">{{localize "UESRPG.Apps.RaceMenu.KhajiitFurstocks"}}</h2>
    <div class="menu-grid">{{{khajiitFurstockRaceCards}}}</div>

    <h2 class="menu-section-heading">{{localize "UESRPG.Apps.RaceMenu.ExpandedRaces"}}</h2>
    <div class="menu-grid">{{{expandedRaceCards}}}</div>
  </div>

  <div class="creation-footer">
    <button type="button" data-action="cancel">{{localize "UESRPG.UI.Cancel"}}</button>
    <button type="button" data-action="submit" class="default">{{localize "UESRPG.UI.Apply"}}</button>
  </div>
</div>
