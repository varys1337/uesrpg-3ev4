{{!-- templates/v2/apps/debug-settings.hbs — AppV2 (no <form> wrapper) --}}
<section class="uesrpg-settings">
{{#if isGM}}
<fieldset>
  <legend>World (GM)</legend>

  <div class="form-group">
    <label>Enable World Debug Logging</label>
    <input type="checkbox" name="world.debugEnabled" {{checked world.debugEnabled}}>
    <p class="notes">Enables all UESRPG world-level debug logging (opposed workflows, spell casting, talents, wounds, rule elements, and more). Applies to all connected clients.</p>
  </div>
</fieldset>
{{/if}}

<fieldset>
  <legend>Client</legend>

  <div class="form-group">
    <label>Enable Client Debug Logging</label>
    <input type="checkbox" name="client.debugClientEnabled" {{checked client.debugClientEnabled}}>
    <p class="notes">Enables all UESRPG client-level debug logging for your session (AE lifecycle, aim, sheet diagnostics, performance traces, and more).</p>
  </div>
</fieldset>

<footer class="sheet-footer flexrow">
  <button type="submit" class="save"><i class="fas fa-save"></i> Save</button>
</footer>
</section>
