{{!-- templates/v2/apps/debug-settings.hbs — AppV2 (no <form> wrapper) --}}
<section class="uesrpg-settings">
{{#if isGM}}
<fieldset>
  <legend>{{localize "UESRPG.Apps.DebugSettings.Sections.World"}}</legend>

  <div class="form-group">
    <label>{{world.debugEnabled.name}}</label>
    <input type="checkbox" name="world.debugEnabled" {{checked world.debugEnabled.value}}>
    <p class="notes">{{world.debugEnabled.hint}}</p>
  </div>
</fieldset>
{{/if}}

<fieldset>
  <legend>{{localize "UESRPG.Apps.DebugSettings.Sections.Client"}}</legend>

  <div class="form-group">
    <label>{{client.debugClientEnabled.name}}</label>
    <input type="checkbox" name="client.debugClientEnabled" {{checked client.debugClientEnabled.value}}>
    <p class="notes">{{client.debugClientEnabled.hint}}</p>
  </div>
</fieldset>

<footer class="sheet-footer flexrow">
  <button type="submit" class="save"><i class="fas fa-save"></i> {{localize "UESRPG.UI.Save"}}</button>
</footer>
</section>
