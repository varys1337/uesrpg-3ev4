<div class="uesrpg-spelllearn">
  <header class="uesrpg-spelllearn__header">
    <div>
      <h2>{{localize "UESRPG.Dialogs.SpellLearning.Title"}}</h2>
      <div class="uesrpg-spelllearn__subtitle">{{actorName}}</div>
    </div>
    <div class="uesrpg-spelllearn__stats">
      <span><b>XP:</b> {{xp}} → {{xpProjected}}</span>
      <span><b>Drakes:</b> {{wealth}} → {{wealthProjected}}</span>
    </div>
    <button type="button" data-action="close"><i class="fas fa-times"></i> {{localize "UESRPG.UI.Close"}}</button>
  </header>

  <div class="uesrpg-spelllearn__scroll">
    <section class="uesrpg-spelllearn__section uesrpg-spelllearn__draft">
      <h3>{{localize "UESRPG.Dialogs.SpellLearning.PendingPurchases"}}</h3>
      <p class="uesrpg-spelllearn__hint">
        {{localize "UESRPG.Dialogs.SpellLearning.PendingSummary" count=stagedCount xp=stagedCostXp drakes=stagedCostWealth}}
      </p>

      {{#if hasDraft}}
        <div class="uesrpg-spelllearn__draft-list">
          {{#each stagedEntries as |row|}}
            <div class="uesrpg-spelllearn__draft-row">
              <div class="uesrpg-spelllearn__draft-text">
                <div class="uesrpg-spelllearn__draft-label">{{row.label}}</div>
                <div class="uesrpg-spelllearn__draft-meta">XP {{row.costXp}} | Drakes {{row.costWealth}}</div>
              </div>
              <button type="button" data-action="removeDraftEntry" data-entry-id="{{row.id}}" class="uesrpg-spelllearn__rollback-btn">
                <i class="fas fa-rotate-left"></i> Remove
              </button>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="uesrpg-spelllearn__hint uesrpg-spelllearn__empty">{{localize "UESRPG.Dialogs.SpellLearning.NoPendingPurchases"}}</p>
      {{/if}}

      <div class="uesrpg-spelllearn__confirm-actions">
        <button type="button" data-action="confirmDraft">
          <i class="fas fa-check"></i> {{localize "UESRPG.Dialogs.SpellLearning.ConfirmPurchases"}}
        </button>
        <button type="button" data-action="discardDraft">
          <i class="fas fa-trash"></i> {{localize "UESRPG.Dialogs.SpellLearning.DiscardPending"}}
        </button>
      </div>
    </section>

    <section class="uesrpg-spelllearn__section">
      <h3>{{localize "UESRPG.Dialogs.SpellLearning.DropSpells"}}</h3>
      <p>{{localize "UESRPG.Dialogs.SpellLearning.DropSpellsHint"}}</p>
      <div class="uesrpg-spelllearn__dropzones">
        <div class="uesrpg-spelllearn__dropzone" data-zone="standard">
          <div class="uesrpg-spelllearn__drop-title">{{localize "UESRPG.Dialogs.SpellLearning.StandardSpells"}}</div>
          <div class="uesrpg-spelllearn__drop-sub">{{localize "UESRPG.Dialogs.SpellLearning.StandardSpellsHint"}}</div>
        </div>
        <div class="uesrpg-spelllearn__dropzone" data-zone="ritual">
          <div class="uesrpg-spelllearn__drop-title">{{localize "UESRPG.Dialogs.SpellLearning.RitualSpells"}}</div>
          <div class="uesrpg-spelllearn__drop-sub">{{localize "UESRPG.Dialogs.SpellLearning.RitualSpellsHint"}}</div>
        </div>
      </div>
    </section>

    <section class="uesrpg-spelllearn__section">
      <h3>{{localize "UESRPG.Dialogs.SpellLearning.RecentPurchases"}}</h3>
      <ul class="uesrpg-spelllearn__log">
        {{#each recentLog as |row|}}
          <li>
            <b>{{row.outcome}}</b> - {{row.spellName}} ({{row.spellType}}, L{{row.level}}, {{row.school}})
            | {{row.paymentMode}} | XP {{row.costXp}} | Drakes {{row.costDrakes}}
            {{#if row.reason}} | {{row.reason}}{{/if}}
          </li>
        {{/each}}
        {{#unless recentLog.length}}
          <li>{{localize "UESRPG.Dialogs.SpellLearning.NoRecentPurchases"}}</li>
        {{/unless}}
      </ul>
    </section>
  </div>
</div>
