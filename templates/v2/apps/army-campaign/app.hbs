<div class="uesrpg-army-campaign__body">
  {{#if error}}
  <p class="notification error">{{error}}</p>
  {{else}}
  <section class="warfare-fieldset">
    <h3>{{group.name}}</h3>
    <p><strong>{{localize "UESRPG.Apps.ArmyCampaign.CampaignTurn"}}:</strong> {{state.campaignTurn}} | <strong>{{localize "UESRPG.Apps.ArmyCampaign.ArmyActions"}}:</strong> {{remainingActionsLabel}}</p>
    <p><strong>{{localize "UESRPG.Apps.ArmyCampaign.Marshal"}}:</strong> {{#if marshal}}{{marshal.name}}{{else}}{{localize "UESRPG.Apps.ArmyCampaign.Unassigned"}}{{/if}}</p>
    <p><strong>{{localize "UESRPG.UI.Location"}}:</strong> {{#if state.locationNote}}{{state.locationNote}}{{else}}{{localize "UESRPG.Apps.ArmyCampaign.Unset"}}{{/if}}</p>
    <p><strong>{{localize "UESRPG.Apps.ArmyCampaign.WarfareUnits"}}:</strong> {{warfareMemberCount}} | <strong>{{localize "UESRPG.Apps.ArmyCampaign.OtherMembers"}}:</strong> {{nonWarfareMemberCount}}</p>
    <div class="controls">
      {{#if editable}}<button type="button" data-action="advanceTurn"><i class="fas fa-forward"></i> {{localize "UESRPG.Apps.ArmyCampaign.AdvanceTurn"}}</button>{{/if}}
      {{#if editable}}<button type="button" data-action="setMarshal"><i class="fas fa-user-tie"></i> {{localize "UESRPG.Apps.ArmyCampaign.SetMarshal"}}</button>{{/if}}
      <button type="button" data-action="openMarshal"><i class="fas fa-user"></i> {{localize "UESRPG.Apps.ArmyCampaign.OpenMarshal"}}</button>
      {{#if editable}}<button type="button" data-action="toggleSupply"><i class="fas fa-boxes-stacked"></i> {{localize "UESRPG.Apps.ArmyCampaign.ToggleSupply"}}</button>{{/if}}
    </div>
  </section>

  <section class="warfare-fieldset">
    <h3>{{localize "UESRPG.Apps.ArmyCampaign.SupplyAndState"}}</h3>
    <p><strong>Reserve:</strong> {{state.supply.reserve}} / {{state.supply.capacity}}</p>
    <p><strong>In Supply:</strong> {{#if state.supply.inSupply}}Yes{{else}}No{{/if}} | <strong>Out of Supply Turns:</strong> {{state.supply.consecutiveOutOfSupplyTurns}}</p>
    <p><strong>Source Note:</strong> {{#if state.supply.sourceNote}}{{state.supply.sourceNote}}{{else}}Unset{{/if}}</p>
    <p><strong>Contact State:</strong> {{contactStateLabel}} | <strong>Surprise:</strong> {{surpriseStateLabel}} | <strong>Battle Role:</strong> {{battleRoleLabel}}</p>
  </section>

  <section class="warfare-fieldset">
    <h3>{{localize "UESRPG.Apps.ArmyCampaign.ArmyActions"}}</h3>
    <div class="controls">
      <button type="button" data-action="armyAction" data-army-action="march">{{localize "UESRPG.Apps.ArmyCampaign.March"}}</button>
      <button type="button" data-action="armyAction" data-army-action="scout">{{localize "UESRPG.Apps.ArmyCampaign.Scout"}}</button>
      <button type="button" data-action="armyAction" data-army-action="forage">{{localize "UESRPG.Apps.ArmyCampaign.ForageRequisition"}}</button>
      <button type="button" data-action="armyAction" data-army-action="raid">{{localize "UESRPG.Apps.ArmyCampaign.Raid"}}</button>
      <button type="button" data-action="armyAction" data-army-action="reinforce">{{localize "UESRPG.Apps.ArmyCampaign.ReinforceMuster"}}</button>
      <button type="button" data-action="armyAction" data-army-action="fortify">{{localize "UESRPG.Apps.ArmyCampaign.FortifyCamp"}}</button>
      <button type="button" data-action="armyAction" data-army-action="besiege">{{localize "UESRPG.Apps.ArmyCampaign.Besiege"}}</button>
      <button type="button" data-action="armyAction" data-army-action="special">{{localize "UESRPG.Apps.ArmyCampaign.SpecialOperation"}}</button>
      <button type="button" data-action="armyAction" data-army-action="contact">{{localize "UESRPG.Apps.ArmyCampaign.ResolveContact"}}</button>
    </div>
  </section>

  <section class="warfare-fieldset">
    <h3>{{localize "UESRPG.Apps.ArmyCampaign.Siege"}}</h3>
    <p><strong>Role:</strong> {{siegeRoleLabel}}</p>
    <p><strong>{{localize "UESRPG.Apps.ArmyCampaign.LinkedScene"}}:</strong> {{#if siegeScene}}{{siegeScene.name}}{{else}}{{localize "UESRPG.UI.None"}}{{/if}}</p>
    {{#if hasActiveSiege}}
    <p><strong>Settlement:</strong> {{#if siegeState.settlementName}}{{siegeState.settlementName}}{{else}}Unset{{/if}}</p>
    <p><strong>Fortification:</strong> Rating {{siegeState.fortificationRating}} | HP {{siegeState.fortificationHp}} / {{siegeState.fortificationHpMax}}</p>
    <p><strong>Blockade:</strong> {{siegeState.blockadeState}} | <strong>Sap:</strong> {{siegeState.sapProgress}} | <strong>Breach:</strong> {{siegeState.breachProgress}} | <strong>Repair:</strong> {{siegeState.repairProgress}}</p>
    <div class="controls">
      <button type="button" data-action="siegeAction" data-siege-action="blockade">Blockade</button>
      <button type="button" data-action="siegeAction" data-siege-action="repair">Repair</button>
      <button type="button" data-action="siegeAction" data-siege-action="sap">Sap / Breach</button>
      <button type="button" data-action="siegeAction" data-siege-action="smuggle">Smuggle / Supply</button>
      <button type="button" data-action="siegeAction" data-siege-action="assault">Assault</button>
      <button type="button" data-action="siegeAction" data-siege-action="sally">Sally</button>
      <button type="button" data-action="configureFeature">Configure Region Feature</button>
    </div>
    {{else}}
    <p class="warfare-hint">Link a siege scene with <strong>Besiege</strong> to unlock siege actions and Region-backed feature configuration.</p>
    {{/if}}
  </section>

  <section class="warfare-fieldset">
    <h3>{{localize "UESRPG.Apps.ArmyCampaign.History"}}</h3>
    {{#if recentHistory.length}}
    <div class="warfare-action-column__list">
      {{#each recentHistory}}
      <div class="warfare-effect-row">
        <span><strong>{{this.label}}</strong></span>
        <span>{{this.summary}}</span>
        <span class="warfare-effect-row__status">{{this.when}}</span>
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="warfare-hint">{{localize "UESRPG.Apps.ArmyCampaign.NoHistory"}}</p>
    {{/if}}
  </section>
  {{/if}}
</div>
