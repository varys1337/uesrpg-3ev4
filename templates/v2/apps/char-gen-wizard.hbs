<div class="uesrpg-char-gen__root">
  <section class="uesrpg-char-gen__layout">
    <aside class="uesrpg-char-gen__stages" aria-label="{{localize "UESRPG.Apps.CharGen.Stages"}}">
      <h3>{{localize "UESRPG.Apps.CharGen.Stages"}}</h3>
      <ol>
        {{#each stageData}}
          <li class="{{#if active}}is-active{{/if}} {{#if complete}}is-complete{{/if}} {{#if locked}}is-locked{{/if}}">
            <button
              type="button"
              class="uesrpg-char-gen__stage-link"
              data-action="goStage"
              data-stage="{{id}}"
              {{#if active}}aria-current="step"{{/if}}
              {{#unless clickable}}disabled{{/unless}}
            >
              <span class="status" aria-hidden="true">{{#if complete}}<i class="fas fa-check"></i>{{else}}<i class="fas fa-minus"></i>{{/if}}</span>
              <span class="label">{{label}}</span>
            </button>
          </li>
        {{/each}}
      </ol>
    </aside>

    <main class="uesrpg-char-gen__content">
      {{#if hasResumeCandidate}}
        <div class="uesrpg-char-gen__resume">
          <p>{{localize "UESRPG.Apps.CharGen.FoundSavedProgress" actor=resumeActorName}}</p>
          <div class="actions">
            <button type="button" class="dialog-button" data-action="resume">{{localize "UESRPG.Apps.CharGen.Resume"}}</button>
            <button type="button" class="dialog-button" data-action="restart">{{localize "UESRPG.Apps.CharGen.Restart"}}</button>
            <button type="button" class="dialog-button" data-action="dismissResume">{{localize "UESRPG.Apps.CharGen.Dismiss"}}</button>
          </div>
        </div>
      {{/if}}

      <header class="uesrpg-char-gen__header">
        <h2>{{stageTitle}}</h2>
        <p>{{stageBody}}</p>
        {{#if actor}}
          <div class="uesrpg-char-gen__actor-name">{{actorName}}</div>
        {{/if}}
        {{#if reviewMode}}
          <div class="uesrpg-char-gen__review-note">{{localize "UESRPG.DefectUpdate.ReviewMode"}}</div>
        {{/if}}
      </header>

      {{#if isStage.actor}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <label>{{localize "UESRPG.Apps.CharGen.NewActorName"}}</label>
          <input type="text" name="newActorName" value="{{ws.newActorName}}" placeholder="{{localize "UESRPG.Apps.CharGen.NewCharacter"}}">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="createActor">{{localize "UESRPG.Apps.CharGen.CreateNewPC"}}</button>
            {{#if hasAssignedCharacter}}
              <button type="button" class="dialog-button" data-action="useAssignedCharacter">{{localize "UESRPG.Apps.CharGen.UseAssignedCharacter"}}</button>
            {{/if}}
            {{#if hasSingleControlledToken}}
              <button type="button" class="dialog-button" data-action="useSelectedTokenActor">{{localize "UESRPG.Apps.CharGen.UseSelectedTokenActor"}}</button>
            {{/if}}
          </div>
        </section>
      {{/if}}

      {{#if isStage.race}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="chooseRace" {{#unless canEditFoundations}}disabled{{/unless}}>{{localize "UESRPG.Apps.CharGen.OpenRaceMenu"}}</button>
          </div>
          {{#if hasRacialGrants}}
            <div class="uesrpg-char-gen__grant-review">
              <h3>{{localize "UESRPG.DefectUpdate.RacialBenefits"}}</h3>
              {{#each racialGrants}}
                <div class="uesrpg-char-gen__grant-row {{#if applied}}is-applied{{else}}is-missing{{/if}}">
                  <span>{{label}}{{#if optionLabel}}: {{optionLabel}}{{/if}}</span>
                  {{#if applied}}
                    <span>{{localize "UESRPG.DefectUpdate.Applied"}}</span>
                    {{#if canChange}}
                      <button type="button" class="dialog-button" data-action="reconcileGrant" data-grant-id="{{id}}">{{localize "UESRPG.DefectUpdate.ChangeGrant"}}</button>
                    {{/if}}
                  {{else}}
                    <button type="button" class="dialog-button" data-action="reconcileGrant" data-grant-id="{{id}}">{{localize "UESRPG.DefectUpdate.Reconcile"}}</button>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          {{/if}}
        </section>
      {{/if}}

      {{#if isStage.stats}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="openStats" {{#unless canEditFoundations}}disabled{{/unless}}>{{localize "UESRPG.Apps.CharGen.OpenCharacteristicsMenu"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.birthsign}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="chooseBirthsign" {{#unless canEditFoundations}}disabled{{/unless}}>{{localize "UESRPG.Apps.CharGen.RollChooseBirthsign"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.resources}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="openStartingResources">{{localize "UESRPG.Apps.CharGen.OpenStartingResources"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.combatstyle}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="openCombatStyleSetup">{{localize "UESRPG.Apps.CharGen.OpenCombatStyleSetup"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.spendxp}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="openSpendXp">{{localize "UESRPG.Apps.CharGen.OpenSpendXp"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.spells}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="openSpellLearning">{{localize "UESRPG.Apps.CharGen.OpenSpellLearningMenu"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.luck}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button" data-action="openLuckyNumbers">{{localize "UESRPG.Apps.CharGen.RollSetLuckyNumbers"}}</button>
          </div>
        </section>
      {{/if}}

      {{#if isStage.finish}}
        <section class="uesrpg-char-gen__stage uesrpg-char-gen__stage--compact">
          <div class="actions">
            <button type="button" class="dialog-button default bright" data-action="finish">{{localize "UESRPG.Apps.CharGen.Finish"}}</button>
          </div>
        </section>
      {{/if}}
    </main>
  </section>

  <footer class="uesrpg-char-gen__footer">
    <button type="button" class="dialog-button" data-action="back" {{#unless canBack}}disabled{{/unless}}>{{localize "UESRPG.Apps.CharGen.Back"}}</button>
    <button type="button" class="dialog-button" data-action="next" {{#unless canNext}}disabled{{/unless}}>{{localize "UESRPG.Apps.CharGen.Next"}}</button>
    <button type="button" class="dialog-button" data-action="cancel">{{localize "UESRPG.UI.Cancel"}}</button>
  </footer>
</div>
