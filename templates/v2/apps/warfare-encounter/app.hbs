<section class="uesrpg-warfare-encounter">
  {{#if error}}
  <div class="warfare-callout warfare-callout--warning">
    <p>{{error}}</p>
  </div>
  {{else}}
  <header class="uesrpg-warfare-encounter__header warfare-sheet-content">
    <div class="warfare-callout warfare-callout--notice">
      <p><strong>Scene:</strong> {{scene.name}}</p>
      <p><strong>Encounter:</strong> {{#if state.active}}Active{{else}}Inactive{{/if}}</p>
      <p><strong>Round:</strong> {{state.round}} | <strong>Phase:</strong> {{phaseLabel}}</p>
      <p><strong>Priority Side:</strong> {{prioritySideLabel}}</p>
      {{#if isStrategicPhase}}
      <p><strong>Current Side:</strong> {{currentSideLabel}}</p>
      {{/if}}
    </div>

    <div class="warfare-action-column__list" style="display:flex; flex-wrap:wrap; gap:8px; margin-top:8px;">
      {{#if state.active}}
      <button type="button" class="warfare-action-btn" data-action="advanceEncounter">Advance to {{nextPhaseLabel}}</button>
      <button type="button" class="warfare-action-btn" data-action="passStrategic" {{#unless isStrategicPhase}}disabled{{/unless}}>Pass Side</button>
      <button type="button" class="warfare-action-btn" data-action="endEncounter">End Encounter</button>
      {{else}}
      <button type="button" class="warfare-action-btn" data-action="startEncounter">Start Encounter</button>
      {{/if}}
    </div>
  </header>

  <div class="uesrpg-warfare-encounter__body warfare-sheet-content" style="display:grid; grid-template-columns:minmax(0,1fr) minmax(260px,0.8fr); gap:16px; align-items:start;">
    <fieldset class="warfare-fieldset">
      <legend>Tracker</legend>
      <div class="warfare-callout warfare-callout--notice">
        <p>Use Warfare Unit actor sheets to declare charges, resolve strategic actions, and initiate clashes. This tracker only rotates the round phase and strategic side turn.</p>
      </div>

      <div style="display:flex; flex-direction:column; gap:8px; margin-top:12px;">
        <div class="warfare-effect-row">
          <div><strong>Declared Charges This Round</strong></div>
          <div>{{declaredChargeCount}}</div>
        </div>
        <div class="warfare-effect-row">
          <div><strong>Strategic Activations This Round</strong></div>
          <div>{{activationCount}}</div>
        </div>
        <div class="warfare-effect-row">
          <div><strong>Recent Clash Cards</strong></div>
          <div>{{latestClashCount}}</div>
        </div>
      </div>

      <div style="display:flex; flex-direction:column; gap:8px; margin-top:12px;">
        {{#each latestClashes}}
        <div class="warfare-effect-row">
          <div><strong>{{this.attackerName}}</strong> vs <strong>{{this.defenderName}}</strong></div>
          <div style="font-size:12px; opacity:0.8;">Round {{this.round}} | {{this.attackType}} | {{this.status}}</div>
        </div>
        {{else}}
        <p class="warfare-hint">No clash cards have been created for this encounter yet.</p>
        {{/each}}
      </div>
    </fieldset>

    <fieldset class="warfare-fieldset">
      <legend>Scene Units</legend>
      <div style="display:flex; flex-direction:column; gap:8px;">
        <div class="warfare-effect-row">
          <div><strong>Total Warfare Tokens</strong></div>
          <div>{{unitSummary.total}}</div>
        </div>
        <div class="warfare-effect-row">
          <div><strong>Allies</strong></div>
          <div>{{unitSummary.allies}}</div>
        </div>
        <div class="warfare-effect-row">
          <div><strong>Enemies</strong></div>
          <div>{{unitSummary.enemies}}</div>
        </div>
        <div class="warfare-effect-row">
          <div><strong>Neutral</strong></div>
          <div>{{unitSummary.neutral}}</div>
        </div>
        <div class="warfare-effect-row">
          <div><strong>Defeated</strong></div>
          <div>{{unitSummary.defeated}}</div>
        </div>
      </div>
    </fieldset>
  </div>
  {{/if}}
</section>
