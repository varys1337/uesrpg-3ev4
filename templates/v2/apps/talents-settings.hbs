{{!-- templates/v2/apps/talents-settings.hbs --}}
<section class="uesrpg-settings uesrpg-settings-panel">
  <fieldset class="uesrpg-settings__section">
    <legend>Talents</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-gladiator-automation-mode">Gladiator - Automation Mode</label>
      <select id="uesrpg-gladiator-automation-mode" name="gladiatorAutomationMode">
        <option value="disabled" {{#if (eq gladiatorAutomationMode "disabled")}}selected{{/if}}>Disabled</option>
        <option value="original" {{#if (eq gladiatorAutomationMode "original")}}selected{{/if}}>Original (Make)</option>
        <option value="updated" {{#if (eq gladiatorAutomationMode "updated")}}selected{{/if}}>Updated (Can)</option>
      </select>
    </div>

    <div class="setting-note">
      <p><strong>Original (Make):</strong> If the character is the target of a melee attack while within the melee range of at least two opponents, then they make a free defensive reaction against that attack, but only once per round.</p>
      <p><strong>Updated (Can):</strong> If the character is the target of a melee attack while within the melee range of at least two opponents, then they can make a free defensive reaction against that attack, but only once per round.</p>
      <p><strong>Disabled:</strong> Gladiator automation is not applied.</p>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enable-mighty-cleave">Enable Mighty Cleave Automation</label>
      </div>
      <input id="uesrpg-enable-mighty-cleave" type="checkbox" name="enableMightyCleave" {{checked enableMightyCleave}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enable-follow-up-strike">Enable Follow-up Strike Automation</label>
      </div>
      <input id="uesrpg-enable-follow-up-strike" type="checkbox" name="enableFollowUpStrike" {{checked enableFollowUpStrike}}>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-talent-learning-mode">Talent Learning Mode</label>
      <select id="uesrpg-talent-learning-mode" name="talentLearningMode">
        <option value="off" {{#if (eq talentLearningMode "off")}}selected{{/if}}>Off</option>
        <option value="warn" {{#if (eq talentLearningMode "warn")}}selected{{/if}}>Warn</option>
        <option value="enforce" {{#if (eq talentLearningMode "enforce")}}selected{{/if}}>Enforce</option>
      </select>
      <p class="setting-help"><strong>Off:</strong> no checks. <strong>Warn:</strong> report RAW violations but allow acquisition. <strong>Enforce:</strong> block invalid acquisitions and auto-deduct XP.</p>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-no-governing-xp-rule">No-Governing XP Rule</label>
      <select id="uesrpg-no-governing-xp-rule" name="talentNoGoverningCostRule">
        <option value="discounted" {{#if (eq talentNoGoverningCostRule "discounted")}}selected{{/if}}>Discounted (75%)</option>
        <option value="base" {{#if (eq talentNoGoverningCostRule "base")}}selected{{/if}}>Base Cost</option>
      </select>
      <p class="setting-help">Controls how talents with no governing characteristic are priced for learning checks.</p>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-talent-learning-notice-mode">Talent Learning Notifications</label>
      <select id="uesrpg-talent-learning-notice-mode" name="talentLearningNoticeMode">
        <option value="off" {{#if (eq talentLearningNoticeMode "off")}}selected{{/if}}>Off</option>
        <option value="problems" {{#if (eq talentLearningNoticeMode "problems")}}selected{{/if}}>Problems Only</option>
        <option value="verbose" {{#if (eq talentLearningNoticeMode "verbose")}}selected{{/if}}>Verbose (includes successful checks)</option>
      </select>
      <p class="setting-help">Controls notification verbosity when talent-learning validation runs.</p>
    </div>
  </fieldset>

  <fieldset class="uesrpg-settings__section">
    <legend>Chapter 4 Compliance</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-chapter4-audit-startup">Chapter 4 Audit at Startup</label>
      <select id="uesrpg-chapter4-audit-startup" name="chapter4AuditStartupMode">
        <option value="off" {{#if (eq chapter4AuditStartupMode "off")}}selected{{/if}}>Off</option>
        <option value="summary" {{#if (eq chapter4AuditStartupMode "summary")}}selected{{/if}}>Summary</option>
        <option value="full" {{#if (eq chapter4AuditStartupMode "full")}}selected{{/if}}>Full (include entries + console log)</option>
      </select>
      <p class="setting-help">Runs <code>game.uesrpg.auditChapter4()</code> on world startup for GMs and posts a summary notification.</p>
    </div>
  </fieldset>

  <fieldset class="uesrpg-settings__section">
    <legend>Character Generation</legend>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enforce-char-gen-milestones">Enforce Character Generation Milestones</label>
        <p class="setting-help">When enabled, Imperial racial talent automation applies only if the actor has completed character generation.</p>
      </div>
      <input id="uesrpg-enforce-char-gen-milestones" type="checkbox" name="enforceCharGenMilestones" {{checked enforceCharGenMilestones}}>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-spell-learning-log-cap">Spell Learning Log Cap</label>
      <input id="uesrpg-spell-learning-log-cap" type="number" name="chargenSpellLearningLogCap" value="{{chargenSpellLearningLogCap}}" min="0" max="5000" step="10">
      <p class="setting-help">0 means unlimited. Otherwise, keep only the most recent N spell-learning log entries per actor.</p>
    </div>
  </fieldset>

  <fieldset class="uesrpg-settings__section">
    <legend>Active Effects</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-passive-transfer-item-types">Passive Transfer Item Types</label>
      <input id="uesrpg-passive-transfer-item-types" type="text" name="passiveTransferItemTypes" value="{{passiveTransferItemTypes}}" placeholder="talent,trait,power,skill">
      <p class="setting-help">Comma-separated item types whose transfer Active Effects apply passively while the item remains in inventory.</p>
      <p class="setting-note">Changing this requires a reload.</p>
    </div>
  </fieldset>

  <footer class="uesrpg-settings__footer">
    <button type="submit" class="save"><i class="fas fa-save"></i> Save</button>
  </footer>
</section>
