{{!-- templates/v2/apps/talents-settings.hbs --}}
<section class="uesrpg-settings uesrpg-settings-panel">
  <fieldset class="uesrpg-settings__section">
    <legend>{{localize "UESRPG.Apps.TalentsSettings.Sections.Talents"}}</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-gladiator-automation-mode">{{settings.gladiatorAutomationMode.name}}</label>
      <select id="uesrpg-gladiator-automation-mode" name="gladiatorAutomationMode">
        {{selectOptions settings.gladiatorAutomationMode.choices selected=settings.gladiatorAutomationMode.value}}
      </select>
    </div>

    <div class="setting-note">
      <p>{{localize "UESRPG.Apps.TalentsSettings.Gladiator.Original"}}</p>
      <p>{{localize "UESRPG.Apps.TalentsSettings.Gladiator.Updated"}}</p>
      <p>{{localize "UESRPG.Apps.TalentsSettings.Gladiator.Disabled"}}</p>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enable-mighty-cleave">{{settings.enableMightyCleave.name}}</label>
        <p class="setting-help">{{settings.enableMightyCleave.hint}}</p>
      </div>
      <input id="uesrpg-enable-mighty-cleave" type="checkbox" name="enableMightyCleave" {{checked settings.enableMightyCleave.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enable-follow-up-strike">{{settings.enableFollowUpStrike.name}}</label>
        <p class="setting-help">{{settings.enableFollowUpStrike.hint}}</p>
      </div>
      <input id="uesrpg-enable-follow-up-strike" type="checkbox" name="enableFollowUpStrike" {{checked settings.enableFollowUpStrike.value}}>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-talent-learning-mode">{{settings.talentLearningMode.name}}</label>
      <select id="uesrpg-talent-learning-mode" name="talentLearningMode">
        {{selectOptions settings.talentLearningMode.choices selected=settings.talentLearningMode.value}}
      </select>
      <p class="setting-help">{{settings.talentLearningMode.hint}}</p>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-no-governing-xp-rule">{{settings.talentNoGoverningCostRule.name}}</label>
      <select id="uesrpg-no-governing-xp-rule" name="talentNoGoverningCostRule">
        {{selectOptions settings.talentNoGoverningCostRule.choices selected=settings.talentNoGoverningCostRule.value}}
      </select>
      <p class="setting-help">{{settings.talentNoGoverningCostRule.hint}}</p>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-talent-learning-notice-mode">{{settings.talentLearningNoticeMode.name}}</label>
      <select id="uesrpg-talent-learning-notice-mode" name="talentLearningNoticeMode">
        {{selectOptions settings.talentLearningNoticeMode.choices selected=settings.talentLearningNoticeMode.value}}
      </select>
      <p class="setting-help">{{settings.talentLearningNoticeMode.hint}}</p>
    </div>
  </fieldset>

  <fieldset class="uesrpg-settings__section">
    <legend>{{localize "UESRPG.Apps.TalentsSettings.Sections.CharacterGeneration"}}</legend>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enforce-char-gen-milestones">{{settings.enforceCharGenMilestones.name}}</label>
        <p class="setting-help">{{settings.enforceCharGenMilestones.hint}}</p>
      </div>
      <input id="uesrpg-enforce-char-gen-milestones" type="checkbox" name="enforceCharGenMilestones" {{checked settings.enforceCharGenMilestones.value}}>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-spell-learning-log-cap">{{settings.chargenSpellLearningLogCap.name}}</label>
      <input id="uesrpg-spell-learning-log-cap" type="number" name="chargenSpellLearningLogCap" value="{{settings.chargenSpellLearningLogCap.value}}" min="0" max="5000" step="10">
      <p class="setting-help">{{settings.chargenSpellLearningLogCap.hint}}</p>
    </div>
  </fieldset>

  <fieldset class="uesrpg-settings__section">
    <legend>{{localize "UESRPG.Apps.TalentsSettings.Sections.ActiveEffects"}}</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-passive-transfer-item-types">{{settings.passiveTransferItemTypes.name}}</label>
      <input id="uesrpg-passive-transfer-item-types" type="text" name="passiveTransferItemTypes" value="{{settings.passiveTransferItemTypes.value}}" placeholder="talent,trait,power,skill">
      <p class="setting-help">{{settings.passiveTransferItemTypes.hint}}</p>
      <p class="setting-note">{{localize "UESRPG.Apps.TalentsSettings.RequiresReload"}}</p>
    </div>
  </fieldset>

  <footer class="uesrpg-settings__footer">
    <button type="submit" class="save"><i class="fas fa-save"></i> {{localize "UESRPG.UI.Save"}}</button>
  </footer>
</section>
