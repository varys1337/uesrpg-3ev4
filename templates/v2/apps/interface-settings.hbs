{{!-- templates/v2/apps/interface-settings.hbs --}}
<section class="uesrpg-settings uesrpg-settings-panel">
  <fieldset class="uesrpg-settings__section">
    <legend>{{localize "UESRPG.Apps.InterfaceSettings.Sections.Interface"}}</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-change-ui-font">{{settings.changeUiFont.name}}</label>
      <select id="uesrpg-change-ui-font" name="changeUiFont">
        {{selectOptions settings.changeUiFont.choices selected=settings.changeUiFont.value}}
      </select>
      <p class="setting-help">{{settings.changeUiFont.hint}}</p>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-sheet-density">{{settings.sheetDensity.name}}</label>
      <select id="uesrpg-sheet-density" name="sheetDensity">
        {{selectOptions settings.sheetDensity.choices selected=settings.sheetDensity.value}}
      </select>
      <p class="setting-help">{{settings.sheetDensity.hint}}</p>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-no-startup-dialog">{{settings.noStartUpDialog.name}}</label>
        <p class="setting-help">{{settings.noStartUpDialog.hint}}</p>
      </div>
      <input id="uesrpg-no-startup-dialog" type="checkbox" name="noStartUpDialog" {{checked settings.noStartUpDialog.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enable-loadouts">{{settings.enableLoadouts.name}}</label>
        <p class="setting-help">{{settings.enableLoadouts.hint}}</p>
      </div>
      <input id="uesrpg-enable-loadouts" type="checkbox" name="enableLoadouts" {{checked settings.enableLoadouts.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-custom-cursor">{{settings.customCursor.name}}</label>
        <p class="setting-help">{{settings.customCursor.hint}}</p>
      </div>
      <input id="uesrpg-custom-cursor" type="checkbox" name="customCursor" {{checked settings.customCursor.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-inline-rules-tooltips">{{settings.enableInlineRulesTooltips.name}}</label>
        <p class="setting-help">{{settings.enableInlineRulesTooltips.hint}}</p>
      </div>
      <input id="uesrpg-inline-rules-tooltips" type="checkbox" name="enableInlineRulesTooltips" {{checked settings.enableInlineRulesTooltips.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-custom-journal-styling">{{settings.enableCustomJournalStyling.name}}</label>
        <p class="setting-help">{{settings.enableCustomJournalStyling.hint}}</p>
      </div>
      <input id="uesrpg-custom-journal-styling" type="checkbox" name="enableCustomJournalStyling" {{checked settings.enableCustomJournalStyling.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-encumbrance-breakdown">{{settings.encumbranceUiEnhanced.name}}</label>
        <p class="setting-help">{{settings.encumbranceUiEnhanced.hint}}</p>
      </div>
      <input id="uesrpg-encumbrance-breakdown" type="checkbox" name="encumbranceUiEnhanced" {{checked settings.encumbranceUiEnhanced.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-dialog-keyboard-flow">{{settings.dialogKeyboardEnhancements.name}}</label>
        <p class="setting-help">{{settings.dialogKeyboardEnhancements.hint}}</p>
      </div>
      <input id="uesrpg-dialog-keyboard-flow" type="checkbox" name="dialogKeyboardEnhancements" {{checked settings.dialogKeyboardEnhancements.value}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-item-row-quick-menu">{{settings.enableItemRowQuickMenu.name}}</label>
        <p class="setting-help">{{settings.enableItemRowQuickMenu.hint}}</p>
      </div>
      <input id="uesrpg-item-row-quick-menu" type="checkbox" name="enableItemRowQuickMenu" {{checked settings.enableItemRowQuickMenu.value}}>
    </div>

  </fieldset>

  <footer class="uesrpg-settings__footer">
    <button type="submit" class="save"><i class="fas fa-save"></i> {{localize "UESRPG.UI.Save"}}</button>
  </footer>
</section>
