{{!-- templates/v2/apps/interface-settings.hbs --}}
<section class="uesrpg-settings uesrpg-settings-panel">
  <fieldset class="uesrpg-settings__section">
    <legend>Interface</legend>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-change-ui-font">System Font</label>
      <select id="uesrpg-change-ui-font" name="changeUiFont">
        {{selectOptions fontChoices selected=changeUiFont}}
      </select>
      <p class="setting-help">Requires a reload to apply.</p>
    </div>

    <div class="setting-row setting-row--select">
      <label class="setting-row__label" for="uesrpg-sheet-density">Sheets: Density</label>
      <select id="uesrpg-sheet-density" name="sheetDensity">
        {{selectOptions sheetDensityChoices selected=sheetDensity}}
      </select>
      <p class="setting-help">Controls vertical spacing and row height for UESRPG AppV2 sheets.</p>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-no-startup-dialog">Do Not Show Dialogue on Startup</label>
      </div>
      <input id="uesrpg-no-startup-dialog" type="checkbox" name="noStartUpDialog" {{checked noStartUpDialog}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-sort-alpha">Sort Actor Items Alphabetically</label>
      </div>
      <input id="uesrpg-sort-alpha" type="checkbox" name="sortAlpha" {{checked sortAlpha}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-enable-loadouts">Sheets: Enable Loadout</label>
      </div>
      <input id="uesrpg-enable-loadouts" type="checkbox" name="enableLoadouts" {{checked enableLoadouts}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-custom-cursor">Custom Cursor</label>
        <p class="setting-help">Use the UESRPG stylized cursor. Requires a reload.</p>
      </div>
      <input id="uesrpg-custom-cursor" type="checkbox" name="customCursor" {{checked customCursor}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-auto-resize-sheets">Auto-resize Actor/Item Sheets</label>
        <p class="setting-help">Automatically resize sheets to fit content, clamped to screen height.</p>
      </div>
      <input id="uesrpg-auto-resize-sheets" type="checkbox" name="autoResizeSheets" {{checked autoResizeSheets}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-inline-rules-tooltips">Sheets: Inline Rules Tooltips</label>
        <p class="setting-help">Show inline tooltips for qualities, traits, and special actions. Alt-click opens a help dialog.</p>
      </div>
      <input id="uesrpg-inline-rules-tooltips" type="checkbox" name="enableInlineRulesTooltips" {{checked enableInlineRulesTooltips}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-encumbrance-breakdown">Sheets: Encumbrance Breakdown + Highlights</label>
        <p class="setting-help">Show the ENC breakdown dialog and highlight top encumbrance contributors.</p>
      </div>
      <input id="uesrpg-encumbrance-breakdown" type="checkbox" name="encumbranceUiEnhanced" {{checked encumbranceUiEnhanced}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-dialog-keyboard-flow">Dialogs: Enhanced Keyboard Flow</label>
        <p class="setting-help">DialogV2 dialogs auto-focus the first input and support consistent Enter/Esc keyboard actions.</p>
      </div>
      <input id="uesrpg-dialog-keyboard-flow" type="checkbox" name="dialogKeyboardEnhancements" {{checked dialogKeyboardEnhancements}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-item-row-quick-menu">Sheets: Item Row Quick Actions Menu</label>
        <p class="setting-help">When enabled, right-clicking an item row opens a quick actions menu.</p>
      </div>
      <input id="uesrpg-item-row-quick-menu" type="checkbox" name="enableItemRowQuickMenu" {{checked enableItemRowQuickMenu}}>
    </div>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-opposed-sub-rolls">Opposed Rolls: Post Sub-Roll Chat Messages</label>
        <p class="setting-help">Disable to reduce chat spam so only the parent opposed card is created or updated.</p>
      </div>
      <input id="uesrpg-opposed-sub-rolls" type="checkbox" name="opposedPostSubRollMessages" {{checked opposedPostSubRollMessages}}>
    </div>
  </fieldset>

  <fieldset class="uesrpg-settings__section">
    <legend>Rule Elements</legend>

    <div class="setting-row setting-row--toggle">
      <div class="setting-row__main">
        <label class="setting-row__label" for="uesrpg-rule-elements-runtime">Rule Elements Engine</label>
        <p class="setting-help">Runs Rule Element automation during opposed workflows. Disabling it suppresses RE automation and hides the Automation tab on item sheets.</p>
      </div>
      <input id="uesrpg-rule-elements-runtime" type="checkbox" name="enableRuleElementsRuntime" {{checked enableRuleElementsRuntime}}>
    </div>
  </fieldset>

  <footer class="uesrpg-settings__footer">
    <button type="submit" class="save"><i class="fas fa-save"></i> Save</button>
  </footer>
</section>
