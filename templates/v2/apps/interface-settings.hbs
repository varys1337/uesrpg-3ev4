{{!-- templates/v2/apps/interface-settings.hbs — AppV2 (no <form> wrapper) --}}
<section class="uesrpg-settings">
<fieldset>
  <legend>Interface</legend>

  <div class="form-group">
    <label>System Font</label>
    <select name="changeUiFont">
      {{selectOptions fontChoices selected=changeUiFont}}
    </select>
    <p class="notes">Requires a reload to apply.</p>
  </div>

  <div class="form-group">
    <label>Sheets: Density</label>
    <select name="sheetDensity">
      {{selectOptions sheetDensityChoices selected=sheetDensity}}
    </select>
    <p class="notes">Controls vertical spacing and row height for UESRPG AppV2 sheets.</p>
  </div>

  <div class="form-group">
    <label>Do Not Show Dialogue on Startup</label>
    <input type="checkbox" name="noStartUpDialog" {{checked noStartUpDialog}}>
  </div>

  <div class="form-group">
    <label>Sort Actor Items Alphabetically</label>
    <input type="checkbox" name="sortAlpha" {{checked sortAlpha}}>
  </div>

  <div class="form-group">
    <label>Sheets: Enable Loadout</label>
    <input type="checkbox" name="enableLoadouts" {{checked enableLoadouts}}>
  </div>

  <div class="form-group">
    <label>Custom Cursor</label>
    <input type="checkbox" name="customCursor" {{checked customCursor}}>
    <p class="notes">Use the UESRPG stylized cursor (requires reload).</p>
  </div>

  <div class="form-group">
    <label>Auto-resize Actor/Item Sheets</label>
    <input type="checkbox" name="autoResizeSheets" {{checked autoResizeSheets}}>
    <p class="notes">Automatically resize sheets to fit content (clamped to screen height).</p>
  </div>

  <div class="form-group">
    <label>Sheets: Inline Rules Tooltips</label>
    <input type="checkbox" name="enableInlineRulesTooltips" {{checked enableInlineRulesTooltips}}>
    <p class="notes">Show inline tooltips for qualities/traits and special actions. Alt-click opens a help dialog.</p>
  </div>

  <div class="form-group">
    <label>Sheets: Encumbrance Breakdown + Highlights</label>
    <input type="checkbox" name="encumbranceUiEnhanced" {{checked encumbranceUiEnhanced}}>
    <p class="notes">Show ENC breakdown dialog and highlight top encumbrance contributors.</p>
  </div>

  <div class="form-group">
    <label>Dialogs: Enhanced Keyboard Flow</label>
    <input type="checkbox" name="dialogKeyboardEnhancements" {{checked dialogKeyboardEnhancements}}>
    <p class="notes">When enabled, DialogV2 dialogs auto-focus the first input and support Enter/Esc keyboard actions in a consistent way.</p>
  </div>

  <div class="form-group">
    <label>Sheets: Item Row Quick Actions Menu</label>
    <input type="checkbox" name="enableItemRowQuickMenu" {{checked enableItemRowQuickMenu}}>
    <p class="notes">When enabled, right-click on an item row opens a quick actions menu.</p>
  </div>

  <div class="form-group">
    <label>Opposed Rolls: Post Sub-Roll Chat Messages</label>
    <input type="checkbox" name="opposedPostSubRollMessages" {{checked opposedPostSubRollMessages}}>
    <p class="notes">Disable to reduce chat spam; only the parent opposed card will be created/updated.</p>
  </div>
</fieldset>

<fieldset>
  <legend>Rule Elements</legend>

  <div class="form-group">
    <label>Rule Elements Engine</label>
    <input type="checkbox" name="enableRuleElementsRuntime" {{checked enableRuleElementsRuntime}}>
    <p class="notes">When enabled, Rule Element automation runs during opposed workflows (combat, skill, magic). When disabled, all RE automation is suppressed and the Automation tab is hidden on item sheets.</p>
  </div>
</fieldset>

<footer class="sheet-footer flexrow">
  <button type="submit" class="save"><i class="fas fa-save"></i> Save</button>
</footer>
</section>
