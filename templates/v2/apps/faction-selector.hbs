<div class="social-selector-app">
  <div class="social-selector-layout">
    <section class="social-panel">
      <h2 class="social-panel-title">{{localize "UESRPG.Apps.FactionSelector.Available"}}</h2>
      <input id="social-faction-search" type="text" value="{{search}}" placeholder="{{localize "UESRPG.Apps.FactionSelector.SearchPlaceholder"}}">
      <div class="social-choice-list social-choice-list--factions">
        {{#each choices as |choice|}}
          <div class="social-choice-row">
            <span>{{choice.label}}</span>
            <button
              type="button"
              data-action="addFaction"
              data-faction-id="{{choice.id}}"
              data-faction-name="{{choice.name}}"
              {{#if choice.disabled}}disabled{{/if}}>
              {{#if choice.disabled}}{{localize "UESRPG.UI.Added"}}{{else}}{{localize "UESRPG.UI.Add"}}{{/if}}
            </button>
          </div>
        {{/each}}
        {{#unless choices.length}}
          <p class="social-empty">{{localize "UESRPG.Apps.FactionSelector.NoMatches"}}</p>
        {{/unless}}
      </div>
      <div class="social-custom-add">
        <input id="social-faction-custom" type="text" placeholder="{{localize "UESRPG.Apps.FactionSelector.CustomPlaceholder"}}">
        <button type="button" data-action="addCustomFaction">{{localize "UESRPG.UI.AddCustom"}}</button>
      </div>
    </section>

    <section class="social-panel">
      <h2 class="social-panel-title">{{localize "UESRPG.Apps.FactionSelector.Selected"}}</h2>
      <div class="social-selected-list social-selected-list--factions">
        {{#each entries as |entry|}}
          <div class="social-faction-row" data-entry-id="{{entry.id}}">
            <label class="social-faction-cell social-faction-cell--name" data-field-label="Nm">
              <input class="social-faction-input" data-field="name" type="text" value="{{entry.name}}" placeholder="{{localize "UESRPG.UI.Name"}}">
            </label>
            <label class="social-faction-cell social-faction-cell--rank" data-field-label="Rk">
              <input class="social-faction-input" data-field="rankTitle" type="text" value="{{entry.rankTitle}}" placeholder="{{localize "UESRPG.Apps.FactionSelector.Rank"}}">
            </label>
            <label class="social-faction-cell social-faction-cell--location" data-field-label="Loc">
              <input class="social-faction-input" data-field="location" type="text" value="{{entry.location}}" placeholder="{{localize "UESRPG.UI.Location"}}">
            </label>
            <label class="social-faction-cell social-faction-cell--notes" data-field-label="Nt">
              <input class="social-faction-input" data-field="notes" type="text" value="{{entry.notes}}" placeholder="{{localize "UESRPG.UI.Notes"}}">
            </label>
            <button type="button" data-action="removeFaction" data-entry-id="{{entry.id}}">{{localize "UESRPG.UI.Remove"}}</button>
          </div>
        {{/each}}
        {{#unless entries.length}}
          <p class="social-empty">{{localize "UESRPG.Apps.FactionSelector.Empty"}}</p>
        {{/unless}}
      </div>
    </section>
  </div>

  <footer class="social-selector-footer">
    <button type="button" data-action="cancel">{{localize "UESRPG.UI.Cancel"}}</button>
    <button type="button" data-action="save" class="default">{{localize "UESRPG.UI.Save"}}</button>
  </footer>
</div>
