{{!-- templates/v2/apps/migration-settings.hbs --}}
<section class="uesrpg-settings uesrpg-settings-panel" aria-busy="{{isRunning}}">
  <div class="uesrpg-settings__body">
    <fieldset class="uesrpg-settings__section">
      <legend>{{localize "UESRPG.Apps.MigrationSettings.Sections.ManualRun"}}</legend>

      <div class="uesrpg-settings__summary">
        <p class="setting-row__label">{{localize "UESRPG.Apps.MigrationSettings.StatusLabel" currentVersion=currentVersion}}</p>
        <p class="setting-help">{{localize "UESRPG.Apps.MigrationSettings.PendingSummary" count=pendingCount}}</p>
      </div>

      <ul class="uesrpg-migration-status-list">
        {{#each statuses as |entry|}}
        <li class="uesrpg-migration-status-row" data-migration-key="{{entry.key}}">
          <strong class="setting-row__label">{{entry.label}}</strong>
          <span class="uesrpg-migration-status-badge {{#if entry.upToDate}}uesrpg-migration-status-badge--current{{else}}uesrpg-migration-status-badge--pending{{/if}}">
            {{#if entry.upToDate}}{{localize "UESRPG.UI.UpToDate"}}{{else}}{{localize "UESRPG.UI.Outdated"}}{{/if}}
          </span>
          <p class="setting-help">{{localize "UESRPG.Apps.MigrationSettings.RevisionStatus" applied=entry.appliedRevision required=entry.requiredRevision}}</p>
        </li>
        {{/each}}
      </ul>
    </fieldset>
  </div>

  <footer class="uesrpg-settings__footer">
    <button type="button" data-action="runMigrations" class="save"
      aria-describedby="uesrpg-run-migrations-hint"
      {{#unless canRun}}disabled{{/unless}}
      {{#if isRunning}}disabled{{/if}}>
      <i class="fas fa-play" aria-hidden="true"></i>
      {{#if isRunning}}{{localize "UESRPG.Apps.MigrationSettings.Running"}}{{else}}{{localize "UESRPG.Apps.MigrationSettings.RunNow"}}{{/if}}
    </button>
    <p id="uesrpg-run-migrations-hint" class="setting-help">{{localize "UESRPG.Apps.MigrationSettings.RunHint"}}</p>
  </footer>
</section>
