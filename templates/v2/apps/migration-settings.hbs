{{!-- templates/v2/apps/migration-settings.hbs --}}
<section class="uesrpg-settings">
<fieldset>
  <legend>{{localize "UESRPG.Apps.MigrationSettings.Sections.Startup"}}</legend>

  <div class="form-group">
    <label>{{autoRunMigrationsOnStartupSetting.name}}</label>
    <input type="checkbox" name="autoRunMigrationsOnStartup" {{checked autoRunMigrationsOnStartup}}>
    <p class="notes">{{autoRunMigrationsOnStartupSetting.hint}}</p>
  </div>
</fieldset>

<fieldset>
  <legend>{{localize "UESRPG.Apps.MigrationSettings.Sections.ManualRun"}}</legend>

  <div class="form-group">
    <label>{{localize "UESRPG.Apps.MigrationSettings.StatusLabel" currentVersion=currentVersion}}</label>
    <p class="notes">{{localize "UESRPG.Apps.MigrationSettings.StatusActorsPrefix" version=status.actors.version}} {{#if status.actors.upToDate}}({{localize "UESRPG.UI.UpToDate"}}){{else}}({{localize "UESRPG.UI.Outdated"}}){{/if}}</p>
    <p class="notes">{{localize "UESRPG.Apps.MigrationSettings.StatusItemsPrefix" version=status.items.version}} {{#if status.items.upToDate}}({{localize "UESRPG.UI.UpToDate"}}){{else}}({{localize "UESRPG.UI.Outdated"}}){{/if}}</p>
    <p class="notes">{{localize "UESRPG.Apps.MigrationSettings.StatusCombatLegacyPrefix" version=status.combatLegacy.version}} {{#if status.combatLegacy.upToDate}}({{localize "UESRPG.UI.UpToDate"}}){{else}}({{localize "UESRPG.UI.Outdated"}}){{/if}}</p>
  </div>

  <div class="form-group">
    <button
      type="button"
      data-action="runMigrations"
      class="save"
      {{#if isRunning}}disabled{{/if}}>
      <i class="fas fa-play"></i>
      {{#if isRunning}}{{localize "UESRPG.Apps.MigrationSettings.Running"}}{{else}}{{localize "UESRPG.Apps.MigrationSettings.RunNow"}}{{/if}}
    </button>
    <p class="notes">{{localize "UESRPG.Apps.MigrationSettings.RunHint"}}</p>
  </div>
</fieldset>

<footer class="sheet-footer flexrow">
  <button type="submit" class="save"><i class="fas fa-save"></i> {{localize "UESRPG.UI.Save"}}</button>
</footer>
</section>
