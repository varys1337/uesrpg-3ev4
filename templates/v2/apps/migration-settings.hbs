{{!-- templates/v2/apps/migration-settings.hbs --}}
<section class="uesrpg-settings">
<fieldset>
  <legend>{{localize "UESRPG.Apps.MigrationSettings.Sections.ManualRun"}}</legend>

  <div class="form-group">
    <label>{{localize "UESRPG.Apps.MigrationSettings.StatusLabel" currentVersion=currentVersion}}</label>
    <p class="notes">{{localize "UESRPG.Apps.MigrationSettings.PendingSummary" count=pendingCount}}</p>
    <div class="uesrpg-migration-status-list">
      {{#each statuses as |entry|}}
        <div class="form-group stacked uesrpg-migration-status-row">
          <label>{{entry.label}}</label>
          <p class="notes">
            {{localize "UESRPG.Apps.MigrationSettings.RevisionStatus" applied=entry.appliedRevision required=entry.requiredRevision}}
            {{#if entry.upToDate}}({{localize "UESRPG.UI.UpToDate"}}){{else}}({{localize "UESRPG.UI.Outdated"}}){{/if}}
          </p>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="form-group">
    <button
      type="button"
      data-action="runMigrations"
      class="save"
      {{#unless canRun}}disabled{{/unless}}
      {{#if isRunning}}disabled{{/if}}>
      <i class="fas fa-play"></i>
      {{#if isRunning}}{{localize "UESRPG.Apps.MigrationSettings.Running"}}{{else}}{{localize "UESRPG.Apps.MigrationSettings.RunNow"}}{{/if}}
    </button>
    <p class="notes">{{localize "UESRPG.Apps.MigrationSettings.RunHint"}}</p>
  </div>
</fieldset>
</section>
