{{!-- AppV2 Alchemy Workshop. The ApplicationV2 root is the form element. --}}
<div class="alchemy-workshop-root">
<section class="alchemy-workshop-body">
  <input type="hidden" name="actorUuid" value="{{actorUuid}}">
  <input type="hidden" name="mode" value="{{mode}}">

  {{#if actorFound}}
  <header class="alchemy-workshop-header">
    <div class="alchemy-workshop-identity">
      <img class="alchemy-workshop-portrait" src="{{actorImg}}" alt="">
      <div class="alchemy-workshop-identity__copy">
        <span class="alchemy-workshop-kicker">{{localize "UESRPG.Apps.AlchemyWorkshop.IdentityKicker"}}</span>
        <strong>{{actorName}}</strong>
        <span>{{localize "UESRPG.Apps.AlchemyWorkshop.SkillSummary" tn=skillSnapshot.tn rank=skillSnapshot.rankLabel}}</span>
      </div>
    </div>
    <div class="alchemy-workshop-inventory">
      <div class="alchemy-workshop-stat"><span>{{localize "UESRPG.Apps.AlchemyWorkshop.UsableIngredients"}}</span><strong>{{usableIngredientCount}}</strong></div>
      <div class="alchemy-workshop-stat"><span>{{localize "UESRPG.Apps.AlchemyWorkshop.UnconfiguredIngredients"}}</span><strong>{{unconfiguredIngredientCount}}</strong></div>
      <div class="alchemy-workshop-stat {{#unless inventory.requirementMet}}is-danger{{/unless}}"><span>{{localize "UESRPG.Apps.AlchemyWorkshop.LabStatus"}}</span><strong>{{#if inventory.requireLab}}{{#if inventory.toolsPresent}}{{localize "UESRPG.Apps.AlchemyWorkshop.Ready"}}{{else}}{{localize "UESRPG.Apps.AlchemyWorkshop.Missing"}}{{/if}}{{else}}{{localize "UESRPG.Apps.AlchemyWorkshop.Waived"}}{{/if}}</strong></div>
    </div>
  </header>

  <div class="alchemy-workshop-chips">
    {{#if talents.isMasterAlchemist}}<span>{{localize "UESRPG.Apps.AlchemyWorkshop.Talents.MasterAlchemist"}}</span>{{/if}}
    {{#each talents.alchemistSchools as |school|}}<span>{{localize "UESRPG.Apps.AlchemyWorkshop.Talents.Alchemist" school=(capitalize school)}}</span>{{/each}}
    {{#if talents.hasNothingVentured}}<span>{{localize "UESRPG.Apps.AlchemyWorkshop.Talents.NothingVentured"}}</span>{{/if}}
    {{#if talents.hasTrialAndError}}<span>{{localize "UESRPG.Apps.AlchemyWorkshop.Talents.TrialAndError"}}</span>{{/if}}
  </div>

  <nav class="alchemy-mode-tabs" aria-label="{{localize "UESRPG.Apps.AlchemyWorkshop.ModeNavigation"}}">
    {{#each modeOptions as |option|}}
    <button type="button" class="alchemy-mode-tab {{#if option.active}}is-active{{/if}}" data-action="modeChange" data-mode="{{option.key}}" aria-label="{{option.label}}" aria-pressed="{{#if option.active}}true{{else}}false{{/if}}" data-tooltip-text="{{option.unavailableReason}}" {{#unless option.available}}disabled{{/unless}}>
      <i class="{{option.icon}}" aria-hidden="true"></i><span>{{option.label}}</span>
    </button>
    {{/each}}
  </nav>

  {{#if hardError}}<div class="alchemy-workshop-banner is-danger">{{hardError}}</div>{{/if}}

  {{#if (or (eq mode "potion") (eq mode "toxin"))}}
  <section class="alchemy-workshop-panel">
    <div class="alchemy-workshop-panel__heading">
      <div><span class="alchemy-workshop-kicker">{{localize "UESRPG.Apps.AlchemyWorkshop.Recipe"}}</span><h2>{{#if (eq mode "potion")}}{{localize "UESRPG.Apps.AlchemyWorkshop.Modes.Potion.Description"}}{{else}}{{localize "UESRPG.Apps.AlchemyWorkshop.Modes.Toxin.Description"}}{{/if}}</h2></div>
      <span>{{localize "UESRPG.Apps.AlchemyWorkshop.AnyEffectGuidance"}}</span>
    </div>
    <div class="alchemy-slot-grid">
      {{#each slots as |slot|}}
      <article class="alchemy-recipe-card {{#if slot.ingredient}}is-filled{{/if}}">
        <header><span>{{localize "UESRPG.Apps.AlchemyWorkshop.EffectSlot" number=slot.number}}</span>{{#if slot.descriptor}}<small>{{slot.sourceLabel}}</small>{{/if}}</header>
        <input type="hidden" name="ingredientUuid-{{slot.idx}}" value="{{slot.ingredientUuid}}">
        <div class="alchemy-ingredient-field">
          <span class="alchemy-ingredient-field__label">{{localize "UESRPG.Apps.AlchemyWorkshop.Ingredient"}}</span>
          <div class="alchemy-ingredient-drop {{#if slot.ingredient}}is-selected{{/if}}" data-alchemy-ingredient-drop="{{slot.idx}}" tabindex="0" role="group" aria-label="{{localize 'UESRPG.Apps.AlchemyWorkshop.Dropzones.DropIngredient'}}">
            {{#if slot.ingredient}}
            <img src="{{slot.ingredient.item.img}}" alt="">
            <span><strong>{{slot.ingredient.name}}</strong><small>{{slot.ingredient.displayMeta}}</small></span>
            <button type="button" data-action="clearIngredient" data-ingredient-target="{{slot.idx}}" aria-label="{{localize 'UESRPG.Apps.AlchemyWorkshop.Dropzones.Clear'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
            {{else}}
            <i class="fas fa-seedling" aria-hidden="true"></i><span>{{localize "UESRPG.Apps.AlchemyWorkshop.Dropzones.DropIngredient"}}</span>
            {{/if}}
          </div>
          <button type="button" class="alchemy-ingredient-choose" data-action="chooseIngredient" data-ingredient-target="{{slot.idx}}">{{localize "UESRPG.Apps.AlchemyWorkshop.Dropzones.ChooseInventory"}}</button>
        </div>
        <div class="form-group">
          <label for="{{@root.controlIdPrefix}}-effect-{{slot.idx}}">{{localize "UESRPG.Apps.AlchemyWorkshop.Effect"}}</label>
          <select id="{{@root.controlIdPrefix}}-effect-{{slot.idx}}" name="effect-{{slot.idx}}" data-alchemy-control {{#unless slot.ingredient}}disabled{{else}}required{{/unless}}>
            <option value="">{{#if slot.ingredient}}{{localize "UESRPG.Apps.AlchemyWorkshop.ChooseEffect"}}{{else}}{{localize "UESRPG.Apps.AlchemyWorkshop.ChooseIngredientFirst"}}{{/if}}</option>
            {{#each slot.catalogOptions as |effect|}}<option value="{{effect.key}}" {{#if effect.selected}}selected{{/if}}>{{effect.label}}</option>{{/each}}
          </select>
        </div>
        {{#if slot.descriptor}}
        <div class="alchemy-recipe-controls">
          <div class="form-group"><label for="{{@root.controlIdPrefix}}-sl-{{slot.idx}}">{{localize "UESRPG.Apps.AlchemyWorkshop.SpellLevel"}}</label><select id="{{@root.controlIdPrefix}}-sl-{{slot.idx}}" name="sl-{{slot.idx}}" data-alchemy-control>{{#each slot.levelOptions as |level|}}<option value="{{level.value}}" {{#if level.selected}}selected{{/if}} {{#if level.disabled}}disabled{{/if}}>SL {{level.value}}{{#if level.cost}} · {{localize "UESRPG.Apps.AlchemyWorkshop.Cost"}} {{level.cost}}{{/if}}</option>{{/each}}</select></div>
          {{#each slot.parameters as |parameter|}}<div class="form-group"><label for="{{@root.controlIdPrefix}}-param-{{slot.idx}}-{{parameter.key}}">{{parameter.label}}</label><select id="{{@root.controlIdPrefix}}-param-{{slot.idx}}-{{parameter.key}}" name="param-{{slot.idx}}-{{parameter.key}}" data-alchemy-control required>{{#each parameter.options as |option|}}<option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></div>{{/each}}
        </div>
        <div class="alchemy-effect-summary"><span>{{slot.descriptor.effectLabel}}</span><span>{{localize "UESRPG.Apps.AlchemyWorkshop.CostCapacity" cost=slot.descriptor.cost capacity=slot.ingredient.effectiveStrength}}</span><span>{{localize "UESRPG.Apps.AlchemyWorkshop.Duration" duration=slot.durationLabel}}</span></div>
        {{/if}}
        <details class="alchemy-custom-effect" {{#if (eq slot.slot.effectSource "spell")}}open{{/if}}>
          <summary>{{localize "UESRPG.Apps.AlchemyWorkshop.CustomEffect"}}</summary>
          <div class="alchemy-custom-drop {{#if (eq slot.slot.effectSource "spell")}}is-filled{{/if}}" data-custom-drop-slot="{{slot.idx}}">
            {{#if (eq slot.slot.effectSource "spell")}}<span>{{slot.descriptor.effectLabel}}</span><button type="button" data-action="clearCustom" data-slot="{{slot.idx}}" aria-label="{{localize "UESRPG.Buttons.Clear"}}"><i class="fas fa-times"></i></button>{{else}}<span>{{localize "UESRPG.Apps.AlchemyWorkshop.DropCustomSpell"}}</span>{{/if}}
          </div>
          <small>{{localize "UESRPG.Apps.AlchemyWorkshop.CustomEffectWarning"}}</small>
        </details>
      </article>
      {{/each}}
    </div>
  </section>
  {{/if}}

  {{#if (eq mode "poison")}}
  <section class="alchemy-workshop-panel alchemy-focused-card">
    <div class="alchemy-workshop-panel__heading"><div><span class="alchemy-workshop-kicker">{{localize "UESRPG.Apps.AlchemyWorkshop.Modes.Poison.Label"}}</span><h2>{{localize "UESRPG.Apps.AlchemyWorkshop.Modes.Poison.Description"}}</h2></div></div>
    <input type="hidden" name="poisonIngredientUuid" value="{{poisonIngredient.uuid}}">
    <div class="alchemy-ingredient-field is-focused">
      <span class="alchemy-ingredient-field__label">{{localize "UESRPG.Apps.AlchemyWorkshop.DestructionIngredient"}}</span>
      <div class="alchemy-ingredient-drop {{#if poisonIngredient}}is-selected{{/if}}" data-alchemy-ingredient-drop="poison" tabindex="0" role="group" aria-label="{{localize 'UESRPG.Apps.AlchemyWorkshop.Dropzones.DropDestructionIngredient'}}">
        {{#if poisonIngredient}}
        <img src="{{poisonIngredient.item.img}}" alt="">
        <span><strong>{{poisonIngredient.name}}</strong><small>{{poisonIngredient.displayMeta}}</small></span>
        <button type="button" data-action="clearIngredient" data-ingredient-target="poison" aria-label="{{localize 'UESRPG.Apps.AlchemyWorkshop.Dropzones.Clear'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
        {{else}}
        <i class="fas fa-skull-crossbones" aria-hidden="true"></i><span>{{localize "UESRPG.Apps.AlchemyWorkshop.Dropzones.DropDestructionIngredient"}}</span>
        {{/if}}
      </div>
      <button type="button" class="alchemy-ingredient-choose" data-action="chooseIngredient" data-ingredient-target="poison">{{localize "UESRPG.Apps.AlchemyWorkshop.Dropzones.ChooseInventory"}}</button>
    </div>
    {{#if poisonIngredient}}<div class="alchemy-poison-profile"><span>{{poisonIngredient.qualityLabel}}</span><strong>{{localize "UESRPG.Apps.AlchemyWorkshop.PoisonProfile" level=poisonIngredient.depthBase dice=poisonDice}}</strong><span>×{{poisonIngredient.quantity}}</span></div>{{/if}}
  </section>
  {{/if}}

  {{#if (eq mode "gather")}}
  <section class="alchemy-workshop-panel alchemy-focused-card">
    <div class="alchemy-workshop-panel__heading"><div><span class="alchemy-workshop-kicker">{{localize "UESRPG.Apps.AlchemyWorkshop.Modes.Gather.Label"}}</span><h2>{{localize "UESRPG.Apps.AlchemyWorkshop.Modes.Gather.Description"}}</h2></div></div>
    <div class="alchemy-gather-overview">
      <div><span>{{localize "UESRPG.Apps.AlchemyWorkshop.GatherTest"}}</span><strong>{{localize "UESRPG.Apps.AlchemyWorkshop.SkillSummary" tn=skillSnapshot.tn rank=skillSnapshot.rankLabel}}</strong></div>
      <div><span>{{localize "UESRPG.Apps.AlchemyWorkshop.GatherTime"}}</span><strong>{{localize "UESRPG.Apps.AlchemyWorkshop.FourHours"}}</strong></div>
      <div><span>{{localize "UESRPG.Apps.AlchemyWorkshop.GatherDailyLimit"}}</span><strong>{{localize "UESRPG.Apps.AlchemyWorkshop.TwoTests"}}</strong></div>
    </div>
    <div class="form-group"><label for="{{controlIdPrefix}}-gather-school">{{localize "UESRPG.Chat.Magic.School"}}</label><select id="{{controlIdPrefix}}-gather-school" name="gather-school" data-alchemy-control>{{#each schools as |school|}}<option value="{{school.key}}" {{#if school.selected}}selected{{/if}}>{{capitalize school.key}}</option>{{/each}}</select></div>
    <div class="alchemy-workshop-banner is-info"><strong>{{localize "UESRPG.Apps.AlchemyWorkshop.GatherResultGuidance"}}</strong><span>{{localize "UESRPG.Apps.AlchemyWorkshop.GatherGuidance"}}</span></div>
  </section>
  {{/if}}

  {{#unless (eq mode "gather")}}
  <section class="alchemy-workshop-summary">
    <div class="alchemy-summary-stat"><span>{{localize "UESRPG.Apps.AlchemyWorkshop.BaseTN"}}</span><strong>{{mods.tn}}</strong></div>
    <div class="alchemy-summary-stat"><span>{{localize "UESRPG.Apps.AlchemyWorkshop.AdjustedTN"}}</span><strong>{{adjustedTN}}</strong></div>
    <div class="alchemy-summary-stat"><span>{{localize "UESRPG.Apps.AlchemyWorkshop.BrewTime"}}</span><strong>{{mods.brewTime}}h</strong></div>
    {{#each mods.penaltyBreakdown as |modifier|}}<div class="alchemy-summary-modifier"><span>{{modifier.label}}</span><strong>{{#if (gt modifier.value 0)}}+{{/if}}{{modifier.value}}</strong></div>{{/each}}
    {{#if talents.hasNothingVentured}}<label class="alchemy-inline-check"><input type="checkbox" name="nothing-ventured" data-alchemy-control {{#if ws.nothingVentured}}checked{{/if}}> {{localize "UESRPG.Apps.AlchemyWorkshop.UseNothingVentured"}}</label>{{/if}}
  </section>
  {{/unless}}

  {{#each errors as |issue|}}<div class="alchemy-workshop-banner is-danger">{{issue.message}}</div>{{/each}}
  {{#each warnings as |issue|}}<div class="alchemy-workshop-banner is-warning">{{issue.message}}</div>{{/each}}
  {{else}}
  <div class="alchemy-workshop-banner is-danger">{{hardError}}</div>
  {{/if}}
</section>

<footer class="alchemy-workshop-footer">
  <div><span>{{localize "UESRPG.Apps.AlchemyWorkshop.ActiveMode"}}</span><strong>{{capitalize mode}}</strong></div>
  <button type="button" data-action="commit" class="alchemy-workshop-primary" {{#unless canCommit}}disabled{{/unless}}><i class="fas fa-dice-d100" aria-hidden="true"></i> {{actionLabel}}</button>
</footer>
</div>
