<div class="alchemy-workshop-wrap">
  {{#if error}}
    <div class="alchemy-workshop-banner is-danger">{{error}}</div>
  {{else}}
    <section class="workshop-header">
      <div class="alchemy-workshop-actor">
        <div class="alchemy-workshop-actor__text">
          <div class="actor-name">{{actor.name}}</div>
          <div class="alchemy-workshop-meta">
            {{#if skillSnapshot.found}}
              Alchemy TN {{skillSnapshot.tn}} · Rank {{skillSnapshot.rank}}
            {{else}}
              <span class="alchemy-workshop-text-danger">No valid Alchemy skill found</span>
            {{/if}}
          </div>
        </div>
      </div>

      <div class="alchemy-workshop-mode">
        <label class="alchemy-workshop-label" for="alchemy-workshop-mode">Mode</label>
        <select id="alchemy-workshop-mode" name="mode" class="alchemy-workshop-select">
          {{#if modes.potion}}<option value="potion" {{#if (eq ws.mode "potion")}}selected{{/if}}>Brew Potion</option>{{/if}}
          {{#if modes.poison}}<option value="poison" {{#if (eq ws.mode "poison")}}selected{{/if}}>Brew Poison</option>{{/if}}
          {{#if modes.toxin}}<option value="toxin" {{#if (eq ws.mode "toxin")}}selected{{/if}}>Brew Toxin</option>{{/if}}
          {{#if modes.gather}}<option value="gather" {{#if (eq ws.mode "gather")}}selected{{/if}}>Gather Ingredients</option>{{/if}}
        </select>
      </div>
    </section>

    {{#if hardError}}
      <div class="alchemy-workshop-banner is-danger">{{hardError}}</div>
    {{/if}}

    {{#if (or (eq ws.mode "potion") (eq ws.mode "toxin"))}}
      <section class="alchemy-workshop-section">
        <div class="alchemy-workshop-section__header">
          <h3>Known Effects</h3>
          <p>Teach the actor effects here, then drag known entries into ingredient slots below. Dropping a valid spell directly into a slot will auto-learn it.</p>
        </div>

        <div class="alchemy-known-dropzone" data-known-effect-drop>
          <div class="alchemy-known-dropzone__title">Drop spell here to learn effect</div>
          <div class="alchemy-known-dropzone__text">
            Accepts actor-owned spells for this actor and world spell items. Compendium spell drops are rejected.
          </div>
        </div>

        <div class="alchemy-known-list">
          {{#if knownEffects.length}}
            {{#each knownEffects as |entry|}}
              <article
                class="alchemy-known-entry {{#unless entry.valid}}is-invalid{{/unless}}"
                draggable="{{#if entry.valid}}true{{else}}false{{/if}}"
                {{#if entry.valid}}data-drag-spell-uuid="{{entry.spellUuid}}"{{/if}}>
                <div class="alchemy-known-entry__body">
                  <div class="alchemy-known-entry__title">{{entry.label}}</div>
                  <div class="alchemy-known-entry__meta">{{capitalize entry.school}} · {{entry.sourceLabel}} · {{entry.levelSummary}}</div>
                  {{#unless entry.valid}}
                    <div class="alchemy-known-entry__warning">
                      Source spell is missing or invalid. Remove this known effect or replace the underlying spell.
                    </div>
                  {{/unless}}
                </div>
                <button type="button" class="alchemy-workshop-button is-compact" data-remove-known-effect="{{entry.spellUuid}}">
                  Remove
                </button>
              </article>
            {{/each}}
          {{else}}
            <div class="alchemy-workshop-empty">
              No known effects stored yet. Add spells above, then drag them into the slots below.
            </div>
          {{/if}}
        </div>
      </section>

      <section class="alchemy-workshop-section">
        <div class="alchemy-workshop-section__header">
          <h3>{{#if (eq ws.mode "potion")}}Potion Effects{{else}}Toxin Effects{{/if}}</h3>
          <p>Up to {{maxSlots}} unique spell effects. Choose an ingredient first, then drop a known spell or a valid actor/world spell into the slot.</p>
        </div>

        <div class="alchemy-slot-list">
          {{#each slots as |s|}}
            <article data-slot-card="{{s.idx}}" class="alchemy-slot-card {{#if s.isActive}}is-active{{/if}}">
              <div class="alchemy-slot-card__top">
                <div class="alchemy-slot-card__label">Slot {{inc s.idx}}</div>
                <select name="ingredient-{{s.idx}}" data-slot="{{s.idx}}" class="alchemy-workshop-select alchemy-slot-card__ingredient">
                  <option value="">- Select Ingredient -</option>
                  {{#each @root.ingredients as |ing|}}
                    <option value="{{ing.id}}" {{#if (eq ing.id s.slot.ingredientId)}}selected{{/if}}>
                      {{ing.name}} ({{capitalize ing.school}}, Str {{ing.effectiveStrength}}, Depth {{ing.depthBase}}) x{{ing.qty}}
                    </option>
                  {{/each}}
                </select>
                {{#if s.slot.spellUuid}}
                  <button type="button" class="alchemy-workshop-button is-compact" data-clear-spell="{{s.idx}}">Clear</button>
                {{/if}}
              </div>

              <div data-spell-drop-slot="{{s.idx}}" class="alchemy-slot-dropzone {{#if s.currentEffectDetail}}is-filled{{/if}}">
                {{#if s.currentEffectDetail}}
                  <div class="alchemy-slot-dropzone__top">
                    <div>
                      <div class="alchemy-slot-dropzone__title">{{s.currentEffectDetail.label}}</div>
                      <div class="alchemy-slot-dropzone__meta">{{capitalize s.currentEffectDetail.school}} spell · {{s.currentEffectDetail.sourceLabel}}</div>
                    </div>
                    <div class="alchemy-slot-dropzone__stats">
                      Cost <strong>{{s.currentEffectDetail.cost}}</strong> / {{s.currentEffectDetail.effectiveStrength}}<br>
                      {{s.currentEffectDetail.durationLabel}}
                    </div>
                  </div>
                {{else if s.missingEffectLabel}}
                  <div class="alchemy-slot-dropzone__warning">
                    {{s.missingEffectLabel}} no longer resolves. Clear the slot or repair the matching Known Effects entry.
                  </div>
                {{else if s.ingredient}}
                  <div class="alchemy-slot-dropzone__hint">
                    Drop a known spell here for this {{capitalize s.ingredient.school}} ingredient, or drag a valid actor/world spell into the slot to auto-learn it.
                  </div>
                {{else}}
                  <div class="alchemy-slot-dropzone__hint">
                    Choose an ingredient first, then drop a spell into this slot.
                  </div>
                {{/if}}
              </div>

              {{#if s.currentEffectDetail}}
                <div class="alchemy-slot-level">
                  <label class="alchemy-workshop-label" for="alchemy-slot-sl-{{s.idx}}">Spell Level</label>
                  {{#if s.currentEffectDetail.hasDiscreteLevels}}
                    <select id="alchemy-slot-sl-{{s.idx}}" name="sl-{{s.idx}}" data-slot="{{s.idx}}" class="alchemy-workshop-select alchemy-slot-level__control">
                      {{#each s.currentEffectDetail.levelOptions as |level|}}
                        <option value="{{level}}" {{#if (eq level s.currentEffectDetail.selectedSpellLevel)}}selected{{/if}}>{{level}}</option>
                      {{/each}}
                    </select>
                  {{else}}
                    <input
                      id="alchemy-slot-sl-{{s.idx}}"
                      type="number"
                      name="sl-{{s.idx}}"
                      data-slot="{{s.idx}}"
                      value="{{s.slot.spellLevel}}"
                      min="{{s.currentEffectDetail.slMin}}"
                      max="{{s.currentEffectDetail.slMax}}"
                      class="alchemy-workshop-input alchemy-slot-level__control"
                      oninput="this.dispatchEvent(new Event('change',{bubbles:true}))">
                  {{/if}}
                </div>
              {{/if}}
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if (eq ws.mode "poison")}}
      <section class="alchemy-workshop-section">
        <div class="alchemy-workshop-section__header">
          <h3>Destruction Ingredient</h3>
          <p>Poisons require a destruction ingredient. Poison level equals ingredient depth.</p>
        </div>

        <div class="alchemy-poison-row">
          <select name="poison-ingredient" class="alchemy-workshop-select alchemy-poison-row__select">
            <option value="">- Select Destruction Ingredient -</option>
            {{#each destructionIngredients as |ing|}}
              <option value="{{ing.id}}" {{#if (eq ing.id ws.ingredientId)}}selected{{/if}}>
                {{ing.name}} ({{ing.tierLabel}}, Depth {{ing.depthBase}}) x{{ing.qty}}
              </option>
            {{/each}}
          </select>

          {{#if poisonIngredient}}
            <div class="alchemy-poison-row__summary">
              Poison Level <strong>{{poisonIngredient.depthBase}}</strong> → <strong>{{poisonDice}}</strong> damage
            </div>
          {{/if}}
        </div>

        {{#unless destructionIngredients.length}}
          <div class="alchemy-workshop-banner is-warning">No Destruction ingredients found in inventory.</div>
        {{/unless}}
      </section>
    {{/if}}

    {{#if (eq ws.mode "gather")}}
      <section class="alchemy-workshop-section">
        <div class="alchemy-workshop-section__header">
          <h3>Gather Ingredients</h3>
          <p>Roll Alchemy to search for ingredients from the chosen school.</p>
        </div>
        <div class="alchemy-gather-row">
          <label class="alchemy-workshop-label" for="alchemy-gather-school">School</label>
          <select id="alchemy-gather-school" name="gatherSchool" class="alchemy-workshop-select">
            {{#each schools as |school|}}
              <option value="{{school}}" {{#if (eq school gatherSchool)}}selected{{/if}}>{{capitalize school}}</option>
            {{/each}}
          </select>
        </div>
      </section>
    {{/if}}

    {{#unless (eq ws.mode "gather")}}
      <section class="alchemy-summary-panel">
        <div class="alchemy-summary-panel__badges">
          {{#if talents.isMasterAlchemist}}
            <span class="badge alchemy-summary-badge">Master Alchemist</span>
          {{/if}}
          {{#each talents.alchemistSchools as |school|}}
            <span class="badge alchemy-summary-badge">Alchemist [{{capitalize school}}]</span>
          {{/each}}
          {{#if talents.hasNothingVentured}}
            <span class="badge alchemy-summary-badge">Nothing Ventured, Nothing Gained</span>
          {{/if}}
          {{#if talents.hasTrialAndError}}
            <span class="badge alchemy-summary-badge">Trial and Error</span>
          {{/if}}
        </div>

        <div class="alchemy-summary-grid">
          {{#each mods.penaltyBreakdown as |p|}}
            <div class="alchemy-summary-grid__label">{{p.label}}</div>
            <div class="alchemy-summary-grid__value {{#if (lt p.value 0)}}is-negative{{else}}is-positive{{/if}}">
              {{#if (gt p.value 0)}}+{{/if}}{{p.value}}
            </div>
          {{/each}}

          <div class="alchemy-summary-grid__label is-strong">Adjusted TN</div>
          <div class="alchemy-summary-grid__value is-strong">{{adjustedTN}}</div>

          <div class="alchemy-summary-grid__label">Brew Time</div>
          <div class="alchemy-summary-grid__value">{{mods.brewTime}} hr{{#if (gt mods.brewTime 1)}}s{{/if}}</div>
        </div>

        {{#if talents.hasNothingVentured}}
          <label class="alchemy-inline-check" for="nothingVentured">
            <input type="checkbox" id="nothingVentured" name="nothingVentured" {{#if ws.nothingVentured}}checked{{/if}}>
            <span>Use Nothing Ventured (+20 TN, but doubles or failure cause backfire).</span>
          </label>
        {{/if}}

        {{#if validation.errors.length}}
          <div class="alchemy-workshop-banner is-danger">
            {{#each validation.errors as |err|}}
              <div>• {{err}}</div>
            {{/each}}
          </div>
        {{/if}}
      </section>
    {{/unless}}

    <footer class="alchemy-workshop-footer">
      {{#if (eq ws.mode "gather")}}
        <button type="button" data-action="rollGather" class="alchemy-workshop-button is-primary is-wide" {{#unless skillSnapshot.found}}disabled{{/unless}}>
          <i class="fas fa-dice"></i> Roll Alchemy (TN {{skillSnapshot.tn}})
        </button>
      {{else}}
        <button
          type="button"
          data-action="commit"
          class="alchemy-workshop-button is-primary is-wide"
          {{#if hasBlockingErrors}}disabled title="Fix blocking validation errors before committing."{{/if}}>
          <i class="fas fa-flask"></i>
          {{#if (eq ws.mode "potion")}}Brew Potion{{/if}}
          {{#if (eq ws.mode "poison")}}Brew Poison{{/if}}
          {{#if (eq ws.mode "toxin")}}Brew Toxin{{/if}}
        </button>
      {{/if}}
    </footer>
  {{/if}}
</div>
