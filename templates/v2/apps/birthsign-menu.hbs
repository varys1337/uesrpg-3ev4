<div class="uesrpg-creation-dialog">
  <div class="menu-pinned">
    <div class="menu-instructions">
      Select a Birthsign from the cards below or input your own custom birthsign label below.
      Leave blank if you do NOT want to use a custom birthsign.
      <input type="text" id="customSign">
    </div>
  </div>

  <div class="menu-cards">
    <h1 class="menu-section-heading">Birthsigns</h1>
    <div class="menu-grid">{{{signCards}}}</div>
  </div>

  <div class="creation-footer">
    <button type="button" data-action="cancel">Cancel</button>
    <button type="button" data-action="submit" class="default">Submit</button>
  </div>
</div>
