{{!-- AppV2 Enchanting Workshop. The ApplicationV2 root is the form element. --}}
<section class="enchanting-workshop-body">
  <input type="hidden" name="actorUuid" value="{{actorUuid}}">
  <input type="hidden" name="mode" value="{{mode}}">

  <header class="enchanting-workshop-header">
    <div class="enchanting-workshop-identity">
      <img class="enchanting-workshop-portrait" src="{{actorImg}}" alt="">
      <div class="enchanting-workshop-identity__copy">
        <span class="enchanting-workshop-kicker">{{localize "UESRPG.Apps.EnchantingWorkshop.IdentityKicker"}}</span>
        <strong class="enchanting-workshop-actor-name">{{actorName}}</strong>
        <span class="enchanting-workshop-skill">
          {{localize "UESRPG.Apps.EnchantingWorkshop.EnchantSkillSummary" tn=enchantTN rank=enchantRank}}
        </span>
      </div>
    </div>

    <div class="enchanting-workshop-inventory" aria-label="{{localize "UESRPG.Apps.EnchantingWorkshop.SoulGemInventory"}}">
      <div class="enchanting-workshop-stat">
        <span>{{localize "UESRPG.Apps.EnchantingWorkshop.TotalGems"}}</span>
        <strong>{{soulGemCount}}</strong>
      </div>
      <div class="enchanting-workshop-stat">
        <span>{{localize "UESRPG.Apps.EnchantingWorkshop.UsableGems"}}</span>
        <strong>{{filledGemCount}}</strong>
      </div>
      <div class="enchanting-workshop-stat">
        <span>{{localize "UESRPG.Apps.EnchantingWorkshop.EmptyGems"}}</span>
        <strong>{{emptyGemCount}}</strong>
      </div>
      <div class="enchanting-workshop-stat">
        <span>{{localize "UESRPG.Apps.EnchantingWorkshop.EnchantableItems"}}</span>
        <strong>{{workshopSummary.itemCount}}</strong>
      </div>
    </div>
  </header>

  {{#if (or hasManifold hasProcedural hasSalvage)}}
  <div class="enchanting-workshop-talents" aria-label="{{localize "UESRPG.Apps.EnchantingWorkshop.ActiveTalents"}}">
    {{#if hasManifold}}<span class="enchanting-workshop-chip">{{localize "UESRPG.ModernUI.ManifoldEnchanter"}}</span>{{/if}}
    {{#if hasProcedural}}<span class="enchanting-workshop-chip">{{localize "UESRPG.ModernUI.ProceduralEnchanting"}}</span>{{/if}}
    {{#if hasSalvage}}<span class="enchanting-workshop-chip">{{localize "UESRPG.ModernUI.SalvageEnergy"}}</span>{{/if}}
  </div>
  {{/if}}

  <nav class="enchanting-mode-tabs" aria-label="{{localize "UESRPG.Apps.EnchantingWorkshop.ModeNavigation"}}">
    {{#each modeOptions as |option|}}
    <button
      type="button"
      class="enchanting-mode-tab {{#if option.active}}is-active{{/if}}"
      data-action="modeChange"
      data-mode="{{option.key}}"
      aria-pressed="{{#if option.active}}true{{else}}false{{/if}}"
      aria-label="{{option.label}}"
      data-tooltip-text="{{option.tooltip}}"
      {{#unless option.available}}disabled{{/unless}}>
      <i class="{{option.icon}}" aria-hidden="true"></i>
      <span>{{option.label}}</span>
      {{#unless option.available}}<small>{{option.unavailableReason}}</small>{{/unless}}
    </button>
    {{/each}}
  </nav>

  {{#unless actorFound}}
  <div class="enchanting-workshop-banner is-danger">
    {{localize "UESRPG.Apps.EnchantingWorkshop.ActorUnavailable"}}
  </div>
  {{/unless}}

  {{#unless (eq mode "toggle")}}
  <section class="enchanting-panel enchanting-resources-panel">
    <header class="enchanting-panel__header">
      <div>
        <span class="enchanting-panel__eyebrow">{{localize "UESRPG.Apps.EnchantingWorkshop.StageResources"}}</span>
        <h3>{{localize "UESRPG.Apps.EnchantingWorkshop.ResourceSelection"}}</h3>
      </div>
      <span class="enchanting-panel__summary">{{workshopSummary.poolRule}}</span>
    </header>

    <div class="enchanting-resource-grid">
      {{#if (eq mode "recharge")}}
      <input type="hidden" name="enchantedItemUuid" value="{{selectedEnchanted.uuid}}" required>
      <div class="enchanting-field">
        <span>{{localize "UESRPG.ModernUI.EnchantedItemCastType"}}</span>
        <div class="enchanting-resource-drop {{#if selectedEnchanted}}is-selected{{/if}}" data-enchant-resource-drop="target" tabindex="0">
          {{#if selectedEnchanted}}
          <img src="{{selectedEnchanted.img}}" alt=""><span><strong>{{selectedEnchanted.name}}</strong><small>{{selectedEnchanted.meta}} · ×{{selectedEnchanted.quantity}}</small></span>
          <button type="button" data-action="clearResource" data-resource-kind="target" aria-label="{{localize 'UESRPG.Apps.EnchantingWorkshop.Dropzones.Clear'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
          {{else}}<i class="fas fa-box-open" aria-hidden="true"></i><span>{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.DropCastItem"}}</span>{{/if}}
        </div>
        <button type="button" class="enchanting-resource-choose" data-action="chooseResource" data-resource-kind="target">{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.ChooseInventory"}}</button>
      </div>
      {{else}}
      <input type="hidden" name="targetItemUuid" value="{{selectedTarget.uuid}}" required>
      <div class="enchanting-field">
        <span>{{#if (eq mode "strike")}}{{localize "UESRPG.ModernUI.WeaponAmmunitionToEnchant"}}{{else}}{{localize "UESRPG.ModernUI.ItemToEnchant"}}{{/if}}</span>
        <div class="enchanting-resource-drop {{#if selectedTarget}}is-selected{{/if}}" data-enchant-resource-drop="target" tabindex="0">
          {{#if selectedTarget}}
          <img src="{{selectedTarget.img}}" alt=""><span><strong>{{selectedTarget.name}}</strong><small>{{selectedTarget.meta}} · ×{{selectedTarget.quantity}}</small></span>
          <button type="button" data-action="clearResource" data-resource-kind="target" aria-label="{{localize 'UESRPG.Apps.EnchantingWorkshop.Dropzones.Clear'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
          {{else}}<i class="fas fa-box-open" aria-hidden="true"></i><span>{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.DropTarget"}}</span>{{/if}}
        </div>
        <button type="button" class="enchanting-resource-choose" data-action="chooseResource" data-resource-kind="target">{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.ChooseInventory"}}</button>
      </div>
      {{/if}}

      <input type="hidden" name="gemUuid" value="{{selectedGem.uuid}}" required>
      <div class="enchanting-field">
        <span>{{#if (eq mode "recharge")}}{{localize "UESRPG.ModernUI.SoulGemToUseForRecharge"}}{{else}}{{localize "UESRPG.Apps.EnchantingWorkshop.SoulGemSource"}}{{/if}}</span>
        <div class="enchanting-resource-drop {{#if selectedGem}}is-selected{{/if}}" data-enchant-resource-drop="gem" tabindex="0">
          {{#if selectedGem}}
          <img src="{{selectedGem.img}}" alt=""><span><strong>{{selectedGem.name}}</strong><small>{{selectedGem.meta}} · ×{{selectedGem.quantity}}</small></span>
          <button type="button" data-action="clearResource" data-resource-kind="gem" aria-label="{{localize 'UESRPG.Apps.EnchantingWorkshop.Dropzones.Clear'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
          {{else}}<i class="fas fa-gem" aria-hidden="true"></i><span>{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.DropGem"}}</span>{{/if}}
        </div>
        <button type="button" class="enchanting-resource-choose" data-action="chooseResource" data-resource-kind="gem">{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.ChooseInventory"}}</button>
        {{#unless hasSoulGems}}
        <small class="enchanting-field__hint is-danger">{{localize "UESRPG.Apps.EnchantingWorkshop.NoSoulGems"}}</small>
        {{else unless hasFilledSoulGems}}
        <small class="enchanting-field__hint is-warning">{{localize "UESRPG.Apps.EnchantingWorkshop.OnlyEmptySoulGems"}}</small>
        {{else if emptyGemCount}}
        <small class="enchanting-field__hint">{{localize "UESRPG.Apps.EnchantingWorkshop.EmptyGemHelp" count=emptyGemCount}}</small>
        {{/unless}}
      </div>
    </div>
  </section>
  {{/unless}}

  {{#if (eq mode "cast")}}
  <section class="enchanting-panel">
    <header class="enchanting-panel__header">
      <div>
        <span class="enchanting-panel__eyebrow">{{localize "UESRPG.Apps.EnchantingWorkshop.StageEffects"}}</span>
        <h3>{{localize "UESRPG.ModernUI.CastEnchantmentStoredSpell"}}</h3>
      </div>
      <span class="enchanting-panel__summary">{{localize "UESRPG.Apps.EnchantingWorkshop.StoredSlotSummary" slots=workshopSummary.slotCount spells=workshopSummary.spellOptionCount}}</span>
    </header>

    <div class="enchanting-slot-list">
      {{#each castSpellSlots as |slot|}}
      <article class="enchanting-slot-card">
        <header class="enchanting-slot-card__header">
          <div>
            <strong>{{localize "UESRPG.ModernUI.SpellSlot" value1=slot.number}}</strong>
            <small>{{#if slot.isPrimary}}{{localize "UESRPG.Apps.EnchantingWorkshop.PrimarySlot"}}{{else}}{{localize "UESRPG.Apps.EnchantingWorkshop.ManifoldSlot"}}{{/if}}</small>
          </div>
          <span class="enchanting-workshop-chip">{{slot.availableSpellCount}} {{localize "UESRPG.ModernUI.KnownSpell"}}</span>
        </header>

        <div class="enchanting-form-grid">
          <label class="enchanting-field">
            <span>{{localize "UESRPG.Sheets.Item.Source"}}</span>
            <select name="spell_source_{{slot.index}}">
              <option value="conventional">{{localize "UESRPG.Sheets.Item.ConventionalStoredSpell"}}</option>
              <option value="unconventional">{{localize "UESRPG.Sheets.Item.UnconventionalStoredSpell"}}</option>
            </select>
          </label>
          <label class="enchanting-field is-wide">
            <span>{{localize "UESRPG.Sheets.Item.StoredSpell"}}</span>
            <select name="spell_select_uuid_{{slot.index}}">
              <option value="">{{localize "UESRPG.ModernUI.SelectSpell"}}</option>
              {{#each slot.spellOptions as |option|}}<option value="{{option.value}}">{{option.label}}</option>{{/each}}
            </select>
            {{#unless slot.availableSpellCount}}<small class="enchanting-field__hint is-warning">{{localize "UESRPG.ModernUI.NoActorOwnedSpellsAvailableUseAdvancedToPreserveALegacyUUID"}}</small>{{/unless}}
          </label>
          <label class="enchanting-field">
            <span>{{localize "UESRPG.Sheets.Item.Label"}}</span>
            <input type="text" name="spell_label_{{slot.index}}" placeholder="{{localize "UESRPG.ModernUI.EGFireball"}}">
          </label>
          <label class="enchanting-field is-number">
            <span>{{localize "UESRPG.Chat.Magic.Level"}}</span>
            <input type="number" name="spell_level_{{slot.index}}" min="0" max="7" value="{{slot.level}}">
          </label>
          <label class="enchanting-field is-number">
            <span>{{localize "UESRPG.Chat.Magic.SoulEnergyCost"}}</span>
            <input type="number" name="spell_cost_{{slot.index}}" min="0" value="{{slot.cost}}">
          </label>
          <label class="enchanting-field is-wide">
            <span>{{localize "UESRPG.Sheets.Item.Attributes"}}</span>
            <input type="text" name="spell_attributes_{{slot.index}}" placeholder="{{localize "UESRPG.Placeholders.AttributesCommaSeparated"}}">
          </label>
        </div>

        <details class="enchanting-advanced">
          <summary>{{localize "UESRPG.ModernUI.AdvancedLegacyUUID"}}</summary>
          <label class="enchanting-field">
            <span>{{localize "UESRPG.Sheets.Item.SpellUUID"}}</span>
            <input type="text" name="spell_uuid_{{slot.index}}" placeholder="{{localize "UESRPG.ModernUI.ActorXItemYOrCompendiumXY"}}">
          </label>
        </details>
      </article>
      {{/each}}
    </div>

    <p class="enchanting-note">
      {{localize "UESRPG.ModernUI.RAWOneEnchantTestPerSpellSlot" value1=workshopSummary.poolRule}}
      {{#if hasProcedural}}{{localize "UESRPG.ModernUI.ProceduralEnchantingOnSuccessChooseDoSOrEnchantRankAsBindingStrength"}}{{/if}}
      {{#if hasSalvage}}{{localize "UESRPG.ModernUI.SalvageEnergyOnFailureAFollowUpTestMayPreserveTheSoulGem"}}{{/if}}
    </p>
  </section>
  {{/if}}

  {{#if (eq mode "strike")}}
  <section class="enchanting-panel">
    <header class="enchanting-panel__header">
      <div>
        <span class="enchanting-panel__eyebrow">{{localize "UESRPG.Apps.EnchantingWorkshop.StageEffects"}}</span>
        <h3>{{localize "UESRPG.ModernUI.StrikeEnchantmentOnHitEffect"}}</h3>
      </div>
      <span class="enchanting-panel__summary">{{#if hasManifold}}{{localize "UESRPG.Apps.EnchantingWorkshop.UpToThreeEffects"}}{{else}}{{localize "UESRPG.Apps.EnchantingWorkshop.OneEffect"}}{{/if}}</span>
    </header>

    <div class="enchanting-slot-list">
      <article class="enchanting-slot-card">
        <header class="enchanting-slot-card__header"><div><strong>{{localize "UESRPG.ModernUI.StrikeEffect1"}}</strong><small>{{localize "UESRPG.Apps.EnchantingWorkshop.PrimarySlot"}}</small></div></header>
        <div class="enchanting-effect-grid">
          <label class="enchanting-field is-effect"><span>{{localize "UESRPG.UI.Effect"}}</span><select name="strike_key_0" required><option value="">{{localize "UESRPG.ModernUI.SelectEffect"}}</option>{{#each strikeOptions}}<option value="{{key}}">{{label}} ({{costFormula}})</option>{{/each}}</select></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.ModernUI.SL"}}</span><input type="number" name="strike_sl_0" min="1" max="7" value="1"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.ModernUI.YDrainAbsorbAmountIfApplicable"}}</span><input type="number" name="strike_y_0" min="0" value="0"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Sheets.Feature.Type"}}</span><input type="text" name="strike_type_0" placeholder="{{localize "UESRPG.Placeholders.WeaponOrArmor"}}"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Sheets.Item.Cost"}}</span><input type="number" name="strike_cost_0" min="0" value="10"></label>
        </div>
      </article>

      {{#if hasManifold}}
      {{#each manifoldEffectSlots as |slot|}}
      <article class="enchanting-slot-card">
        <header class="enchanting-slot-card__header"><div><strong>{{localize "UESRPG.Apps.EnchantingWorkshop.StrikeEffectNumber" number=slot.number}}</strong><small>{{localize "UESRPG.Apps.EnchantingWorkshop.ManifoldSlot"}}</small></div></header>
        <div class="enchanting-effect-grid">
          <label class="enchanting-field is-effect"><span>{{localize "UESRPG.UI.Effect"}}</span><select name="strike_key_{{slot.index}}"><option value="">{{localize "UESRPG.ModernUI.None"}}</option>{{#each @root.strikeOptions}}<option value="{{key}}">{{label}} ({{costFormula}})</option>{{/each}}</select></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.ModernUI.SL"}}</span><input type="number" name="strike_sl_{{slot.index}}" min="0" max="7" value="0"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Apps.EnchantingWorkshop.ParameterY"}}</span><input type="number" name="strike_y_{{slot.index}}" min="0" value="0"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Sheets.Feature.Type"}}</span><input type="text" name="strike_type_{{slot.index}}"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Sheets.Item.Cost"}}</span><input type="number" name="strike_cost_{{slot.index}}" min="0" value="0"></label>
        </div>
      </article>
      {{/each}}
      {{/if}}
    </div>

    <p class="enchanting-note {{#if enableChargedStrike}}is-warning{{/if}}">
      {{#if enableChargedStrike}}<strong>{{localize "UESRPG.ModernUI.ChargedStrikeVariantActive"}}</strong> {{localize "UESRPG.ModernUI.PoolFloorTotalCost10Charges"}}{{else}}{{localize "UESRPG.ModernUI.StrikeEnchantmentsHaveNoPoolByDefaultNoRechargeEnableTheChargedStrikeVar"}}{{/if}}
    </p>
  </section>
  {{/if}}

  {{#if (eq mode "constant")}}
  <section class="enchanting-panel">
    <header class="enchanting-panel__header">
      <div>
        <span class="enchanting-panel__eyebrow">{{localize "UESRPG.Apps.EnchantingWorkshop.StageEffects"}}</span>
        <h3>{{localize "UESRPG.ModernUI.ConstantEnchantmentPassiveEffect"}}</h3>
      </div>
      <span class="enchanting-panel__summary">{{#if hasManifold}}{{localize "UESRPG.Apps.EnchantingWorkshop.UpToThreeEffects"}}{{else}}{{localize "UESRPG.Apps.EnchantingWorkshop.OneEffect"}}{{/if}}</span>
    </header>

    <p class="enchanting-note is-warning"><strong>{{localize "UESRPG.ModernUI.Restrictions"}}</strong> {{localize "UESRPG.ModernUI.EffectsMustHaveUpkeepAndAListedDuration"}} {{localize "UESRPG.ModernUI.BecomeEtherealConjurationAndNecromancyEffectsAreProhibited"}}</p>

    <div class="enchanting-slot-list">
      <article class="enchanting-slot-card">
        <header class="enchanting-slot-card__header"><div><strong>{{localize "UESRPG.ModernUI.ConstantEffect1"}}</strong><small>{{localize "UESRPG.Apps.EnchantingWorkshop.PrimarySlot"}}</small></div></header>
        <div class="enchanting-effect-grid is-constant">
          <label class="enchanting-field is-effect"><span>{{localize "UESRPG.ModernUI.EffectUpkeepEligibleOnly"}}</span><select name="const_key_0" required><option value="">{{localize "UESRPG.ModernUI.SelectEffect"}}</option>{{#each spellfxConstantOptions}}<option value="{{key}}">{{label}} ({{school}})</option>{{/each}}</select></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.ModernUI.SL"}}</span><input type="number" name="const_sl_0" min="1" max="7" value="1"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Sheets.Item.Cost"}}</span><input type="number" name="const_cost_0" min="0" value="10"></label>
          <label class="enchanting-field is-params"><span>{{localize "UESRPG.ModernUI.Params"}}</span><input type="text" name="const_params_0" placeholder="{}"></label>
        </div>
      </article>

      {{#if hasManifold}}
      {{#each manifoldEffectSlots as |slot|}}
      <article class="enchanting-slot-card">
        <header class="enchanting-slot-card__header"><div><strong>{{localize "UESRPG.Apps.EnchantingWorkshop.ConstantEffectNumber" number=slot.number}}</strong><small>{{localize "UESRPG.Apps.EnchantingWorkshop.ManifoldSlot"}}</small></div></header>
        <div class="enchanting-effect-grid is-constant">
          <label class="enchanting-field is-effect"><span>{{localize "UESRPG.UI.Effect"}}</span><select name="const_key_{{slot.index}}"><option value="">{{localize "UESRPG.ModernUI.None"}}</option>{{#each @root.spellfxConstantOptions}}<option value="{{key}}">{{label}}</option>{{/each}}</select></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.ModernUI.SL"}}</span><input type="number" name="const_sl_{{slot.index}}" min="0" max="7" value="0"></label>
          <label class="enchanting-field"><span>{{localize "UESRPG.Sheets.Item.Cost"}}</span><input type="number" name="const_cost_{{slot.index}}" min="0" value="0"></label>
          <label class="enchanting-field is-params"><span>{{localize "UESRPG.ModernUI.Params"}}</span><input type="text" name="const_params_{{slot.index}}" placeholder="{}"></label>
        </div>
      </article>
      {{/each}}
      {{/if}}
    </div>

    {{#if enableCursed}}
    <label class="enchanting-toggle-field">
      <input type="checkbox" name="cursed" value="1">
      <span><strong>{{localize "UESRPG.ModernUI.CursedConstantOptionalRule"}}</strong> {{localize "UESRPG.ModernUI.CursedConstantEnchantmentsCannotBeDisabledByTheWearerSpecialFailureCaden"}}</span>
    </label>
    {{/if}}
  </section>
  {{/if}}

  {{#if (eq mode "recharge")}}
  <section class="enchanting-panel">
    <header class="enchanting-panel__header">
      <div>
        <span class="enchanting-panel__eyebrow">{{localize "UESRPG.Apps.EnchantingWorkshop.StageRitual"}}</span>
        <h3>{{localize "UESRPG.ModernUI.RechargeCastEnchantment"}}</h3>
      </div>
    </header>
    <p class="enchanting-note"><strong>{{localize "UESRPG.ModernUI.RAW"}}</strong> {{localize "UESRPG.ModernUI.RequiresTrainedEnchantRankNoTestRequired"}} {{localize "UESRPG.ModernUI.Text1MinuteRitualTransfersGemSoulEnergyIntoPoolUpToMaxExcessLost"}}</p>
  </section>
  {{/if}}

  {{#if (eq mode "toggle")}}
  <section class="enchanting-panel">
    <header class="enchanting-panel__header">
      <div>
        <span class="enchanting-panel__eyebrow">{{localize "UESRPG.Apps.EnchantingWorkshop.StageMaintenance"}}</span>
        <h3>{{localize "UESRPG.ModernUI.ToggleConstantEnchantment"}}</h3>
      </div>
    </header>
    <p class="enchanting-note">{{localize "UESRPG.ModernUI.EnableOrDisableAConstantEnchantmentOnAnItemCursedEnchantmentsCannotBeDis"}}</p>
    <input type="hidden" name="enchantedItemUuid" value="{{selectedEnchanted.uuid}}" required>
    <div class="enchanting-field">
      <span>{{localize "UESRPG.ModernUI.EnchantedItemConstantType"}}</span>
      <div class="enchanting-resource-drop {{#if selectedEnchanted}}is-selected{{/if}}" data-enchant-resource-drop="target" tabindex="0">
        {{#if selectedEnchanted}}
        <img src="{{selectedEnchanted.img}}" alt=""><span><strong>{{selectedEnchanted.name}}</strong><small>{{selectedEnchanted.meta}}</small></span>
        <button type="button" data-action="clearResource" data-resource-kind="target" aria-label="{{localize 'UESRPG.Apps.EnchantingWorkshop.Dropzones.Clear'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
        {{else}}<i class="fas fa-toggle-on" aria-hidden="true"></i><span>{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.DropConstantItem"}}</span>{{/if}}
      </div>
      <button type="button" class="enchanting-resource-choose" data-action="chooseResource" data-resource-kind="target">{{localize "UESRPG.Apps.EnchantingWorkshop.Dropzones.ChooseInventory"}}</button>
    </div>
  </section>
  {{/if}}

  <footer class="enchanting-workshop-footer">
    <div class="enchanting-workshop-footer__summary">
      <strong>{{activeMode.label}}</strong>
      <span>{{activeMode.description}}</span>
    </div>
    <button type="submit" class="enchanting-submit" {{#unless canSubmit}}disabled{{/unless}}>
      <i class="{{activeMode.icon}}" aria-hidden="true"></i>
      {{#if (eq mode "cast")}}{{localize "UESRPG.Apps.EnchantingWorkshop.CreateCast"}}{{/if}}
      {{#if (eq mode "strike")}}{{localize "UESRPG.Apps.EnchantingWorkshop.CreateStrike"}}{{/if}}
      {{#if (eq mode "constant")}}{{localize "UESRPG.Apps.EnchantingWorkshop.CreateConstant"}}{{/if}}
      {{#if (eq mode "recharge")}}{{localize "UESRPG.Apps.EnchantingWorkshop.Recharge"}}{{/if}}
      {{#if (eq mode "toggle")}}{{localize "UESRPG.Apps.EnchantingWorkshop.Toggle"}}{{/if}}
    </button>
  </footer>
</section>
