<div class="uesrpg-stamina-dialog">
  <div class="uesrpg-stamina-status">
    <p class="uesrpg-stamina-status__line"><b>{{localize "UESRPG.Dialogs.Stamina.CurrentSP"}}:</b> {{currentSP}} / {{maxSP}}</p>
    {{#if (gt tempSP 0)}}
    <p class="uesrpg-stamina-status__line"><b>{{localize "UESRPG.Dialogs.Stamina.TemporarySP"}}:</b> +{{tempSP}}</p>
    {{/if}}
    <p class="uesrpg-stamina-status__line"><b>{{localize "UESRPG.Dialogs.Stamina.EffectiveSP"}}:</b> {{effectiveSP}} / {{maxSP}}</p>
  </div>
  <div class="uesrpg-resource-dialog__form uesrpg-stamina-form">
    <div class="form-group">
      <label><b>{{localize "UESRPG.Dialogs.Stamina.SelectAction"}}:</b></label>
      <select name="stamina-action" class="uesrpg-stamina-select">
        <option value="">{{localize "UESRPG.Dialogs.Stamina.SelectOption"}}</option>
        {{#each options}}
          <option value="{{id}}">{{name}} ({{cost}} SP)</option>
        {{/each}}
      </select>
    </div>
    <div class="uesrpg-stamina-power-attack is-hidden">
      <label><b>{{localize "UESRPG.Dialogs.Stamina.PowerAttackAmount"}}:</b></label>
      <input type="number" name="power-attack-sp" min="1" max="3" value="1" class="uesrpg-stamina-input" />
    </div>
  </div>
</div>
