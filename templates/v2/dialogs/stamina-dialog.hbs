<div class="uesrpg-stamina-dialog">
  <div class="uesrpg-stamina-status{{#if showWarning}} is-warning{{/if}}">
    <p class="uesrpg-stamina-status__line"><b>Current SP:</b> {{currentSP}}</p>
    {{#if (gt tempSP 0)}}
    <p class="uesrpg-stamina-status__line"><b>Temporary SP:</b> +{{tempSP}} <span class="u-text-faint u-text-sm">(consumed first)</span></p>
    {{/if}}
    <p class="uesrpg-stamina-status__line"><b>Effective SP:</b> {{effectiveSP}} / {{maxSP}}</p>
    {{#if showWarning}}
      <p class="uesrpg-stamina-warning">⚠️ Warning: Spending at or below 0 SP will increase fatigue.</p>
    {{/if}}
  </div>
  <div class="uesrpg-resource-dialog__form uesrpg-stamina-form">
    <div class="form-group">
      <label><b>Select Stamina Action:</b></label>
      <select name="stamina-action" class="uesrpg-stamina-select">
        <option value="">-- Select an option --</option>
        {{#each options}}
          <option value="{{id}}" data-description="{{description}}">{{name}} ({{cost}} SP)</option>
        {{/each}}
      </select>
      <p class="uesrpg-stamina-action-help uesrpg-resource-dialog__hint">Choose an action to see details.</p>
    </div>
    <div class="uesrpg-stamina-power-attack is-hidden">
      <label><b>Power Attack SP Amount (1-3):</b></label>
      <input type="number" name="power-attack-sp" min="1" max="3" value="1" class="uesrpg-stamina-input" />
    </div>
  </div>
</div>
