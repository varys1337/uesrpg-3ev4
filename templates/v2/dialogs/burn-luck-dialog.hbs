<div class="uesrpg-resource-dialog__layout uesrpg-burn-luck">
  <div class="uesrpg-resource-dialog__body">
    <div class="uesrpg-burn-luck__summary">
      <p class="uesrpg-burn-luck__summary-line"><strong>{{actorName}}</strong></p>
      <p class="uesrpg-burn-luck__summary-line">{{localize "UESRPG.Dialogs.BurnLuck.BurnableLuck"}}: <strong>{{currentLuck}}</strong></p>
      <p class="uesrpg-burn-luck__summary-line">{{localize "UESRPG.Dialogs.BurnLuck.TotalLuck"}}: <strong>{{totalLuck}}</strong></p>
      <p class="uesrpg-resource-dialog__hint">{{localize "UESRPG.Dialogs.BurnLuck.Hint"}}</p>
    </div>

    <div class="uesrpg-burn-luck__grid">
      {{#each options}}
      <div class="uesrpg-burn-luck__card{{#unless this.available}} is-disabled{{/unless}}">
        <button
          type="button"
          class="uesrpg-burn-luck__option{{#unless this.available}} is-disabled{{/unless}}"
          data-option-id="{{this.id}}"
          {{#unless this.available}}disabled{{/unless}}>
          <span class="uesrpg-burn-luck__option-title">{{this.title}}</span>
        </button>
        <p class="uesrpg-burn-luck__option-text">{{this.effectText}}</p>
      </div>
      {{/each}}
    </div>
  </div>
</div>
