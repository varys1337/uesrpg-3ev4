<div class="uesrpg-resource-dialog__layout">
  <div class="uesrpg-resource-dialog__body uesrpg-magicka-barrier-dialog">
    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">{{localize "UESRPG.Dialogs.MagickaBarrier.Magicka"}}</label>
      <input type="number" name="magicka" value="{{currentMP}}" min="0" max="{{maxMP}}" />
      <span class="uesrpg-resource-dialog__hint hint">{{localize "UESRPG.Dialogs.MagickaBarrier.Max" max=maxMP}}</span>
    </div>

    <p class="uesrpg-resource-dialog__hint uesrpg-resource-dialog__hint--copy">
      {{localize "UESRPG.Dialogs.MagickaBarrier.Copy"}}
    </p>

    {{#if hasBarrierEffects}}
    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">{{localize "UESRPG.Dialogs.MagickaBarrier.ActiveSources"}}</label>
      <ul class="uesrpg-magicka-barrier-dialog__sources">
        {{#each barrierEffects}}
        <li>
          <strong>{{this.name}}</strong> - {{this.typeLabel}} {{this.originalValue}}{{#if this.hasUpkeep}} <span class="hint">({{localize "UESRPG.UI.Upkeep"}})</span>{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">
        {{localize "UESRPG.Dialogs.MagickaBarrier.PhysicalBuffer"}}
        {{#if physicalSourceCount}}
        <span class="buffer-source-indicator" title="{{localize "UESRPG.Dialogs.MagickaBarrier.SourceCount" count=physicalSourceCount title=physicalSourceTitle}}">({{physicalSourceCount}})</span>
        {{/if}}
      </label>
      <input type="number" name="bufferPhysical" value="{{physBuf}}" min="0" />
      <span class="uesrpg-resource-dialog__hint hint">{{localize "UESRPG.Dialogs.MagickaBarrier.PhysicalHint"}}</span>
    </div>

    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">
        {{localize "UESRPG.Dialogs.MagickaBarrier.MagicalBuffer"}}
        {{#if magicalSourceCount}}
        <span class="buffer-source-indicator" title="{{localize "UESRPG.Dialogs.MagickaBarrier.SourceCount" count=magicalSourceCount title=magicalSourceTitle}}">({{magicalSourceCount}})</span>
        {{/if}}
      </label>
      <input type="number" name="bufferMagical" value="{{magBuf}}" min="0" />
      <span class="uesrpg-resource-dialog__hint hint">{{localize "UESRPG.Dialogs.MagickaBarrier.MagicalHint"}}</span>
    </div>

    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">
        {{localize "UESRPG.Dialogs.MagickaBarrier.ElementalBuffer"}}
        {{#if elementalSourceCount}}
        <span class="buffer-source-indicator" title="{{localize "UESRPG.Dialogs.MagickaBarrier.SourceCount" count=elementalSourceCount title=elementalSourceTitle}}">({{elementalSourceCount}})</span>
        {{/if}}
      </label>
      <input type="number" name="bufferElemental" value="{{elemBuf}}" min="0" />
      <span class="uesrpg-resource-dialog__hint hint">{{localize "UESRPG.Dialogs.MagickaBarrier.ElementalHint"}}</span>
    </div>
  </div>
</div>
