<div class="uesrpg-resource-dialog__layout">
  <div class="uesrpg-resource-dialog__body uesrpg-piety-dialog">
    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">Domain</label>
      <span class="uesrpg-resource-dialog__hint hint">{{domainLabel}}</span>
    </div>

    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">Current PP</label>
      <input type="number" name="currentPP" value="{{currentPP}}" min="0" />
    </div>

    <div class="uesrpg-resource-dialog__group form-group">
      <label class="uesrpg-resource-dialog__label">Maximum PP</label>
      <input type="number" name="maxPP" value="{{maxPP}}" min="0" />
    </div>
  </div>
</div>
